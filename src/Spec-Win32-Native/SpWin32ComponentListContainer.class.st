Class {	#name : 'SpWin32ComponentListContainer',	#superclass : 'SpWin32NativeControl',	#instVars : [		'contentControl',		'rows',		'scrollPosition',		'rowBounds',		'lastPageExtent',		'lastContentExtent',		'rowSpacing'	],	#category : 'Spec-Win32-Native-Collections',	#package : 'Spec-Win32-Native',	#tag : 'Collections'}{ #category : 'instance creation' }SpWin32ComponentListContainer class >> runtime: aRuntime [	^ self new		runtime: aRuntime;		kind: aRuntime class controlScrollViewport;		text: '';		preferredExtent: 240@160;		eventHandler: nil;		yourself]{ #category : 'accessing' }SpWin32ComponentListContainer >> children [	^ rows asArray]{ #category : 'lifecycle' }SpWin32ComponentListContainer >> destroy [	rows do: [ :row | row destroy ].	contentControl ifNotNil: [ :content | content destroy ].	contentControl := nil.	rows removeAll.	super destroy]{ #category : 'private - lifecycle' }SpWin32ComponentListContainer >> ensureContentControl [	contentControl ifNil: [		contentControl := SpWin32NativeControl			runtime: runtime			kind: runtime class controlScrollContent			text: ''			preferredExtent: 1@1 ]]{ #category : 'initialization' }SpWin32ComponentListContainer >> initialize [	super initialize.	rows := OrderedCollection new.	selectedIndexes := #().	scrollPosition := 0@0.	rowBounds := #().	lastPageExtent := 1@1.	lastContentExtent := 1@1.	rowSpacing := 1]{ #category : 'accessing' }SpWin32ComponentListContainer >> rowBounds [ ^ rowBounds ]{ #category : 'accessing' }SpWin32ComponentListContainer >> rows [ ^ rows asArray ]{ #category : 'accessing' }SpWin32ComponentListContainer >> rows: aCollection [	rows := aCollection asOrderedCollection.	rows do: [ :row |		(row respondsTo: #layoutOwner:) ifTrue: [ row layoutOwner: self ] ].	self applySelection.	self requestRelayout]{ #category : 'selection' }SpWin32ComponentListContainer >> applySelection [	rows withIndexDo: [ :row :index |		row selected: (selectedIndexes includes: index) ]]{ #category : 'selection' }SpWin32ComponentListContainer >> selectedIndexes [ ^ selectedIndexes ]{ #category : 'selection' }SpWin32ComponentListContainer >> selectedIndexes: aCollection [	selectedIndexes := (aCollection collect: #asInteger) asArray.	self applySelection]{ #category : 'scrolling' }SpWin32ComponentListContainer >> scrollPosition [ ^ scrollPosition ]{ #category : 'scrolling' }SpWin32ComponentListContainer >> scrollToIndex: anInteger [	| rectangle top bottom y |	(anInteger between: 1 and: rowBounds size) ifFalse: [ ^ self ].	rectangle := rowBounds at: anInteger.	top := scrollPosition y.	bottom := top + lastPageExtent y.	y := top.	rectangle top < top ifTrue: [ y := rectangle top ].	rectangle bottom > bottom ifTrue: [ y := rectangle bottom - lastPageExtent y ].	y := y max: 0.	scrollPosition := scrollPosition x @ y.	self isValid ifTrue: [ runtime setScrollViewport: self position: scrollPosition ]]{ #category : 'native events' }SpWin32ComponentListContainer >> win32ScrollPositionChanged: aPoint [	scrollPosition := aPoint]{ #category : 'geometry' }SpWin32ComponentListContainer >> refreshRowsIn: aNativeParent [	rows do: [ :row | row refreshPreferredExtentIn: aNativeParent ]]{ #category : 'geometry' }SpWin32ComponentListContainer >> contentExtentForPage: pageExtent [	| maxWidth totalHeight |	maxWidth := pageExtent x max: 1.	totalHeight := 0.	rows withIndexDo: [ :row :index |		maxWidth := maxWidth max: row preferredExtent x.		totalHeight := totalHeight + row preferredExtent y.		index < rows size ifTrue: [ totalHeight := totalHeight + rowSpacing ] ].	^ maxWidth @ ((totalHeight max: pageExtent y) max: 1)]{ #category : 'lifecycle' }SpWin32ComponentListContainer >> realizeIn: aNativeParent bounds: aRectangle [	| initialExtent contentExtent pageExtent y placements boundsCollection |	super realizeIn: aNativeParent bounds: aRectangle.	runtime setControlBoundsBatch: { { self. aRectangle left. aRectangle top. aRectangle width. aRectangle height } }.	self ensureContentControl.	initialExtent := aRectangle extent max: 1@1.	contentControl realizeIn: self bounds: (0@0 extent: initialExtent).	self refreshRowsIn: contentControl.	contentExtent := self contentExtentForPage: initialExtent.	contentControl realizeIn: self bounds: (0@0 extent: contentExtent).	runtime		configureScrollViewport: self		content: contentControl		extent: contentExtent		horizontalPolicy: runtime class scrollPolicyAutomatic		verticalPolicy: runtime class scrollPolicyAutomatic.	pageExtent := runtime scrollViewportPageExtent: self.	lastPageExtent := pageExtent.	contentExtent := self contentExtentForPage: pageExtent.	lastContentExtent := contentExtent.	contentControl realizeIn: self bounds: (0@0 extent: contentExtent).	placements := OrderedCollection new.	boundsCollection := OrderedCollection new.	y := 0.	rows do: [ :row |		| rectangle |		rectangle := (0@y) extent: (contentExtent x @ row preferredExtent y).		boundsCollection add: rectangle.		row realizeIn: contentControl bounds: rectangle.		placements add: { row. rectangle left. rectangle top. rectangle width. rectangle height }.		y := y + rectangle height + rowSpacing ].	rowBounds := boundsCollection asArray.	placements ifNotEmpty: [ runtime setControlBoundsBatch: placements ].	runtime		configureScrollViewport: self		content: contentControl		extent: contentExtent		horizontalPolicy: runtime class scrollPolicyAutomatic		verticalPolicy: runtime class scrollPolicyAutomatic.	runtime setScrollViewport: self position: scrollPosition]{ #category : 'geometry' }SpWin32ComponentListContainer >> requestRelayout [	layoutOwner		ifNotNil: [ :owner | owner requestRelayout ]		ifNil: [			(parentWindow notNil and: [ bounds notNil ]) ifTrue: [				self realizeIn: parentWindow bounds: bounds ] ]]{ #category : 'geometry' }SpWin32ComponentListContainer >> relayoutExtent: anExtent [	parentWindow ifNil: [ ^ self ].	^ self realizeIn: parentWindow bounds: ((bounds ifNil: [ 0@0 extent: anExtent ]) origin extent: anExtent)]{ #category : 'lifecycle' }SpWin32ComponentListContainer >> realizeIn: aNativeParent extent: anExtent [	^ self realizeIn: aNativeParent bounds: (0@0 extent: anExtent)]