Class {	#name : 'SpWin32RuntimeEventLibrary',	#superclass : 'FFILibrary',	#category : 'Spec-Win32-Native-Libraries',	#package : 'Spec-Win32-Native',	#tag : 'Libraries'}{ #category : 'accessing - platform' }SpWin32RuntimeEventLibrary >> macLibraryName [	^ self error: 'The Spec Win32 runtime DLL is available only on Windows']{ #category : 'threaded ffi' }SpWin32RuntimeEventLibrary >> runner [	^ TFWorker named: 'Spec Win32 events']{ #category : 'accessing - platform' }SpWin32RuntimeEventLibrary >> unixLibraryName [	^ self error: 'The Spec Win32 runtime DLL is available only on Windows']{ #category : 'accessing - platform' }SpWin32RuntimeEventLibrary >> win32LibraryName [	^ 'spec-win32-runtime.dll']