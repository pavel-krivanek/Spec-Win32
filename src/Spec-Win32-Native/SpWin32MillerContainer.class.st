Class {	#name : 'SpWin32MillerContainer',	#superclass : 'SpWin32NativeControl',	#instVars : [		'layout',		'pages',		'contentControl',		'horizontalScrollBar',		'scrollPosition',		'firstShowingPageIndex',		'lastPageExtent',		'lastContentExtent'	],	#category : 'Spec-Win32-Native-Layout',	#package : 'Spec-Win32-Native',	#tag : 'Layout'}{ #category : 'instance creation' }SpWin32MillerContainer class >> layout: aLayout runtime: aRuntime [	^ self new		runtime: aRuntime;		kind: aRuntime class controlScrollViewport;		text: '';		preferredExtent: 200@120;		layout: aLayout;		yourself]{ #category : 'accessing' }SpWin32MillerContainer >> addPage: aWidget constraints: constraints [	(aWidget respondsTo: #layoutOwner:) ifTrue: [ aWidget layoutOwner: self ].	pages add: { aWidget. constraints }.	self showLastPagesOnNextLayout.	self requestRelayout]{ #category : 'accessing' }SpWin32MillerContainer >> children [	^ (pages collect: #first) asArray]{ #category : 'lifecycle' }SpWin32MillerContainer >> destroy [	pages do: [ :entry |		(entry first respondsTo: #destroy) ifTrue: [ entry first destroy ] ].	contentControl ifNotNil: [ :content | content destroy ].	contentControl := nil.	pages removeAll.	super destroy]{ #category : 'private - lifecycle' }SpWin32MillerContainer >> ensureContentControl [	contentControl ifNil: [		contentControl := SpWin32NativeControl			runtime: runtime			kind: runtime class controlScrollContent			text: ''			preferredExtent: 1@1 ]]{ #category : 'accessing' }SpWin32MillerContainer >> horizontalScrollBar: aBoolean [	horizontalScrollBar = aBoolean ifTrue: [ ^ self ].	horizontalScrollBar := aBoolean.	self requestRelayout]{ #category : 'initialization' }SpWin32MillerContainer >> initialize [	super initialize.	pages := OrderedCollection new.	horizontalScrollBar := true.	scrollPosition := 0@0.	firstShowingPageIndex := nil.	lastPageExtent := 1@1.	lastContentExtent := 1@1]{ #category : 'accessing' }SpWin32MillerContainer >> layout: aLayout [	layout := aLayout]{ #category : 'private - geometry' }SpWin32MillerContainer >> mainOf: anExtent [	^ layout isHorizontal		ifTrue: [ anExtent x ]		ifFalse: [ anExtent y ]]{ #category : 'private - geometry' }SpWin32MillerContainer >> crossOf: anExtent [	^ layout isHorizontal		ifTrue: [ anExtent y ]		ifFalse: [ anExtent x ]]{ #category : 'private - geometry' }SpWin32MillerContainer >> extentMain: main cross: cross [	^ layout isHorizontal		ifTrue: [ main @ cross ]		ifFalse: [ cross @ main ]]{ #category : 'private - geometry' }SpWin32MillerContainer >> visiblePageCount [	pages ifEmpty: [ ^ 1 ].	^ ((layout visiblePages asInteger max: 1) min: pages size)]{ #category : 'private - geometry' }SpWin32MillerContainer >> pageMainExtentForViewport: viewportExtent [	| border spacing visible available |	border := layout borderWidth asInteger max: 0.	spacing := layout spacing asInteger max: 0.	visible := self visiblePageCount.	available := (self mainOf: viewportExtent)		- (border * 2)		- (spacing * (visible - 1)).	^ ((available max: visible) // visible) max: 1]{ #category : 'private - geometry' }SpWin32MillerContainer >> pageExtentForViewport: viewportExtent [	| border main cross |	border := layout borderWidth asInteger max: 0.	main := self pageMainExtentForViewport: viewportExtent.	cross := ((self crossOf: viewportExtent) - (border * 2)) max: 1.	^ self extentMain: main cross: cross]{ #category : 'private - geometry' }SpWin32MillerContainer >> contentExtentForViewport: viewportExtent [	| border spacing pageMain contentMain contentCross |	pages ifEmpty: [ ^ viewportExtent max: 1@1 ].	border := layout borderWidth asInteger max: 0.	spacing := layout spacing asInteger max: 0.	pageMain := self pageMainExtentForViewport: viewportExtent.	contentMain := (border * 2)		+ (pageMain * pages size)		+ (spacing * (pages size - 1)).	contentCross := self crossOf: viewportExtent.	^ self extentMain: (contentMain max: 1) cross: (contentCross max: 1)]{ #category : 'private - scrolling' }SpWin32MillerContainer >> horizontalPolicy [	layout isHorizontal ifFalse: [ ^ runtime class scrollPolicyDisabled ].	^ horizontalScrollBar		ifTrue: [ runtime class scrollPolicyAutomatic ]		ifFalse: [ runtime class scrollPolicyHidden ]]{ #category : 'private - scrolling' }SpWin32MillerContainer >> verticalPolicy [	^ layout isVertical		ifTrue: [ runtime class scrollPolicyAutomatic ]		ifFalse: [ runtime class scrollPolicyDisabled ]]{ #category : 'private - scrolling' }SpWin32MillerContainer >> scrollPositionForFirstShowingPage [	| index border spacing pageMain mainPosition |	firstShowingPageIndex ifNil: [ ^ scrollPosition ].	pages ifEmpty: [ ^ 0@0 ].	index := (firstShowingPageIndex max: 1) min: pages size.	border := layout borderWidth asInteger max: 0.	spacing := layout spacing asInteger max: 0.	pageMain := self mainOf: lastPageExtent.	mainPosition := border + ((index - 1) * (pageMain + spacing)).	^ layout isHorizontal		ifTrue: [ mainPosition @ 0 ]		ifFalse: [ 0 @ mainPosition ]]{ #category : 'private - scrolling' }SpWin32MillerContainer >> showLastPagesOnNextLayout [	pages ifEmpty: [		firstShowingPageIndex := nil.		scrollPosition := 0@0.		^ self ].	firstShowingPageIndex := (pages size - self visiblePageCount + 1) max: 1]{ #category : 'scrolling' }SpWin32MillerContainer >> selectPage: aNumber [	pages ifEmpty: [ ^ self ].	firstShowingPageIndex := (aNumber asInteger max: 1) min: pages size.	self requestRelayout]{ #category : 'scrolling' }SpWin32MillerContainer >> scrollByDeltaPercent: percent [	| mainDelta newMain |	pages ifEmpty: [ ^ self ].	mainDelta := ((self mainOf: lastContentExtent) * (percent asFloat / 100.0)) rounded.	newMain := (self mainOf: scrollPosition) + mainDelta.	scrollPosition := layout isHorizontal		ifTrue: [ (newMain max: 0) @ 0 ]		ifFalse: [ 0 @ (newMain max: 0) ].	firstShowingPageIndex := nil.	self isValid ifTrue: [ runtime setScrollViewport: self position: scrollPosition ]]{ #category : 'accessing' }SpWin32MillerContainer >> removePageWidget: aWidget [	| entry |	entry := pages		detect: [ :each | each first == aWidget ]		ifNone: [ ^ self ].	(aWidget respondsTo: #destroy) ifTrue: [ aWidget destroy ].	pages remove: entry.	self showLastPagesOnNextLayout.	self requestRelayout]{ #category : 'accessing' }SpWin32MillerContainer >> removeAllPages [	pages do: [ :entry |		(entry first respondsTo: #destroy) ifTrue: [ entry first destroy ] ].	pages removeAll.	firstShowingPageIndex := nil.	scrollPosition := 0@0.	self requestRelayout]{ #category : 'geometry' }SpWin32MillerContainer >> refreshPreferredExtentIn: aNativeParent [	pages do: [ :entry |		| child |		child := entry first.		(child respondsTo: #refreshPreferredExtentIn:)			ifTrue: [ child refreshPreferredExtentIn: aNativeParent ]			ifFalse: [				(child respondsTo: #refreshPreferredExtentsIn:)					ifTrue: [ child refreshPreferredExtentsIn: aNativeParent ] ] ].	preferredExtent := self preferredExtent.	^ preferredExtent]{ #category : 'geometry' }SpWin32MillerContainer >> preferredExtent [	| border spacing visible maxMain maxCross extent main cross |	pages ifEmpty: [ ^ 200@120 ].	border := layout borderWidth asInteger max: 0.	spacing := layout spacing asInteger max: 0.	visible := self visiblePageCount.	maxMain := 1.	maxCross := 1.	pages do: [ :entry |		extent := entry first preferredExtent ifNil: [ 1@1 ].		main := self mainOf: extent.		cross := self crossOf: extent.		maxMain := maxMain max: main.		maxCross := maxCross max: cross ].	^ self		extentMain: ((border * 2) + (maxMain * visible) + (spacing * (visible - 1)))		cross: ((border * 2) + maxCross)]{ #category : 'private - geometry' }SpWin32MillerContainer >> realizePagesInContentExtent: contentExtent pageExtent: pageExtent [	| border spacing pageMain pageCross directPlacements |	border := layout borderWidth asInteger max: 0.	spacing := layout spacing asInteger max: 0.	pageMain := self mainOf: pageExtent.	pageCross := self crossOf: pageExtent.	directPlacements := OrderedCollection new.	pages withIndexDo: [ :entry :index |		| child mainOrigin origin rectangle |		child := entry first.		mainOrigin := border + ((index - 1) * (pageMain + spacing)).		origin := layout isHorizontal			ifTrue: [ mainOrigin @ border ]			ifFalse: [ border @ mainOrigin ].		rectangle := origin extent: (self extentMain: pageMain cross: pageCross).		(child respondsTo: #realizeIn:rectangle:)			ifTrue: [ child realizeIn: contentControl rectangle: rectangle ]			ifFalse: [				child realizeIn: contentControl bounds: rectangle.				directPlacements add: {					child.					rectangle left.					rectangle top.					rectangle width.					rectangle height } ] ].	directPlacements ifNotEmpty: [ runtime setControlBoundsBatch: directPlacements ].	pages do: [ :entry |		(entry first respondsTo: #applyNativeOrderingRecursively) ifTrue: [			entry first applyNativeOrderingRecursively ] ]]{ #category : 'lifecycle' }SpWin32MillerContainer >> realizeIn: aNativeParent bounds: aRectangle [	| viewportExtent contentExtent pageExtent pageExtentAfterBars |	super realizeIn: aNativeParent bounds: aRectangle.	runtime setControlBoundsBatch: {		{ self. aRectangle left. aRectangle top. aRectangle width. aRectangle height } }.	self ensureContentControl.	viewportExtent := aRectangle extent max: 1@1.	self refreshPreferredExtentIn: self.	contentExtent := self contentExtentForViewport: viewportExtent.	contentControl realizeIn: self bounds: (0@0 extent: contentExtent).	runtime		configureScrollViewport: self		content: contentControl		extent: contentExtent		horizontalPolicy: self horizontalPolicy		verticalPolicy: self verticalPolicy.	pageExtentAfterBars := runtime scrollViewportPageExtent: self.	pageExtent := self pageExtentForViewport: pageExtentAfterBars.	contentExtent := self contentExtentForViewport: pageExtentAfterBars.	lastPageExtent := pageExtent.	lastContentExtent := contentExtent.	contentControl realizeIn: self bounds: (0@0 extent: contentExtent).	self		realizePagesInContentExtent: contentExtent		pageExtent: pageExtent.	runtime		configureScrollViewport: self		content: contentControl		extent: contentExtent		horizontalPolicy: self horizontalPolicy		verticalPolicy: self verticalPolicy.	scrollPosition := self scrollPositionForFirstShowingPage.	runtime setScrollViewport: self position: scrollPosition]{ #category : 'geometry' }SpWin32MillerContainer >> requestRelayout [	layoutOwner		ifNotNil: [ :owner | owner requestRelayout ]		ifNil: [			(parentWindow notNil and: [ bounds notNil ]) ifTrue: [				self realizeIn: parentWindow bounds: bounds ] ]]{ #category : 'lifecycle' }SpWin32MillerContainer >> realizeIn: aNativeParent extent: anExtent [	^ self realizeIn: aNativeParent bounds: (0@0 extent: anExtent)]{ #category : 'geometry' }SpWin32MillerContainer >> relayoutExtent: anExtent [	parentWindow ifNil: [ ^ self ].	^ self		realizeIn: parentWindow		bounds: ((bounds ifNil: [ 0@0 extent: anExtent ]) origin extent: anExtent)]{ #category : 'updating' }SpWin32MillerContainer >> visiblePagesChanged [	self showLastPagesOnNextLayout.	self requestRelayout]