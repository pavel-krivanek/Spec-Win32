Class {	#name : 'SpWin32ButtonBarContainer',	#superclass : 'SpWin32LayoutContainer',	#instVars : [		'widgets',		'placeAtStart',		'spacing',		'padding'	],	#category : 'Spec-Win32-Native-Layout',	#package : 'Spec-Win32-Native',	#tag : 'Layout'}{ #category : 'instance creation' }SpWin32ButtonBarContainer class >> runtime: aRuntime [	^ self new		runtime: aRuntime;		yourself]{ #category : 'initialization' }SpWin32ButtonBarContainer >> initialize [	super initialize.	widgets := #().	placeAtStart := false.	spacing := 3.	padding := 5]{ #category : 'geometry' }SpWin32ButtonBarContainer >> layoutIn: aRectangle collect: placements [	| top availableHeight x | 	lastExtent := aRectangle extent.	top := aRectangle top + padding.	availableHeight := (aRectangle height - (padding * 2)) max: 1.	placeAtStart		ifTrue: [			x := aRectangle left + padding.			widgets do: [ :widget |				| extent width height y |				extent := widget preferredExtent.				width := extent x max: 1.				height := extent y min: availableHeight.				y := top + ((availableHeight - height) // 2).				placements add: { widget. x. y. width. height }.				x := x + width + spacing ] ]		ifFalse: [			x := aRectangle right - padding.			widgets reverseDo: [ :widget |				| extent width height y |				extent := widget preferredExtent.				width := extent x max: 1.				height := extent y min: availableHeight.				x := x - width.				y := top + ((availableHeight - height) // 2).				placements addFirst: { widget. x. y. width. height }.				x := x - spacing ] ]]{ #category : 'accessing' }SpWin32ButtonBarContainer >> placeAtStart: aBoolean [	placeAtStart := aBoolean.	self requestRelayout]{ #category : 'accessing' }SpWin32ButtonBarContainer >> preferredExtent [	| width height |	widgets ifEmpty: [ ^ 0 @ (28 + (padding * 2)) ].	width := widgets sum: [ :each | each preferredExtent x ].	width := width + (spacing * ((widgets size - 1) max: 0)) + (padding * 2).	height := (widgets inject: 0 into: [ :max :each | max max: each preferredExtent y ]) + (padding * 2).	^ width @ height]{ #category : 'accessing' }SpWin32ButtonBarContainer >> widgets [	^ widgets]{ #category : 'accessing' }SpWin32ButtonBarContainer >> widgets: aCollection [	widgets := aCollection asArray.	children := OrderedCollection new.	widgets do: [ :each |		(each respondsTo: #layoutOwner:) ifTrue: [ each layoutOwner: self ].		children add: { each. nil } ].	self requestRelayout]