Class {	#name : 'SpWin32MenuEntry',	#superclass : 'Object',	#instVars : [		'label',		'enabled',		'checked',		'separator',		'iconData',		'children',		'action',		'source'	],	#category : 'Spec-Win32-Native-Menus',	#package : 'Spec-Win32-Native',	#tag : 'Menus'}{ #category : 'instance creation' }SpWin32MenuEntry class >> separator [	^ self new		separator: true;		yourself]{ #category : 'initialization' }SpWin32MenuEntry >> initialize [	super initialize.	label := ''.	enabled := true.	checked := false.	separator := false.	children := OrderedCollection new]{ #category : 'accessing' }SpWin32MenuEntry >> label [ ^ label ]{ #category : 'accessing' }SpWin32MenuEntry >> label: aString [ label := aString ifNil: [ '' ] ]{ #category : 'accessing' }SpWin32MenuEntry >> enabled [ ^ enabled ]{ #category : 'accessing' }SpWin32MenuEntry >> enabled: aBoolean [ enabled := aBoolean = true ]{ #category : 'accessing' }SpWin32MenuEntry >> checked [ ^ checked ]{ #category : 'accessing' }SpWin32MenuEntry >> checked: aBoolean [ checked := aBoolean = true ]{ #category : 'accessing' }SpWin32MenuEntry >> separator [ ^ separator ]{ #category : 'accessing' }SpWin32MenuEntry >> separator: aBoolean [ separator := aBoolean = true ]{ #category : 'accessing' }SpWin32MenuEntry >> iconData [ ^ iconData ]{ #category : 'accessing' }SpWin32MenuEntry >> iconData: anImageData [ iconData := anImageData ]{ #category : 'accessing' }SpWin32MenuEntry >> children [ ^ children ]{ #category : 'accessing' }SpWin32MenuEntry >> children: aCollection [ children := aCollection asOrderedCollection ]{ #category : 'accessing' }SpWin32MenuEntry >> addChild: anEntry [ children add: anEntry ]{ #category : 'testing' }SpWin32MenuEntry >> hasChildren [ ^ children notEmpty ]{ #category : 'accessing' }SpWin32MenuEntry >> action [ ^ action ]{ #category : 'accessing' }SpWin32MenuEntry >> action: aBlock [ action := aBlock ]{ #category : 'accessing' }SpWin32MenuEntry >> source [ ^ source ]{ #category : 'accessing' }SpWin32MenuEntry >> source: anObject [ source := anObject ]{ #category : 'executing' }SpWin32MenuEntry >> execute [	(enabled and: [ separator not and: [ action notNil ] ]) ifTrue: [ action value ]]