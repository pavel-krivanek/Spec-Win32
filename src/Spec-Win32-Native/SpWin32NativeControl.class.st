Class {	#name : 'SpWin32NativeControl',	#superclass : 'SpWin32NativeObject',	#instVars : [		'kind',		'text',		'enabled',		'visible',		'bounds',		'preferredExtent',		'parentWindow',		'layoutOwner',		'checked',		'editable',		'maxLength',		'password',		'placeholder',		'items',		'selectedIndex',		'normalizedValue',		'indeterminate',		'hasKeyboardFocus',		'selectionStart',		'selectionEnd',		'selectedIndexes',		'multipleSelection',		'headerText',		'headerVisible',		'tooltipText',		'contextMenuEnabled',		'imageData',		'imageAutoScale',		'listRowImages',		'textWrapWord',		'textScrollBars',		'textUndoEnabled',		'codeLineNumbers',		'codeStyleSpans',		'codeLineDecorations',		'codeForegroundRgb',		'codeBackgroundRgb'	],	#category : 'Spec-Win32-Native-Objects',	#package : 'Spec-Win32-Native',	#tag : 'Objects'}{ #category : 'instance creation' }SpWin32NativeControl class >> runtime: aRuntime kind: aKind text: aString preferredExtent: anExtent [	^ self new		runtime: aRuntime;		kind: aKind;		text: aString;		preferredExtent: anExtent;		yourself]{ #category : 'accessing' }SpWin32NativeControl >> bounds [ ^ bounds ]{ #category : 'geometry' }SpWin32NativeControl >> bounds: aRectangle [ bounds := aRectangle ]{ #category : 'lifecycle' }SpWin32NativeControl >> destroy [	self isValid ifTrue: [ runtime destroyControl: self ]]{ #category : 'accessing' }SpWin32NativeControl >> enabled [ ^ enabled ]{ #category : 'accessing' }SpWin32NativeControl >> enabled: aBoolean [	enabled := aBoolean.	self isValid ifTrue: [ runtime setControl: self enabled: aBoolean ]]{ #category : 'initialization' }SpWin32NativeControl >> initialize [	super initialize.	enabled := true.	visible := true.	checked := false.	editable := true.	maxLength := 0.	password := false.	placeholder := ''.	items := #().	selectedIndex := 0.	normalizedValue := 0.0.	indeterminate := false.	hasKeyboardFocus := false.	selectionStart := 0.	selectionEnd := 0.	selectedIndexes := #().	multipleSelection := false.	headerText := ''.	headerVisible := false.	tooltipText := ''.	contextMenuEnabled := false.	imageData := nil.	imageAutoScale := false.	listRowImages := #().	textWrapWord := true.	textScrollBars := true.	textUndoEnabled := true.	codeLineNumbers := false.	codeStyleSpans := #().	codeLineDecorations := #().	codeForegroundRgb := 16rFFFFFF.	codeBackgroundRgb := 16r202020.	bounds := 0@0 extent: 1@1]{ #category : 'testing' }SpWin32NativeControl >> isVisible [ ^ visible ]{ #category : 'accessing' }SpWin32NativeControl >> kind [ ^ kind ]{ #category : 'accessing' }SpWin32NativeControl >> kind: anInteger [ kind := anInteger ]{ #category : 'events' }SpWin32NativeControl >> nativeEventType: eventType argument1: argument1 argument2: argument2 [	eventType = runtime class eventClicked ifTrue: [		eventHandler ifNotNil: [ :handler | handler win32Clicked ].		^ self ].	eventType = runtime class eventToggled ifTrue: [		checked := argument1 ~= 0.		eventHandler ifNotNil: [ :handler | handler win32Toggled: checked ].		^ self ].	eventType = runtime class eventTextChanged ifTrue: [		text := runtime controlTextOf: self.		eventHandler ifNotNil: [ :handler | handler win32TextChanged: text ].		^ self ].	eventType = runtime class eventSelectionChanged ifTrue: [		selectedIndex := argument1 asInteger.		eventHandler ifNotNil: [ :handler | handler win32SelectionChanged: selectedIndex ].		^ self ].	eventType = runtime class eventValueChanged ifTrue: [		normalizedValue := argument1 asFloat / runtime class normalizedValueScale.		eventHandler ifNotNil: [ :handler | handler win32ValueChanged: normalizedValue ].		^ self ].	eventType = runtime class eventNumberStep ifTrue: [		eventHandler ifNotNil: [ :handler | handler win32NumberStep: argument1 asInteger ].		^ self ].	eventType = runtime class eventFocusReceived ifTrue: [		hasKeyboardFocus := true.		eventHandler ifNotNil: [ :handler | handler win32FocusReceived ].		^ self ].	eventType = runtime class eventFocusLost ifTrue: [		hasKeyboardFocus := false.		eventHandler ifNotNil: [ :handler | handler win32FocusLost ].		^ self ].	eventType = runtime class eventListSelectionChanged ifTrue: [		self refreshSelectedIndexesFromNative.		eventHandler ifNotNil: [ :handler |			handler				win32ListSelectionChanged: selectedIndexes				changedIndex: argument1 asInteger				selected: argument2 ~= 0 ].		^ self ].	eventType = runtime class eventActivated ifTrue: [		eventHandler ifNotNil: [ :handler |			handler win32ActivatedAt: argument1 asInteger source: argument2 asInteger ].		^ self ].	eventType = runtime class eventColumnClicked ifTrue: [		eventHandler ifNotNil: [ :handler | handler win32ColumnClicked: argument1 asInteger ].		^ self ].	eventType = runtime class eventTreeSelectionChanged ifTrue: [		eventHandler ifNotNil: [ :handler | handler win32TreeSelectionChangedToken: argument1 asInteger ].		^ self ].	eventType = runtime class eventTreeExpansionChanged ifTrue: [		eventHandler ifNotNil: [ :handler | handler win32TreeExpansionChangedToken: argument1 asInteger expanded: argument2 ~= 0 ].		^ self ].	eventType = runtime class eventKeyDown ifTrue: [		eventHandler ifNotNil: [ :handler | handler win32KeyDownValue: argument1 asInteger modifiers: argument2 asInteger ].		^ self ].	eventType = runtime class eventKeyUp ifTrue: [		eventHandler ifNotNil: [ :handler | handler win32KeyUpValue: argument1 asInteger modifiers: argument2 asInteger ].		^ self ].	(eventType between: runtime class eventMouseDown and: runtime class eventMouseDoubleClick) ifTrue: [		| packed y flags button |		packed := argument2 asInteger.		y := packed bitAnd: 16rFFFFFFFF.		y > 16r7FFFFFFF ifTrue: [ y := y - 16r100000000 ].		flags := (packed bitShift: -32) bitAnd: 16rFFFFFFFF.		button := (flags bitShift: -16) bitAnd: 16rFF.		flags := flags bitAnd: 16rFFFF.		eventHandler ifNotNil: [ :handler |			handler				win32MouseEventType: eventType				position: argument1 asInteger @ y				button: button				modifiers: flags ].		^ self ].	eventType = runtime class eventContextMenuRequested ifTrue: [		eventHandler ifNotNil: [ :handler |			handler win32ContextMenuRequestedAt: argument1 asInteger @ argument2 asInteger ].		^ self ].	eventType = runtime class eventScrollPositionChanged ifTrue: [		eventHandler ifNotNil: [ :handler |			(handler respondsTo: #win32ScrollPositionChanged:source:)				ifTrue: [					handler						win32ScrollPositionChanged: argument1 asInteger @ argument2 asInteger						source: self ]				ifFalse: [					handler win32ScrollPositionChanged: argument1 asInteger @ argument2 asInteger ] ].		^ self ].	eventType = runtime class eventDestroyed ifTrue: [		self markDestroyed.		runtime unregisterObjectId: objectId.		^ self ]]{ #category : 'accessing' }SpWin32NativeControl >> parentWindow [ ^ parentWindow ]{ #category : 'accessing' }SpWin32NativeControl >> preferredExtent [ ^ preferredExtent ]{ #category : 'accessing' }SpWin32NativeControl >> preferredExtent: aPoint [ preferredExtent := aPoint ]{ #category : 'lifecycle' }SpWin32NativeControl >> realizeIn: aNativeWindow bounds: aRectangle [	self isValid ifTrue: [		bounds := aRectangle.		^ self ].	parentWindow := aNativeWindow.	bounds := aRectangle.	runtime realizeControl: self inWindow: aNativeWindow bounds: aRectangle.	runtime setControl: self enabled: enabled.	runtime showControl: self visible: visible.	runtime setControl: self tooltipText: tooltipText.	runtime setControl: self contextMenuEnabled: contextMenuEnabled.	self applyKindSpecificNativeState]{ #category : 'focus' }SpWin32NativeControl >> takeKeyboardFocus [	self isValid ifTrue: [ runtime focusControl: self ]]{ #category : 'accessing' }SpWin32NativeControl >> text [ ^ text ]{ #category : 'accessing' }SpWin32NativeControl >> text: aString [	text := aString ifNil: [ '' ].	self isValid ifTrue: [		runtime setControl: self text: text.		(kind ~= runtime class controlTextInput and: [ kind ~= runtime class controlTextArea and: [ kind ~= runtime class controlCode ] ]) ifTrue: [			parentWindow ifNotNil: [ self refreshPreferredExtentIn: parentWindow ].			self requestRelayout ] ]]{ #category : 'visibility' }SpWin32NativeControl >> visible: aBoolean [	visible := aBoolean.	self isValid ifTrue: [ runtime showControl: self visible: aBoolean ]]{ #category : 'layout' }SpWin32NativeControl >> layoutOwner: aContainer [	layoutOwner := aContainer]{ #category : 'geometry' }SpWin32NativeControl >> refreshPreferredExtentIn: aNativeWindow [	preferredExtent := runtime measureControl: self inWindow: aNativeWindow.	^ preferredExtent]{ #category : 'geometry' }SpWin32NativeControl >> requestRelayout [	layoutOwner ifNotNil: [ :owner | owner requestRelayout ]]{ #category : 'private - lifecycle' }SpWin32NativeControl >> applyKindSpecificNativeState [	(kind = runtime class controlCheckBox or: [		kind = runtime class controlRadioButton or: [			kind = runtime class controlToggleButton or: [				kind = runtime class controlSwitch or: [ kind = runtime class controlComponentRow ] ] ] ])		ifTrue: [ runtime setControl: self checked: checked ].	((kind = runtime class controlTextInput) or: [		kind = runtime class controlNumberInput or: [ kind = runtime class controlSearchInput ] ]) ifTrue: [		runtime setControl: self editable: editable.		runtime setControl: self maxLength: maxLength.		runtime setControl: self password: password.		runtime setControl: self placeholder: placeholder.		runtime setControl: self selectionStart: selectionStart end: selectionEnd ].	(kind = runtime class controlTextArea or: [ kind = runtime class controlCode ]) ifTrue: [		runtime setControl: self editable: editable.		runtime setControl: self placeholder: placeholder.		runtime			configureTextControl: self			wrapWord: textWrapWord			scrollBars: textScrollBars			undoEnabled: textUndoEnabled.		runtime setControl: self selectionStart: selectionStart end: selectionEnd ].	kind = runtime class controlCode ifTrue: [		runtime setCodeControl: self lineNumbers: codeLineNumbers.		runtime			styleCodeControl: self			spans: codeStyleSpans			foreground: codeForegroundRgb			background: codeBackgroundRgb.		runtime decorateCodeControl: self entries: codeLineDecorations ].	((kind = runtime class controlDropList) or: [ kind = runtime class controlNotebook ]) ifTrue: [		runtime setControl: self items: items.		runtime setControl: self selectedIndex: selectedIndex ].	kind = runtime class controlList ifTrue: [		runtime setControl: self multipleSelection: multipleSelection.		(self hasListRowImages			ifTrue: [ runtime setControl: self listRows: items images: listRowImages ]			ifFalse: [ runtime setControl: self items: items ]).		runtime setControl: self headerText: headerText visible: headerVisible.		runtime setControl: self selectedIndexes: selectedIndexes ].	((kind = runtime class controlSliderHorizontal) or: [		kind = runtime class controlSliderVertical or: [ kind = runtime class controlProgress ] ]) ifTrue: [		runtime setControl: self normalizedValue: normalizedValue ].	kind = runtime class controlProgress ifTrue: [		runtime setControl: self indeterminate: indeterminate ].	(imageData notNil or: [ kind = runtime class controlImage ]) ifTrue: [		runtime setControl: self imageAutoScale: imageAutoScale.		runtime setControl: self imageData: imageData ]]{ #category : 'accessing' }SpWin32NativeControl >> checked [	^ checked]{ #category : 'accessing' }SpWin32NativeControl >> checked: aBoolean [	checked := aBoolean.	self isValid ifTrue: [ runtime setControl: self checked: checked ]]{ #category : 'accessing' }SpWin32NativeControl >> editable [	^ editable]{ #category : 'accessing' }SpWin32NativeControl >> editable: aBoolean [	editable := aBoolean.	self isValid ifTrue: [ runtime setControl: self editable: editable ]]{ #category : 'accessing' }SpWin32NativeControl >> maxLength [	^ maxLength]{ #category : 'accessing' }SpWin32NativeControl >> maxLength: anInteger [	maxLength := anInteger max: 0.	self isValid ifTrue: [ runtime setControl: self maxLength: maxLength ]]{ #category : 'accessing' }SpWin32NativeControl >> password [	^ password]{ #category : 'accessing' }SpWin32NativeControl >> password: aBoolean [	password := aBoolean.	self isValid ifTrue: [ runtime setControl: self password: password ]]{ #category : 'accessing' }SpWin32NativeControl >> placeholder [	^ placeholder]{ #category : 'accessing' }SpWin32NativeControl >> placeholder: aString [	placeholder := aString ifNil: [ '' ].	self isValid ifTrue: [ runtime setControl: self placeholder: placeholder ]]{ #category : 'text area' }SpWin32NativeControl >> configureTextWrapWord: wrapWord scrollBars: scrollBars undoEnabled: undoEnabled [	textWrapWord := wrapWord.	textScrollBars := scrollBars.	textUndoEnabled := undoEnabled.	self isValid ifTrue: [		runtime			configureTextControl: self			wrapWord: textWrapWord			scrollBars: textScrollBars			undoEnabled: textUndoEnabled ]]{ #category : 'text area' }SpWin32NativeControl >> replaceSelectionWith: aString [	self isValid ifFalse: [ ^ self ].	runtime replaceSelectionInTextControl: self with: aString.	self refreshTextFromNative]{ #category : 'text area' }SpWin32NativeControl >> performTextCommand: commandCode [	self isValid ifFalse: [ ^ self ].	runtime performTextCommand: commandCode on: self]{ #category : 'text area' }SpWin32NativeControl >> scrollToTextLine: zeroBasedLine [	self isValid ifTrue: [ runtime scrollTextControl: self toLine: zeroBasedLine ]]{ #category : 'text area' }SpWin32NativeControl >> firstVisibleTextLine [	self isValid ifFalse: [ ^ 0 ].	^ runtime firstVisibleLineOfTextControl: self]{ #category : 'accessing' }SpWin32NativeControl >> refreshTextFromNative [	self isValid ifTrue: [ text := runtime controlTextOf: self ].	^ text]{ #category : 'accessing' }SpWin32NativeControl >> items [	^ items]{ #category : 'accessing' }SpWin32NativeControl >> items: aCollection [	items := aCollection asArray.	listRowImages := #().	self isValid ifTrue: [		runtime setControl: self items: items.		kind = runtime class controlList			ifTrue: [ runtime setControl: self selectedIndexes: selectedIndexes ]			ifFalse: [ runtime setControl: self selectedIndex: selectedIndex ].		parentWindow ifNotNil: [ self refreshPreferredExtentIn: parentWindow ].		self requestRelayout ]]{ #category : 'accessing' }SpWin32NativeControl >> items: aCollection rowImages: imageCollection [	items := aCollection asArray.	listRowImages := imageCollection asArray.	items size = listRowImages size ifFalse: [		self error: 'Win32 ListView row image count must match item count.' ].	self isValid ifTrue: [		runtime setControl: self listRows: items images: listRowImages.		runtime setControl: self selectedIndexes: selectedIndexes.		parentWindow ifNotNil: [ self refreshPreferredExtentIn: parentWindow ].		self requestRelayout ]]{ #category : 'accessing' }SpWin32NativeControl >> listRowImages [	^ listRowImages]{ #category : 'testing' }SpWin32NativeControl >> hasListRowImages [	^ listRowImages anySatisfy: [ :each | each notNil ]]{ #category : 'accessing' }SpWin32NativeControl >> selectedIndex [	^ selectedIndex]{ #category : 'accessing' }SpWin32NativeControl >> selectedIndex: anInteger [	selectedIndex := anInteger max: 0.	self isValid ifTrue: [ runtime setControl: self selectedIndex: selectedIndex ]]{ #category : 'geometry' }SpWin32NativeControl >> measurementText [	| longest |	((kind = runtime class controlDropList) or: [ kind = runtime class controlNotebook ]) ifFalse: [ ^ text ].	items ifEmpty: [ ^ '' ].	longest := items first asString.	items allButFirstDo: [ :each |		each asString size > longest size ifTrue: [ longest := each asString ] ].	^ longest]{ #category : 'accessing' }SpWin32NativeControl >> normalizedValue [	^ normalizedValue]{ #category : 'accessing' }SpWin32NativeControl >> normalizedValue: aNumber [	normalizedValue := ((aNumber ifNil: [ 0 ]) asFloat max: 0.0) min: 1.0.	self isValid ifTrue: [ runtime setControl: self normalizedValue: normalizedValue ]]{ #category : 'accessing' }SpWin32NativeControl >> refreshNormalizedValueFromNative [	self isValid ifTrue: [ normalizedValue := runtime normalizedValueOfControl: self ].	^ normalizedValue]{ #category : 'accessing' }SpWin32NativeControl >> indeterminate [	^ indeterminate]{ #category : 'accessing' }SpWin32NativeControl >> indeterminate: aBoolean [	indeterminate := aBoolean.	self isValid ifTrue: [ runtime setControl: self indeterminate: indeterminate ]]{ #category : 'focus' }SpWin32NativeControl >> hasKeyboardFocus [	self isValid ifTrue: [		hasKeyboardFocus := runtime controlHasFocus: self ].	^ hasKeyboardFocus]{ #category : 'selection' }SpWin32NativeControl >> selectionOffsets [	| offsets |	self isValid ifTrue: [		offsets := runtime selectionOffsetsOfControl: self.		selectionStart := offsets x.		selectionEnd := offsets y ].	^ selectionStart @ selectionEnd]{ #category : 'selection' }SpWin32NativeControl >> selectionStart: startOffset end: endOffset [	selectionStart := startOffset asInteger max: 0.	selectionEnd := endOffset asInteger max: selectionStart.	self isValid ifTrue: [		runtime			setControl: self			selectionStart: selectionStart			end: selectionEnd ]]{ #category : 'accessing - collections' }SpWin32NativeControl >> selectedIndexes [	^ selectedIndexes]{ #category : 'accessing - collections' }SpWin32NativeControl >> selectedIndexes: aCollection [	selectedIndexes := aCollection collect: [ :each | each asInteger ] as: Array.	self isValid ifTrue: [ runtime setControl: self selectedIndexes: selectedIndexes ]]{ #category : 'accessing - collections' }SpWin32NativeControl >> refreshSelectedIndexesFromNative [	self isValid ifTrue: [ selectedIndexes := runtime selectedIndexesOfControl: self ].	^ selectedIndexes]{ #category : 'accessing - collections' }SpWin32NativeControl >> multipleSelection [	^ multipleSelection]{ #category : 'accessing - collections' }SpWin32NativeControl >> multipleSelection: aBoolean [	multipleSelection := aBoolean.	self isValid ifTrue: [ runtime setControl: self multipleSelection: multipleSelection ]]{ #category : 'accessing - collections' }SpWin32NativeControl >> headerText [	^ headerText]{ #category : 'accessing - collections' }SpWin32NativeControl >> headerVisible [	^ headerVisible]{ #category : 'accessing - collections' }SpWin32NativeControl >> headerText: aString visible: aBoolean [	headerText := aString ifNil: [ '' ].	headerVisible := aBoolean.	self isValid ifTrue: [ runtime setControl: self headerText: headerText visible: headerVisible ]]{ #category : 'scrolling' }SpWin32NativeControl >> ensureVisibleIndex: anInteger [	self isValid ifTrue: [ runtime ensureControl: self visibleIndex: anInteger ]]{ #category : 'accessing' }SpWin32NativeControl >> tooltipText [	^ tooltipText]{ #category : 'accessing' }SpWin32NativeControl >> tooltipText: aString [	tooltipText := aString ifNil: [ '' ].	self isValid ifTrue: [ runtime setControl: self tooltipText: tooltipText ]]{ #category : 'accessing - images' }SpWin32NativeControl >> imageData [	^ imageData]{ #category : 'accessing - images' }SpWin32NativeControl >> imageData: anImageDataOrNil [	imageData := anImageDataOrNil.	self isValid ifTrue: [ runtime setControl: self imageData: imageData ]]{ #category : 'accessing - images' }SpWin32NativeControl >> imageAutoScale [	^ imageAutoScale]{ #category : 'accessing - images' }SpWin32NativeControl >> imageAutoScale: aBoolean [	imageAutoScale := aBoolean.	self isValid ifTrue: [ runtime setControl: self imageAutoScale: imageAutoScale ]]{ #category : 'accessing - menus' }SpWin32NativeControl >> contextMenuEnabled [	^ contextMenuEnabled]{ #category : 'accessing - menus' }SpWin32NativeControl >> contextMenuEnabled: aBoolean [	contextMenuEnabled := aBoolean.	self isValid ifTrue: [ runtime setControl: self contextMenuEnabled: aBoolean ]]{ #category : 'menus' }SpWin32NativeControl >> showContextMenuLabels: labels flags: flags at: aPoint [	self isValid ifFalse: [ ^ 0 ].	^ runtime showContextMenuFor: self labels: labels flags: flags at: aPoint]{ #category : 'code editor' }SpWin32NativeControl >> codeLineNumbers [	^ codeLineNumbers]{ #category : 'code editor' }SpWin32NativeControl >> codeLineNumbers: aBoolean [	codeLineNumbers := aBoolean.	(self isValid and: [ kind = runtime class controlCode ]) ifTrue: [		runtime setCodeControl: self lineNumbers: codeLineNumbers ]]{ #category : 'code editor' }SpWin32NativeControl >> codeStyleSpans [	^ codeStyleSpans]{ #category : 'code editor' }SpWin32NativeControl >> codeStyleSpans: flatSpans foreground: foregroundRgb background: backgroundRgb [	codeStyleSpans := flatSpans asArray.	codeForegroundRgb := foregroundRgb asInteger.	codeBackgroundRgb := backgroundRgb asInteger.	(self isValid and: [ kind = runtime class controlCode ]) ifTrue: [		runtime			styleCodeControl: self			spans: codeStyleSpans			foreground: codeForegroundRgb			background: codeBackgroundRgb ]]{ #category : 'code editor' }SpWin32NativeControl >> codeForegroundRgb [	^ codeForegroundRgb]{ #category : 'code editor' }SpWin32NativeControl >> codeBackgroundRgb [	^ codeBackgroundRgb]{ #category : 'code editor' }SpWin32NativeControl >> codeLineDecorations [	^ codeLineDecorations]{ #category : 'code editor' }SpWin32NativeControl >> codeLineDecorations: flatEntries [	codeLineDecorations := flatEntries asArray.	(self isValid and: [ kind = runtime class controlCode ]) ifTrue: [		runtime decorateCodeControl: self entries: codeLineDecorations ]]{ #category : 'text area' }SpWin32NativeControl >> textWrapWord [	^ textWrapWord]