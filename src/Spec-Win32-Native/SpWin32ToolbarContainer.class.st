Class {	#name : 'SpWin32ToolbarContainer',	#superclass : 'SpWin32LayoutContainer',	#instVars : [		'leftWidgets',		'rightWidgets',		'spacing',		'padding'	],	#category : 'Spec-Win32-Native-Layout',	#package : 'Spec-Win32-Native',	#tag : 'Layout'}{ #category : 'instance creation' }SpWin32ToolbarContainer class >> runtime: aRuntime [	^ self new		runtime: aRuntime;		yourself]{ #category : 'initialization' }SpWin32ToolbarContainer >> initialize [	super initialize.	leftWidgets := #().	rightWidgets := #().	spacing := 4.	padding := 4]{ #category : 'accessing' }SpWin32ToolbarContainer >> leftWidgets [	^ leftWidgets]{ #category : 'accessing' }SpWin32ToolbarContainer >> rightWidgets [	^ rightWidgets]{ #category : 'accessing' }SpWin32ToolbarContainer >> leftWidgets: leftCollection rightWidgets: rightCollection [	leftWidgets := leftCollection asArray.	rightWidgets := rightCollection asArray.	children := OrderedCollection new.	leftWidgets do: [ :each |		(each respondsTo: #layoutOwner:) ifTrue: [ each layoutOwner: self ].		children add: { each. #left } ].	rightWidgets do: [ :each |		(each respondsTo: #layoutOwner:) ifTrue: [ each layoutOwner: self ].		children add: { each. #right } ].	self requestRelayout]{ #category : 'geometry' }SpWin32ToolbarContainer >> layoutIn: aRectangle collect: placements [	| leftX rightX top availableHeight placeLeft placeRight |	lastExtent := aRectangle extent.	leftX := aRectangle left + padding.	rightX := aRectangle right - padding.	top := aRectangle top + padding.	availableHeight := (aRectangle height - (padding * 2)) max: 1.	placeLeft := [ :widget |		| extent width height y |		extent := widget preferredExtent.		width := extent x max: 1.		height := extent y min: availableHeight.		y := top + ((availableHeight - height) // 2).		placements add: { widget. leftX. y. width. height }.		leftX := leftX + width + spacing ].	placeRight := [ :widget |		| extent width height y |		extent := widget preferredExtent.		width := extent x max: 1.		height := extent y min: availableHeight.		rightX := rightX - width.		y := top + ((availableHeight - height) // 2).		placements add: { widget. rightX. y. width. height }.		rightX := rightX - spacing ].	leftWidgets do: placeLeft.	rightWidgets reverseDo: placeRight]{ #category : 'accessing' }SpWin32ToolbarContainer >> preferredExtent [	| all width height |	all := leftWidgets , rightWidgets.	all ifEmpty: [ ^ 0 @ 0 ].	width := all sum: [ :each | each preferredExtent x ].	width := width + (spacing * ((all size - 1) max: 0)) + (padding * 2).	height := (all inject: 0 into: [ :max :each | max max: each preferredExtent y ]) + (padding * 2).	^ width @ height]{ #category : 'accessing' }SpWin32ToolbarContainer >> spacing [	^ spacing]{ #category : 'accessing' }SpWin32ToolbarContainer >> spacing: anInteger [	spacing := anInteger asInteger max: 0.	self requestRelayout]