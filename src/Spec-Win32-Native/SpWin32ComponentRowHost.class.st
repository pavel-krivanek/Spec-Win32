Class {	#name : 'SpWin32ComponentRowHost',	#superclass : 'SpWin32NativeControl',	#instVars : [		'child',		'rowPresenter',		'index',		'ownerAdapter',		'padding'	],	#category : 'Spec-Win32-Native-Collections',	#package : 'Spec-Win32-Native',	#tag : 'Collections'}{ #category : 'instance creation' }SpWin32ComponentRowHost class >> runtime: aRuntime child: aWidget presenter: aPresenter index: anIndex owner: anAdapter [	^ self new		runtime: aRuntime;		kind: aRuntime class controlComponentRow;		text: '';		preferredExtent: 120@28;		child: aWidget;		rowPresenter: aPresenter;		index: anIndex;		ownerAdapter: anAdapter;		eventHandler: nil;		yourself]{ #category : 'initialization' }SpWin32ComponentRowHost >> initialize [	super initialize.	padding := 3@3]{ #category : 'accessing' }SpWin32ComponentRowHost >> child [ ^ child ]{ #category : 'accessing' }SpWin32ComponentRowHost >> child: aWidget [	child := aWidget.	(child respondsTo: #layoutOwner:) ifTrue: [ child layoutOwner: self ]]{ #category : 'accessing' }SpWin32ComponentRowHost >> children [	^ child ifNil: [ #() ] ifNotNil: [ { child } ]]{ #category : 'lifecycle' }SpWin32ComponentRowHost >> destroy [	child ifNotNil: [ :aWidget |		(aWidget respondsTo: #destroy) ifTrue: [ aWidget destroy ] ].	super destroy]{ #category : 'accessing' }SpWin32ComponentRowHost >> index [ ^ index ]{ #category : 'accessing' }SpWin32ComponentRowHost >> index: anInteger [ index := anInteger ]{ #category : 'events' }SpWin32ComponentRowHost >> nativeEventType: eventType argument1: argument1 argument2: argument2 [	eventType = runtime class eventClicked ifTrue: [		ownerAdapter ifNotNil: [ :adapter |			adapter rowClickedAt: index modifiers: argument1 asInteger ].		^ self ].	eventType = runtime class eventSelectionChanged ifTrue: [		ownerAdapter ifNotNil: [ :adapter | adapter rowFocusedAt: index ].		^ self ].	eventType = runtime class eventActivated ifTrue: [		ownerAdapter ifNotNil: [ :adapter |			adapter rowActivatedAt: index source: argument2 asInteger ].		^ self ].	^ super nativeEventType: eventType argument1: argument1 argument2: argument2]{ #category : 'accessing' }SpWin32ComponentRowHost >> ownerAdapter: anAdapter [ ownerAdapter := anAdapter ]{ #category : 'accessing' }SpWin32ComponentRowHost >> padding [ ^ padding ]{ #category : 'accessing' }SpWin32ComponentRowHost >> padding: aPoint [ padding := aPoint ]{ #category : 'geometry' }SpWin32ComponentRowHost >> preferredChildExtent [	^ child		ifNil: [ 1@1 ]		ifNotNil: [			(child respondsTo: #preferredExtent)				ifTrue: [ child preferredExtent ]				ifFalse: [ 120@22 ] ]]{ #category : 'geometry' }SpWin32ComponentRowHost >> refreshPreferredExtentIn: aNativeParent [	child ifNotNil: [		(child respondsTo: #refreshPreferredExtentIn:)			ifTrue: [ child refreshPreferredExtentIn: aNativeParent ]			ifFalse: [				(child respondsTo: #refreshPreferredExtentsIn:)					ifTrue: [ child refreshPreferredExtentsIn: aNativeParent ] ] ].	preferredExtent := self preferredChildExtent + (padding * 2).	preferredExtent := (preferredExtent x max: 40) @ (preferredExtent y max: 24).	^ preferredExtent]{ #category : 'lifecycle' }SpWin32ComponentRowHost >> realizeIn: aNativeParent bounds: aRectangle [	| inner placements |	super realizeIn: aNativeParent bounds: aRectangle.	child ifNil: [ ^ self ].	inner := (padding x @ padding y)		extent: ((aRectangle width - (padding x * 2)) max: 1)			@ ((aRectangle height - (padding y * 2)) max: 1).	(child respondsTo: #realizeIn:rectangle:)		ifTrue: [ child realizeIn: self rectangle: inner ]		ifFalse: [			child realizeIn: self bounds: inner.			placements := { { child. inner left. inner top. inner width. inner height } }.			runtime setControlBoundsBatch: placements ]]{ #category : 'geometry' }SpWin32ComponentRowHost >> requestRelayout [	layoutOwner		ifNotNil: [ :owner | owner requestRelayout ]		ifNil: [ super requestRelayout ]]{ #category : 'accessing' }SpWin32ComponentRowHost >> rowPresenter [ ^ rowPresenter ]{ #category : 'accessing' }SpWin32ComponentRowHost >> rowPresenter: aPresenter [ rowPresenter := aPresenter ]{ #category : 'selection' }SpWin32ComponentRowHost >> selected: aBoolean [	self checked: aBoolean]