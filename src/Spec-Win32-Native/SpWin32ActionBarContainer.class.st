Class {	#name : 'SpWin32ActionBarContainer',	#superclass : 'SpWin32LayoutContainer',	#instVars : [		'leftWidgets',		'rightWidgets',		'centerWidget',		'spacing',		'padding'	],	#category : 'Spec-Win32-Native-Layout',	#package : 'Spec-Win32-Native',	#tag : 'Layout'}{ #category : 'instance creation' }SpWin32ActionBarContainer class >> runtime: aRuntime [	^ self new		runtime: aRuntime;		yourself]{ #category : 'initialization' }SpWin32ActionBarContainer >> initialize [	super initialize.	leftWidgets := #().	rightWidgets := #().	centerWidget := nil.	spacing := 3.	padding := 4]{ #category : 'accessing' }SpWin32ActionBarContainer >> leftWidgets: leftCollection rightWidgets: rightCollection centerWidget: aWidgetOrNil [	leftWidgets := leftCollection asArray.	rightWidgets := rightCollection asArray.	centerWidget := aWidgetOrNil.	children := OrderedCollection new.	leftWidgets do: [ :each | self registerChild: each ].	centerWidget ifNotNil: [ :each | self registerChild: each ].	rightWidgets do: [ :each | self registerChild: each ].	self requestRelayout]{ #category : 'private' }SpWin32ActionBarContainer >> registerChild: aWidget [	(aWidget respondsTo: #layoutOwner:) ifTrue: [ aWidget layoutOwner: self ].	children add: { aWidget. nil }]{ #category : 'geometry' }SpWin32ActionBarContainer >> layoutIn: aRectangle collect: placements [	| leftX rightX top availableHeight centerExtent centerWidth centerHeight centerX centerY | 	lastExtent := aRectangle extent.	leftX := aRectangle left + padding.	rightX := aRectangle right - padding.	top := aRectangle top + padding.	availableHeight := (aRectangle height - (padding * 2)) max: 1.	leftWidgets do: [ :widget |		| extent width height y |		extent := widget preferredExtent.		width := extent x max: 1.		height := extent y min: availableHeight.		y := top + ((availableHeight - height) // 2).		placements add: { widget. leftX. y. width. height }.		leftX := leftX + width + spacing ].	rightWidgets reverseDo: [ :widget |		| extent width height y |		extent := widget preferredExtent.		width := extent x max: 1.		height := extent y min: availableHeight.		rightX := rightX - width.		y := top + ((availableHeight - height) // 2).		placements add: { widget. rightX. y. width. height }.		rightX := rightX - spacing ].	centerWidget ifNil: [ ^ self ].	centerExtent := centerWidget preferredExtent.	centerWidth := centerExtent x min: ((rightX - leftX) max: 1).	centerHeight := centerExtent y min: availableHeight.	centerX := aRectangle left + ((aRectangle width - centerWidth) // 2).	centerX := (centerX max: leftX) min: (rightX - centerWidth max: leftX).	centerY := top + ((availableHeight - centerHeight) // 2).	placements add: { centerWidget. centerX. centerY. centerWidth. centerHeight }]{ #category : 'accessing' }SpWin32ActionBarContainer >> preferredExtent [	| sideWidth centerWidth all height | 	all := leftWidgets , rightWidgets , (centerWidget ifNil: [ #() ] ifNotNil: [ { centerWidget } ]).	all ifEmpty: [ ^ 0 @ (28 + (padding * 2)) ].	sideWidth := (leftWidgets sum: [ :each | each preferredExtent x ]) + (rightWidgets sum: [ :each | each preferredExtent x ]).	sideWidth := sideWidth + (spacing * (((leftWidgets size - 1) max: 0) + ((rightWidgets size - 1) max: 0))).	centerWidth := centerWidget ifNil: [ 0 ] ifNotNil: [ centerWidget preferredExtent x ].	height := (all inject: 0 into: [ :max :each | max max: each preferredExtent y ]) + (padding * 2).	^ ((sideWidth + centerWidth + (padding * 2)) max: centerWidth + (padding * 2)) @ height]