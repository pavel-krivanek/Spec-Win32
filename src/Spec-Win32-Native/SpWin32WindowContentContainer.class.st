Class {	#name : 'SpWin32WindowContentContainer',	#superclass : 'SpWin32LayoutContainer',	#instVars : [		'toolbar',		'content',		'statusbar'	],	#category : 'Spec-Win32-Native-Layout',	#package : 'Spec-Win32-Native',	#tag : 'Layout'}{ #category : 'instance creation' }SpWin32WindowContentContainer class >> toolbar: aToolbar content: aContent runtime: aRuntime [	^ self		toolbar: aToolbar		content: aContent		statusbar: nil		runtime: aRuntime]{ #category : 'instance creation' }SpWin32WindowContentContainer class >> toolbar: aToolbar content: aContent statusbar: aStatusbar runtime: aRuntime [	^ self new		runtime: aRuntime;		toolbar: aToolbar content: aContent statusbar: aStatusbar;		yourself]{ #category : 'accessing' }SpWin32WindowContentContainer >> toolbar: aToolbar content: aContent [	^ self toolbar: aToolbar content: aContent statusbar: nil]{ #category : 'accessing' }SpWin32WindowContentContainer >> toolbar: aToolbar content: aContent statusbar: aStatusbar [	toolbar := aToolbar.	content := aContent.	statusbar := aStatusbar.	children := OrderedCollection new.	toolbar ifNotNil: [		(toolbar respondsTo: #layoutOwner:) ifTrue: [ toolbar layoutOwner: self ].		children add: { toolbar. #toolbar } ].	content ifNotNil: [		(content respondsTo: #layoutOwner:) ifTrue: [ content layoutOwner: self ].		children add: { content. #content } ].	statusbar ifNotNil: [		(statusbar respondsTo: #layoutOwner:) ifTrue: [ statusbar layoutOwner: self ].		children add: { statusbar. #statusbar } ]]{ #category : 'geometry' }SpWin32WindowContentContainer >> layoutIn: aRectangle collect: placements [	| toolbarHeight statusbarHeight contentTop contentHeight contentRectangle |	lastExtent := aRectangle extent.	toolbarHeight := toolbar		ifNil: [ 0 ]		ifNotNil: [ :aToolbar | aToolbar preferredExtent y min: aRectangle height ].	statusbarHeight := statusbar		ifNil: [ 0 ]		ifNotNil: [ :aStatusbar | aStatusbar preferredExtent y min: (aRectangle height - toolbarHeight max: 0) ].	toolbar ifNotNil: [		toolbar layoutIn: (aRectangle origin extent: aRectangle width @ toolbarHeight) collect: placements ].	contentTop := aRectangle top + toolbarHeight.	contentHeight := (aRectangle height - toolbarHeight - statusbarHeight) max: 1.	content ifNotNil: [		contentRectangle := (aRectangle left @ contentTop)			extent: aRectangle width @ contentHeight.		content layoutIn: contentRectangle collect: placements ].	statusbar ifNotNil: [		placements add: {			statusbar.			aRectangle left.			aRectangle top + aRectangle height - statusbarHeight.			aRectangle width.			statusbarHeight } ]]{ #category : 'accessing' }SpWin32WindowContentContainer >> preferredExtent [	| toolbarExtent contentExtent statusbarExtent |	toolbarExtent := toolbar ifNil: [ 0 @ 0 ] ifNotNil: [ toolbar preferredExtent ].	contentExtent := content ifNil: [ 0 @ 0 ] ifNotNil: [ content preferredExtent ].	statusbarExtent := statusbar ifNil: [ 0 @ 0 ] ifNotNil: [ statusbar preferredExtent ].	^ ((toolbarExtent x max: contentExtent x) max: statusbarExtent x)		@ (toolbarExtent y + contentExtent y + statusbarExtent y)]