Class {	#name : 'SpWin32ImageData',	#superclass : 'Object',	#instVars : [		'width',		'height',		'bytes'	],	#category : 'Spec-Win32-Native-Images',	#package : 'Spec-Win32-Native',	#tag : 'Images'}{ #category : 'instance creation' }SpWin32ImageData class >> fromForm: aForm [	| result data position |	aForm ifNil: [ ^ nil ].	result := self new.	result width: aForm width; height: aForm height.	data := ByteArray new: aForm width * aForm height * 4.	position := 1.	0 to: aForm height - 1 do: [ :y |		0 to: aForm width - 1 do: [ :x |			| color alpha |			color := aForm colorAt: x @ y.			alpha := color alpha asFloat.			data at: position put: (self premultipliedByteFor: color blue alpha: alpha).			data at: position + 1 put: (self premultipliedByteFor: color green alpha: alpha).			data at: position + 2 put: (self premultipliedByteFor: color red alpha: alpha).			data at: position + 3 put: (self byteForUnit: alpha).			position := position + 4 ] ].	result bytes: data.	^ result]{ #category : 'instance creation' }SpWin32ImageData class >> fromPremultipliedBGRABytes: aByteArray width: anInteger height: anotherInteger [	| expectedSize result |	expectedSize := anInteger * anotherInteger * 4.	aByteArray size = expectedSize ifFalse: [		self error: 'Premultiplied BGRA byte size does not match the supplied extent' ].	result := self new.	result		width: anInteger;		height: anotherInteger;		bytes: aByteArray.	^ result]{ #category : 'instance creation' }SpWin32ImageData class >> fromPremultipliedBGRAPointer: aPointer width: width height: height stride: stride [	| raw rowBytes compact |	(width < 1 or: [ height < 1 ]) ifTrue: [		self error: 'Premultiplied BGRA extent must be positive' ].	rowBytes := width * 4.	stride < rowBytes ifTrue: [		self error: 'Premultiplied BGRA stride is smaller than one packed row' ].	raw := ByteArray new: stride * height.	LibC memCopy: aPointer to: raw size: raw size.	compact := stride = rowBytes		ifTrue: [ raw ]		ifFalse: [			| packed |			packed := ByteArray new: rowBytes * height.			0 to: height - 1 do: [ :row |				packed				replaceFrom: (row * rowBytes) + 1				to: ((row + 1) * rowBytes)				with: raw				startingAt: (row * stride) + 1 ].			packed ].	^ self		fromPremultipliedBGRABytes: compact		width: width		height: height]{ #category : 'private' }SpWin32ImageData class >> byteForUnit: aNumber [	^ ((((aNumber asFloat max: 0.0) min: 1.0) * 255.0) rounded max: 0) min: 255]{ #category : 'private' }SpWin32ImageData class >> premultipliedByteFor: component alpha: alpha [	^ self byteForUnit: component asFloat * alpha asFloat]{ #category : 'accessing' }SpWin32ImageData >> bytes [	^ bytes]{ #category : 'private' }SpWin32ImageData >> bytes: aByteArray [	bytes := aByteArray]{ #category : 'accessing' }SpWin32ImageData >> extent [	^ width @ height]{ #category : 'accessing' }SpWin32ImageData >> height [	^ height]{ #category : 'private' }SpWin32ImageData >> height: anInteger [	height := anInteger]{ #category : 'accessing' }SpWin32ImageData >> width [	^ width]{ #category : 'private' }SpWin32ImageData >> width: anInteger [	width := anInteger]