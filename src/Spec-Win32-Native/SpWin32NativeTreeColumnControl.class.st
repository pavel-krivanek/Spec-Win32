Class {	#name : 'SpWin32NativeTreeColumnControl',	#superclass : 'SpWin32NativeTreeControl',	#instVars : [		'columnTitles',		'columnWidths',		'columnAlignments',		'columnExpandables',		'headersVisible',		'resizable',		'cellStrings',		'cellImages',		'rowCount',		'columnCount'	],	#category : 'Spec-Win32-Native-Objects',	#package : 'Spec-Win32-Native',	#tag : 'Objects'}{ #category : 'initialization' }SpWin32NativeTreeColumnControl >> initialize [	super initialize.	columnTitles := #('Column').	columnWidths := #(220).	columnAlignments := #(0).	columnExpandables := #(true).	headersVisible := true.	resizable := true.	cellStrings := #().	cellImages := #().	rowCount := 0.	columnCount := 1.	items := #()]{ #category : 'private - lifecycle' }SpWin32NativeTreeColumnControl >> applyKindSpecificNativeState [	super applyKindSpecificNativeState.	self applyTableDefinition]{ #category : 'private - lifecycle' }SpWin32NativeTreeColumnControl >> applyTableDefinition [	self isValid ifFalse: [ ^ self ].	runtime		setTableControl: self		columnTitles: columnTitles		widths: columnWidths		alignments: columnAlignments		expandables: columnExpandables		headersVisible: headersVisible		resizable: resizable.	(cellImages anySatisfy: [ :each | each notNil ])		ifTrue: [			runtime				setTableControl: self				cells: cellStrings				images: cellImages				rowCount: rowCount				columnCount: columnCount ]		ifFalse: [			runtime				setTableControl: self				cells: cellStrings				rowCount: rowCount				columnCount: columnCount ]]{ #category : 'accessing - collections' }SpWin32NativeTreeColumnControl >> items: aCollection [ items := aCollection asArray ]{ #category : 'accessing - collections' }SpWin32NativeTreeColumnControl >> items [ ^ items ]{ #category : 'accessing - table' }SpWin32NativeTreeColumnControl >> columnTitles [ ^ columnTitles ]{ #category : 'accessing - table' }SpWin32NativeTreeColumnControl >> columnWidths [ ^ columnWidths ]{ #category : 'accessing - table' }SpWin32NativeTreeColumnControl >> columnAlignments [ ^ columnAlignments ]{ #category : 'accessing - table' }SpWin32NativeTreeColumnControl >> columnExpandables [ ^ columnExpandables ]{ #category : 'accessing - table' }SpWin32NativeTreeColumnControl >> headersVisible [ ^ headersVisible ]{ #category : 'accessing - table' }SpWin32NativeTreeColumnControl >> resizable [ ^ resizable ]{ #category : 'accessing - table' }SpWin32NativeTreeColumnControl >> cellStrings [ ^ cellStrings ]{ #category : 'accessing - table' }SpWin32NativeTreeColumnControl >> cellImages [ ^ cellImages ]{ #category : 'accessing - table' }SpWin32NativeTreeColumnControl >> rowCount [ ^ rowCount ]{ #category : 'accessing - table' }SpWin32NativeTreeColumnControl >> columnCount [ ^ columnCount ]{ #category : 'accessing - table' }SpWin32NativeTreeColumnControl >> columnsTitles: titles widths: widths alignments: alignments expandables: expandables headersVisible: aBoolean resizable: isResizable [	columnTitles := titles asArray.	columnWidths := widths asArray.	columnAlignments := alignments asArray.	columnExpandables := expandables asArray.	headersVisible := aBoolean.	resizable := isResizable.	columnCount := columnTitles size.	self isValid ifTrue: [ self applyTableDefinition ]]{ #category : 'accessing - table' }SpWin32NativeTreeColumnControl >> cells: strings rowCount: rows columnCount: columns [	cellStrings := strings asArray.	cellImages := Array new: cellStrings size withAll: nil.	rowCount := rows.	columnCount := columns.	self isValid ifTrue: [		runtime setTableControl: self cells: cellStrings rowCount: rowCount columnCount: columnCount ]]{ #category : 'accessing - table' }SpWin32NativeTreeColumnControl >> cells: strings images: images rowCount: rows columnCount: columns [	cellStrings := strings asArray.	cellImages := images asArray.	cellStrings size = cellImages size ifFalse: [ self error: 'TreeColumnView cell image count does not match cell count.' ].	rowCount := rows.	columnCount := columns.	self isValid ifTrue: [		(cellImages anySatisfy: [ :each | each notNil ])			ifTrue: [ runtime setTableControl: self cells: cellStrings images: cellImages rowCount: rowCount columnCount: columnCount ]			ifFalse: [ runtime setTableControl: self cells: cellStrings rowCount: rowCount columnCount: columnCount ] ]]