Class {	#name : 'SpWin32NativeTableControl',	#superclass : 'SpWin32NativeControl',	#instVars : [		'columnTitles',		'columnWidths',		'columnAlignments',		'columnExpandables',		'headersVisible',		'resizable',		'cellStrings',		'cellImages',		'rowCount',		'columnCount'	],	#category : 'Spec-Win32-Native-Objects',	#package : 'Spec-Win32-Native',	#tag : 'Objects'}{ #category : 'initialization' }SpWin32NativeTableControl >> initialize [	super initialize.	columnTitles := #('Column').	columnWidths := #(120).	columnAlignments := #(0).	columnExpandables := #(true).	headersVisible := true.	resizable := false.	cellStrings := #().	cellImages := #().	rowCount := 0.	columnCount := 1]{ #category : 'private - lifecycle' }SpWin32NativeTableControl >> applyKindSpecificNativeState [	super applyKindSpecificNativeState.	runtime		setControl: self multipleSelection: multipleSelection.	self applyTableDefinition.	runtime setControl: self selectedIndexes: selectedIndexes]{ #category : 'private - lifecycle' }SpWin32NativeTableControl >> applyTableDefinition [	self isValid ifFalse: [ ^ self ].	runtime		setTableControl: self		columnTitles: columnTitles		widths: columnWidths		alignments: columnAlignments		expandables: columnExpandables		headersVisible: headersVisible		resizable: resizable.	(cellImages anySatisfy: [ :each | each notNil ])		ifTrue: [			runtime				setTableControl: self				cells: cellStrings				images: cellImages				rowCount: rowCount				columnCount: columnCount ]		ifFalse: [			runtime				setTableControl: self				cells: cellStrings				rowCount: rowCount				columnCount: columnCount ]]{ #category : 'accessing - table' }SpWin32NativeTableControl >> columnTitles [ ^ columnTitles ]{ #category : 'accessing - table' }SpWin32NativeTableControl >> columnWidths [ ^ columnWidths ]{ #category : 'accessing - table' }SpWin32NativeTableControl >> columnAlignments [ ^ columnAlignments ]{ #category : 'accessing - table' }SpWin32NativeTableControl >> columnExpandables [ ^ columnExpandables ]{ #category : 'accessing - table' }SpWin32NativeTableControl >> headersVisible [ ^ headersVisible ]{ #category : 'accessing - table' }SpWin32NativeTableControl >> resizable [ ^ resizable ]{ #category : 'accessing - table' }SpWin32NativeTableControl >> cellStrings [ ^ cellStrings ]{ #category : 'accessing - table' }SpWin32NativeTableControl >> cellImages [ ^ cellImages ]{ #category : 'accessing - table' }SpWin32NativeTableControl >> rowCount [ ^ rowCount ]{ #category : 'accessing - table' }SpWin32NativeTableControl >> columnCount [ ^ columnCount ]{ #category : 'accessing - collections' }SpWin32NativeTableControl >> items: aCollection [	items := aCollection asArray]{ #category : 'accessing - table' }SpWin32NativeTableControl >> columnsTitles: titles widths: widths alignments: alignments expandables: expandables headersVisible: aBoolean resizable: isResizable [	columnTitles := titles asArray.	columnWidths := widths asArray.	columnAlignments := alignments asArray.	columnExpandables := expandables asArray.	headersVisible := aBoolean.	resizable := isResizable.	columnCount := columnTitles size.	self isValid ifTrue: [ self applyTableDefinition ]]{ #category : 'accessing - table' }SpWin32NativeTableControl >> cells: strings rowCount: rows columnCount: columns [	cellStrings := strings asArray.	cellImages := Array new: cellStrings size withAll: nil.	rowCount := rows.	columnCount := columns.	self isValid ifTrue: [		runtime			setTableControl: self			cells: cellStrings			rowCount: rowCount			columnCount: columnCount.		runtime setControl: self selectedIndexes: selectedIndexes ]]{ #category : 'accessing - table' }SpWin32NativeTableControl >> cells: strings images: images rowCount: rows columnCount: columns [	cellStrings := strings asArray.	cellImages := images asArray.	cellStrings size = cellImages size ifFalse: [ self error: 'Table cell image count does not match cell count.' ].	rowCount := rows.	columnCount := columns.	self isValid ifTrue: [		(cellImages anySatisfy: [ :each | each notNil ])			ifTrue: [ runtime setTableControl: self cells: cellStrings images: cellImages rowCount: rowCount columnCount: columnCount ]			ifFalse: [ runtime setTableControl: self cells: cellStrings rowCount: rowCount columnCount: columnCount ].		runtime setControl: self selectedIndexes: selectedIndexes ]]