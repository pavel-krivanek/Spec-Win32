Class {	#name : 'SpWin32NotebookContainer',	#superclass : 'SpWin32LayoutContainer',	#instVars : [		'tabControl',		'pages',		'pageWidgets',		'selectedPage',		'visible'	],	#category : 'Spec-Win32-Native-Layout',	#package : 'Spec-Win32-Native',	#tag : 'Layout'}{ #category : 'instance creation' }SpWin32NotebookContainer class >> runtime: aRuntime eventHandler: anEventHandler [	^ self new		runtime: aRuntime;		initializeTabControlWith: anEventHandler;		yourself]{ #category : 'accessing' }SpWin32NotebookContainer >> children [	^ { tabControl }, pageWidgets values asArray]{ #category : 'private' }SpWin32NotebookContainer >> contentRectangleWithin: aRectangle [	| inset header width height |	inset := 6.	header := 30.	width := (aRectangle width - (inset * 2)) max: 1.	height := (aRectangle height - header - inset) max: 1.	^ (aRectangle origin + (inset @ header)) extent: width @ height]{ #category : 'lifecycle' }SpWin32NotebookContainer >> destroy [	tabControl ifNotNil: [ tabControl destroy ].	pageWidgets valuesDo: [ :widget |		(widget respondsTo: #destroy) ifTrue: [ widget destroy ] ].	pageWidgets removeAll]{ #category : 'initialization' }SpWin32NotebookContainer >> initialize [	super initialize.	pages := #().	pageWidgets := IdentityDictionary new.	selectedPage := nil.	visible := true]{ #category : 'initialization' }SpWin32NotebookContainer >> initializeTabControlWith: anEventHandler [	tabControl := SpWin32NativeControl		runtime: runtime		kind: SpWin32Runtime controlNotebook		text: ''		preferredExtent: 180 @ 140.	tabControl eventHandler: anEventHandler]{ #category : 'testing' }SpWin32NotebookContainer >> isVisible [	^ visible]{ #category : 'geometry' }SpWin32NotebookContainer >> layoutIn: aRectangle collect: placements [	| content widget |	lastExtent := aRectangle extent.	placements add: { tabControl. aRectangle left. aRectangle top. (aRectangle width max: 1). (aRectangle height max: 1) }.	selectedPage ifNil: [ ^ self ].	widget := pageWidgets at: selectedPage ifAbsent: [ ^ self ].	content := self contentRectangleWithin: aRectangle.	(widget respondsTo: #layoutIn:collect:)		ifTrue: [ widget layoutIn: content collect: placements ]		ifFalse: [ placements add: { widget. content left. content top. content width. content height } ]]{ #category : 'accessing' }SpWin32NotebookContainer >> numberOfTabs [	^ pages size]{ #category : 'accessing' }SpWin32NotebookContainer >> pageWidgetAt: aPage [	^ pageWidgets at: aPage ifAbsent: [ nil ]]{ #category : 'accessing' }SpWin32NotebookContainer >> pageWidget: aWidget for: aPage [	| old |	old := pageWidgets at: aPage ifAbsent: [ nil ].	old == aWidget ifTrue: [ ^ self ].	old ifNotNil: [ (old respondsTo: #destroy) ifTrue: [ old destroy ] ].	(aWidget respondsTo: #layoutOwner:) ifTrue: [ aWidget layoutOwner: self ].	pageWidgets at: aPage put: aWidget.	(aWidget respondsTo: #visible:) ifTrue: [ aWidget visible: (visible and: [ aPage == selectedPage ]) ].	self requestRelayout]{ #category : 'accessing' }SpWin32NotebookContainer >> pages [	^ pages]{ #category : 'accessing' }SpWin32NotebookContainer >> pages: aCollection [	| newPages removed |	newPages := aCollection asArray.	removed := pageWidgets keys reject: [ :page | newPages identityIncludes: page ].	removed do: [ :page | self resetPageWidget: page ].	pages := newPages.	tabControl items: (pages collect: [ :page | page title ifNil: [ '' ] ifNotNil: [ :title | title asString ] ]).	(selectedPage notNil and: [ (pages identityIncludes: selectedPage) not ]) ifTrue: [ selectedPage := nil ].	tabControl selectedIndex: self selectedIndex.	self requestRelayout]{ #category : 'accessing' }SpWin32NotebookContainer >> preferredExtent [	| contentExtent |	contentExtent := self selectedPageWidget		ifNil: [ 160 @ 100 ]		ifNotNil: [ :widget | (widget respondsTo: #preferredExtent) ifTrue: [ widget preferredExtent ] ifFalse: [ 160 @ 100 ] ].	^ ((contentExtent x + 12) max: 180) @ ((contentExtent y + 40) max: 140)]{ #category : 'geometry' }SpWin32NotebookContainer >> refreshPreferredExtentsIn: aNativeWindow [	tabControl refreshPreferredExtentIn: aNativeWindow.	pageWidgets valuesDo: [ :widget |		(widget respondsTo: #refreshPreferredExtentIn:)			ifTrue: [ widget refreshPreferredExtentIn: aNativeWindow ]			ifFalse: [				(widget respondsTo: #refreshPreferredExtentsIn:)					ifTrue: [ widget refreshPreferredExtentsIn: aNativeWindow ] ] ]]{ #category : 'accessing' }SpWin32NotebookContainer >> resetPageWidget: aPage [	| widget |	widget := pageWidgets removeKey: aPage ifAbsent: [ ^ self ].	(widget respondsTo: #destroy) ifTrue: [ widget destroy ].	self requestRelayout]{ #category : 'accessing' }SpWin32NotebookContainer >> selectedIndex [	selectedPage ifNil: [ ^ 0 ].	^ pages identityIndexOf: selectedPage ifAbsent: [ 0 ]]{ #category : 'accessing' }SpWin32NotebookContainer >> selectedPage [	^ selectedPage]{ #category : 'accessing' }SpWin32NotebookContainer >> selectedPage: aPage [	| oldWidget newWidget |	selectedPage == aPage ifTrue: [		tabControl selectedIndex: self selectedIndex.		^ self ].	oldWidget := self selectedPageWidget.	oldWidget ifNotNil: [ (oldWidget respondsTo: #visible:) ifTrue: [ oldWidget visible: false ] ].	selectedPage := aPage.	tabControl selectedIndex: self selectedIndex.	newWidget := self selectedPageWidget.	newWidget ifNotNil: [ (newWidget respondsTo: #visible:) ifTrue: [ newWidget visible: visible ] ].	self requestRelayout]{ #category : 'accessing' }SpWin32NotebookContainer >> selectedPageWidget [	selectedPage ifNil: [ ^ nil ].	^ pageWidgets at: selectedPage ifAbsent: [ nil ]]{ #category : 'accessing' }SpWin32NotebookContainer >> tabControl [	^ tabControl]{ #category : 'updating' }SpWin32NotebookContainer >> updateTitles [	tabControl items: (pages collect: [ :page | page title ifNil: [ '' ] ifNotNil: [ :title | title asString ] ])]{ #category : 'visibility' }SpWin32NotebookContainer >> visible: aBoolean [	visible := aBoolean.	tabControl visible: aBoolean.	pageWidgets keysAndValuesDo: [ :page :widget |		(widget respondsTo: #visible:) ifTrue: [ widget visible: (aBoolean and: [ page == selectedPage ]) ] ]]