Class {	#name : 'SpWin32LayoutContainer',	#superclass : 'Object',	#instVars : [		'children',		'runtime',		'parentWindow',		'lastExtent',		'lastRectangle',		'layoutOwner'	],	#category : 'Spec-Win32-Native-Layout',	#package : 'Spec-Win32-Native',	#tag : 'Layout'}{ #category : 'testing' }SpWin32LayoutContainer class >> isAbstract [	^ self == SpWin32LayoutContainer]{ #category : 'accessing' }SpWin32LayoutContainer >> addChild: aWidget constraints: constraints [	(aWidget respondsTo: #layoutOwner:) ifTrue: [ aWidget layoutOwner: self ].	children add: { aWidget. constraints }.	self requestRelayout]{ #category : 'accessing' }SpWin32LayoutContainer >> children [	^ (children collect: #first) asArray]{ #category : 'geometry - native order' }SpWin32LayoutContainer >> applyNativeOrderingRecursively [	children do: [ :entry |		| child |		child := entry first.		(child respondsTo: #applyNativeOrderingRecursively) ifTrue: [			child applyNativeOrderingRecursively ] ]]{ #category : 'lifecycle' }SpWin32LayoutContainer >> destroy [	children do: [ :entry |		(entry first respondsTo: #destroy) ifTrue: [ entry first destroy ] ]]{ #category : 'initialization' }SpWin32LayoutContainer >> initialize [	super initialize.	children := OrderedCollection new]{ #category : 'geometry - native order' }SpWin32LayoutContainer >> nativeControlsForZOrder [	| result |	result := OrderedCollection new.	children do: [ :entry |		| child |		child := entry first.		(child isKindOf: SpWin32NativeControl)			ifTrue: [ result add: child ]			ifFalse: [				(child respondsTo: #nativeControlsForZOrder) ifTrue: [					result addAll: child nativeControlsForZOrder ] ] ].	^ result asArray]{ #category : 'testing' }SpWin32LayoutContainer >> isVisible [	^ true]{ #category : 'geometry' }SpWin32LayoutContainer >> layoutIn: aRectangle collect: placements [	self subclassResponsibility]{ #category : 'layout' }SpWin32LayoutContainer >> layoutOwner: aContainer [	layoutOwner := aContainer]{ #category : 'lifecycle' }SpWin32LayoutContainer >> realizeIn: aNativeWindow extent: anExtent [	^ self realizeIn: aNativeWindow rectangle: (0@0 extent: anExtent)]{ #category : 'lifecycle' }SpWin32LayoutContainer >> realizeIn: aNativeWindow rectangle: aRectangle [	| placements |	parentWindow := aNativeWindow.	lastRectangle := aRectangle.	lastExtent := aRectangle extent.	self refreshPreferredExtentsIn: aNativeWindow.	placements := OrderedCollection new.	self layoutIn: aRectangle collect: placements.	placements do: [ :placement |		| control bounds |		control := placement first.		bounds := (placement second @ placement third)			extent: (placement fourth @ placement fifth).		control realizeIn: aNativeWindow bounds: bounds ].	runtime setControlBoundsBatch: placements.	self applyNativeOrderingRecursively]{ #category : 'geometry' }SpWin32LayoutContainer >> refreshPreferredExtentsIn: aNativeWindow [	children do: [ :entry |		| child |		child := entry first.		(child respondsTo: #refreshPreferredExtentIn:)			ifTrue: [ child refreshPreferredExtentIn: aNativeWindow ]			ifFalse: [				(child respondsTo: #refreshPreferredExtentsIn:)					ifTrue: [ child refreshPreferredExtentsIn: aNativeWindow ] ] ]]{ #category : 'geometry' }SpWin32LayoutContainer >> relayout [	(parentWindow isNil or: [ lastRectangle isNil ]) ifTrue: [ ^ self ].	self realizeIn: parentWindow rectangle: lastRectangle]{ #category : 'geometry' }SpWin32LayoutContainer >> relayoutExtent: anExtent [	parentWindow ifNil: [ ^ self ].	self realizeIn: parentWindow rectangle: ((lastRectangle ifNil: [ 0@0 extent: anExtent ]) origin extent: anExtent)]{ #category : 'accessing' }SpWin32LayoutContainer >> removeAll [	self destroy.	children removeAll.	self requestRelayout]{ #category : 'accessing' }SpWin32LayoutContainer >> removeChildWidget: aWidget [	| entry |	entry := children		detect: [ :each | each first == aWidget ]		ifNone: [ ^ self ].	(aWidget respondsTo: #destroy) ifTrue: [ aWidget destroy ].	children remove: entry.	self requestRelayout]{ #category : 'accessing' }SpWin32LayoutContainer >> replaceChildWidget: oldWidget with: newWidget constraints: constraints [	| index oldEntry |	index := children findFirst: [ :entry | entry first == oldWidget ].	index = 0 ifTrue: [ ^ self ].	oldEntry := children at: index.	(oldEntry first respondsTo: #destroy) ifTrue: [ oldEntry first destroy ].	(newWidget respondsTo: #layoutOwner:) ifTrue: [ newWidget layoutOwner: self ].	children at: index put: { newWidget. constraints }.	self requestRelayout]{ #category : 'geometry' }SpWin32LayoutContainer >> requestRelayout [	layoutOwner		ifNotNil: [ :owner | owner requestRelayout ]		ifNil: [ self relayout ]]{ #category : 'accessing' }SpWin32LayoutContainer >> runtime: aRuntime [	runtime := aRuntime]{ #category : 'visibility' }SpWin32LayoutContainer >> visible: aBoolean [	children do: [ :entry |		| child |		child := entry first.		(child respondsTo: #visible:) ifTrue: [ child visible: aBoolean ] ]]