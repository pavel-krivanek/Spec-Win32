Class {	#name : 'SpWin32DialogContainer',	#superclass : 'Object',	#instVars : [		'content',		'buttons',		'runtime',		'parentWindow',		'lastExtent',		'buttonsVisible'	],	#category : 'Spec-Win32-Native-Layout',	#package : 'Spec-Win32-Native',	#tag : 'Layout'}{ #category : 'instance creation' }SpWin32DialogContainer class >> content: aWidget buttons: buttonWidgets runtime: aRuntime [	^ self new		content: aWidget;		buttons: buttonWidgets;		runtime: aRuntime;		yourself]{ #category : 'accessing' }SpWin32DialogContainer >> buttons [	^ buttons]{ #category : 'accessing' }SpWin32DialogContainer >> buttons: aCollection [	buttons := aCollection asArray]{ #category : 'accessing' }SpWin32DialogContainer >> buttonsVisible [	^ buttonsVisible]{ #category : 'accessing' }SpWin32DialogContainer >> buttonsVisible: aBoolean [	buttonsVisible := aBoolean.	buttons do: [ :each |		(each respondsTo: #visible:) ifTrue: [ each visible: aBoolean ] ].	parentWindow ifNotNil: [ self relayout ]]{ #category : 'geometry' }SpWin32DialogContainer >> buttonBarHeight [	| maximum |	buttonsVisible ifFalse: [ ^ 0 ].	buttons ifEmpty: [ ^ 0 ].	maximum := buttons inject: 0 into: [ :height :button |		height max: button preferredExtent y asInteger ].	^ maximum + 20]{ #category : 'accessing' }SpWin32DialogContainer >> content [	^ content]{ #category : 'accessing' }SpWin32DialogContainer >> content: aWidget [	content := aWidget]{ #category : 'lifecycle' }SpWin32DialogContainer >> destroy [	(content respondsTo: #destroy) ifTrue: [ content destroy ].	buttons do: [ :each |		(each respondsTo: #destroy) ifTrue: [ each destroy ] ]]{ #category : 'initialization' }SpWin32DialogContainer >> initialize [	super initialize.	buttons := #().	buttonsVisible := true]{ #category : 'testing' }SpWin32DialogContainer >> isVisible [	^ true]{ #category : 'private - geometry' }SpWin32DialogContainer >> realizeContentExtent: contentExtent [	(content respondsTo: #realizeIn:extent:) ifTrue: [		content realizeIn: parentWindow extent: contentExtent.		^ self ].	(content respondsTo: #realizeIn:bounds:) ifTrue: [		content			realizeIn: parentWindow			bounds: (0@0 extent: contentExtent).		runtime setControlBoundsBatch: {			{ content. 0. 0. contentExtent x. contentExtent y } } ]]{ #category : 'private - geometry' }SpWin32DialogContainer >> realizeButtonsInExtent: anExtent barHeight: barHeight [	| spacing margin totalWidth cursor placements y |	buttons ifEmpty: [ ^ self ].	buttons do: [ :each |		(each respondsTo: #refreshPreferredExtentIn:) ifTrue: [			each refreshPreferredExtentIn: parentWindow ].		(each respondsTo: #visible:) ifTrue: [ each visible: buttonsVisible ] ].	buttonsVisible ifFalse: [ ^ self ].	spacing := 8.	margin := 10.	totalWidth := (buttons inject: 0 into: [ :sum :button |		sum + button preferredExtent x asInteger ])		+ (spacing * ((buttons size - 1) max: 0)).	cursor := (anExtent x - margin - totalWidth) max: margin.	placements := OrderedCollection new.	buttons do: [ :button |		| buttonExtent |		buttonExtent := button preferredExtent.		y := anExtent y - barHeight + ((barHeight - buttonExtent y) // 2).		button			realizeIn: parentWindow			bounds: (cursor @ y extent: buttonExtent).		placements add: {			button.			cursor.			y.			buttonExtent x.			buttonExtent y }.		cursor := cursor + buttonExtent x + spacing ].	placements ifNotEmpty: [ runtime setControlBoundsBatch: placements ]]{ #category : 'lifecycle' }SpWin32DialogContainer >> realizeIn: aNativeWindow extent: anExtent [	| barHeight contentExtent |	parentWindow := aNativeWindow.	lastExtent := anExtent.	barHeight := self buttonBarHeight.	contentExtent := anExtent x @ ((anExtent y - barHeight) max: 1).	self realizeContentExtent: contentExtent.	self realizeButtonsInExtent: anExtent barHeight: barHeight]{ #category : 'layout' }SpWin32DialogContainer >> relayout [	(parentWindow isNil or: [ lastExtent isNil ]) ifTrue: [ ^ self ].	self realizeIn: parentWindow extent: lastExtent]{ #category : 'layout' }SpWin32DialogContainer >> relayoutExtent: anExtent [	parentWindow ifNil: [ ^ self ].	self realizeIn: parentWindow extent: anExtent]{ #category : 'accessing' }SpWin32DialogContainer >> runtime: aRuntime [	runtime := aRuntime]{ #category : 'visibility' }SpWin32DialogContainer >> visible: aBoolean [	(content respondsTo: #visible:) ifTrue: [ content visible: aBoolean ].	buttons do: [ :each |		(each respondsTo: #visible:) ifTrue: [			each visible: (aBoolean and: [ buttonsVisible ]) ] ]]