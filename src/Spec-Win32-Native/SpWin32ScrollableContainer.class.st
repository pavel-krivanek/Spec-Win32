Class {	#name : 'SpWin32ScrollableContainer',	#superclass : 'SpWin32NativeControl',	#instVars : [		'layout',		'child',		'contentControl',		'scrollPosition',		'childNaturalExtent'	],	#category : 'Spec-Win32-Native-Layout',	#package : 'Spec-Win32-Native',	#tag : 'Layout'}{ #category : 'instance creation' }SpWin32ScrollableContainer class >> layout: aLayout runtime: aRuntime [	^ self new		runtime: aRuntime;		kind: aRuntime class controlScrollViewport;		text: '';		preferredExtent: 100@100;		layout: aLayout;		yourself]{ #category : 'accessing' }SpWin32ScrollableContainer >> child [	^ child]{ #category : 'accessing' }SpWin32ScrollableContainer >> children [	^ child ifNil: [ #() ] ifNotNil: [ { child } ]]{ #category : 'accessing' }SpWin32ScrollableContainer >> child: aWidget [	child == aWidget ifTrue: [ ^ self ].	child ifNotNil: [ self destroyChild ].	child := aWidget.	child ifNotNil: [		(child respondsTo: #layoutOwner:) ifTrue: [ child layoutOwner: self ] ].	self requestRelayout]{ #category : 'lifecycle' }SpWin32ScrollableContainer >> destroy [	contentControl := nil.	child := nil.	super destroy]{ #category : 'private' }SpWin32ScrollableContainer >> destroyChild [	child ifNotNil: [		(child respondsTo: #destroy) ifTrue: [ child destroy ] ].	child := nil]{ #category : 'initialization' }SpWin32ScrollableContainer >> initialize [	super initialize.	scrollPosition := 0@0.	childNaturalExtent := 0@0]{ #category : 'accessing' }SpWin32ScrollableContainer >> layout: aLayout [	layout := aLayout]{ #category : 'geometry' }SpWin32ScrollableContainer >> layoutIn: aRectangle collect: placements [	bounds := aRectangle.	placements add: { self. aRectangle left. aRectangle top. aRectangle width. aRectangle height }]{ #category : 'geometry' }SpWin32ScrollableContainer >> preferredExtent [	| width height |	width := layout isPropagateNaturalWidth		ifTrue: [ childNaturalExtent x ]		ifFalse: [ 100 ].	height := layout isPropagateNaturalHeight		ifTrue: [ childNaturalExtent y ]		ifFalse: [ 100 ].	^ (width max: 1) @ (height max: 1)]{ #category : 'geometry' }SpWin32ScrollableContainer >> refreshPreferredExtentIn: aNativeParent [	child ifNil: [		childNaturalExtent := 0@0.		preferredExtent := self preferredExtent.		^ preferredExtent ].	(child respondsTo: #refreshPreferredExtentIn:)		ifTrue: [ child refreshPreferredExtentIn: aNativeParent ]		ifFalse: [			(child respondsTo: #refreshPreferredExtentsIn:)				ifTrue: [ child refreshPreferredExtentsIn: aNativeParent ] ].	childNaturalExtent := child preferredExtent.	preferredExtent := self preferredExtent.	^ preferredExtent]{ #category : 'private - geometry' }SpWin32ScrollableContainer >> alignedOriginForChildExtent: childExtent in: contentExtent [	| x y |	x := self alignedOffsetFor: childExtent x available: contentExtent x alignment: layout hAlign.	y := self alignedOffsetFor: childExtent y available: contentExtent y alignment: layout vAlign.	^ x@y]{ #category : 'private - geometry' }SpWin32ScrollableContainer >> alignedOffsetFor: childSize available: availableSize alignment: anAlignment [	anAlignment ifNil: [ ^ 0 ].	anAlignment == SpLayoutWidgetAlignment center ifTrue: [ ^ ((availableSize - childSize) max: 0) // 2 ].	anAlignment == SpLayoutWidgetAlignment end ifTrue: [ ^ (availableSize - childSize) max: 0 ].	^ 0]{ #category : 'private - geometry' }SpWin32ScrollableContainer >> contentExtentForViewport: viewportExtent [	| width height |	width := layout hasHScrollbar		ifTrue: [ childNaturalExtent x max: viewportExtent x ]		ifFalse: [ viewportExtent x ].	height := layout hasVScrollbar		ifTrue: [ childNaturalExtent y max: viewportExtent y ]		ifFalse: [ viewportExtent y ].	^ (width max: 1) @ (height max: 1)]{ #category : 'private - geometry' }SpWin32ScrollableContainer >> childExtentIn: contentExtent [	| width height |	width := layout hAlign		ifNil: [ contentExtent x ]		ifNotNil: [ childNaturalExtent x min: contentExtent x ].	height := layout vAlign		ifNil: [ contentExtent y ]		ifNotNil: [ childNaturalExtent y min: contentExtent y ].	^ (width max: 1) @ (height max: 1)]{ #category : 'private - lifecycle' }SpWin32ScrollableContainer >> ensureContentControl [	contentControl ifNil: [		contentControl := SpWin32NativeControl			runtime: runtime			kind: runtime class controlScrollContent			text: ''			preferredExtent: 1@1 ]]{ #category : 'lifecycle' }SpWin32ScrollableContainer >> realizeIn: aNativeParent bounds: aRectangle [	| viewportExtent contentExtent pageExtent actualChildExtent childOrigin childRectangle placements |	super realizeIn: aNativeParent bounds: aRectangle.	runtime setControlBoundsBatch: { { self. aRectangle left. aRectangle top. aRectangle width. aRectangle height } }.	self ensureContentControl.	viewportExtent := aRectangle extent max: 1@1.	self refreshPreferredExtentIn: self.	"Configure once with the nominal viewport so Win32 can decide which	 automatic scrollbars are required. Standard scrollbars consume client	 space, therefore query the resulting page extent before laying out the	 content subtree. This prevents a vertical bar from creating a spurious	 horizontal bar merely because the child was stretched to the pre-bar	 viewport width (and vice versa)."	contentExtent := self contentExtentForViewport: viewportExtent.	contentControl realizeIn: self bounds: (0@0 extent: contentExtent).	runtime		configureScrollViewport: self		content: contentControl		extent: contentExtent		horizontal: layout hasHScrollbar		vertical: layout hasVScrollbar.	pageExtent := runtime scrollViewportPageExtent: self.	contentExtent := self contentExtentForViewport: pageExtent.	contentControl realizeIn: self bounds: (0@0 extent: contentExtent).	child ifNotNil: [		actualChildExtent := self childExtentIn: contentExtent.		childOrigin := self alignedOriginForChildExtent: actualChildExtent in: contentExtent.		childRectangle := childOrigin extent: actualChildExtent.		(child respondsTo: #realizeIn:rectangle:)			ifTrue: [ child realizeIn: contentControl rectangle: childRectangle ]			ifFalse: [				child realizeIn: contentControl bounds: childRectangle.				placements := { { child. childRectangle left. childRectangle top. childRectangle width. childRectangle height } }.				runtime setControlBoundsBatch: placements ] ].	runtime		configureScrollViewport: self		content: contentControl		extent: contentExtent		horizontal: layout hasHScrollbar		vertical: layout hasVScrollbar.	runtime setScrollViewport: self position: scrollPosition]{ #category : 'accessing' }SpWin32ScrollableContainer >> removeChildWidget: aWidget [	child == aWidget ifFalse: [ ^ self ].	self destroyChild.	self requestRelayout]{ #category : 'geometry' }SpWin32ScrollableContainer >> requestRelayout [	layoutOwner		ifNotNil: [ :owner | owner requestRelayout ]		ifNil: [			(parentWindow notNil and: [ bounds notNil ]) ifTrue: [				self realizeIn: parentWindow bounds: bounds ] ]]{ #category : 'scrolling' }SpWin32ScrollableContainer >> scrollTo: aPoint [	scrollPosition := (aPoint x asInteger max: 0) @ (aPoint y asInteger max: 0).	self isValid ifTrue: [ runtime setScrollViewport: self position: scrollPosition ]]{ #category : 'lifecycle' }SpWin32ScrollableContainer >> realizeIn: aNativeParent extent: anExtent [	^ self realizeIn: aNativeParent bounds: (0@0 extent: anExtent)]{ #category : 'geometry' }SpWin32ScrollableContainer >> relayoutExtent: anExtent [	parentWindow ifNil: [ ^ self ].	^ self		realizeIn: parentWindow		bounds: ((bounds ifNil: [ 0@0 extent: anExtent ]) origin extent: anExtent)]