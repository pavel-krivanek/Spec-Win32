Class {	#name : 'SpWin32MouseEvent',	#superclass : 'Object',	#instVars : [		'position',		'button',		'modifiers',		'wasHandled'	],	#category : 'Spec-Win32-Native-Events',	#package : 'Spec-Win32-Native',	#tag : 'Events'}{ #category : 'instance creation' }SpWin32MouseEvent class >> position: aPoint button: buttonCode modifiers: modifierFlags [	^ self new		position: aPoint;		button: buttonCode;		modifiers: modifierFlags;		yourself]{ #category : 'initialization' }SpWin32MouseEvent >> initialize [	super initialize.	button := 0.	modifiers := 0.	wasHandled := false]{ #category : 'accessing' }SpWin32MouseEvent >> position [ ^ position ]{ #category : 'accessing' }SpWin32MouseEvent >> cursorPoint [ ^ position ]{ #category : 'accessing' }SpWin32MouseEvent >> position: aPoint [ position := aPoint ]{ #category : 'accessing' }SpWin32MouseEvent >> button [ ^ button ]{ #category : 'accessing' }SpWin32MouseEvent >> button: anInteger [ button := anInteger ]{ #category : 'accessing' }SpWin32MouseEvent >> modifiers [ ^ modifiers ]{ #category : 'accessing' }SpWin32MouseEvent >> modifiers: anInteger [ modifiers := anInteger ]{ #category : 'testing - buttons' }SpWin32MouseEvent >> isPrimaryButton [ ^ button = 1 ]{ #category : 'testing - buttons' }SpWin32MouseEvent >> isSecondaryButton [ ^ button = 2 ]{ #category : 'testing - buttons' }SpWin32MouseEvent >> isMiddleButton [ ^ button = 3 ]{ #category : 'testing - modifiers' }SpWin32MouseEvent >> shiftPressed [ ^ (modifiers bitAnd: 1) ~= 0 ]{ #category : 'testing - modifiers' }SpWin32MouseEvent >> controlPressed [ ^ (modifiers bitAnd: 2) ~= 0 ]{ #category : 'testing - modifiers' }SpWin32MouseEvent >> altPressed [ ^ (modifiers bitAnd: 4) ~= 0 ]{ #category : 'testing - modifiers' }SpWin32MouseEvent >> metaPressed [ ^ (modifiers bitAnd: 8) ~= 0 ]{ #category : 'testing - modifiers' }SpWin32MouseEvent >> anyModifierKeyPressed [	^ self controlPressed or: [ self altPressed or: [ self metaPressed ] ]]{ #category : 'handling' }SpWin32MouseEvent >> wasHandled [ ^ wasHandled ]{ #category : 'handling' }SpWin32MouseEvent >> wasHandled: aBoolean [ wasHandled := aBoolean ]