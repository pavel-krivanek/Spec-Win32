Class {	#name : 'SpWin32TabContainer',	#superclass : 'SpWin32NativeControl',	#instVars : [		'layout',		'pages',		'pageNaturalExtent'	],	#category : 'Spec-Win32-Native-Layout',	#package : 'Spec-Win32-Native',	#tag : 'Layout'}{ #category : 'instance creation' }SpWin32TabContainer class >> layout: aLayout runtime: aRuntime eventHandler: anEventHandler [	^ self new		runtime: aRuntime;		kind: aRuntime class controlNotebook;		text: '';		preferredExtent: 100@100;		layout: aLayout;		eventHandler: anEventHandler;		yourself]{ #category : 'accessing' }SpWin32TabContainer >> addPageWidget: aWidget constraints: constraints [	(aWidget respondsTo: #layoutOwner:) ifTrue: [ aWidget layoutOwner: self ].	pages add: { aWidget. constraints. nil. 0@0 }.	self updateItems.	selectedIndex = 0 ifTrue: [ self selectedIndex: 1 ].	self requestRelayout]{ #category : 'accessing' }SpWin32TabContainer >> children [	^ (pages collect: [ :entry | entry first ]) asArray]{ #category : 'private - lifecycle' }SpWin32TabContainer >> contentControlFor: anEntry [	| control |	control := anEntry third.	control ifNotNil: [ ^ control ].	control := SpWin32NativeControl		runtime: runtime		kind: runtime class controlTabContent		text: ''		preferredExtent: 1@1.	anEntry at: 3 put: control.	^ control]{ #category : 'lifecycle' }SpWin32TabContainer >> destroy [	pages do: [ :entry |		(entry first respondsTo: #destroy) ifTrue: [ entry first destroy ].		entry third ifNotNil: [ :content | content destroy ] ].	pages removeAll.	super destroy]{ #category : 'private - lifecycle' }SpWin32TabContainer >> destroyEntry: anEntry [	(anEntry first respondsTo: #destroy) ifTrue: [ anEntry first destroy ].	anEntry third ifNotNil: [ :content | content destroy ]]{ #category : 'initialization' }SpWin32TabContainer >> initialize [	super initialize.	pages := OrderedCollection new.	pageNaturalExtent := 0@0]{ #category : 'accessing' }SpWin32TabContainer >> layout: aLayout [	layout := aLayout]{ #category : 'geometry' }SpWin32TabContainer >> layoutIn: aRectangle collect: placements [	bounds := aRectangle.	placements add: { self. aRectangle left. aRectangle top. aRectangle width. aRectangle height }]{ #category : 'private - geometry' }SpWin32TabContainer >> normalizedSelectedIndex: anInteger [	pages ifEmpty: [ ^ 0 ].	^ (anInteger asInteger max: 1) min: pages size]{ #category : 'accessing' }SpWin32TabContainer >> numberOfTabs [	^ pages size]{ #category : 'accessing' }SpWin32TabContainer >> pageContentControls [	^ (pages collect: [ :entry | entry third ]) reject: #isNil]{ #category : 'accessing' }SpWin32TabContainer >> pageWidgetAt: anIndex [	(anIndex between: 1 and: pages size) ifFalse: [ ^ nil ].	^ (pages at: anIndex) first]{ #category : 'accessing' }SpWin32TabContainer >> pages [	^ pages]{ #category : 'geometry' }SpWin32TabContainer >> preferredExtent [	pages ifEmpty: [ ^ 0@0 ].	^ (pageNaturalExtent x + 12) @ (pageNaturalExtent y + 40)]{ #category : 'geometry' }SpWin32TabContainer >> refreshPreferredExtentIn: aNativeParent [	| maximum |	maximum := 0@0.	pages do: [ :entry |		| child extent |		child := entry first.		(child respondsTo: #refreshPreferredExtentIn:)			ifTrue: [ child refreshPreferredExtentIn: aNativeParent ]			ifFalse: [				(child respondsTo: #refreshPreferredExtentsIn:)					ifTrue: [ child refreshPreferredExtentsIn: aNativeParent ] ].		extent := child preferredExtent.		entry at: 4 put: extent.		maximum := (maximum x max: extent x) @ (maximum y max: extent y) ].	pageNaturalExtent := maximum.	preferredExtent := self preferredExtent.	^ preferredExtent]{ #category : 'lifecycle' }SpWin32TabContainer >> realizeIn: aNativeParent bounds: aRectangle [	| contentRectangle contentPlacements |	selectedIndex := self normalizedSelectedIndex: selectedIndex.	super realizeIn: aNativeParent bounds: aRectangle.	runtime setControlBoundsBatch: { { self. aRectangle left. aRectangle top. aRectangle width. aRectangle height } }.	self refreshPreferredExtentIn: self.	contentRectangle := runtime notebookContentRectangleOf: self.	contentPlacements := OrderedCollection new.	pages do: [ :entry |		| content |		content := self contentControlFor: entry.		content realizeIn: self bounds: contentRectangle.		contentPlacements add: { content. contentRectangle left. contentRectangle top. contentRectangle width. contentRectangle height } ].	contentPlacements ifNotEmpty: [ runtime setControlBoundsBatch: contentPlacements ].	pages doWithIndex: [ :entry :index |		| content |		content := entry third.		self realizeChild: entry first inContent: content extent: contentRectangle extent.		content visible: index = selectedIndex ]]{ #category : 'lifecycle' }SpWin32TabContainer >> realizeIn: aNativeParent extent: anExtent [	^ self realizeIn: aNativeParent bounds: (0@0 extent: anExtent)]{ #category : 'private - lifecycle' }SpWin32TabContainer >> realizeChild: aChild inContent: aContent extent: anExtent [	| rectangle |	rectangle := 0@0 extent: (anExtent max: 1@1).	(aChild respondsTo: #realizeIn:rectangle:)		ifTrue: [ aChild realizeIn: aContent rectangle: rectangle ]		ifFalse: [			aChild realizeIn: aContent bounds: rectangle.			runtime setControlBoundsBatch: { { aChild. 0. 0. rectangle width. rectangle height } } ]]{ #category : 'geometry' }SpWin32TabContainer >> relayoutExtent: anExtent [	parentWindow ifNil: [ ^ self ].	^ self		realizeIn: parentWindow		bounds: ((bounds ifNil: [ 0@0 extent: anExtent ]) origin extent: anExtent)]{ #category : 'accessing' }SpWin32TabContainer >> removeAll [	pages do: [ :entry | self destroyEntry: entry ].	pages removeAll.	selectedIndex := 0.	self updateItems.	self requestRelayout]{ #category : 'accessing' }SpWin32TabContainer >> removePageWidget: aWidget [	| index entry oldSelected |	index := pages findFirst: [ :each | each first == aWidget ].	index = 0 ifTrue: [ ^ self ].	oldSelected := selectedIndex.	entry := pages at: index.	self destroyEntry: entry.	pages removeAt: index.	pages ifEmpty:		[ selectedIndex := 0 ]		ifNotEmpty: [			selectedIndex := index < oldSelected				ifTrue: [ oldSelected - 1 ]				ifFalse: [ oldSelected min: pages size ].			selectedIndex := self normalizedSelectedIndex: selectedIndex ].	self updateItems.	self isValid ifTrue: [ runtime setControl: self selectedIndex: selectedIndex ].	self updatePageVisibility.	self requestRelayout]{ #category : 'geometry' }SpWin32TabContainer >> requestRelayout [	layoutOwner		ifNotNil: [ :owner | owner requestRelayout ]		ifNil: [			(parentWindow notNil and: [ bounds notNil ]) ifTrue: [				self realizeIn: parentWindow bounds: bounds ] ]]{ #category : 'accessing' }SpWin32TabContainer >> selectedIndex: anInteger [	| normalized |	normalized := self normalizedSelectedIndex: anInteger.	super selectedIndex: normalized.	self updatePageVisibility]{ #category : 'accessing' }SpWin32TabContainer >> selectedPageWidget [	^ self pageWidgetAt: selectedIndex]{ #category : 'native events' }SpWin32TabContainer >> selectionChangedFromNative [	selectedIndex := self normalizedSelectedIndex: selectedIndex.	self updatePageVisibility]{ #category : 'private - updating' }SpWin32TabContainer >> updateItems [	self items: (pages collect: [ :entry |		entry second label			ifNil: [ '' ]			ifNotNil: [ :label | label asString ] ])]{ #category : 'private - updating' }SpWin32TabContainer >> updatePageVisibility [	pages doWithIndex: [ :entry :index |		entry third ifNotNil: [ :content |			content visible: index = selectedIndex ] ]]