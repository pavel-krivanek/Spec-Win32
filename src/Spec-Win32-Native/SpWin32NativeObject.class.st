Class {	#name : 'SpWin32NativeObject',	#superclass : 'Object',	#instVars : [		'runtime',		'objectId',		'eventHandler',		'destroyed'	],	#category : 'Spec-Win32-Native-Objects',	#package : 'Spec-Win32-Native',	#tag : 'Objects'}{ #category : 'instance creation' }SpWin32NativeObject class >> runtime: aRuntime objectId: anInteger [	^ self new		runtime: aRuntime;		objectId: anInteger;		yourself]{ #category : 'accessing' }SpWin32NativeObject >> eventHandler [	^ eventHandler]{ #category : 'accessing' }SpWin32NativeObject >> eventHandler: anObject [	eventHandler := anObject]{ #category : 'initialization' }SpWin32NativeObject >> initialize [	super initialize.	destroyed := false]{ #category : 'testing' }SpWin32NativeObject >> isDestroyed [	^ destroyed]{ #category : 'testing' }SpWin32NativeObject >> isValid [	^ destroyed not and: [ objectId isNotNil and: [ objectId > 0 ] ]]{ #category : 'private' }SpWin32NativeObject >> markDestroyed [	destroyed := true]{ #category : 'events' }SpWin32NativeObject >> nativeEventType: eventType argument1: argument1 argument2: argument2 [	self subclassResponsibility]{ #category : 'accessing' }SpWin32NativeObject >> objectId [	^ objectId]{ #category : 'accessing' }SpWin32NativeObject >> objectId: anInteger [	objectId := anInteger]{ #category : 'accessing' }SpWin32NativeObject >> runtime [	^ runtime]{ #category : 'accessing' }SpWin32NativeObject >> runtime: aRuntime [	runtime := aRuntime]