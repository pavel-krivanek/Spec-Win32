Class {	#name : 'SpWin32OverlayContainer',	#superclass : 'SpWin32LayoutContainer',	#instVars : [		'layout'	],	#category : 'Spec-Win32-Native-Layout',	#package : 'Spec-Win32-Native',	#tag : 'Layout'}{ #category : 'instance creation' }SpWin32OverlayContainer class >> layout: aLayout runtime: aRuntime [	^ self new		layout: aLayout;		runtime: aRuntime;		yourself]{ #category : 'private - geometry' }SpWin32OverlayContainer >> alignmentOffsetFor: extra alignment: anAlignment [	anAlignment == SpLayoutWidgetAlignment center ifTrue: [ ^ extra // 2 ].	anAlignment == SpLayoutWidgetAlignment end ifTrue: [ ^ extra ].	^ 0]{ #category : 'geometry - native order' }SpWin32OverlayContainer >> applyNativeOrderingRecursively [	| controls |	super applyNativeOrderingRecursively.	controls := self nativeControlsForZOrder.	controls ifNotEmpty: [ runtime setControlZOrderBottomToTop: controls ]]{ #category : 'accessing' }SpWin32OverlayContainer >> children [	| overlays main |	overlays := children select: [ :entry | entry second isOverlay ].	main := children reject: [ :entry | entry second isOverlay ].	^ ((overlays reversed collect: #first), (main collect: #first)) asArray]{ #category : 'private - geometry' }SpWin32OverlayContainer >> extentForOverlay: aWidget in: aRectangle [	| preferred |	preferred := aWidget preferredExtent ifNil: [ 1@1 ].	^ ((preferred x min: aRectangle width) max: 1)		@ ((preferred y min: aRectangle height) max: 1)]{ #category : 'accessing' }SpWin32OverlayContainer >> layout: aLayout [	layout := aLayout]{ #category : 'geometry' }SpWin32OverlayContainer >> layoutIn: aRectangle collect: placements [	| ordered |	lastExtent := aRectangle extent.	ordered := self orderedEntriesBottomToTop.	ordered do: [ :entry |		| widget constraints childRectangle extent hAlign vAlign extraX extraY origin |		widget := entry first.		constraints := entry second.		constraints isOverlay			ifTrue: [				extent := self extentForOverlay: widget in: aRectangle.				hAlign := constraints hAlign ifNil: [ SpLayoutWidgetAlignment center ].				vAlign := constraints vAlign ifNil: [ SpLayoutWidgetAlignment center ].				extraX := (aRectangle width - extent x) max: 0.				extraY := (aRectangle height - extent y) max: 0.				origin := aRectangle origin					+ ((self alignmentOffsetFor: extraX alignment: hAlign)						@ (self alignmentOffsetFor: extraY alignment: vAlign)).				childRectangle := origin extent: extent ]			ifFalse: [ childRectangle := aRectangle ].		(widget respondsTo: #layoutIn:collect:)			ifTrue: [ widget layoutIn: childRectangle collect: placements ]			ifFalse: [				placements add: {					widget.					childRectangle left.					childRectangle top.					childRectangle width.					childRectangle height } ] ]]{ #category : 'geometry - native order' }SpWin32OverlayContainer >> nativeControlsForZOrder [	| result |	result := OrderedCollection new.	self orderedEntriesBottomToTop do: [ :entry |		| child |		child := entry first.		(child isKindOf: SpWin32NativeControl)			ifTrue: [ result add: child ]			ifFalse: [				(child respondsTo: #nativeControlsForZOrder) ifTrue: [					result addAll: child nativeControlsForZOrder ] ] ].	^ result asArray]{ #category : 'private - ordering' }SpWin32OverlayContainer >> orderedEntriesBottomToTop [	| overlays main |	main := children reject: [ :entry | entry second isOverlay ].	overlays := children select: [ :entry | entry second isOverlay ].	^ main, overlays]{ #category : 'geometry' }SpWin32OverlayContainer >> preferredExtent [	| maximum |	children ifEmpty: [ ^ 0@0 ].	maximum := 0@0.	children do: [ :entry |		| extent |		extent := entry first preferredExtent ifNil: [ 0@0 ].		maximum := (maximum x max: extent x) @ (maximum y max: extent y) ].	^ maximum]