Class {	#name : 'SpWin32KeyEvent',	#superclass : 'Object',	#instVars : [		'keyValue',		'modifiers',		'wasHandled'	],	#category : 'Spec-Win32-Native-Events',	#package : 'Spec-Win32-Native',	#tag : 'Events'}{ #category : 'instance creation' }SpWin32KeyEvent class >> keyValue: anInteger modifiers: modifierFlags [	^ self new		keyValue: anInteger;		modifiers: modifierFlags;		yourself]{ #category : 'initialization' }SpWin32KeyEvent >> initialize [	super initialize.	wasHandled := false.	modifiers := 0]{ #category : 'accessing' }SpWin32KeyEvent >> keyValue [ ^ keyValue ]{ #category : 'accessing' }SpWin32KeyEvent >> keyValue: anInteger [ keyValue := anInteger ]{ #category : 'accessing' }SpWin32KeyEvent >> modifiers [ ^ modifiers ]{ #category : 'accessing' }SpWin32KeyEvent >> modifiers: anInteger [ modifiers := anInteger ]{ #category : 'testing - modifiers' }SpWin32KeyEvent >> shiftPressed [ ^ (modifiers bitAnd: 1) ~= 0 ]{ #category : 'testing - modifiers' }SpWin32KeyEvent >> controlPressed [ ^ (modifiers bitAnd: 2) ~= 0 ]{ #category : 'testing - modifiers' }SpWin32KeyEvent >> altPressed [ ^ (modifiers bitAnd: 4) ~= 0 ]{ #category : 'testing - modifiers' }SpWin32KeyEvent >> metaPressed [ ^ (modifiers bitAnd: 8) ~= 0 ]{ #category : 'testing - modifiers' }SpWin32KeyEvent >> commandKeyPressed [ ^ self metaPressed ]{ #category : 'testing - modifiers' }SpWin32KeyEvent >> optionKeyPressed [ ^ self altPressed ]{ #category : 'testing - modifiers' }SpWin32KeyEvent >> anyModifierKeyPressed [	"Spec's searchable presenters deliberately allow Shift while typing."	^ self controlPressed or: [ self altPressed or: [ self metaPressed ] ]]{ #category : 'accessing' }SpWin32KeyEvent >> keyCharacter [	| value |	value := keyValue asInteger.	(value between: 16r41 and: 16r5A) ifTrue: [		^ Character value: (self shiftPressed ifTrue: [ value ] ifFalse: [ value + 32 ]) ].	(value between: 16r30 and: 16r39) ifTrue: [ ^ Character value: value ].	value = 16r20 ifTrue: [ ^ Character space ].	^ Character value: value]{ #category : 'handling' }SpWin32KeyEvent >> wasHandled [ ^ wasHandled ]{ #category : 'handling' }SpWin32KeyEvent >> wasHandled: aBoolean [ wasHandled := aBoolean ]