Class {	#name : 'SpWin32NativeTreeControl',	#superclass : 'SpWin32NativeControl',	#instVars : [ 'treeLabels', 'parentTokens', 'treeImages', 'selectedToken', 'expandedTokens' ],	#category : 'Spec-Win32-Native-Objects',	#package : 'Spec-Win32-Native',	#tag : 'Objects'}{ #category : 'initialization' }SpWin32NativeTreeControl >> initialize [	super initialize.	treeLabels := #().	parentTokens := #().	treeImages := nil.	selectedToken := 0.	expandedTokens := Set new]{ #category : 'private - lifecycle' }SpWin32NativeTreeControl >> applyKindSpecificNativeState [	super applyKindSpecificNativeState.	treeImages		ifNil: [ runtime setControl: self treeLabels: treeLabels parentTokens: parentTokens ]		ifNotNil: [ runtime setControl: self treeLabels: treeLabels parentTokens: parentTokens images: treeImages ].	expandedTokens do: [ :token | runtime setControl: self treeToken: token expanded: true ].	runtime setControl: self selectedTreeToken: selectedToken]{ #category : 'tree' }SpWin32NativeTreeControl >> labels: labels parentTokens: parents [	treeLabels := labels asArray.	parentTokens := parents asArray.	treeImages := nil.	self isValid ifTrue: [		runtime setControl: self treeLabels: treeLabels parentTokens: parentTokens.		expandedTokens removeAll.		selectedToken := 0 ]]{ #category : 'tree' }SpWin32NativeTreeControl >> labels: labels parentTokens: parents images: images [	treeLabels := labels asArray.	parentTokens := parents asArray.	treeImages := images asArray.	self isValid ifTrue: [		runtime setControl: self treeLabels: treeLabels parentTokens: parentTokens images: treeImages.		expandedTokens removeAll.		selectedToken := 0 ]]{ #category : 'tree' }SpWin32NativeTreeControl >> treeImages [ ^ treeImages ]{ #category : 'tree' }SpWin32NativeTreeControl >> treeLabels [ ^ treeLabels ]{ #category : 'tree' }SpWin32NativeTreeControl >> parentTokens [ ^ parentTokens ]{ #category : 'tree' }SpWin32NativeTreeControl >> selectedToken: token [	selectedToken := token asInteger.	self isValid ifTrue: [ runtime setControl: self selectedTreeToken: selectedToken ]]{ #category : 'tree' }SpWin32NativeTreeControl >> selectedToken [ ^ selectedToken ]{ #category : 'tree' }SpWin32NativeTreeControl >> token: token expanded: aBoolean [	aBoolean		ifTrue: [ expandedTokens add: token ]		ifFalse: [ expandedTokens remove: token ifAbsent: [ ] ].	self isValid ifTrue: [ runtime setControl: self treeToken: token expanded: aBoolean ]]{ #category : 'tree' }SpWin32NativeTreeControl >> isTokenExpanded: token [	self isValid ifTrue: [ ^ runtime isControl: self treeTokenExpanded: token ].	^ expandedTokens includes: token]{ #category : 'tree' }SpWin32NativeTreeControl >> ensureVisibleToken: token [	self isValid ifTrue: [ runtime ensureVisibleControl: self treeToken: token ]]