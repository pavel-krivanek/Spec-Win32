Class {	#name : 'SpWin32NativeWindow',	#superclass : 'SpWin32NativeObject',	#instVars : [		'extent',		'position'	],	#category : 'Spec-Win32-Native-Objects',	#package : 'Spec-Win32-Native',	#tag : 'Objects'}{ #category : 'instance creation' }SpWin32NativeWindow class >> runtime: aRuntime objectId: anInteger extent: anExtent [	^ (self runtime: aRuntime objectId: anInteger)		extent: anExtent;		position: 0 @ 0;		yourself]{ #category : 'window management' }SpWin32NativeWindow >> activate [	self isValid ifTrue: [ runtime activateWindow: self ]]{ #category : 'window management' }SpWin32NativeWindow >> destroy [	self isValid ifTrue: [ runtime destroyWindow: self ]]{ #category : 'accessing' }SpWin32NativeWindow >> extent [	^ extent]{ #category : 'accessing' }SpWin32NativeWindow >> extent: aPoint [	extent := aPoint]{ #category : 'window management' }SpWin32NativeWindow >> hide [	self isValid ifTrue: [ runtime showWindow: self command: runtime class swHide ]]{ #category : 'testing' }SpWin32NativeWindow >> isVisible [	^ self isValid and: [ runtime isWindowVisible: self ]]{ #category : 'window management' }SpWin32NativeWindow >> maximize [	self isValid ifTrue: [ runtime showWindow: self command: runtime class swMaximize ]]{ #category : 'window management' }SpWin32NativeWindow >> minimize [	self isValid ifTrue: [ runtime showWindow: self command: runtime class swMinimize ]]{ #category : 'window management' }SpWin32NativeWindow >> moveTo: aPosition extent: anExtent [	position := aPosition.	extent := anExtent.	self isValid ifTrue: [		runtime setWindow: self boundsOrigin: aPosition extent: anExtent ]]{ #category : 'events' }SpWin32NativeWindow >> nativeEventType: eventType argument1: argument1 argument2: argument2 [	eventType = runtime class eventCloseRequested ifTrue: [		eventHandler ifNotNil: [ :handler | handler win32CloseRequested ].		^ self ].	eventType = runtime class eventResized ifTrue: [		| oldExtent newExtent |		oldExtent := extent.		newExtent := argument1 @ argument2.		extent := newExtent.		eventHandler ifNotNil: [ :handler |			handler win32ResizedFrom: oldExtent to: newExtent ].		^ self ].	eventType = runtime class eventPopupDismissRequested ifTrue: [		eventHandler ifNotNil: [ :handler | handler win32PopupDismissRequested ].		^ self ].	eventType = runtime class eventMenuCommand ifTrue: [		eventHandler ifNotNil: [ :handler | handler win32MenuCommand: argument1 ].		^ self ].	eventType = runtime class eventDestroyed ifTrue: [		self markDestroyed.		runtime unregisterObjectId: objectId.		eventHandler ifNotNil: [ :handler | handler win32Destroyed ].		^ self ]]{ #category : 'accessing' }SpWin32NativeWindow >> position [	self isValid ifTrue: [ position := self bounds origin ].	^ position]{ #category : 'accessing' }SpWin32NativeWindow >> position: aPoint [	position := aPoint]{ #category : 'window management' }SpWin32NativeWindow >> restore [	self isValid ifTrue: [ runtime showWindow: self command: runtime class swRestore ]]{ #category : 'window management' }SpWin32NativeWindow >> show [	self isValid ifTrue: [ runtime showWindow: self command: runtime class swShow ]]{ #category : 'window management' }SpWin32NativeWindow >> showWithoutActivation [	self isValid ifTrue: [ runtime showWindow: self command: runtime class swShowNoActivate ]]{ #category : 'accessing' }SpWin32NativeWindow >> title: aString [	self isValid ifTrue: [ runtime setWindow: self title: aString ]]{ #category : 'geometry' }SpWin32NativeWindow >> clientExtent [	^ self isValid		ifTrue: [ runtime windowClientExtent: self ]		ifFalse: [ 0@0 ]]{ #category : 'geometry' }SpWin32NativeWindow >> bounds [	^ self isValid		ifTrue: [ runtime windowBounds: self ]		ifFalse: [ Rectangle origin: position extent: extent ]]{ #category : 'window management' }SpWin32NativeWindow >> centerOnMonitor [	self isValid ifTrue: [		runtime centerWindow: self.		position := self bounds origin ]]{ #category : 'window management' }SpWin32NativeWindow >> centerRelativeTo: anotherNativeWindow [	self isValid ifTrue: [		runtime centerWindow: self relativeTo: anotherNativeWindow.		position := self bounds origin ]]{ #category : 'window management' }SpWin32NativeWindow >> owner: anotherNativeWindowOrNil [	self isValid ifTrue: [ runtime setWindow: self owner: anotherNativeWindowOrNil ]]{ #category : 'testing' }SpWin32NativeWindow >> isMinimized [	^ self isValid and: [ runtime isWindowMinimized: self ]]{ #category : 'testing' }SpWin32NativeWindow >> isMaximized [	^ self isValid and: [ runtime isWindowMaximized: self ]]{ #category : 'testing' }SpWin32NativeWindow >> isForeground [	^ self isValid and: [ runtime isWindowForeground: self ]]{ #category : 'window management' }SpWin32NativeWindow >> enabled: aBoolean [	self isValid ifTrue: [ runtime setWindow: self enabled: aBoolean ]]{ #category : 'testing' }SpWin32NativeWindow >> isEnabled [	^ self isValid and: [ runtime isWindowEnabled: self ]]