Class {	#name : 'SpWin32PopoverGeometry',	#superclass : 'Object',	#category : 'Spec-Win32-Native-Support',	#package : 'Spec-Win32-Native',	#tag : 'Support'}{ #category : 'geometry' }SpWin32PopoverGeometry class >> originForPosition: aPosition anchor: anAnchorRectangle extent: anExtent [	| x y |	aPosition == SpPopoverPosition top ifTrue: [		x := anAnchorRectangle center x - (anExtent x // 2).		y := anAnchorRectangle top - anExtent y.		^ x @ y ].	aPosition == SpPopoverPosition left ifTrue: [		x := anAnchorRectangle left - anExtent x.		y := anAnchorRectangle center y - (anExtent y // 2).		^ x @ y ].	aPosition == SpPopoverPosition right ifTrue: [		x := anAnchorRectangle right.		y := anAnchorRectangle center y - (anExtent y // 2).		^ x @ y ].	x := anAnchorRectangle center x - (anExtent x // 2).	y := anAnchorRectangle bottom.	^ x @ y]{ #category : 'geometry' }SpWin32PopoverGeometry class >> clampOrigin: anOrigin extent: anExtent toWorkArea: aRectangle [	| x y maxX maxY |	anExtent x >= aRectangle width		ifTrue: [ x := aRectangle left ]		ifFalse: [			maxX := aRectangle right - anExtent x.			x := (anOrigin x max: aRectangle left) min: maxX ].	anExtent y >= aRectangle height		ifTrue: [ y := aRectangle top ]		ifFalse: [			maxY := aRectangle bottom - anExtent y.			y := (anOrigin y max: aRectangle top) min: maxY ].	^ x @ y]