Class {	#name : 'SpWin32RuntimeLibrary',	#superclass : 'FFILibrary',	#category : 'Spec-Win32-Native-Libraries',	#package : 'Spec-Win32-Native',	#tag : 'Libraries'}{ #category : 'accessing - platform' }SpWin32RuntimeLibrary >> macLibraryName [	^ self error: 'The Spec Win32 runtime DLL is available only on Windows']{ #category : 'threaded ffi' }SpWin32RuntimeLibrary >> runner [	"Commands use a worker distinct from the blocking event waiter. Otherwise a	#spw_wait_for_activity call could serialize normal window operations behind it."	^ TFWorker named: 'Spec Win32 commands']{ #category : 'accessing - platform' }SpWin32RuntimeLibrary >> unixLibraryName [	^ self error: 'The Spec Win32 runtime DLL is available only on Windows']{ #category : 'accessing - platform' }SpWin32RuntimeLibrary >> win32LibraryName [	^ 'spec-win32-runtime.dll']