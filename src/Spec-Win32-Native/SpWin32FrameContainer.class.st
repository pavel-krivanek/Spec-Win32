Class {	#name : 'SpWin32FrameContainer',	#superclass : 'SpWin32NativeControl',	#instVars : [		'layout',		'child',		'constraints',		'childNaturalExtent'	],	#category : 'Spec-Win32-Native-Layout',	#package : 'Spec-Win32-Native',	#tag : 'Layout'}{ #category : 'instance creation' }SpWin32FrameContainer class >> layout: aLayout runtime: aRuntime [	^ self new		runtime: aRuntime;		kind: aRuntime class controlFrame;		text: (aLayout label ifNil: [ '' ] ifNotNil: [ :label | label asString ]);		preferredExtent: 24@28;		layout: aLayout;		yourself]{ #category : 'accessing' }SpWin32FrameContainer >> child [	^ child]{ #category : 'accessing' }SpWin32FrameContainer >> child: aWidget constraints: frameConstraints [	child == aWidget ifTrue: [		constraints := frameConstraints.		^ self ].	child ifNotNil: [ self destroyChild ].	child := aWidget.	constraints := frameConstraints.	child ifNotNil: [		(child respondsTo: #layoutOwner:) ifTrue: [ child layoutOwner: self ] ].	self requestRelayout]{ #category : 'accessing' }SpWin32FrameContainer >> children [	^ child ifNil: [ #() ] ifNotNil: [ { child } ]]{ #category : 'private - geometry' }SpWin32FrameContainer >> contentRectangleFor: aRectangle [	| left top right bottom width height |	left := 12.	right := 12.	top := text isEmpty ifTrue: [ 12 ] ifFalse: [ 20 ].	bottom := 10.	width := (aRectangle width - left - right) max: 1.	height := (aRectangle height - top - bottom) max: 1.	^ left@top extent: width@height]{ #category : 'lifecycle' }SpWin32FrameContainer >> destroy [	self destroyChild.	super destroy]{ #category : 'private - lifecycle' }SpWin32FrameContainer >> destroyChild [	child ifNotNil: [		(child respondsTo: #destroy) ifTrue: [ child destroy ] ].	child := nil.	constraints := nil.	childNaturalExtent := 0@0]{ #category : 'initialization' }SpWin32FrameContainer >> initialize [	super initialize.	childNaturalExtent := 0@0]{ #category : 'accessing' }SpWin32FrameContainer >> layout: aLayout [	layout := aLayout]{ #category : 'geometry' }SpWin32FrameContainer >> preferredExtent [	| leftRight topBottom titleWidth |	leftRight := 24.	topBottom := text isEmpty ifTrue: [ 22 ] ifFalse: [ 30 ].	titleWidth := preferredExtent ifNil: [ 0 ] ifNotNil: [ preferredExtent x ].	^ ((childNaturalExtent x + leftRight) max: titleWidth)		@ (childNaturalExtent y + topBottom)]{ #category : 'geometry' }SpWin32FrameContainer >> refreshPreferredExtentIn: aNativeParent [	| titleExtent |	titleExtent := super refreshPreferredExtentIn: aNativeParent.	child ifNil: [		childNaturalExtent := 0@0.		preferredExtent := (titleExtent x max: 24) @ (text isEmpty ifTrue: [ 22 ] ifFalse: [ 30 ]).		^ preferredExtent ].	(child respondsTo: #refreshPreferredExtentIn:)		ifTrue: [ child refreshPreferredExtentIn: aNativeParent ]		ifFalse: [			(child respondsTo: #refreshPreferredExtentsIn:)				ifTrue: [ child refreshPreferredExtentsIn: aNativeParent ] ].	childNaturalExtent := child preferredExtent.	preferredExtent := ((childNaturalExtent x + 24) max: titleExtent x)		@ (childNaturalExtent y + (text isEmpty ifTrue: [ 22 ] ifFalse: [ 30 ])).	^ preferredExtent]{ #category : 'lifecycle' }SpWin32FrameContainer >> realizeIn: aNativeParent bounds: aRectangle [	| childRectangle placements |	super realizeIn: aNativeParent bounds: aRectangle.	runtime setControlBoundsBatch: { { self. aRectangle left. aRectangle top. aRectangle width. aRectangle height } }.	self refreshPreferredExtentIn: self.	child ifNil: [ ^ self ].	childRectangle := self contentRectangleFor: aRectangle.	"Child coordinates are local to the frame HWND."	childRectangle := childRectangle origin - aRectangle origin extent: childRectangle extent.	(child respondsTo: #realizeIn:rectangle:)		ifTrue: [ child realizeIn: self rectangle: childRectangle ]		ifFalse: [			child realizeIn: self bounds: childRectangle.			placements := { { child. childRectangle left. childRectangle top. childRectangle width. childRectangle height } }.			runtime setControlBoundsBatch: placements ]]{ #category : 'lifecycle' }SpWin32FrameContainer >> realizeIn: aNativeParent extent: anExtent [	^ self realizeIn: aNativeParent bounds: (0@0 extent: anExtent)]{ #category : 'geometry' }SpWin32FrameContainer >> relayoutExtent: anExtent [	parentWindow ifNil: [ ^ self ].	^ self		realizeIn: parentWindow		bounds: ((bounds ifNil: [ 0@0 extent: anExtent ]) origin extent: anExtent)]{ #category : 'accessing' }SpWin32FrameContainer >> removeChildWidget: aWidget [	child == aWidget ifFalse: [ ^ self ].	self destroyChild.	self requestRelayout]{ #category : 'geometry' }SpWin32FrameContainer >> requestRelayout [	layoutOwner		ifNotNil: [ :owner | owner requestRelayout ]		ifNil: [			(parentWindow notNil and: [ bounds notNil ]) ifTrue: [				self realizeIn: parentWindow bounds: bounds ] ]]