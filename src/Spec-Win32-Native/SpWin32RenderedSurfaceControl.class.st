Class {	#name : 'SpWin32RenderedSurfaceControl',	#superclass : 'SpWin32NativeControl',	#instVars : [		'extentChangedAction'	],	#category : 'Spec-Win32-Native-Images',	#package : 'Spec-Win32-Native',	#tag : 'Images'}{ #category : 'instance creation' }SpWin32RenderedSurfaceControl class >> runtime: aRuntime preferredExtent: anExtent extentChangedAction: aBlock [	^ self new		runtime: aRuntime;		kind: aRuntime class controlImage;		text: '';		preferredExtent: anExtent;		extentChangedAction: aBlock;		imageAutoScale: false;		yourself]{ #category : 'accessing' }SpWin32RenderedSurfaceControl >> extentChangedAction: aBlock [	extentChangedAction := aBlock]{ #category : 'geometry' }SpWin32RenderedSurfaceControl >> refreshPreferredExtentIn: aNativeWindow [	"Rendered surfaces own their preferred drawing extent. Native STATIC image	measurement would otherwise replace it with Image's generic 64@64 default."	^ preferredExtent]{ #category : 'lifecycle' }SpWin32RenderedSurfaceControl >> realizeIn: aNativeWindow bounds: aRectangle [	| oldExtent newExtent |	oldExtent := bounds ifNil: [ 0 @ 0 ] ifNotNil: [ bounds extent ].	newExtent := aRectangle extent.	super realizeIn: aNativeWindow bounds: aRectangle.	oldExtent = newExtent ifFalse: [		extentChangedAction ifNotNil: [ :action | action value: newExtent ] ]]