Class {	#name : 'SpWin32PanedContainer',	#superclass : 'SpWin32NativeControl',	#instVars : [		'layout',		'firstChild',		'secondChild',		'firstConstraints',		'secondConstraints',		'firstContentControl',		'secondContentControl',		'currentPosition',		'firstNaturalExtent',		'secondNaturalExtent'	],	#category : 'Spec-Win32-Native-Layout',	#package : 'Spec-Win32-Native',	#tag : 'Layout'}{ #category : 'instance creation' }SpWin32PanedContainer class >> layout: aLayout runtime: aRuntime [	^ self new		runtime: aRuntime;		kind: aRuntime class controlPaned;		text: '';		preferredExtent: 100@100;		layout: aLayout;		yourself]{ #category : 'accessing' }SpWin32PanedContainer >> child: aWidget at: anInteger constraints: constraints [	anInteger = 1 ifTrue: [		firstChild == aWidget ifTrue: [ ^ self ].		firstChild ifNotNil: [ self destroyChild: firstChild ].		firstChild := aWidget.		firstConstraints := constraints ].	anInteger = 2 ifTrue: [		secondChild == aWidget ifTrue: [ ^ self ].		secondChild ifNotNil: [ self destroyChild: secondChild ].		secondChild := aWidget.		secondConstraints := constraints ].	(anInteger between: 1 and: 2) ifFalse: [ self error: 'Paned child position must be 1 or 2.' ].	aWidget ifNotNil: [		(aWidget respondsTo: #layoutOwner:) ifTrue: [ aWidget layoutOwner: self ] ].	self requestRelayout]{ #category : 'accessing' }SpWin32PanedContainer >> children [	^ { firstChild. secondChild } reject: #isNil]{ #category : 'lifecycle' }SpWin32PanedContainer >> destroy [	firstContentControl := nil.	secondContentControl := nil.	firstChild := nil.	secondChild := nil.	super destroy]{ #category : 'private - lifecycle' }SpWin32PanedContainer >> destroyChild: aWidget [	(aWidget respondsTo: #destroy) ifTrue: [ aWidget destroy ]]{ #category : 'private - lifecycle' }SpWin32PanedContainer >> ensureContentControls [	firstContentControl ifNil: [		firstContentControl := SpWin32NativeControl			runtime: runtime			kind: runtime class controlPanedContent			text: ''			preferredExtent: 1@1 ].	secondContentControl ifNil: [		secondContentControl := SpWin32NativeControl			runtime: runtime			kind: runtime class controlPanedContent			text: ''			preferredExtent: 1@1 ]]{ #category : 'accessing' }SpWin32PanedContainer >> firstChild [	^ firstChild]{ #category : 'private - geometry' }SpWin32PanedContainer >> firstMinimumMainExtent [	(firstChild isNil or: [ firstConstraints isNil or: [ firstConstraints canShrink ] ]) ifTrue: [ ^ 0 ].	^ self mainExtentOf: firstNaturalExtent]{ #category : 'initialization' }SpWin32PanedContainer >> initialize [	super initialize.	currentPosition := 0.	firstNaturalExtent := 0@0.	secondNaturalExtent := 0@0]{ #category : 'private - geometry' }SpWin32PanedContainer >> initialPositionForExtent: anExtent [	| position main |	position := layout positionOfSlider ifNil: [ 0.5 ].	main := self mainExtentOf: anExtent.	^ position < 1		ifTrue: [ (main * position) asInteger ]		ifFalse: [ position asInteger ]]{ #category : 'accessing' }SpWin32PanedContainer >> layout: aLayout [	layout := aLayout]{ #category : 'geometry' }SpWin32PanedContainer >> layoutIn: aRectangle collect: placements [	bounds := aRectangle.	placements add: { self. aRectangle left. aRectangle top. aRectangle width. aRectangle height }]{ #category : 'private - geometry' }SpWin32PanedContainer >> mainExtentOf: aPoint [	^ layout isHorizontal		ifTrue: [ aPoint x asInteger ]		ifFalse: [ aPoint y asInteger ]]{ #category : 'events' }SpWin32PanedContainer >> nativeEventType: eventType argument1: argument1 argument2: argument2 [	eventType = runtime class eventPanedPositionChanged ifTrue: [		currentPosition := argument1 asInteger.		self relayoutPaneChildren.		^ self ].	^ super nativeEventType: eventType argument1: argument1 argument2: argument2]{ #category : 'private - geometry' }SpWin32PanedContainer >> paneExtents [	| extent splitter secondMain |	extent := bounds ifNil: [ 1@1 ] ifNotNil: [ :rectangle | rectangle extent max: 1@1 ].	(firstChild isNil or: [ secondChild isNil ]) ifTrue: [		^ { extent. extent } ].	splitter := 6.	secondMain := ((self mainExtentOf: extent) - currentPosition - splitter) max: 1.	^ layout isHorizontal		ifTrue: [ { (currentPosition max: 1) @ extent y. secondMain @ extent y } ]		ifFalse: [ { extent x @ (currentPosition max: 1). extent x @ secondMain } ]]{ #category : 'geometry' }SpWin32PanedContainer >> preferredExtent [	(firstChild isNil and: [ secondChild isNil ]) ifTrue: [ ^ 0@0 ].	firstChild ifNil: [ ^ secondNaturalExtent ].	secondChild ifNil: [ ^ firstNaturalExtent ].	^ layout isHorizontal		ifTrue: [ (firstNaturalExtent x + secondNaturalExtent x + 6) @ (firstNaturalExtent y max: secondNaturalExtent y) ]		ifFalse: [ (firstNaturalExtent x max: secondNaturalExtent x) @ (firstNaturalExtent y + secondNaturalExtent y + 6) ]]{ #category : 'geometry' }SpWin32PanedContainer >> refreshPreferredExtentIn: aNativeParent [	firstNaturalExtent := self refreshPreferredExtentOf: firstChild in: aNativeParent.	secondNaturalExtent := self refreshPreferredExtentOf: secondChild in: aNativeParent.	preferredExtent := self preferredExtent.	^ preferredExtent]{ #category : 'private - geometry' }SpWin32PanedContainer >> refreshPreferredExtentOf: aChild in: aNativeParent [	aChild ifNil: [ ^ 0@0 ].	(aChild respondsTo: #refreshPreferredExtentIn:)		ifTrue: [ aChild refreshPreferredExtentIn: aNativeParent ]		ifFalse: [			(aChild respondsTo: #refreshPreferredExtentsIn:)				ifTrue: [ aChild refreshPreferredExtentsIn: aNativeParent ] ].	^ aChild preferredExtent]{ #category : 'lifecycle' }SpWin32PanedContainer >> realizeIn: aNativeParent bounds: aRectangle [	| extents initial |	super realizeIn: aNativeParent bounds: aRectangle.	runtime setControlBoundsBatch: { { self. aRectangle left. aRectangle top. aRectangle width. aRectangle height } }.	self ensureContentControls.	firstContentControl realizeIn: self bounds: (0@0 extent: 1@1).	secondContentControl realizeIn: self bounds: (0@0 extent: 1@1).	self refreshPreferredExtentIn: self.	initial := self initialPositionForExtent: aRectangle extent.	runtime		configurePaned: self		firstContent: firstContentControl		secondContent: secondContentControl		vertical: layout isVertical		initialPosition: initial		firstPresent: firstChild notNil		secondPresent: secondChild notNil		firstResize: (firstConstraints ifNil: [ true ] ifNotNil: [ firstConstraints canResize ])		secondResize: (secondConstraints ifNil: [ true ] ifNotNil: [ secondConstraints canResize ])		firstMin: self firstMinimumMainExtent		secondMin: self secondMinimumMainExtent.	currentPosition := runtime panedPositionOf: self.	extents := self paneExtents.	self realizeChild: firstChild inContent: firstContentControl extent: extents first.	self realizeChild: secondChild inContent: secondContentControl extent: extents second]{ #category : 'private - lifecycle' }SpWin32PanedContainer >> realizeChild: aChild inContent: aContent extent: anExtent [	| rectangle |	aChild ifNil: [ ^ self ].	rectangle := 0@0 extent: (anExtent max: 1@1).	(aChild respondsTo: #realizeIn:rectangle:)		ifTrue: [ aChild realizeIn: aContent rectangle: rectangle ]		ifFalse: [			aChild realizeIn: aContent bounds: rectangle.			runtime setControlBoundsBatch: { { aChild. 0. 0. rectangle width. rectangle height } } ]]{ #category : 'geometry' }SpWin32PanedContainer >> relayoutPaneChildren [	| extents |	(firstContentControl isNil or: [ secondContentControl isNil ]) ifTrue: [ ^ self ].	extents := self paneExtents.	self realizeChild: firstChild inContent: firstContentControl extent: extents first.	self realizeChild: secondChild inContent: secondContentControl extent: extents second]{ #category : 'accessing' }SpWin32PanedContainer >> removeAll [	firstChild ifNotNil: [ self destroyChild: firstChild ].	secondChild ifNotNil: [ self destroyChild: secondChild ].	firstChild := nil.	secondChild := nil.	firstConstraints := nil.	secondConstraints := nil.	self requestRelayout]{ #category : 'accessing' }SpWin32PanedContainer >> removeChildWidget: aWidget [	firstChild == aWidget ifTrue: [		self destroyChild: firstChild.		firstChild := nil.		firstConstraints := nil.		self requestRelayout.		^ self ].	secondChild == aWidget ifTrue: [		self destroyChild: secondChild.		secondChild := nil.		secondConstraints := nil.		self requestRelayout ]]{ #category : 'geometry' }SpWin32PanedContainer >> requestRelayout [	layoutOwner		ifNotNil: [ :owner | owner requestRelayout ]		ifNil: [			(parentWindow notNil and: [ bounds notNil ]) ifTrue: [				self realizeIn: parentWindow bounds: bounds ] ]]{ #category : 'private - geometry' }SpWin32PanedContainer >> secondMinimumMainExtent [	(secondChild isNil or: [ secondConstraints isNil or: [ secondConstraints canShrink ] ]) ifTrue: [ ^ 0 ].	^ self mainExtentOf: secondNaturalExtent]{ #category : 'accessing' }SpWin32PanedContainer >> secondChild [	^ secondChild]{ #category : 'lifecycle' }SpWin32PanedContainer >> realizeIn: aNativeParent extent: anExtent [	^ self realizeIn: aNativeParent bounds: (0@0 extent: anExtent)]{ #category : 'geometry' }SpWin32PanedContainer >> relayoutExtent: anExtent [	parentWindow ifNil: [ ^ self ].	^ self		realizeIn: parentWindow		bounds: ((bounds ifNil: [ 0@0 extent: anExtent ]) origin extent: anExtent)]