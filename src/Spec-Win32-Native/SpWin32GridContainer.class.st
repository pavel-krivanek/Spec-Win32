Class {	#name : 'SpWin32GridContainer',	#superclass : 'SpWin32LayoutContainer',	#instVars : [		'layout'	],	#category : 'Spec-Win32-Native-Layout',	#package : 'Spec-Win32-Native',	#tag : 'Layout'}{ #category : 'instance creation' }SpWin32GridContainer class >> layout: aLayout runtime: aRuntime [	^ self new		layout: aLayout;		runtime: aRuntime;		yourself]{ #category : 'private - geometry' }SpWin32GridContainer >> alignmentOffsetFor: extra alignment: anAlignment [	anAlignment == SpLayoutWidgetAlignment center ifTrue: [ ^ extra // 2 ].	anAlignment == SpLayoutWidgetAlignment end ifTrue: [ ^ extra ].	^ 0]{ #category : 'private - geometry' }SpWin32GridContainer >> columnCount [	| count |	count := 0.	children do: [ :entry |		| constraints |		constraints := entry second.		count := count max: constraints column + constraints columnSpan - 1 ].	^ count]{ #category : 'private - geometry' }SpWin32GridContainer >> columnWidths [	| count widths spacing |	count := self columnCount.	count = 0 ifTrue: [ ^ #() ].	spacing := layout columnSpacing asInteger max: 0.	widths := Array new: count withAll: 0.	children do: [ :entry |		| child constraints |		child := entry first.		constraints := entry second.		constraints columnSpan = 1 ifTrue: [			widths				at: constraints column				put: ((widths at: constraints column) max: child preferredExtent x asInteger) ] ].	children do: [ :entry |		| child constraints first last current deficit indices |		child := entry first.		constraints := entry second.		constraints columnSpan > 1 ifTrue: [			first := constraints column.			last := first + constraints columnSpan - 1.			indices := first to: last.			current := (indices sum: [ :index | widths at: index ])				+ (spacing * (constraints columnSpan - 1)).			deficit := child preferredExtent x asInteger - current.			deficit > 0 ifTrue: [				self distribute: deficit among: widths atIndices: indices ] ] ].	layout isColumnHomogeneous ifTrue: [ self homogenize: widths ].	^ widths]{ #category : 'private - geometry' }SpWin32GridContainer >> distribute: amount among: sizes atIndices: indices [	| quotient remainder |	indices isEmpty ifTrue: [ ^ self ].	quotient := amount // indices size.	remainder := amount \\ indices size.	indices withIndexDo: [ :index :position |		sizes			at: index			put: (sizes at: index) + quotient + (position <= remainder ifTrue: [ 1 ] ifFalse: [ 0 ]) ]]{ #category : 'private - geometry' }SpWin32GridContainer >> effectiveHAlignmentFor: constraints [	constraints hAlign ifNotNil: [ :alignment | ^ alignment ].	(layout columnConstraintsAt: constraints column) ifNotNil: [ :axis |		axis hAlign ifNotNil: [ :alignment | ^ alignment ] ].	(layout rowConstraintsAt: constraints row) ifNotNil: [ :axis |		axis hAlign ifNotNil: [ :alignment | ^ alignment ] ].	^ nil]{ #category : 'private - geometry' }SpWin32GridContainer >> effectiveVAlignmentFor: constraints [	constraints vAlign ifNotNil: [ :alignment | ^ alignment ].	(layout columnConstraintsAt: constraints column) ifNotNil: [ :axis |		axis vAlign ifNotNil: [ :alignment | ^ alignment ] ].	(layout rowConstraintsAt: constraints row) ifNotNil: [ :axis |		axis vAlign ifNotNil: [ :alignment | ^ alignment ] ].	^ nil]{ #category : 'private - geometry' }SpWin32GridContainer >> expandableColumnIndices [	^ (1 to: self columnCount) select: [ :index |		(layout columnConstraintsAt: index)			ifNil: [ false ]			ifNotNil: [ :constraints | constraints isExpand ] ]]{ #category : 'private - geometry' }SpWin32GridContainer >> expandableRowIndices [	^ (1 to: self rowCount) select: [ :index |		(layout rowConstraintsAt: index)			ifNil: [ false ]			ifNotNil: [ :constraints | constraints isExpand ] ]]{ #category : 'private - geometry' }SpWin32GridContainer >> fitSizes: preferredSizes available: available homogeneous: homogeneous expandIndices: expandIndices [	| sizes current extra allIndices |	preferredSizes isEmpty ifTrue: [ ^ preferredSizes ].	sizes := preferredSizes copy.	homogeneous ifTrue: [		| minimum each |		minimum := sizes max.		each := minimum max: (available // sizes size).		1 to: sizes size do: [ :index | sizes at: index put: each ].		^ sizes ].	current := sizes sum.	extra := available - current.	extra > 0 ifTrue: [		expandIndices isEmpty ifFalse: [			self distribute: extra among: sizes atIndices: expandIndices ] ].	^ sizes]{ #category : 'private - geometry' }SpWin32GridContainer >> homogenize: sizes [	| maximum |	sizes isEmpty ifTrue: [ ^ self ].	maximum := sizes max.	1 to: sizes size do: [ :index | sizes at: index put: maximum ]]{ #category : 'geometry' }SpWin32GridContainer >> layoutIn: aRectangle collect: placements [	| border columnSpacing rowSpacing innerOrigin innerExtent preferredColumns preferredRows columns rows columnAvailable rowAvailable columnPositions rowPositions |	lastExtent := aRectangle extent.	children isEmpty ifTrue: [ ^ self ].	border := layout borderWidth asInteger max: 0.	columnSpacing := layout columnSpacing asInteger max: 0.	rowSpacing := layout rowSpacing asInteger max: 0.	innerOrigin := aRectangle origin + (border @ border).	innerExtent := (aRectangle extent - ((border * 2) @ (border * 2))) max: 0@0.	preferredColumns := self columnWidths.	preferredRows := self rowHeights.	columnAvailable := (innerExtent x - (columnSpacing * ((preferredColumns size - 1) max: 0))) max: 0.	rowAvailable := (innerExtent y - (rowSpacing * ((preferredRows size - 1) max: 0))) max: 0.	columns := self		fitSizes: preferredColumns		available: columnAvailable		homogeneous: layout isColumnHomogeneous		expandIndices: self expandableColumnIndices.	rows := self		fitSizes: preferredRows		available: rowAvailable		homogeneous: layout isRowHomogeneous		expandIndices: self expandableRowIndices.	columnPositions := self positionsFor: columns spacing: columnSpacing.	rowPositions := self positionsFor: rows spacing: rowSpacing.	children do: [ :entry |		self			placeEntry: entry			innerOrigin: innerOrigin			columns: columns			rows: rows			columnPositions: columnPositions			rowPositions: rowPositions			columnSpacing: columnSpacing			rowSpacing: rowSpacing			collect: placements ]]{ #category : 'accessing' }SpWin32GridContainer >> layout: aLayout [	layout := aLayout]{ #category : 'private - geometry' }SpWin32GridContainer >> placeEntry: entry innerOrigin: innerOrigin columns: columns rows: rows columnPositions: columnPositions rowPositions: rowPositions columnSpacing: columnSpacing rowSpacing: rowSpacing collect: placements [	| child constraints firstColumn lastColumn firstRow lastRow cellX cellY cellWidth cellHeight hAlign vAlign preferred childWidth childHeight extraX extraY childOrigin childExtent |	child := entry first.	constraints := entry second.	firstColumn := constraints column.	lastColumn := firstColumn + constraints columnSpan - 1.	firstRow := constraints row.	lastRow := firstRow + constraints rowSpan - 1.	cellX := innerOrigin x + (columnPositions at: firstColumn).	cellY := innerOrigin y + (rowPositions at: firstRow).	cellWidth := ((firstColumn to: lastColumn) sum: [ :index | columns at: index ])		+ (columnSpacing * (constraints columnSpan - 1)).	cellHeight := ((firstRow to: lastRow) sum: [ :index | rows at: index ])		+ (rowSpacing * (constraints rowSpan - 1)).	hAlign := self effectiveHAlignmentFor: constraints.	vAlign := self effectiveVAlignmentFor: constraints.	preferred := child preferredExtent.	childWidth := hAlign		ifNil: [ cellWidth ]		ifNotNil: [ preferred x asInteger min: cellWidth ].	childHeight := vAlign		ifNil: [ cellHeight ]		ifNotNil: [ preferred y asInteger min: cellHeight ].	extraX := (cellWidth - childWidth) max: 0.	extraY := (cellHeight - childHeight) max: 0.	childOrigin :=		(cellX + (self alignmentOffsetFor: extraX alignment: hAlign))		@		(cellY + (self alignmentOffsetFor: extraY alignment: vAlign)).	childExtent := (childWidth max: 1) @ (childHeight max: 1).	(child respondsTo: #layoutIn:collect:)		ifTrue: [ child layoutIn: (childOrigin extent: childExtent) collect: placements ]		ifFalse: [			placements add: {				child.				childOrigin x.				childOrigin y.				childExtent x.				childExtent y } ]]{ #category : 'private - geometry' }SpWin32GridContainer >> positionsFor: sizes spacing: spacing [	| positions cursor |	positions := Array new: sizes size.	cursor := 0.	1 to: sizes size do: [ :index |		positions at: index put: cursor.		cursor := cursor + (sizes at: index) + spacing ].	^ positions]{ #category : 'accessing' }SpWin32GridContainer >> preferredExtent [	| columns rows border width height |	children isEmpty ifTrue: [ ^ 0@0 ].	columns := self columnWidths.	rows := self rowHeights.	border := layout borderWidth asInteger max: 0.	width := columns sum		+ ((layout columnSpacing asInteger max: 0) * ((columns size - 1) max: 0))		+ (border * 2).	height := rows sum		+ ((layout rowSpacing asInteger max: 0) * ((rows size - 1) max: 0))		+ (border * 2).	^ width @ height]{ #category : 'private - geometry' }SpWin32GridContainer >> rowCount [	| count |	count := 0.	children do: [ :entry |		| constraints |		constraints := entry second.		count := count max: constraints row + constraints rowSpan - 1 ].	^ count]{ #category : 'private - geometry' }SpWin32GridContainer >> rowHeights [	| count heights spacing |	count := self rowCount.	count = 0 ifTrue: [ ^ #() ].	spacing := layout rowSpacing asInteger max: 0.	heights := Array new: count withAll: 0.	children do: [ :entry |		| child constraints |		child := entry first.		constraints := entry second.		constraints rowSpan = 1 ifTrue: [			heights				at: constraints row				put: ((heights at: constraints row) max: child preferredExtent y asInteger) ] ].	children do: [ :entry |		| child constraints first last current deficit indices |		child := entry first.		constraints := entry second.		constraints rowSpan > 1 ifTrue: [			first := constraints row.			last := first + constraints rowSpan - 1.			indices := first to: last.			current := (indices sum: [ :index | heights at: index ])				+ (spacing * (constraints rowSpan - 1)).			deficit := child preferredExtent y asInteger - current.			deficit > 0 ifTrue: [				self distribute: deficit among: heights atIndices: indices ] ] ].	layout isRowHomogeneous ifTrue: [ self homogenize: heights ].	^ heights]