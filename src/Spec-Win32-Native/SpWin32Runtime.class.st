h signedLongAt: 1) max: 1) @ ((height signedLongAt: 1) max: 1)	] ensure: [		x free.		y free.		width free.		height free ]]{ #category : 'private - ffi' }SpWin32Runtime >> primNotebookGetContentRect: notebookId x: x y: y width: width height: height [	^ self		ffiCall: #(int32 spw_notebook_get_content_rect(uint64 notebookId, void * x, void * y, void * width, void * height))		library: SpWin32RuntimeLibrary]{ #category : 'controls' }SpWin32Runtime >> destroyControl: aNativeControl [	| status |	status := self primControlDestroy: aNativeControl objectId.	(status = -3) ifTrue: [		aNativeControl markDestroyed.		self unregisterObjectId: aNativeControl objectId.		^ self ].	self checkStatus: status operation: 'spw_control_destroy']{ #category : 'controls' }SpWin32Runtime >> focusControl: aNativeControl [	self		checkStatus: (self primControlSetFocus: aNativeControl objectId)		operation: 'spw_control_set_focus']{ #category : 'controls' }SpWin32Runtime >> realizeControl: aNativeControl inWindow: aNativeWindow bounds: aRectangle [	| outId status objectId |	outId := ExternalAddress allocate: 8.	[		outId unsignedLongLongAt: 1 put: 0.		self withUtf8String: aNativeControl measurementText do: [ :utf8 :length |			status := self				primControlCreateKind: aNativeControl kind				parentId: aNativeWindow objectId				text: utf8				length: length				x: aRectangle left asInteger				y: aRectangle top asInteger				width: (aRectangle width max: 1) asInteger				height: (aRectangle height max: 1) asInteger				outId: outId ].		self checkStatus: status operation: 'spw_control_create'.		objectId := outId unsignedLongLongAt: 1	] ensure: [ outId free ].	aNativeControl objectId: objectId.	self registerObject: aNativeControl]{ #category : 'controls' }SpWin32Runtime >> setControl: aNativeControl enabled: aBoolean [	self		checkStatus: (self primControlSetEnabled: aNativeControl objectId enabled: (aBoolean ifTrue: [ 1 ] ifFalse: [ 0 ]))		operation: 's