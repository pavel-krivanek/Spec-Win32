 #category : 'private - ffi' }SpWin32Runtime >> primPopupWindowCreateOwner: ownerId x: x y: y width: width height: height autohide: autohide outId: outId [	^ self		ffiCall: #(int32 spw_popup_window_create(uint64 ownerId, int32 x, int32 y, int32 width, int32 height, int32 autohide, void * outId))		library: SpWin32RuntimeLibrary]{ #category : 'controls - scrolling' }SpWin32Runtime >> configureScrollViewport: aViewport content: aContent extent: anExtent horizontal: horizontalEnabled vertical: verticalEnabled [	self		checkStatus: (self			primScrollViewConfigure: aViewport objectId			contentId: aContent objectId			width: (anExtent x max: 1) asInteger			height: (anExtent y max: 1) asInteger			horizontal: (horizontalEnabled ifTrue: [ 1 ] ifFalse: [ 0 ])			vertical: (verticalEnabled ifTrue: [ 1 ] ifFalse: [ 0 ]))		operation: 'spw_scroll_view_configure']{ #category : 'controls - scrolling' }SpWin32Runtime >> configureScrollViewport: aViewport content: aContent extent: anExtent horizontalPolicy: horizontalPolicy verticalPolicy: verticalPolicy [	self		checkStatus: (self			primScrollViewConfigurePolicies: aViewport objectId			contentId: aContent objectId			width: (anExtent x max: 1) asInteger			height: (anExtent y max: 1) asInteger			horizontalPolicy: horizontalPolicy asInteger			verticalPolicy: verticalPolicy asInteger)		operation: 'spw_scroll_view_configure_policies']{ #category : 'controls - scrolling' }SpWin32Runtime >> scrollViewportPageExtent: aViewport [	| width height status |	width := ExternalAddress allocate: 4.	height := ExternalAddress allocate: 4.	[		status := self			primScrollViewGetPageExtent: aViewport objectId			width: width			height: height.		self checkStatus: status operation: 'spw_scroll_view_get_page_extent'.		^ (width signedLongAt: 1) @ (height signedLongAt: 1)	] ensure: [ width free. height free ]]{ #category : 'controls - scrolling' }SpWin32Runtime >> setScrollViewport: aViewport position: aPoint [	self	