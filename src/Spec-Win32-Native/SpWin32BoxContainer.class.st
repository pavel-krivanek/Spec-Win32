Class {	#name : 'SpWin32BoxContainer',	#superclass : 'SpWin32LayoutContainer',	#instVars : [		'layout'	],	#category : 'Spec-Win32-Native-Layout',	#package : 'Spec-Win32-Native',	#tag : 'Layout'}{ #category : 'instance creation' }SpWin32BoxContainer class >> layout: aLayout runtime: aRuntime [	^ self new layout: aLayout; runtime: aRuntime; yourself]{ #category : 'geometry' }SpWin32BoxContainer >> layoutIn: aRectangle collect: placements [	| border innerOrigin innerExtent count spacing mainAvailable crossAvailable fixed expandedCount homogeneousMain cursor startEntries endEntries placeEntry |	lastExtent := aRectangle extent.	border := layout borderWidth asInteger max: 0.	innerOrigin := aRectangle origin + (border @ border).	innerExtent := (aRectangle extent - ((border * 2) @ (border * 2))) max: 0@0.	count := children size.	count = 0 ifTrue: [ ^ self ].	spacing := layout spacing asInteger max: 0.	mainAvailable := (layout isHorizontal ifTrue: [ innerExtent x ] ifFalse: [ innerExtent y ]) - (spacing * (count - 1)).	crossAvailable := layout isHorizontal ifTrue: [ innerExtent y ] ifFalse: [ innerExtent x ].	mainAvailable := mainAvailable max: 0.	fixed := 0.	expandedCount := 0.	layout isHomogeneous ifFalse: [		children do: [ :entry | | constraints widget |			widget := entry first. constraints := entry second.			constraints isExpand				ifTrue: [ expandedCount := expandedCount + 1 ]				ifFalse: [ fixed := fixed + (self mainPreferredFor: widget constraints: constraints) + (constraints padding * 2) ] ] ].	homogeneousMain := layout isHomogeneous		ifTrue: [ mainAvailable // count ]		ifFalse: [ expandedCount > 0 ifTrue: [ ((mainAvailable - fixed) max: 0) // expandedCount ] ifFalse: [ 0 ] ].	startEntries := children select: [ :entry | entry second isPlacedAtStart ].	endEntries := children reject: [ :entry | entry second isPlacedAtStart ].	cursor := layout isHorizontal ifTrue: [ innerOrigin x ] ifFalse: [ innerOrigin y ].	placeEntry := [ :entry :atEnd | | widget constraints slotMain childMain pad childOrigin childExtent |		widget := entry first. constraints := entry second. pad := constraints padding asInteger max: 0.		slotMain := layout isHomogeneous			ifTrue: [ homogeneousMain ]			ifFalse: [ constraints isExpand				ifTrue: [ homogeneousMain ]				ifFalse: [ (self mainPreferredFor: widget constraints: constraints) + (pad * 2) ] ].		childMain := (constraints isExpand and: [ constraints isFill ])			ifTrue: [ (slotMain - (pad * 2)) max: 1 ]			ifFalse: [ (self mainPreferredFor: widget constraints: constraints) min: ((slotMain - (pad * 2)) max: 1) ].		atEnd			ifTrue: [				cursor := cursor - slotMain.				layout isHorizontal					ifTrue: [ childOrigin := (cursor + pad) @ innerOrigin y ]					ifFalse: [ childOrigin := innerOrigin x @ (cursor + pad) ].				cursor := cursor - spacing ]			ifFalse: [				layout isHorizontal					ifTrue: [ childOrigin := (cursor + pad) @ innerOrigin y ]					ifFalse: [ childOrigin := innerOrigin x @ (cursor + pad) ].				cursor := cursor + slotMain + spacing ].		childExtent := layout isHorizontal			ifTrue: [ childMain @ (crossAvailable max: 1) ]			ifFalse: [ (crossAvailable max: 1) @ childMain ].		(widget respondsTo: #layoutIn:collect:)			ifTrue: [ widget layoutIn: (childOrigin extent: childExtent) collect: placements ]			ifFalse: [ placements add: { widget. childOrigin x. childOrigin y. childExtent x. childExtent y } ] ].	startEntries do: [ :entry | placeEntry value: entry value: false ].	cursor := (layout isHorizontal ifTrue: [ innerOrigin x + innerExtent x ] ifFalse: [ innerOrigin y + innerExtent y ]).	endEntries reverseDo: [ :entry | placeEntry value: entry value: true ]]{ #category : 'private' }SpWin32BoxContainer >> mainPreferredFor: widget constraints: constraints [	layout isHorizontal ifTrue: [		constraints width ifNotNil: [ :value | ^ value asInteger ].		^ widget preferredExtent x asInteger ].	constraints height ifNotNil: [ :value | ^ value asInteger ].	^ widget preferredExtent y asInteger]{ #category : 'accessing' }SpWin32BoxContainer >> preferredExtent [	| border spacing main cross |	children ifEmpty: [ ^ 0@0 ].	border := layout borderWidth asInteger max: 0.	spacing := layout spacing asInteger max: 0.	main := 0. cross := 0.	children do: [ :entry | | child constraints extent childMain childCross |		child := entry first. constraints := entry second. extent := child preferredExtent.		childMain := self mainPreferredFor: child constraints: constraints.		childCross := layout isHorizontal ifTrue: [ extent y ] ifFalse: [ extent x ].		main := main + childMain + (constraints padding * 2).		cross := cross max: childCross ].	main := main + (spacing * (children size - 1)) + (border * 2).	cross := cross + (border * 2).	^ layout isHorizontal ifTrue: [ main@cross ] ifFalse: [ cross@main ]]{ #category : 'accessing' }SpWin32BoxContainer >> layout: aLayout [ layout := aLayout ]