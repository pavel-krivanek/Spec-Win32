Class {	#name : 'SpWin32GenericEventTest',	#superclass : 'TestCase',	#category : 'Spec-Win32-Tests-Events',	#package : 'Spec-Win32-Tests',	#tag : 'Events'}{ #category : 'running' }SpWin32GenericEventTest >> tearDown [	SpWin32DeferredDispatcher resetDefault.	super tearDown]{ #category : 'tests' }SpWin32GenericEventTest >> testKeyDownTravelsFromNativeControlToPresenterEventHandler [	| presenter adapter received |	presenter := SpTextInputFieldPresenter new.	presenter eventHandler whenKeyDownDo: [ :event | received := event ].	adapter := SpWin32TextInputFieldAdapter adapt: presenter.	adapter widget		nativeEventType: SpWin32Runtime eventKeyDown		argument1: 16r41		argument2: 0.	self assert: received class equals: SpWin32KeyEvent.	self assert: received keyValue equals: 16r41.	self assert: received keyCharacter equals: $a.	self deny: received anyModifierKeyPressed]{ #category : 'tests' }SpWin32GenericEventTest >> testKeyEventModifierSemanticsAllowShiftOnlyTyping [	| event |	event := SpWin32KeyEvent keyValue: 16r41 modifiers: 1.	self assert: event shiftPressed.	self deny: event anyModifierKeyPressed.	self assert: event keyCharacter equals: $A.	event := SpWin32KeyEvent keyValue: 16r41 modifiers: 3.	self assert: event controlPressed.	self assert: event anyModifierKeyPressed]{ #category : 'tests' }SpWin32GenericEventTest >> testMouseDownUnpacksPositionButtonAndModifiers [	| presenter adapter received flags packed |	presenter := SpButtonPresenter new.	presenter eventHandler whenMouseDownDo: [ :event | received := event ].	adapter := SpWin32ButtonAdapter adapt: presenter.	flags := 1 bitOr: (2 bitShift: 16).	packed := (flags bitShift: 32) bitOr: 27.	adapter widget		nativeEventType: SpWin32Runtime eventMouseDown		argument1: 14		argument2: packed.	self assert: received class equals: SpWin32MouseEvent.	self assert: received position equals: 14 @ 27.	self assert: received isSecondaryButton.	self assert: received shiftPressed]{ #category : 'tests' }SpWin32GenericEventTest >> testMouseEventRoutesAllGenericKinds [	| presenter adapter seen |	seen := OrderedCollection new.	presenter := SpButtonPresenter new.	presenter eventHandler		whenMouseUpDo: [ :event | seen add: #up ];		whenMouseMoveDo: [ :event | seen add: #move ];		whenMouseEnterDo: [ :event | seen add: #enter ];		whenMouseLeaveDo: [ :event | seen add: #leave ];		whenDoubleClickDo: [ :event | seen add: #double ].	adapter := SpWin32ButtonAdapter adapt: presenter.	adapter win32MouseEventType: SpWin32Runtime eventMouseUp position: 1@2 button: 1 modifiers: 0.	adapter win32MouseEventType: SpWin32Runtime eventMouseMove position: 2@3 button: 0 modifiers: 0.	adapter win32MouseEventType: SpWin32Runtime eventMouseEnter position: 2@3 button: 0 modifiers: 0.	adapter win32MouseEventType: SpWin32Runtime eventMouseLeave position: 2@3 button: 0 modifiers: 0.	adapter win32MouseEventType: SpWin32Runtime eventMouseDoubleClick position: 2@3 button: 1 modifiers: 0.	self assert: seen asArray equals: #( up move enter leave double )]{ #category : 'tests' }SpWin32GenericEventTest >> testEventRegisteredAfterAdapterBuildIsInstalled [	| presenter adapter received |	presenter := SpTextInputFieldPresenter new.	adapter := SpWin32TextInputFieldAdapter adapt: presenter.	presenter adapter: adapter.	presenter eventHandler whenKeyUpDo: [ :event | received := event ].	adapter win32KeyUpValue: 16r42 modifiers: 0.	self assert: received keyCharacter equals: $b]{ #category : 'tests' }SpWin32GenericEventTest >> testHandledFlagRoundTripsOnWin32Events [	| key mouse |	key := SpWin32KeyEvent keyValue: 16r41 modifiers: 0.	mouse := SpWin32MouseEvent position: 1@2 button: 1 modifiers: 0.	self deny: key wasHandled.	self deny: mouse wasHandled.	key wasHandled: true.	mouse wasHandled: true.	self assert: key wasHandled.	self assert: mouse wasHandled]{ #category : 'tests' }SpWin32GenericEventTest >> testBackendDefersInFifoOrder [	| backend order done |	backend := SpWin32Backend new.	order := OrderedCollection new.	done := Semaphore new.	backend defer: [ order add: 1 ].	backend defer: [ order add: 2. done signal ].	done waitTimeoutMilliseconds: 2000.	self assert: order asArray equals: #( 1 2 )]