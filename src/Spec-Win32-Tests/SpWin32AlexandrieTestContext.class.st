Class {	#name : 'SpWin32AlexandrieTestContext',	#superclass : 'Object',	#instVars : [		'surface'	],	#category : 'Spec-Win32-Tests-Support',	#package : 'Spec-Win32-Tests',	#tag : 'Support'}{ #category : 'instance creation' }SpWin32AlexandrieTestContext class >> on: aSurface [	^ self new surface: aSurface; yourself]{ #category : 'accessing' }SpWin32AlexandrieTestContext >> surface: aSurface [	surface := aSurface]{ #category : 'testing' }SpWin32AlexandrieTestContext >> fillHalfAlphaRed [	surface fillHalfAlphaRed]{ #category : 'testing' }SpWin32AlexandrieTestContext >> fillValidationPattern [	surface fillValidationPattern]