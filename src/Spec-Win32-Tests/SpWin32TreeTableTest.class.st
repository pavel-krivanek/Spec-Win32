Class {	#name : 'SpWin32TreeTableTest',	#superclass : 'TestCase',	#category : 'Spec-Win32-Tests-Controls',	#package : 'Spec-Win32-Tests',	#tag : 'Controls'}{ #category : 'private' }SpWin32TreeTableTest >> newApplication [	^ SpApplication new useBackend: #Win32]{ #category : 'private' }SpWin32TreeTableTest >> newPresenter [	| presenter |	presenter := SpTreeTablePresenter newApplication: self newApplication.	presenter		addColumn: ((SpStringTableColumn title: 'Name' evaluated: #key) width: 170; yourself);		addColumn: ((SpStringTableColumn title: 'Value' evaluated: #value) width: 70; yourself);		roots: { 'A' -> 1. 'B' -> 2 };		children: [ :item |			item key = 'A'				ifTrue: [ { 'A1' -> 11. 'A2' -> 12 } ]				ifFalse: [ item key = 'A1' ifTrue: [ { 'A11' -> 111 } ] ifFalse: [ #() ] ] ].	^ presenter]{ #category : 'tests' }SpWin32TreeTableTest >> testBindingResolvesTreeTableAdapter [	self assert: (SpWin32AdapterBindings new adapterClass: #TreeTableAdapter) equals: SpWin32TreeTableAdapter]{ #category : 'tests' }SpWin32TreeTableTest >> testInitialRowsAreRootsAndColumnsAreNativeTableColumns [	| adapter |	adapter := SpWin32TreeTableAdapter adapt: self newPresenter.	self assert: adapter widget rowCount equals: 2.	self assert: adapter widget columnCount equals: 2.	self assert: adapter widget columnTitles equals: #('Name' 'Value').	self assert: (adapter displayItems collect: #key) equals: #('A' 'B')]{ #category : 'tests' }SpWin32TreeTableTest >> testExpandAndCollapsePathChangesVisibleRows [	| adapter |	adapter := SpWin32TreeTableAdapter adapt: self newPresenter.	adapter expandPath: #(1).	self assert: (adapter displayItems collect: #key) equals: #('A' 'A1' 'A2' 'B').	self assert: (adapter isExpanded: #(1)).	adapter collapsePath: #(1).	self assert: (adapter displayItems collect: #key) equals: #('A' 'B').	self deny: (adapter isExpanded: #(1))]{ #category : 'tests' }SpWin32TreeTableTest >> testSelectionExpandsAncestorsAndUsesPath [	| presenter adapter |	presenter := self newPresenter.	adapter := SpWin32TreeTableAdapter adapt: presenter.	presenter selectPath: #(1 1 1).	self assert: adapter selectedItem key equals: 'A11'.	self assert: (adapter isExpanded: #(1)).	self assert: (adapter isExpanded: #(1 1)).	self assert: adapter widget selectedIndexes equals: #(3)]{ #category : 'tests' }SpWin32TreeTableTest >> testNativeRowSelectionMapsBackToTreePath [	| presenter adapter |	presenter := self newPresenter.	adapter := SpWin32TreeTableAdapter adapt: presenter.	adapter expandPath: #(1).	adapter win32ListSelectionChanged: #(3) changedIndex: 3 selected: true.	self assert: presenter selection selectedPath equals: #(1 2).	self assert: presenter selectedItem key equals: 'A2']{ #category : 'tests' }SpWin32TreeTableTest >> testMultipleSelectionMapsVisibleRowsToPaths [	| presenter adapter |	presenter := self newPresenter.	presenter beMultipleSelection.	adapter := SpWin32TreeTableAdapter adapt: presenter.	adapter expandPath: #(1).	adapter win32ListSelectionChanged: #(2 4) changedIndex: 4 selected: true.	self assert: presenter selection selectedPaths equals: #(#(1 1) #(2)).	self assert: adapter widget multipleSelection]{ #category : 'tests' }SpWin32TreeTableTest >> testHeadersAndResizableStateFollowPresenter [	| presenter adapter |	presenter := self newPresenter.	adapter := SpWin32TreeTableAdapter adapt: presenter.	self assert: adapter widget headersVisible.	self deny: adapter widget resizable.	presenter hideColumnHeaders.	self deny: adapter widget headersVisible.	presenter beResizable.	self assert: adapter widget resizable]{ #category : 'tests' }SpWin32TreeTableTest >> testColumnChangeRefreshesDefinitionAndCells [	| presenter adapter |	presenter := self newPresenter.	adapter := SpWin32TreeTableAdapter adapt: presenter.	presenter addColumn: (SpStringTableColumn title: 'Again' evaluated: #key).	self assert: adapter widget columnCount equals: 3.	self assert: adapter widget cellStrings size equals: 6]{ #category : 'tests' }SpWin32TreeTableTest >> testFirstColumnContainsTreeMarkersAndIndentation [	| adapter cells |	adapter := SpWin32TreeTableAdapter adapt: self newPresenter.	cells := adapter widget cellStrings.	self assert: (cells first beginsWith: '▶ ').	adapter expandPath: #(1).	cells := adapter widget cellStrings.	self assert: (cells first beginsWith: '▼ ').	self assert: ((cells at: 3) beginsWith: '  ▶ ')]{ #category : 'tests' }SpWin32TreeTableTest >> testExpandRootsAndCollapseAll [	| adapter |	adapter := SpWin32TreeTableAdapter adapt: self newPresenter.	adapter expandRoots.	self assert: (adapter isExpanded: #(1)).	self assert: (adapter isExpanded: #(2)).	adapter collapseAll.	self deny: (adapter isExpanded: #(1)).	self assert: adapter widget rowCount equals: 2]{ #category : 'tests' }SpWin32TreeTableTest >> testRootsChangeResetsExpansionAndRows [	| presenter adapter |	presenter := self newPresenter.	adapter := SpWin32TreeTableAdapter adapt: presenter.	adapter expandPath: #(1).	presenter roots: { 'X' -> 9 }.	self assert: adapter widget rowCount equals: 1.	self assert: adapter selectedItem equals: nil.	self deny: (adapter isExpanded: #(1))]{ #category : 'tests' }SpWin32TreeTableTest >> testSortableColumnSortsSiblingsWithoutChangingPaths [	| presenter adapter column |	presenter := self newPresenter.	column := presenter columns first.	column beSortable.	adapter := SpWin32TreeTableAdapter adapt: presenter.	adapter clickOnColumnHeaderAt: 1.	adapter clickOnColumnHeaderAt: 1.	self assert: (adapter displayItems collect: #key) equals: #('B' 'A').	adapter win32ListSelectionChanged: #(2) changedIndex: 2 selected: true.	self assert: presenter selection selectedPath equals: #(1).	self assert: presenter selectedItem key equals: 'A']{ #category : 'tests' }SpWin32TreeTableTest >> testActivationMapsVisibleRowToPath [	| presenter adapter activated |	presenter := self newPresenter.	activated := nil.	presenter whenActivatedDo: [ :selection | activated := selection selectedItem ].	adapter := SpWin32TreeTableAdapter adapt: presenter.	adapter expandPath: #(1).	adapter win32ActivatedAt: 3 source: 1.	self assert: activated key equals: 'A2']