Class {	#name : 'SpWin32MenuTest',	#superclass : 'TestCase',	#category : 'Spec-Win32-Tests-Menu',	#package : 'Spec-Win32-Tests',	#tag : 'Menu'}{ #category : 'private' }SpWin32MenuTest >> application [	^ SpApplication new		useBackend: #Win32;		yourself]{ #category : 'private' }SpWin32MenuTest >> iconExtent: anExtent color: aColor [	| form |	form := Form extent: anExtent depth: 32.	form fillColor: aColor.	^ form]{ #category : 'private' }SpWin32MenuTest >> menuWithNestedItem [	| menu submenu |	menu := SpMenuPresenter newApplication: self application.	submenu := SpMenuPresenter newApplication: menu application.	submenu addItem: [ :item | item name: 'Child'; action: [ ] ].	menu		addItem: [ :item |			item				name: 'Open';				icon: (self iconExtent: 12 @ 10 color: Color blue);				state: true;				action: [ ] ];		addGroup: [ :group |			group addItem: [ :item | item name: 'More'; subMenu: submenu ] ].	^ menu]{ #category : 'tests' }SpWin32MenuTest >> testAdapterBindingsResolveMenuFamily [	| bindings |	bindings := SpWin32AdapterBindings new.	self assert: (bindings adapterClass: #MenuAdapter) equals: SpWin32MenuAdapter.	self assert: (bindings adapterClass: #MenuItemAdapter) equals: SpWin32MenuItemAdapter.	self assert: (bindings adapterClass: #MenuGroupAdapter) equals: SpWin32MenuGroupAdapter.	self assert: (bindings adapterClass: #MenuBarAdapter) equals: SpWin32MenuBarAdapter.	self assert: (bindings adapterClass: #MenuButtonAdapter) equals: SpWin32MenuButtonAdapter.	self assert: (bindings adapterClass: #ToolbarMenuButtonAdapter) equals: SpWin32ToolbarMenuButtonAdapter]{ #category : 'tests' }SpWin32MenuTest >> testMenuBuilderPreservesGroupsStateIconsAndSubmenus [	| menu entries first separator submenu |	menu := self menuWithNestedItem.	entries := (SpWin32MenuBuilder for: menu) entriesForMenuPresenter: menu.	self assert: entries size equals: 3.	first := entries first.	separator := entries second.	submenu := entries third.	self assert: first label equals: 'Open'.	self assert: first enabled.	self assert: first checked.	self assert: first iconData extent equals: 12 @ 10.	self assert: separator separator.	self assert: submenu label equals: 'More'.	self assert: submenu children size equals: 1.	self assert: submenu children first label equals: 'Child']{ #category : 'tests' }SpWin32MenuTest >> testMenuItemAdapterTracksNameAndIcon [	| item adapter secondIcon |	item := SpMenuItemPresenter newApplication: self application.	item name: 'Before'.	adapter := SpWin32MenuItemAdapter adapt: item.	self assert: adapter widgetName equals: 'Before'.	secondIcon := self iconExtent: 9 @ 7 color: Color green.	item name: 'After'.	item icon: secondIcon.	self assert: adapter widgetName equals: 'After'.	self assert: adapter widgetIcon extent equals: 9 @ 7]{ #category : 'tests' }SpWin32MenuTest >> testDisabledMenuItemIsCapturedAtOpenTime [	| menu item entries |	menu := SpMenuPresenter newApplication: self application.	menu addItem: [ :each | item := each. each name: 'Disabled' ].	item enabled: false.	entries := (SpWin32MenuBuilder for: menu) entriesForMenuPresenter: menu.	self deny: entries first enabled.	item enabled: true.	entries := (SpWin32MenuBuilder for: menu) entriesForMenuPresenter: menu.	self assert: entries first enabled]{ #category : 'tests' }SpWin32MenuTest >> testActionBuilderPreservesEnablementAndCheckedState [	| group enabled checked entries |	enabled := false.	checked := true.	group := SpActionGroup new.	group addActionWith: [ :action |		action			name: 'State';			actionEnabled: [ enabled ];			state: checked;			action: [ ] ].	entries := (SpWin32MenuBuilder for: nil) entriesForActionGroup: group.	self assert: entries size equals: 1.	self deny: entries first enabled.	self assert: entries first checked.	enabled := true.	checked := false.	group entries first state: checked.	entries := (SpWin32MenuBuilder for: nil) entriesForActionGroup: group.	self assert: entries first enabled.	self deny: entries first checked]{ #category : 'tests' }SpWin32MenuTest >> testActionSubmenuGroupRemainsNested [	| root nested entries |	root := SpActionGroup new.	nested := SpActionGroup newName: 'Tools'.	nested beDisplayedAsSubMenu.	nested addActionWith: [ :action | action name: 'Inspect'; action: [ ] ].	root add: nested.	entries := (SpWin32MenuBuilder for: nil) entriesForActionGroup: root.	self assert: entries size equals: 1.	self assert: entries first label equals: 'Tools'.	self assert: entries first children size equals: 1.	self assert: entries first children first label equals: 'Inspect']{ #category : 'tests' }SpWin32MenuTest >> testDynamicActionGroupIsResolvedForEachBuild [	| root value entries |	value := 'One'.	root := SpActionGroup new.	root addDynamicGroupWith: [ :dynamic |		dynamic addActionWith: [ :action | action name: value; action: [ ] ] ].	entries := (SpWin32MenuBuilder for: nil) entriesForActionGroup: root.	self assert: entries first label equals: 'One'.	value := 'Two'.	entries := (SpWin32MenuBuilder for: nil) entriesForActionGroup: root.	self assert: entries first label equals: 'Two']{ #category : 'tests' }SpWin32MenuTest >> testToolbarMenuButtonUsesNativeButtonAndActions [	| toolbar button group |	toolbar := SpToolbarPresenter newApplication: self application.	group := SpActionGroup new.	group addActionWith: [ :action | action name: 'Run'; action: [ ] ].	button := SpToolbarMenuButtonPresenter new		label: 'More';		actions: group;		yourself.	toolbar addItem: button.	SpWin32ToolbarAdapter adapt: toolbar.	self assert: button adapter class equals: SpWin32ToolbarMenuButtonAdapter.	self assert: button adapter widget kind equals: SpWin32Runtime controlButton.	self assert: button adapter widget text equals: 'More'.	self assert: button adapter menuEntries first label equals: 'Run'.	self deny: button adapter widget contextMenuEnabled]{ #category : 'tests' }SpWin32MenuTest >> testRuntimeAbiAndRichMenuFlagsAreExplicit [	self assert: SpWin32Runtime abiVersion equals: 16r00290000.	self assert: SpWin32Runtime menuItemSeparatorFlag equals: 1.	self assert: SpWin32Runtime menuItemEnabledFlag equals: 2.	self assert: SpWin32Runtime menuItemCheckedFlag equals: 4.	self assert: SpWin32Runtime menuItemSubmenuFlag equals: 8]{ #category : 'tests' }SpWin32MenuTest >> testRuntimeFlattensSubmenuWithParentIndex [	| parent child flat |	parent := SpWin32MenuEntry new label: 'Parent'; yourself.	child := SpWin32MenuEntry new label: 'Child'; yourself.	parent addChild: child.	flat := SpWin32Runtime default flattenedMenuEntries: { parent }.	self assert: flat size equals: 2.	self assert: flat first second equals: 0.	self assert: flat second second equals: 1.	self assert: flat second first identicalTo: child]{ #category : 'tests - menu bar' }SpWin32MenuTest >> testMenuBarAdapterUsesSameHierarchyBuilder [	| menu adapter entries |	menu := SpMenuBarPresenter newApplication: self application.	menu addItem: [ :item | item name: 'File'; subMenu: self menuWithNestedItem ].	adapter := SpWin32MenuBarAdapter adapt: menu.	entries := adapter menuEntries.	self assert: entries size equals: 1.	self assert: entries first label equals: 'File'.	self assert: entries first children notEmpty]{ #category : 'tests - menu bar' }SpWin32MenuTest >> testMenuBarRefreshTracksObservableItemChanges [	| menu item adapter refreshCount |	refreshCount := 0.	menu := SpMenuBarPresenter newApplication: self application.	menu addItem: [ :each | item := each. each name: 'Before' ].	adapter := SpWin32MenuBarAdapter adapt: menu.	adapter whenMenuNeedsRefreshDo: [ refreshCount := refreshCount + 1 ].	item name: 'After'.	item enabled: false.	self assert: refreshCount equals: 2.	self assert: adapter menuEntries first label equals: 'After'.	self deny: adapter menuEntries first enabled]{ #category : 'tests - menu bar' }SpWin32MenuTest >> testWindowMenuCommandExecutesMappedEntry [	| window adapter executed entry |	executed := false.	window := SpWindowPresenter application: self application.	adapter := SpWin32WindowAdapter basicNew.	adapter instVarNamed: 'model' put: window.	entry := SpWin32MenuEntry new action: [ executed := true ]; yourself.	adapter instVarNamed: 'menuEntries' put: { entry }.	adapter win32MenuCommand: 1.	self assert: executed]{ #category : 'tests - menu button' }SpWin32MenuTest >> testMenuButtonUsesNativeButtonAndRichMenuBuilder [	| button menu adapter icon |	menu := SpMenuPresenter newApplication: self application.	menu addItem: [ :item | item name: 'Open'; action: [ ] ].	icon := self iconExtent: 10 @ 8 color: Color red.	button := SpMenuButtonPresenter newApplication: self application.	button label: 'More'; icon: icon; menu: menu.	adapter := SpWin32MenuButtonAdapter adapt: button.	self assert: adapter widget kind equals: SpWin32Runtime controlButton.	self assert: adapter widget text equals: 'More'.	self assert: adapter widget imageData extent equals: 10 @ 8.	self assert: adapter menuEntries first label equals: 'Open'.	self deny: adapter widget contextMenuEnabled]{ #category : 'tests - menu button' }SpWin32MenuTest >> testMenuButtonResolvesLazyMenuEveryTime [	| button adapter label builds |	label := 'First'.	builds := 0.	button := SpMenuButtonPresenter newApplication: self application.	button		label: 'Dynamic';		menu: [ | menu |			builds := builds + 1.			menu := SpMenuPresenter newApplication: button application.			menu addItem: [ :item | item name: label; action: [ ] ].			menu ].	adapter := SpWin32MenuButtonAdapter adapt: button.	self assert: adapter menuEntries first label equals: 'First'.	label := 'Second'.	self assert: adapter menuEntries first label equals: 'Second'.	self assert: builds equals: 2]{ #category : 'tests - menu button' }SpWin32MenuTest >> testMenuButtonTracksMenuReplacementAndButtonProperties [	| button first second adapter |	first := SpMenuPresenter newApplication: self application.	first addItem: [ :item | item name: 'One'; action: [ ] ].	second := SpMenuPresenter newApplication: self application.	second addItem: [ :item | item name: 'Two'; action: [ ] ].	button := SpMenuButtonPresenter newApplication: self application.	button label: 'Before'; help: 'Menu help'; menu: first.	adapter := SpWin32MenuButtonAdapter adapt: button.	self assert: adapter helpText equals: 'Menu help'.	self assert: adapter menuEntries first label equals: 'One'.	button label: 'After'.	button enabled: false.	button menu: second.	self assert: adapter widget text equals: 'After'.	self deny: adapter widget enabled.	self assert: adapter menuEntries first label equals: 'Two']