Class {	#name : 'SpWin32AlexandrieTestSurface',	#superclass : 'Object',	#instVars : [		'extent',		'data',		'stride',		'contextCount'	],	#category : 'Spec-Win32-Tests-Support',	#package : 'Spec-Win32-Tests',	#tag : 'Support'}{ #category : 'instance creation' }SpWin32AlexandrieTestSurface class >> extent: anExtent [	^ self new initializeExtent: anExtent]{ #category : 'initialization' }SpWin32AlexandrieTestSurface >> initializeExtent: anExtent [	extent := anExtent.	stride := extent x * 4.	data := ExternalAddress allocate: stride * extent y.	1 to: stride * extent y do: [ :index | data unsignedByteAt: index put: 0 ].	contextCount := 0.	^ self]{ #category : 'accessing' }SpWin32AlexandrieTestSurface >> data [	^ data]{ #category : 'accessing' }SpWin32AlexandrieTestSurface >> extent [	^ extent]{ #category : 'accessing' }SpWin32AlexandrieTestSurface >> width [	^ extent x]{ #category : 'accessing' }SpWin32AlexandrieTestSurface >> height [	^ extent y]{ #category : 'accessing' }SpWin32AlexandrieTestSurface >> stride [	^ stride]{ #category : 'testing' }SpWin32AlexandrieTestSurface >> flush []{ #category : 'drawing' }SpWin32AlexandrieTestSurface >> newContextDo: aBlock [	contextCount := contextCount + 1.	^ aBlock value: (SpWin32AlexandrieTestContext on: self)]{ #category : 'accessing' }SpWin32AlexandrieTestSurface >> contextCount [	^ contextCount]{ #category : 'private - testing' }SpWin32AlexandrieTestSurface >> fillHalfAlphaRed [	1 to: self width * self height do: [ :pixel |		| offset |		offset := ((pixel - 1) * 4) + 1.		data unsignedByteAt: offset put: 0.		data unsignedByteAt: offset + 1 put: 0.		data unsignedByteAt: offset + 2 put: 127.		data unsignedByteAt: offset + 3 put: 127 ]]{ #category : 'private - testing' }SpWin32AlexandrieTestSurface >> fillValidationPattern [	0 to: self height - 1 do: [ :y |		0 to: self width - 1 do: [ :x |			| offset red green blue |			offset := ((y * self width + x) * 4) + 1.			red := (x * 255 // (self width max: 1)) min: 255.			green := (y * 255 // (self height max: 1)) min: 255.			blue := ((x + y) * 127 // ((self width + self height) max: 1)) min: 127.			((x > (self width // 5) and: [ x < ((self width * 4) // 5) ]) and: [				y > (self height // 3) and: [ y < ((self height * 2) // 3) ] ]) ifTrue: [				red := 255. green := 190. blue := 20 ].			data unsignedByteAt: offset put: blue.			data unsignedByteAt: offset + 1 put: green.			data unsignedByteAt: offset + 2 put: red.			data unsignedByteAt: offset + 3 put: 255 ] ]]