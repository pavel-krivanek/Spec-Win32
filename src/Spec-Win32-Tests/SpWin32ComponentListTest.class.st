Class {	#name : 'SpWin32ComponentListTest',	#superclass : 'TestCase',	#instVars : [		'application'	],	#category : 'Spec-Win32-Tests-Collections',	#package : 'Spec-Win32-Tests',	#tag : 'Collections'}{ #category : 'running' }SpWin32ComponentListTest >> setUp [	super setUp.	application := SpApplication new useBackend: #Win32]{ #category : 'private' }SpWin32ComponentListTest >> newPresenterWithThreeLabels [	| presenter |	presenter := SpComponentListPresenter newApplication: application.	presenter presenters: {		(SpLabelPresenter newApplication: application) label: 'One'; yourself.		(SpLabelPresenter newApplication: application) label: 'Two'; yourself.		(SpLabelPresenter newApplication: application) label: 'Three'; yourself }.	^ presenter]{ #category : 'tests' }SpWin32ComponentListTest >> testAdapterBindingAndNativeKindsAreReserved [	self		assert: (SpWin32AdapterBindings new adapterClass: #ComponentListAdapter)		equals: SpWin32ComponentListAdapter.	self assert: SpWin32Runtime controlComponentRow equals: 29.	self assert: SpWin32Runtime eventScrollPositionChanged equals: 30.	self assert: SpWin32Runtime abiVersion equals: 16r00290000]{ #category : 'tests' }SpWin32ComponentListTest >> testEmptyPresenterHasNoChildren [	| presenter adapter |	presenter := SpComponentListPresenter newApplication: application.	adapter := SpWin32ComponentListAdapter adapt: presenter.	presenter adapter: adapter.	self assertEmpty: adapter children.	self assertEmpty: adapter widget rows]{ #category : 'tests' }SpWin32ComponentListTest >> testRowsContainActualPresenterWidgets [	| presenter button label adapter |	presenter := SpComponentListPresenter newApplication: application.	button := SpButtonPresenter newApplication: application.	button label: 'Run'.	label := SpLabelPresenter newApplication: application.	label label: 'Status'.	presenter presenters: { button. label }.	adapter := SpWin32ComponentListAdapter adapt: presenter.	presenter adapter: adapter.	self assert: adapter children first identicalTo: button adapter widget.	self assert: adapter children second identicalTo: label adapter widget.	self assert: adapter widget rows first child identicalTo: button adapter widget.	self assert: adapter widget rows first kind equals: SpWin32Runtime controlComponentRow]{ #category : 'tests' }SpWin32ComponentListTest >> testNestedPresenterRowKeepsExecutableSpecSubtree [	| list row label input button adapter rowWidget |	list := SpComponentListPresenter newApplication: application.	row := SpPresenter newApplication: application.	label := (SpLabelPresenter newApplication: application) label: 'Name'; yourself.	input := (SpTextInputFieldPresenter newApplication: application) text: 'Ada'; yourself.	button := (SpButtonPresenter newApplication: application) label: 'Edit'; yourself.	row layout: (SpBoxLayout newLeftToRight		add: label expand: false;		add: input;		add: button expand: false;		yourself).	list addPresenter: row.	adapter := SpWin32ComponentListAdapter adapt: list.	list adapter: adapter.	rowWidget := adapter children first.	self assert: rowWidget class equals: SpWin32BoxContainer.	self assert: rowWidget children equals: {		label adapter widget. input adapter widget. button adapter widget }.	self assert: input adapter widget kind equals: SpWin32Runtime controlTextInput.	self assert: button adapter widget kind equals: SpWin32Runtime controlButton]{ #category : 'tests' }SpWin32ComponentListTest >> testAddingPresenterPreservesExistingRowWidget [	| list first adapter original second |	list := SpComponentListPresenter newApplication: application.	first := (SpButtonPresenter newApplication: application) label: 'First'; yourself.	list addPresenter: first.	adapter := SpWin32ComponentListAdapter adapt: list.	list adapter: adapter.	original := first adapter widget.	second := (SpLabelPresenter newApplication: application) label: 'Second'; yourself.	list addPresenter: second.	self assert: adapter children size equals: 2.	self assert: adapter children first identicalTo: original.	self assert: adapter children second identicalTo: second adapter widget]{ #category : 'tests' }SpWin32ComponentListTest >> testReplacingPresentersRebuildsOnlyRemovedRows [	| list first second replacement adapter retained oldFirstWidget |	list := SpComponentListPresenter newApplication: application.	first := (SpLabelPresenter newApplication: application) label: 'First'; yourself.	second := (SpLabelPresenter newApplication: application) label: 'Second'; yourself.	list presenters: { first. second }.	adapter := SpWin32ComponentListAdapter adapt: list.	list adapter: adapter.	retained := second adapter widget.	oldFirstWidget := first adapter widget.	replacement := (SpButtonPresenter newApplication: application) label: 'Replacement'; yourself.	list presenters: { second. replacement }.	self assert: adapter children first identicalTo: retained.	self assert: adapter children second identicalTo: replacement adapter widget.	self deny: (adapter children includes: oldFirstWidget).	self assert: first adapter isNil]{ #category : 'tests' }SpWin32ComponentListTest >> testProgrammaticSingleSelectionUpdatesRowHosts [	| presenter adapter |	presenter := self newPresenterWithThreeLabels.	adapter := SpWin32ComponentListAdapter adapt: presenter.	presenter adapter: adapter.	presenter selectIndex: 2.	self assert: adapter selectedIndexes asArray equals: #(2).	self deny: adapter widget rows first checked.	self assert: adapter widget rows second checked.	self deny: adapter widget rows third checked.	self assert: adapter selectedRowPresenter identicalTo: presenter presenters second]{ #category : 'tests' }SpWin32ComponentListTest >> testRowClickSelectsAndActivatesSingleSelection [	| presenter adapter activated |	presenter := self newPresenterWithThreeLabels.	activated := nil.	presenter activateOnSingleClick.	presenter whenActivatedDo: [ :selection | activated := selection selectedItem ].	adapter := SpWin32ComponentListAdapter adapt: presenter.	presenter adapter: adapter.	adapter rowClickedAt: 2 modifiers: 0.	self assert: presenter selection selectedIndex equals: 2.	self assert: activated identicalTo: presenter presenters second]{ #category : 'tests' }SpWin32ComponentListTest >> testMultipleSelectionSupportsControlAndShift [	| presenter adapter |	presenter := self newPresenterWithThreeLabels.	presenter beMultipleSelection.	adapter := SpWin32ComponentListAdapter adapt: presenter.	presenter adapter: adapter.	adapter rowClickedAt: 1 modifiers: 0.	adapter rowClickedAt: 3 modifiers: SpWin32Runtime modifierControl.	self assertCollection: presenter selection selectedIndexes asArray hasSameElements: #(1 3).	adapter rowClickedAt: 2 modifiers: SpWin32Runtime modifierShift.	self assert: presenter selection selectedIndexes asArray equals: #(2 3)]{ #category : 'tests' }SpWin32ComponentListTest >> testDoubleClickActivationHonorsPresenterPolicy [	| presenter adapter activated |	presenter := self newPresenterWithThreeLabels.	activated := nil.	presenter activateOnDoubleClick.	presenter whenActivatedDo: [ :selection | activated := selection selectedItem ].	adapter := SpWin32ComponentListAdapter adapt: presenter.	presenter adapter: adapter.	adapter rowActivatedAt: 3 source: 1.	self assert: activated identicalTo: presenter presenters third]{ #category : 'tests' }SpWin32ComponentListTest >> testPlainPresenterRowsAreSelectableByDefault [	| list label adapter |	list := SpComponentListPresenter newApplication: application.	label := (SpLabelPresenter newApplication: application) label: 'Selectable'; yourself.	list addPresenter: label.	adapter := SpWin32ComponentListAdapter adapt: list.	list adapter: adapter.	adapter rowClickedAt: 1 modifiers: 0.	self assert: list selection selectedIndex equals: 1]{ #category : 'tests' }SpWin32ComponentListTest >> testRowHostForwardsNativeClickModifiersWithoutFlatteningChild [	| presenter adapter row |	presenter := self newPresenterWithThreeLabels.	presenter beMultipleSelection.	adapter := SpWin32ComponentListAdapter adapt: presenter.	presenter adapter: adapter.	row := adapter widget rows second.	row nativeEventType: SpWin32Runtime eventClicked argument1: SpWin32Runtime modifierControl argument2: 0.	self assert: presenter selection selectedIndexes asArray equals: #(2)]{ #category : 'tests' }SpWin32ComponentListTest >> testContainerComputesScrollableContentExtent [    | presenter adapter extent |    presenter := self newPresenterWithThreeLabels.    adapter := SpWin32ComponentListAdapter adapt: presenter.    presenter adapter: adapter.    extent := adapter widget contentExtentForPage: 200@40.    self assert: extent equals: 200@86]