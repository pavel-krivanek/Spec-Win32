Class {	#name : 'SpWin32ActionManagerTest',	#superclass : 'TestCase',	#category : 'Spec-Win32-Tests-Actions',	#package : 'Spec-Win32-Tests',	#tag : 'Actions'}{ #category : 'tests' }SpWin32ActionManagerTest >> testControlShortcutExecutesActionAndMarksEventHandled [	| presenter adapter invoked event |	invoked := false.	presenter := SpButtonPresenter new.	presenter addShortcutWith: [ :action |		action shortcutKey: $k ctrl; action: [ invoked := true ] ].	adapter := SpWin32ButtonAdapter adapt: presenter.	event := SpWin32KeyEvent keyValue: 16r4B modifiers: 2.	adapter ensureActionManager handleKeyDown: event.	self assert: invoked.	self assert: event wasHandled]{ #category : 'tests' }SpWin32ActionManagerTest >> testShortcutRequiresExactModifiers [	| presenter adapter count |	count := 0.	presenter := SpButtonPresenter new.	presenter addShortcutWith: [ :action |		action shortcutKey: $k ctrl; action: [ count := count + 1 ] ].	adapter := SpWin32ButtonAdapter adapt: presenter.	adapter win32KeyDownValue: 16r4B modifiers: 0.	adapter win32KeyDownValue: 16r4B modifiers: 3.	self assert: count equals: 0.	adapter win32KeyDownValue: 16r4B modifiers: 2.	self assert: count equals: 1]{ #category : 'tests' }SpWin32ActionManagerTest >> testWindowsActionModifierUsesControlEvenWhenTestsRunOnUnix [	| matcher event |	matcher := SpWin32ShortcutMatcher new.	event := SpWin32KeyEvent keyValue: 16r41 modifiers: 2.	self assert: (matcher matches: $a actionModifier event: event).	self deny: (matcher matches: $a actionModifier event: (SpWin32KeyEvent keyValue: 16r41 modifiers: 8))]{ #category : 'tests' }SpWin32ActionManagerTest >> testChoiceShortcutMatchesEitherCombination [	| matcher shortcut |	matcher := SpWin32ShortcutMatcher new.	shortcut := $a ctrl | $b ctrl.	self assert: (matcher matches: shortcut event: (SpWin32KeyEvent keyValue: 16r42 modifiers: 2)).	self deny: (matcher matches: shortcut event: (SpWin32KeyEvent keyValue: 16r43 modifiers: 2))]{ #category : 'tests' }SpWin32ActionManagerTest >> testSpecialKeyboardKeyShortcutMatchesWindowsVirtualKey [	| matcher |	matcher := SpWin32ShortcutMatcher new.	self assert: (matcher		matches: KeyboardKey left asKeyCombination		event: (SpWin32KeyEvent keyValue: 16r25 modifiers: 0))]{ #category : 'tests' }SpWin32ActionManagerTest >> testDisabledActionDoesNotExecute [	| presenter adapter invoked event |	invoked := false.	presenter := SpButtonPresenter new.	presenter addShortcutWith: [ :action |		action			shortcutKey: $d ctrl;			actionEnabled: [ false ];			action: [ invoked := true ] ].	adapter := SpWin32ButtonAdapter adapt: presenter.	event := SpWin32KeyEvent keyValue: 16r44 modifiers: 2.	adapter ensureActionManager handleKeyDown: event.	self deny: invoked.	self deny: event wasHandled]{ #category : 'tests' }SpWin32ActionManagerTest >> testStatefulActionTogglesBeforeExecution [	| presenter adapter stateSeen action |	presenter := SpButtonPresenter new.	action := SpAction newShortcutKey: $t ctrl action: [ :context :executedAction |		stateSeen := executedAction state ].	action state: false.	presenter addAction: action.	adapter := SpWin32ButtonAdapter adapt: presenter.	adapter win32KeyDownValue: 16r54 modifiers: 2.	self assert: action state.	self assert: stateSeen]{ #category : 'tests' }SpWin32ActionManagerTest >> testParentPresenterShortcutExecutesWhenChildHasFocus [	| application parent child layout invoked |	application := SpApplication new useBackend: #Win32.	parent := SpPresenter newApplication: application.	child := SpTextInputFieldPresenter newApplication: application.	invoked := false.	parent addShortcutWith: [ :action |		action shortcutKey: $p ctrl; action: [ invoked := true ] ].	layout := SpBoxLayout newTopToBottom add: child; yourself.	parent layout: layout.	parent build.	child adapter win32KeyDownValue: 16r50 modifiers: 2.	self assert: invoked]{ #category : 'tests' }SpWin32ActionManagerTest >> testPresenterActionReplacementIsObservedWithoutRebuildingAdapter [	| presenter adapter first second |	first := 0.	second := 0.	presenter := SpButtonPresenter new.	presenter actionsWith: [ :group |		group addShortcutWith: [ :action |			action shortcutKey: $x ctrl; action: [ first := first + 1 ] ] ].	adapter := SpWin32ButtonAdapter adapt: presenter.	adapter win32KeyDownValue: 16r58 modifiers: 2.	presenter actionsWith: [ :group |		group addShortcutWith: [ :action |			action shortcutKey: $x ctrl; action: [ second := second + 1 ] ] ].	adapter win32KeyDownValue: 16r58 modifiers: 2.	self assert: first equals: 1.	self assert: second equals: 1]{ #category : 'tests' }SpWin32ActionManagerTest >> testParentAdapterAdditionalShortcutExecutesWhenChildHasFocus [	| application parent child layout invoked group |	application := SpApplication new useBackend: #Win32.	parent := SpPresenter newApplication: application.	child := SpTextInputFieldPresenter newApplication: application.	invoked := false.	layout := SpBoxLayout newTopToBottom add: child; yourself.	parent layout: layout.	parent build.	group := SpActionGroup new		addShortcutWith: [ :action |			action				shortcutKey: $g ctrl;				action: [ invoked := true ] ];		yourself.	parent adapter addActionGroup: group.	child adapter win32KeyDownValue: 16r47 modifiers: 2.	self assert: invoked]