Class {	#name : 'SpWin32StatusBarTest',	#superclass : 'TestCase',	#category : 'Spec-Win32-Tests-StatusBar',	#package : 'Spec-Win32-Tests',	#tag : 'StatusBar'}{ #category : 'private' }SpWin32StatusBarTest >> application [	^ SpApplication new useBackend: #Win32; yourself]{ #category : 'tests' }SpWin32StatusBarTest >> testAdapterBindingResolvesStatusBar [	self		assert: (SpWin32AdapterBindings new adapterClass: #StatusBarAdapter)		equals: SpWin32StatusBarAdapter]{ #category : 'tests' }SpWin32StatusBarTest >> testInitialMessageBuildsIntoNativeLabel [	| presenter adapter |	presenter := SpStatusBarPresenter newApplication: self application.	presenter pushMessage: 'Ready'.	adapter := SpWin32StatusBarAdapter adapt: presenter.	self assert: adapter widget kind equals: SpWin32Runtime controlLabel.	self assert: adapter widget text equals: 'Ready'.	self assert: adapter pushedMessageCount equals: 1]{ #category : 'tests' }SpWin32StatusBarTest >> testPushAndPopMaintainMessageStack [	| presenter adapter |	presenter := SpStatusBarPresenter newApplication: self application.	adapter := SpWin32StatusBarAdapter adapt: presenter.	presenter pushMessage: 'One'.	presenter pushMessage: 'Two'.	self assert: adapter widget text equals: 'Two'.	self assert: adapter pushedMessageCount equals: 2.	presenter popMessage.	self assert: adapter widget text equals: 'One'.	self assert: adapter pushedMessageCount equals: 1.	presenter popMessage.	self assert: adapter widget text equals: ''.	self assert: adapter pushedMessageCount equals: 0]{ #category : 'tests' }SpWin32StatusBarTest >> testWindowContentContainerPlacesStatusBarAfterContent [	| toolbar content statusbar composite placements |	toolbar := SpWin32ToolbarContainer runtime: nil.	content := SpWin32ToolbarContainer runtime: nil.	statusbar := SpWin32NativeControl runtime: nil kind: 1 text: 'status' preferredExtent: 100 @ 24.	composite := SpWin32WindowContentContainer		toolbar: toolbar		content: content		statusbar: statusbar		runtime: nil.	placements := OrderedCollection new.	composite layoutIn: (0@0 extent: 400@300) collect: placements.	self assert: composite children size equals: 3.	self assert: composite children last identicalTo: statusbar.	self assert: placements last first identicalTo: statusbar.	self assert: placements last third equals: 276.	self assert: placements last fifth equals: 24]{ #category : 'tests' }SpWin32StatusBarTest >> testWindowBuilderRecognizesStatusBarDecoration [	self assert: (SpWin32WindowAdapter canUnderstand: #buildWindowContentWithSpecLayout:).	self assert: SpWin32WindowContentContainer superclass equals: SpWin32LayoutContainer]