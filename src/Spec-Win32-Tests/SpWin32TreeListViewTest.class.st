Class {	#name : 'SpWin32TreeListViewTest',	#superclass : 'TestCase',	#category : 'Spec-Win32-Tests-ListView',	#package : 'Spec-Win32-Tests',	#tag : 'ListView'}{ #category : 'private' }SpWin32TreeListViewTest >> newApplication [ ^ SpApplication new useBackend: #Win32 ]{ #category : 'private' }SpWin32TreeListViewTest >> newPresenter [	| presenter |	presenter := SpTreeListViewPresenter newApplication: self newApplication.	presenter		roots: #( A B );		children: [ :each |			each = #A				ifTrue: [ #( A1 A2 ) ]				ifFalse: [ each = #A1 ifTrue: [ #( A11 ) ] ifFalse: [ #() ] ] ];		setup: [ :owner | owner newLabel ];		bind: [ :row :item | row label: 'node-', item asString ].	^ presenter]{ #category : 'tests' }SpWin32TreeListViewTest >> testBindingResolvesTreeListViewAdapter [	self assert: (SpWin32AdapterBindings new adapterClass: #TreeListViewAdapter) equals: SpWin32TreeListViewAdapter]{ #category : 'tests' }SpWin32TreeListViewTest >> testSetupBindSnapshotsAllTreeNodesWithParents [	| adapter |	adapter := SpWin32TreeListViewAdapter adapt: self newPresenter.	self assert: adapter widget treeLabels equals: #( 'node-A' 'node-A1' 'node-A11' 'node-A2' 'node-B' ).	self assert: adapter widget parentTokens equals: #( 0 1 2 1 0 ).	self assert: adapter rowPresenters size equals: 5]{ #category : 'tests' }SpWin32TreeListViewTest >> testProgrammaticExpansionAndSelectionUseTreePaths [	| presenter adapter |	presenter := self newPresenter.	adapter := SpWin32TreeListViewAdapter adapt: presenter.	adapter expandPath: #( 1 1 ).	self assert: (adapter isExpanded: #( 1 1 )).	presenter selectPath: #( 1 1 1 ).	self assert: adapter widget selectedToken equals: 3.	adapter collapsePath: #( 1 1 ).	self deny: (adapter isExpanded: #( 1 1 ))]{ #category : 'tests' }SpWin32TreeListViewTest >> testNativeSelectionAndActivationMapBackToPath [	| presenter adapter activated |	presenter := self newPresenter.	activated := nil.	presenter whenActivatedDo: [ :selection | activated := selection selectedItem ].	adapter := SpWin32TreeListViewAdapter adapt: presenter.	adapter win32TreeSelectionChangedToken: 4.	self assert: presenter selection selectedPath equals: #( 1 2 ).	self assert: presenter selectedItem equals: #A2.	adapter win32ActivatedAt: 4 source: 1.	self assert: activated equals: #A2]{ #category : 'tests' }SpWin32TreeListViewTest >> testNativeExpansionEventTracksAdapterState [	| adapter |	adapter := SpWin32TreeListViewAdapter adapt: self newPresenter.	adapter win32TreeExpansionChangedToken: 2 expanded: true.	self assert: (adapter isExpanded: #( 1 1 )).	self assert: (adapter elementAt: 2) equals: #A1.	adapter win32TreeExpansionChangedToken: 2 expanded: false.	self deny: (adapter isExpanded: #( 1 1 ))]{ #category : 'tests' }SpWin32TreeListViewTest >> testRefreshRebindsTextAndPreservesExpansion [	| presenter adapter prefix |	prefix := 'before-'.	presenter := self newPresenter.	presenter bind: [ :row :item | row label: prefix, item asString ].	adapter := SpWin32TreeListViewAdapter adapt: presenter.	presenter adapter: adapter.	adapter expandPath: #( 1 ).	prefix := 'after-'.	presenter refresh.	self assert: adapter widget treeLabels first equals: 'after-A'.	self assert: (adapter isExpanded: #( 1 ))]{ #category : 'tests' }SpWin32TreeListViewTest >> testImageRowsProduceNativeTreeImageData [	| presenter adapter form |	form := Form extent: 2 @ 2 depth: 32.	presenter := self newPresenter.	presenter		setup: [ :owner |			| row |			row := owner newPresenter.			row layout: (SpBoxLayout newHorizontal				add: row newImage expand: false;				add: row newLabel;				yourself).			row ];		bind: [ :row :item |			row layout children first image: form.			row layout children second label: item asString ].	adapter := SpWin32TreeListViewAdapter adapt: presenter.	self assert: adapter rowImages size equals: 5.	self assert: adapter widget treeImages size equals: 5.	self assert: adapter widget treeImages first width equals: 2.	self assert: adapter widget treeImages first height equals: 2]{ #category : 'tests' }SpWin32TreeListViewTest >> testUnsupportedInteractiveRowFailsExplicitly [	| presenter |	presenter := self newPresenter.	presenter		setup: [ :owner | owner newButton ];		bind: [ :row :item | row label: item asString ].	self should: [ SpWin32TreeListViewAdapter adapt: presenter ] raise: Error]{ #category : 'tests' }SpWin32TreeListViewTest >> testMultipleSelectionUsesLastSelectedPathAsNativeCaret [	| presenter adapter |	presenter := self newPresenter.	adapter := SpWin32TreeListViewAdapter adapt: presenter.	presenter beMultipleSelection.	presenter selectPaths: #( #( 1 ) #( 2 ) ).	self assert: presenter selection isMultipleSelection.	self assert: adapter widget selectedToken equals: 5]{ #category : 'tests' }SpWin32TreeListViewTest >> testRootsChangeRebuildsSnapshotsAndDropsExpansion [	| presenter adapter |	presenter := self newPresenter.	adapter := SpWin32TreeListViewAdapter adapt: presenter.	adapter expandPath: #( 1 ).	presenter roots: #( X ).	self assert: adapter widget treeLabels equals: #( 'node-X' ).	self deny: (adapter isExpanded: #( 1 ))]