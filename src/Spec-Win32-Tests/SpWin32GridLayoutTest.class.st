Class {	#name : 'SpWin32GridLayoutTest',	#superclass : 'TestCase',	#category : 'Spec-Win32-Tests-Layout',	#package : 'Spec-Win32-Tests',	#tag : 'Layout'}{ #category : 'private' }SpWin32GridLayoutTest >> controlExtent: anExtent [	^ SpWin32NativeControl		runtime: SpWin32Runtime new		kind: SpWin32Runtime controlLabel		text: ''		preferredExtent: anExtent]{ #category : 'private' }SpWin32GridLayoutTest >> newNonHomogeneousLayout [	^ SpGridLayout new		borderWidth: 0;		columnSpacing: 0;		rowSpacing: 0;		beColumnNotHomogeneous;		beRowNotHomogeneous;		yourself]{ #category : 'tests' }SpWin32GridLayoutTest >> testAdapterBindingResolvesGridAdapter [	self		assert: (SpWin32AdapterBindings new adapterClass: #GridAdapter)		equals: SpWin32GridAdapter]{ #category : 'tests' }SpWin32GridLayoutTest >> testBasicNonHomogeneousGridUsesPreferredTrackSizes [	| layout container first second third fourth placements |	layout := self newNonHomogeneousLayout.	container := SpWin32GridContainer layout: layout runtime: SpWin32Runtime new.	first := self controlExtent: 30@20.	second := self controlExtent: 60@24.	third := self controlExtent: 40@18.	fourth := self controlExtent: 50@22.	container addChild: first constraints: (SpGridConstraints at: 1@1).	container addChild: second constraints: (SpGridConstraints at: 2@1).	container addChild: third constraints: (SpGridConstraints at: 1@2).	container addChild: fourth constraints: (SpGridConstraints at: 2@2).	placements := OrderedCollection new.	container layoutIn: (0@0 extent: 200@100) collect: placements.	self assert: placements equals: {		{ first. 0. 0. 40. 24 }.		{ second. 40. 0. 60. 24 }.		{ third. 0. 24. 40. 22 }.		{ fourth. 40. 24. 60. 22 } } asOrderedCollection]{ #category : 'tests' }SpWin32GridLayoutTest >> testBorderAndSpacingAreIncludedInPlacement [	| layout container first second placements |	layout := self newNonHomogeneousLayout		borderWidth: 5;		columnSpacing: 7;		yourself.	container := SpWin32GridContainer layout: layout runtime: SpWin32Runtime new.	first := self controlExtent: 30@20.	second := self controlExtent: 40@20.	container addChild: first constraints: (SpGridConstraints at: 1@1).	container addChild: second constraints: (SpGridConstraints at: 2@1).	placements := OrderedCollection new.	container layoutIn: (0@0 extent: 200@80) collect: placements.	self assert: placements first equals: { first. 5. 5. 30. 20 }.	self assert: placements second equals: { second. 42. 5. 40. 20 }]{ #category : 'tests' }SpWin32GridLayoutTest >> testColumnAndRowExpansionReceiveRemainingSpace [	| layout container first second third fourth placements |	layout := self newNonHomogeneousLayout.	layout column: 2 expand: true.	layout row: 2 expand: true.	container := SpWin32GridContainer layout: layout runtime: SpWin32Runtime new.	first := self controlExtent: 30@20.	second := self controlExtent: 60@24.	third := self controlExtent: 30@18.	fourth := self controlExtent: 60@22.	container addChild: first constraints: (SpGridConstraints at: 1@1).	container addChild: second constraints: (SpGridConstraints at: 2@1).	container addChild: third constraints: (SpGridConstraints at: 1@2).	container addChild: fourth constraints: (SpGridConstraints at: 2@2).	placements := OrderedCollection new.	container layoutIn: (0@0 extent: 200@100) collect: placements.	self assert: placements first equals: { first. 0. 0. 30. 24 }.	self assert: placements second equals: { second. 30. 0. 170. 24 }.	self assert: placements third equals: { third. 0. 24. 30. 76 }.	self assert: placements fourth equals: { fourth. 30. 24. 170. 76 }]{ #category : 'tests' }SpWin32GridLayoutTest >> testDefaultHomogeneousColumnsFillAvailableWidth [	| layout container first second placements |	layout := SpGridLayout new		borderWidth: 0;		columnSpacing: 0;		rowSpacing: 0;		beRowNotHomogeneous;		yourself.	container := SpWin32GridContainer layout: layout runtime: SpWin32Runtime new.	first := self controlExtent: 30@20.	second := self controlExtent: 60@20.	container addChild: first constraints: (SpGridConstraints at: 1@1).	container addChild: second constraints: (SpGridConstraints at: 2@1).	placements := OrderedCollection new.	container layoutIn: (0@0 extent: 200@60) collect: placements.	self assert: placements first equals: { first. 0. 0. 100. 20 }.	self assert: placements second equals: { second. 100. 0. 100. 20 }]{ #category : 'tests' }SpWin32GridLayoutTest >> testExplicitAlignmentUsesPreferredExtentInsideCell [	| layout container child constraints placements |	layout := SpGridLayout new		borderWidth: 0;		columnSpacing: 0;		rowSpacing: 0;		beColumnHomogeneous;		beRowHomogeneous;		yourself.	container := SpWin32GridContainer layout: layout runtime: SpWin32Runtime new.	child := self controlExtent: 50@20.	constraints := SpGridConstraints at: 1@1.	constraints hAlignCenter; vAlignEnd.	container addChild: child constraints: constraints.	placements := OrderedCollection new.	container layoutIn: (0@0 extent: 200@100) collect: placements.	self assert: placements first equals: { child. 75. 80. 50. 20 }]{ #category : 'tests' }SpWin32GridLayoutTest >> testAxisAlignmentIsAppliedWhenChildHasNoAlignment [	| layout container child placements |	layout := SpGridLayout new		borderWidth: 0;		columnSpacing: 0;		rowSpacing: 0;		beColumnHomogeneous;		beRowHomogeneous;		column: 1 withConstraints: [ :c | c hAlignEnd ];		row: 1 withConstraints: [ :c | c vAlignCenter ];		yourself.	container := SpWin32GridContainer layout: layout runtime: SpWin32Runtime new.	child := self controlExtent: 50@20.	container addChild: child constraints: (SpGridConstraints at: 1@1).	placements := OrderedCollection new.	container layoutIn: (0@0 extent: 200@100) collect: placements.	self assert: placements first equals: { child. 150. 40. 50. 20 }]{ #category : 'tests' }SpWin32GridLayoutTest >> testChildAlignmentOverridesAxisAlignment [	| layout container child constraints placements |	layout := SpGridLayout new		borderWidth: 0;		columnSpacing: 0;		rowSpacing: 0;		beColumnHomogeneous;		beRowHomogeneous;		column: 1 withConstraints: [ :c | c hAlignEnd ];		row: 1 withConstraints: [ :c | c vAlignEnd ];		yourself.	container := SpWin32GridContainer layout: layout runtime: SpWin32Runtime new.	child := self controlExtent: 50@20.	constraints := SpGridConstraints at: 1@1.	constraints hAlignStart; vAlignStart.	container addChild: child constraints: constraints.	placements := OrderedCollection new.	container layoutIn: (0@0 extent: 200@100) collect: placements.	self assert: placements first equals: { child. 0. 0. 50. 20 }]{ #category : 'tests' }SpWin32GridLayoutTest >> testSpanIncludesInternalSpacing [	| layout container child placements |	layout := self newNonHomogeneousLayout		columnSpacing: 10;		yourself.	container := SpWin32GridContainer layout: layout runtime: SpWin32Runtime new.	child := self controlExtent: 100@20.	container addChild: child constraints: (SpGridConstraints at: 1@1 span: 2@1).	placements := OrderedCollection new.	container layoutIn: (0@0 extent: 200@50) collect: placements.	self assert: placements first equals: { child. 0. 0. 100. 20 }.	self assert: container preferredExtent equals: 100@20]{ #category : 'tests' }SpWin32GridLayoutTest >> testPreferredExtentAccountsForTracksSpacingBorderAndSpan [	| layout container first second spanning |	layout := self newNonHomogeneousLayout		borderWidth: 5;		columnSpacing: 10;		rowSpacing: 4;		yourself.	container := SpWin32GridContainer layout: layout runtime: SpWin32Runtime new.	first := self controlExtent: 30@20.	second := self controlExtent: 40@25.	spanning := self controlExtent: 120@30.	container addChild: first constraints: (SpGridConstraints at: 1@1).	container addChild: second constraints: (SpGridConstraints at: 2@1).	container addChild: spanning constraints: (SpGridConstraints at: 1@2 span: 2@1).	self assert: container preferredExtent equals: 130@69]{ #category : 'tests' }SpWin32GridLayoutTest >> testNestedBoxLayoutIsFlattenedIntoNativePlacements [	| gridLayout grid boxLayout box first second placements |	gridLayout := self newNonHomogeneousLayout.	grid := SpWin32GridContainer layout: gridLayout runtime: SpWin32Runtime new.	boxLayout := SpBoxLayout newLeftToRight		borderWidth: 0;		spacing: 5;		yourself.	box := SpWin32BoxContainer layout: boxLayout runtime: SpWin32Runtime new.	first := self controlExtent: 20@20.	second := self controlExtent: 30@20.	box addChild: first constraints: (SpBoxConstraints new expand: false; yourself).	box addChild: second constraints: (SpBoxConstraints new expand: false; yourself).	grid addChild: box constraints: (SpGridConstraints at: 1@1).	placements := OrderedCollection new.	grid layoutIn: (0@0 extent: 100@40) collect: placements.	self assert: placements size equals: 2.	self assert: placements first equals: { first. 0. 0. 20. 20 }.	self assert: placements second equals: { second. 25. 0. 30. 20 }]{ #category : 'tests' }SpWin32GridLayoutTest >> testSpecBuildCreatesGridAdapterAndDynamicReplacement [	| application root first second replacement layout widget |	application := SpApplication new useBackend: #Win32.	root := SpPresenter newApplication: application.	first := SpLabelPresenter newApplication: application.	first label: 'Name'.	second := SpTextInputFieldPresenter newApplication: application.	layout := SpGridLayout new		borderWidth: 0;		add: first atPoint: 1@1;		add: second atPoint: 2@1;		yourself.	root layout: layout.	widget := root build.	self assert: root adapter class equals: SpWin32GridAdapter.	self assert: widget class equals: SpWin32GridContainer.	self assert: widget children equals: { first adapter widget. second adapter widget }.	replacement := SpButtonPresenter newApplication: application.	replacement label: 'Browse'.	layout replaceAtPoint: 2@1 with: replacement.	self assert: widget children equals: { first adapter widget. replacement adapter widget }]