Class {	#name : 'SpWin32ModernListViewTest',	#superclass : 'TestCase',	#category : 'Spec-Win32-Tests-ListView',	#package : 'Spec-Win32-Tests',	#tag : 'ListView'}{ #category : 'private' }SpWin32ModernListViewTest >> application [	^ SpApplication new useBackend: #Win32; yourself]{ #category : 'tests - dropdown' }SpWin32ModernListViewTest >> testDropDownAdapterBindingAndKind [	| presenter adapter |	presenter := SpDropDownPresenter newApplication: self application.	presenter items: #('Alpha' 'Beta' 'Gamma').	adapter := SpWin32DropDownAdapter adapt: presenter.	self assert: adapter class adaptingName equals: #DropDownAdapter.	self assert: adapter widget kind equals: SpWin32Runtime controlDropList.	self assert: adapter displayStrings equals: #('Alpha' 'Beta' 'Gamma')]{ #category : 'tests - dropdown' }SpWin32ModernListViewTest >> testDropDownSelectionSynchronizesBothWays [	| presenter adapter |	presenter := SpDropDownPresenter newApplication: self application.	presenter items: #('Alpha' 'Beta' 'Gamma').	adapter := SpWin32DropDownAdapter adapt: presenter.	presenter adapter: adapter.	presenter selectIndex: 2.	self assert: adapter widget selectedIndex equals: 2.	adapter win32SelectionChanged: 3.	self assert: presenter selectedIndex equals: 3.	self assert: presenter selectedItem equals: 'Gamma']{ #category : 'tests - dropdown' }SpWin32ModernListViewTest >> testDropDownRefreshesBoundLabelRows [	| presenter adapter |	presenter := SpDropDownPresenter newApplication: self application.	presenter		setup: [ :builder | builder newLabel ];		bind: [ :label :association | label label: association key, '=', association value asString ];		items: { 'A' -> 1. 'B' -> 2 }.	adapter := SpWin32DropDownAdapter adapt: presenter.	presenter adapter: adapter.	self assert: adapter displayStrings equals: #('A=1' 'B=2').	presenter items: { 'C' -> 3 }.	self assert: adapter displayStrings equals: #('C=3')]{ #category : 'tests - listview' }SpWin32ModernListViewTest >> testListViewAdapterBindingAndKind [	| presenter adapter |	presenter := SpListViewPresenter newApplication: self application.	presenter items: #('One' 'Two' 'Three').	adapter := SpWin32ListViewAdapter adapt: presenter.	self assert: adapter class adaptingName equals: #ListViewAdapter.	self assert: adapter widget kind equals: SpWin32Runtime controlList.	self assert: adapter displayStrings equals: #('One' 'Two' 'Three')]{ #category : 'tests - listview' }SpWin32ModernListViewTest >> testListViewCustomLabelBindingIsFlattened [	| presenter adapter |	presenter := SpListViewPresenter newApplication: self application.	presenter		setup: [ :builder | builder newLabel ];		bind: [ :label :number | label label: 'Item ', number asString ];		items: #(10 20 30).	adapter := SpWin32ListViewAdapter adapt: presenter.	self assert: adapter displayStrings equals: #('Item 10' 'Item 20' 'Item 30').	self assert: adapter rowPresenters size equals: 3]{ #category : 'tests - listview' }SpWin32ModernListViewTest >> testListViewLabelImageCompositeIsFlattened [	| presenter adapter |	presenter := SpListViewPresenter newApplication: self application.	presenter		setup: [ :builder |			| row |			row := builder newPresenter.			row layout: (SpBoxLayout newLeftToRight				add: builder newImage expand: false;				add: builder newLabel;				yourself).			row ];		bind: [ :row :name | row layout children second label: name ];		items: #('Alpha' 'Beta').	adapter := SpWin32ListViewAdapter adapt: presenter.	self assert: adapter displayStrings equals: #('Alpha' 'Beta')]{ #category : 'tests - listview' }SpWin32ModernListViewTest >> testListViewRejectsInteractiveRowPresenter [	| presenter |	presenter := SpListViewPresenter newApplication: self application.	presenter		setup: [ :builder | builder newButton ];		bind: [ :button :name | button label: name ];		items: #('Alpha').	self		should: [ SpWin32ListViewAdapter adapt: presenter ]		raise: Error]{ #category : 'tests - listview' }SpWin32ModernListViewTest >> testListViewSelectionSynchronizesBothWays [	| presenter adapter |	presenter := SpListViewPresenter newApplication: self application.	presenter items: #('One' 'Two' 'Three').	adapter := SpWin32ListViewAdapter adapt: presenter.	presenter adapter: adapter.	presenter selectIndex: 2.	self assert: adapter widget selectedIndexes equals: #(2).	adapter win32ListSelectionChanged: #(3) changedIndex: 3 selected: true.	self assert: presenter selectedIndex equals: 3.	self assert: presenter selectedItem equals: 'Three']{ #category : 'tests - listview' }SpWin32ModernListViewTest >> testListViewMultipleSelectionSynchronizes [	| presenter adapter |	presenter := SpListViewPresenter newApplication: self application.	presenter beMultipleSelection; items: #('One' 'Two' 'Three').	adapter := SpWin32ListViewAdapter adapt: presenter.	presenter adapter: adapter.	presenter selectIndexes: #(1 3).	self assert: adapter widget selectedIndexes equals: #(1 3).	adapter win32ListSelectionChanged: #(2 3) changedIndex: 2 selected: true.	self assert: presenter selection selectedIndexes asArray equals: #(2 3)]{ #category : 'tests - listview' }SpWin32ModernListViewTest >> testListViewHeaderAndRefresh [	| presenter adapter |	presenter := SpListViewPresenter newApplication: self application.	presenter headerTitle: 'Modern list'; items: #('One' 'Two').	adapter := SpWin32ListViewAdapter adapt: presenter.	presenter adapter: adapter.	self assert: adapter widget headerText equals: 'Modern list'.	self assert: adapter widget headerVisible.	presenter items: #('Three').	self assert: adapter displayStrings equals: #('Three')]{ #category : 'tests - listview' }SpWin32ModernListViewTest >> testListViewActivationUsesModernPresenter [	| presenter adapter activated |	presenter := SpListViewPresenter newApplication: self application.	presenter items: #('One' 'Two').	activated := nil.	presenter whenActivatedDo: [ :selection | activated := selection selectedItem ].	adapter := SpWin32ListViewAdapter adapt: presenter.	presenter adapter: adapter.	adapter win32ActivatedAt: 2 source: 1.	self assert: activated equals: 'Two']{ #category : 'tests - easy' }SpWin32ModernListViewTest >> testEasyDropDownUsesModernAdapterTextPath [	| presenter adapter |	presenter := SpEasyDropDownPresenter newApplication: self application.	presenter		display: [ :item | item asUppercase ];		displayIcon: [ :item | Form extent: 1@1 ];		items: #('alpha' 'beta').	adapter := SpWin32DropDownAdapter adapt: presenter.	self assert: adapter displayStrings equals: #('ALPHA' 'BETA').	self assert: adapter rowImages size equals: 2.	self assert: adapter rowImages first extent equals: 1 @ 1]{ #category : 'tests - easy' }SpWin32ModernListViewTest >> testEasyListViewContentUsesModernAdapterTextPath [	| easy content adapter |	easy := SpEasyListViewPresenter newApplication: self application.	easy		display: [ :item | item asUppercase ];		displayIcon: [ :item | Form extent: 1@1 ];		items: #('alpha' 'beta').	content := easy contentView.	adapter := SpWin32ListViewAdapter adapt: content.	self assert: adapter displayStrings equals: #('ALPHA' 'BETA').	self assert: adapter rowImages size equals: 2.	self assert: adapter rowImages first extent equals: 1 @ 1]{ #category : 'tests - easy' }SpWin32ModernListViewTest >> testEasyDropDownBuildsWithWin32DropDownAdapter [	| presenter widget |	presenter := SpEasyDropDownPresenter newApplication: self application.	presenter items: #('alpha' 'beta').	widget := presenter build.	self assert: widget notNil.	self assert: presenter adapter class equals: SpWin32DropDownAdapter]{ #category : 'tests - easy' }SpWin32ModernListViewTest >> testEasyListViewBuildsContentWithWin32ListViewAdapter [	| presenter widget content |	presenter := SpEasyListViewPresenter newApplication: self application.	presenter items: #('alpha' 'beta').	widget := presenter build.	content := presenter contentView.	self assert: widget notNil.	self assert: content adapter class equals: SpWin32ListViewAdapter]{ #category : 'tests - listview' }SpWin32ModernListViewTest >> testListViewLabelImageCompositeCapturesNativeRowImage [	| presenter adapter red blue |	red := Form extent: 12 @ 10 depth: 32.	red fillColor: Color red.	blue := Form extent: 18 @ 14 depth: 32.	blue fillColor: Color blue.	presenter := SpListViewPresenter newApplication: self application.	presenter		setup: [ :builder |			| row |			row := builder newPresenter.			row layout: (SpBoxLayout newLeftToRight				add: builder newImage expand: false;				add: builder newLabel;				yourself).			row ];		bind: [ :row :association |			row layout children first image: association value.			row layout children second label: association key ];		items: { 'Red' -> red. 'Blue' -> blue }.	adapter := SpWin32ListViewAdapter adapt: presenter.	self assert: adapter displayStrings equals: #('Red' 'Blue').	self assert: adapter rowImages size equals: 2.	self assert: adapter rowImages first extent equals: 12 @ 10.	self assert: adapter rowImages second extent equals: 18 @ 14.	self assert: adapter widget listRowImages second extent equals: 18 @ 14]{ #category : 'tests - listview' }SpWin32ModernListViewTest >> testListViewRejectsMultipleImagesInOneNativeRow [	| presenter |	presenter := SpListViewPresenter newApplication: self application.	presenter		setup: [ :builder |			| row |			row := builder newPresenter.			row layout: (SpBoxLayout newLeftToRight				add: builder newImage expand: false;				add: builder newImage expand: false;				add: builder newLabel;				yourself).			row ];		bind: [ :row :name |			row layout children first image: (Form extent: 4 @ 4).			row layout children second image: (Form extent: 4 @ 4).			row layout children third label: name ];		items: #('Alpha').	self should: [ SpWin32ListViewAdapter adapt: presenter ] raise: Error]{ #category : 'tests - listview' }SpWin32ModernListViewTest >> testListViewRowImagesRefreshWithModel [	| presenter adapter first second |	first := Form extent: 8 @ 8 depth: 32.	first fillColor: Color red.	second := Form extent: 16 @ 12 depth: 32.	second fillColor: Color green.	presenter := SpListViewPresenter newApplication: self application.	presenter		setup: [ :builder |			| row |			row := builder newPresenter.			row layout: (SpBoxLayout newLeftToRight				add: builder newImage expand: false;				add: builder newLabel;				yourself).			row ];		bind: [ :row :association |			row layout children first image: association value.			row layout children second label: association key ];		items: { 'First' -> first }.	adapter := SpWin32ListViewAdapter adapt: presenter.	presenter adapter: adapter.	self assert: adapter rowImages first extent equals: 8 @ 8.	presenter items: { 'Second' -> second }.	self assert: adapter displayStrings equals: #('Second').	self assert: adapter rowImages first extent equals: 16 @ 12.	self assert: adapter widget listRowImages first extent equals: 16 @ 12]{ #category : 'tests - listview' }SpWin32ModernListViewTest >> testModernListRowImagesAdvanceAbiToV034 [	self assert: SpWin32Runtime abiVersion equals: 16r00290000]