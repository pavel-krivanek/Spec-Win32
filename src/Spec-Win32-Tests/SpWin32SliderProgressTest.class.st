Class {	#name : 'SpWin32SliderProgressTest',	#superclass : 'TestCase',	#category : 'Spec-Win32-Tests-Controls',	#package : 'Spec-Win32-Tests',	#tag : 'Controls'}{ #category : 'tests' }SpWin32SliderProgressTest >> testBindingsResolveSliderAndProgressBar [	| bindings |	bindings := SpWin32AdapterBindings new.	self assert: (bindings adapterClass: #SliderAdapter) equals: SpWin32SliderAdapter.	self assert: (bindings adapterClass: #ProgressBarAdapter) equals: SpWin32ProgressBarAdapter]{ #category : 'tests' }SpWin32SliderProgressTest >> testHorizontalAndVerticalSliderChooseNativeKinds [	| horizontal vertical |	horizontal := SpSliderPresenter new.	vertical := SpSliderPresenter new beVertical; yourself.	self		assert: (SpWin32SliderAdapter adapt: horizontal) widget kind		equals: SpWin32Runtime controlSliderHorizontal.	self		assert: (SpWin32SliderAdapter adapt: vertical) widget kind		equals: SpWin32Runtime controlSliderVertical]{ #category : 'tests' }SpWin32SliderProgressTest >> testSliderPresenterValueUpdatesDeferredNativePosition [	| presenter adapter |	presenter := SpSliderPresenter new		min: -50;		max: 150;		value: 50;		yourself.	adapter := SpWin32SliderAdapter adapt: presenter.	self assert: adapter widgetAbsoluteValue closeTo: 0.5.	presenter value: 100.	self assert: adapter widgetAbsoluteValue closeTo: 0.75.	self assert: adapter widgetValue closeTo: 100]{ #category : 'tests' }SpWin32SliderProgressTest >> testSliderWidgetValueHonorsQuantum [	| presenter adapter |	presenter := SpSliderPresenter new min: -50; max: 150; yourself.	adapter := SpWin32SliderAdapter adapt: presenter.	presenter value: 49.1.	self assert: adapter widgetValue closeTo: 49.	presenter quantum: nil.	self assert: adapter widgetValue closeTo: 49.1.	presenter quantum: 10.	self assert: adapter widgetValue equals: 50]{ #category : 'tests' }SpWin32SliderProgressTest >> testSliderMinMaxChangesPreserveAbsolutePosition [	| presenter adapter |	presenter := SpSliderPresenter new value: 80; yourself.	adapter := SpWin32SliderAdapter adapt: presenter.	self assert: adapter widgetAbsoluteValue closeTo: 0.8.	presenter max: 1000.	self assert: adapter widgetAbsoluteValue closeTo: 0.8.	self assert: adapter widgetValue equals: 800]{ #category : 'tests' }SpWin32SliderProgressTest >> testSliderNativeValueChangeUpdatesPresenter [	| presenter adapter |	presenter := SpSliderPresenter new min: -50; max: 150; quantum: 10; yourself.	adapter := SpWin32SliderAdapter adapt: presenter.	adapter win32ValueChanged: 0.52.	self assert: presenter value equals: 50.	self assert: presenter absoluteValue closeTo: 0.5.	self assert: adapter widgetAbsoluteValue closeTo: 0.5]{ #category : 'tests' }SpWin32SliderProgressTest >> testSliderLabelRemainsSpecState [	| presenter adapter |	presenter := SpSliderPresenter new label: 'Speed'; yourself.	adapter := SpWin32SliderAdapter adapt: presenter.	self assert: adapter widgetLabel equals: 'Speed'.	presenter label: 'Volume'.	self assert: adapter widgetLabel equals: 'Volume']{ #category : 'tests' }SpWin32SliderProgressTest >> testFixedProgressStateUpdatesNativeControl [	| presenter adapter |	presenter := SpProgressBarPresenter new.	adapter := SpWin32ProgressBarAdapter adapt: presenter.	self deny: adapter widgetIsIndeterminate.	self assert: adapter widgetValue closeTo: 0.	presenter fixedAt: 0.42.	self deny: adapter widgetIsIndeterminate.	self assert: adapter widgetValue closeTo: 0.42]{ #category : 'tests' }SpWin32SliderProgressTest >> testIndeterminateProgressStateUpdatesNativeControl [	| presenter adapter |	presenter := SpProgressBarPresenter new.	adapter := SpWin32ProgressBarAdapter adapt: presenter.	presenter indeterminate.	self assert: adapter widgetIsIndeterminate.	presenter fixedAt: 0.75.	self deny: adapter widgetIsIndeterminate.	self assert: adapter widgetValue closeTo: 0.75]{ #category : 'tests' }SpWin32SliderProgressTest >> testNativeNormalizedValueEventIsDecoded [	| runtime control handler |	runtime := SpWin32Runtime new.	control := SpWin32NativeControl		runtime: runtime		kind: SpWin32Runtime controlSliderHorizontal		text: ''		preferredExtent: 160 @ 32.	control objectId: 91.	handler := SpWin32RuntimeTestHandler new.	control eventHandler: handler.	control		nativeEventType: SpWin32Runtime eventValueChanged		argument1: 375000		argument2: 0.	self assert: control normalizedValue closeTo: 0.375.	self assert: handler valueChanged closeTo: 0.375]