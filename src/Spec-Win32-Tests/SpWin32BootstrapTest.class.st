Class {	#name : 'SpWin32BootstrapTest',	#superclass : 'TestCase',	#category : 'Spec-Win32-Tests-Bootstrap',	#package : 'Spec-Win32-Tests',	#tag : 'Bootstrap'}{ #category : 'tests' }SpWin32BootstrapTest >> testAdapterBindingResolvesWindowAdapter [	self		assert: (SpWin32AdapterBindings new adapterClass: #WindowAdapter)		equals: SpWin32WindowAdapter]{ #category : 'tests' }SpWin32BootstrapTest >> testBackendCanBeFound [	self assert: (SpApplicationBackend findBackendNamed: #Win32) class equals: SpWin32Backend]{ #category : 'tests' }SpWin32BootstrapTest >> testRuntimeAbiVersionIsExplicit [	self assert: SpWin32Runtime abiVersion equals: 16r00290000]{ #category : 'tests' }SpWin32BootstrapTest >> testRuntimeLibrariesUseSeparateThreadedFFIWorkers [	| commandWorker eventWorker |	commandWorker := SpWin32RuntimeLibrary uniqueInstance runner.	eventWorker := SpWin32RuntimeEventLibrary uniqueInstance runner.	self assert: commandWorker class equals: TFWorker.	self assert: eventWorker class equals: TFWorker.	self deny: commandWorker identicalTo: eventWorker]{ #category : 'tests' }SpWin32BootstrapTest >> testAdapterBindingResolvesBasicControlAndLayoutAdapters [	| bindings |	bindings := SpWin32AdapterBindings new.	self assert: (bindings adapterClass: #LabelAdapter) equals: SpWin32LabelAdapter.	self assert: (bindings adapterClass: #ButtonAdapter) equals: SpWin32ButtonAdapter.	self assert: (bindings adapterClass: #BoxAdapter) equals: SpWin32BoxAdapter]{ #category : 'tests' }SpWin32BootstrapTest >> testLabelAndButtonRemainUnrealizedUntilAttachedToWindow [	| label button labelAdapter buttonAdapter |	label := SpLabelPresenter new label: 'Label'; yourself.	button := SpButtonPresenter new label: 'Button'; yourself.	labelAdapter := SpWin32LabelAdapter adapt: label.	buttonAdapter := SpWin32ButtonAdapter adapt: button.	self deny: labelAdapter widget isValid.	self deny: buttonAdapter widget isValid.	self assert: labelAdapter label equals: 'Label'.	self assert: buttonAdapter label equals: 'Button']{ #category : 'tests' }SpWin32BootstrapTest >> testLabelChangesUpdateDeferredNativeControlState [	| label adapter |	label := SpLabelPresenter new label: 'Before'; yourself.	adapter := SpWin32LabelAdapter adapt: label.	label label: 'After'.	self assert: adapter widget text equals: 'After']{ #category : 'tests' }SpWin32BootstrapTest >> testSpecBuildCreatesBoxLabelAndButtonAdaptersWithoutNativeRuntime [	| application root label button layout widget |	application := SpApplication new useBackend: #Win32.	root := SpPresenter newApplication: application.	label := SpLabelPresenter newApplication: application.	label label: 'Hello'.	button := SpButtonPresenter newApplication: application.	button label: 'Push'.	layout := SpBoxLayout newTopToBottom		spacing: 6;		add: label expand: false;		add: button expand: false;		yourself.	root layout: layout.	widget := root build.	self assert: root adapter class equals: SpWin32BoxAdapter.	self assert: widget class equals: SpWin32BoxContainer.	self assert: widget children size equals: 2.	self assert: label adapter class equals: SpWin32LabelAdapter.	self assert: button adapter class equals: SpWin32ButtonAdapter]{ #category : 'tests' }SpWin32BootstrapTest >> testButtonNativeClickInvokesPresenterAction [	| application button invoked adapter |	application := SpApplication new useBackend: #Win32.	invoked := false.	button := SpButtonPresenter newApplication: application.	button		label: 'Push';		action: [ invoked := true ].	adapter := SpWin32ButtonAdapter adapt: button.	adapter win32Clicked.	self assert: invoked]{ #category : 'tests' }SpWin32BootstrapTest >> testBoxReplacePreservesChildOrder [	| application root first middle last replacement layout widget |	application := SpApplication new useBackend: #Win32.	root := SpPresenter newApplication: application.	first := SpLabelPresenter newApplication: application.	first label: 'first'.	middle := SpLabelPresenter newApplication: application.	middle label: 'middle'.	last := SpLabelPresenter newApplication: application.	last label: 'last'.	layout := SpBoxLayout newTopToBottom		add: first;		add: middle;		add: last;		yourself.	root layout: layout.	widget := root build.	replacement := SpButtonPresenter newApplication: application.	replacement label: 'replacement'.	layout replace: middle with: replacement.	self assert: widget children equals: {		first adapter widget.		replacement adapter widget.		last adapter widget }]{ #category : 'tests' }SpWin32BootstrapTest >> testBoxDynamicAddAndRemoveUpdatesAdapterChildren [	| application root first second layout widget |	application := SpApplication new useBackend: #Win32.	root := SpPresenter newApplication: application.	first := SpLabelPresenter newApplication: application.	first label: 'first'.	layout := SpBoxLayout newTopToBottom add: first; yourself.	root layout: layout.	widget := root build.	self assert: widget children size equals: 1.	second := SpButtonPresenter newApplication: application.	second label: 'second'.	layout add: second.	self assert: widget children size equals: 2.	self deny: root adapter isEmpty.	layout remove: first.	self assert: widget children equals: { second adapter widget }.	layout remove: second.	self assert: root adapter isEmpty]{ #category : 'tests' }SpWin32BootstrapTest >> testBarrierEventCodeIsExplicit [	self assert: SpWin32Runtime eventBarrier equals: 5]{ #category : 'tests' }SpWin32BootstrapTest >> testAdapterBindingResolvesFormAndTextInputAdapters [	| bindings |	bindings := SpWin32AdapterBindings new.	self assert: (bindings adapterClass: #CheckBoxAdapter) equals: SpWin32CheckBoxAdapter.	self assert: (bindings adapterClass: #RadioButtonAdapter) equals: SpWin32RadioButtonAdapter.	self assert: (bindings adapterClass: #TextInputFieldAdapter) equals: SpWin32TextInputFieldAdapter]{ #category : 'tests' }SpWin32BootstrapTest >> testCheckBoxStateIsKeptBeforeNativeRealization [	| presenter adapter |	presenter := SpCheckBoxPresenter new state: true; label: 'Enabled'; yourself.	adapter := SpWin32CheckBoxAdapter adapt: presenter.	self assert: adapter widget checked.	presenter state: false.	self deny: adapter widget checked.	adapter win32Toggled: true.	self assert: presenter state]{ #category : 'tests' }SpWin32BootstrapTest >> testRadioButtonGroupStateIsDrivenByPresenters [	| first second firstAdapter secondAdapter |	first := SpRadioButtonPresenter new label: 'One'; yourself.	second := SpRadioButtonPresenter new label: 'Two'; yourself.	first associatedRadioButtons: { second }.	firstAdapter := SpWin32RadioButtonAdapter adapt: first.	secondAdapter := SpWin32RadioButtonAdapter adapt: second.	self assert: first state.	self deny: second state.	secondAdapter win32Toggled: true.	self deny: first state.	self assert: second state.	self deny: firstAdapter widget checked.	self assert: secondAdapter widget checked]{ #category : 'tests' }SpWin32BootstrapTest >> testTextInputDeferredPropertiesFollowPresenter [	| presenter adapter |	presenter := SpTextInputFieldPresenter new		text: 'hello';		placeholder: 'type here';		maxLength: 12;		bePassword;		beNotEditable;		yourself.	adapter := SpWin32TextInputFieldAdapter adapt: presenter.	self assert: adapter getText equals: 'hello'.	self assert: adapter placeHolderText equals: 'type here'.	self assert: adapter widget maxLength equals: 12.	self assert: adapter isPassword.	self deny: adapter widget editable]{ #category : 'tests' }SpWin32BootstrapTest >> testTextInputAdapterTextUpdatesPresenterAndHonorsMaxLength [	| presenter adapter |	presenter := SpTextInputFieldPresenter new maxLength: 4; yourself.	adapter := SpWin32TextInputFieldAdapter adapt: presenter.	adapter text: '1234567'.	self assert: presenter text equals: '1234'.	self assert: adapter getText equals: '1234']{ #category : 'tests' }SpWin32BootstrapTest >> testTextInputTypeByCharHonorsEditable [	| presenter adapter |	presenter := SpTextInputFieldPresenter new.	adapter := SpWin32TextInputFieldAdapter adapt: presenter.	adapter typeByChar: 'abc'.	self assert: presenter text equals: 'abc'.	presenter beNotEditable.	adapter typeByChar: 'x'.	self assert: presenter text equals: 'abc']{ #category : 'tests' }SpWin32BootstrapTest >> testNewControlEventCodesAreExplicit [	self assert: SpWin32Runtime eventToggled equals: 6.	self assert: SpWin32Runtime eventTextChanged equals: 7.	self assert: SpWin32Runtime controlCheckBox equals: 3.	self assert: SpWin32Runtime controlRadioButton equals: 4.	self assert: SpWin32Runtime controlTextInput equals: 5.	self assert: SpWin32Runtime eventSelectionChanged equals: 8.	self assert: SpWin32Runtime controlDropList equals: 6.	self assert: SpWin32Runtime eventValueChanged equals: 9.	self assert: SpWin32Runtime controlSliderHorizontal equals: 7.	self assert: SpWin32Runtime controlSliderVertical equals: 8.	self assert: SpWin32Runtime controlProgress equals: 9.	self assert: SpWin32Runtime controlNotebook equals: 10.	self assert: SpWin32Runtime eventListSelectionChanged equals: 12.	self assert: SpWin32Runtime eventActivated equals: 13.	self assert: SpWin32Runtime controlList equals: 11.	self assert: SpWin32Runtime eventColumnClicked equals: 14.	self assert: SpWin32Runtime controlTable equals: 12.	self assert: SpWin32Runtime eventTreeSelectionChanged equals: 15.	self assert: SpWin32Runtime eventTreeExpansionChanged equals: 16.	self assert: SpWin32Runtime eventKeyDown equals: 17.	self assert: SpWin32Runtime eventKeyUp equals: 18.	self assert: SpWin32Runtime eventMouseDown equals: 19.	self assert: SpWin32Runtime eventMouseUp equals: 20.	self assert: SpWin32Runtime eventMouseMove equals: 21.	self assert: SpWin32Runtime eventMouseEnter equals: 22.	self assert: SpWin32Runtime eventMouseLeave equals: 23.	self assert: SpWin32Runtime eventMouseDoubleClick equals: 24.	self assert: SpWin32Runtime eventContextMenuRequested equals: 25.	self assert: SpWin32Runtime eventNumberStep equals: 26.	self assert: SpWin32Runtime controlTree equals: 13.	self assert: SpWin32Runtime controlNumberInput equals: 18.	self assert: SpWin32Runtime controlSearchInput equals: 19]{ #category : 'tests' }SpWin32BootstrapTest >> testTextInputNativeChangeUpdatesPresenter [	| presenter adapter |	presenter := SpTextInputFieldPresenter new.	adapter := SpWin32TextInputFieldAdapter adapt: presenter.	adapter win32TextChanged: 'typed'.	self assert: presenter text equals: 'typed']{ #category : 'tests' }SpWin32BootstrapTest >> testAdapterBindingResolvesDropListAdapter [	self		assert: (SpWin32AdapterBindings new adapterClass: #DropListAdapter)		equals: SpWin32DropListAdapter]{ #category : 'tests' }SpWin32BootstrapTest >> testDropListDeferredStateFollowsPresenter [	| presenter adapter |	presenter := SpDropListPresenter new.	presenter items: #( 10 20 30 ).	adapter := SpWin32DropListAdapter adapt: presenter.	self assert: adapter widget items equals: #( '10' '20' '30' ).	self assert: adapter widget selectedIndex equals: 1.	presenter selectIndex: 3.	self assert: adapter widget selectedIndex equals: 3]{ #category : 'tests' }SpWin32BootstrapTest >> testDropListNativeSelectionUpdatesPresenterAndExecutesAction [	| presenter adapter selected |	presenter := SpDropListPresenter new.	presenter dropListItems: (#( 10 20 30 ) collect: [ :each |		SpDropListItem on: each do: [ selected := each ] ]).	adapter := SpWin32DropListAdapter adapt: presenter.	adapter win32SelectionChanged: 2.	self assert: presenter selectedItem equals: 20.	self assert: selected equals: 20.	self assert: adapter selectedIndexes equals: #( 2 )]{ #category : 'tests' }SpWin32BootstrapTest >> testDropListStartWithoutSelectionRemainsUnselected [	| presenter adapter |	presenter := SpDropListPresenter new.	presenter startWithoutSelection; items: #( alpha beta gamma ).	adapter := SpWin32DropListAdapter adapt: presenter.	self assert: presenter selectedIndex equals: 0.	self assert: adapter widget selectedIndex equals: 0.	self assert: adapter selectedIndexes isEmpty]{ #category : 'tests' }SpWin32BootstrapTest >> testDropListModelChangeUpdatesDeferredItems [	| presenter adapter |	presenter := SpDropListPresenter new.	presenter items: #( one two ).	adapter := SpWin32DropListAdapter adapt: presenter.	presenter items: #( red green blue ).	self assert: adapter widget items equals: #( 'red' 'green' 'blue' ).	self assert: adapter widget selectedIndex equals: presenter selectedIndex]{ #category : 'tests' }SpWin32BootstrapTest >> testDropListSelectIndexEmulatesWidgetSelection [	| presenter adapter |	presenter := SpDropListPresenter new.	presenter items: #( 10 20 30 ).	adapter := SpWin32DropListAdapter adapt: presenter.	adapter selectIndex: 2.	self assert: presenter selectedItem equals: 20.	self assert: adapter selectedIndexes equals: #( 2 )]{ #category : 'tests' }SpWin32BootstrapTest >> testDropListUsesPresenterDisplayBlock [	| presenter adapter |	presenter := SpDropListPresenter new.	presenter display: [ :each | 'item-', each asString ].	presenter items: #( 1 22 333 ).	adapter := SpWin32DropListAdapter adapt: presenter.	self assert: adapter widget items equals: #( 'item-1' 'item-22' 'item-333' ).	self assert: adapter widget measurementText equals: 'item-333']{ #category : 'tests' }SpWin32BootstrapTest >> testGenericHelpIsCopiedToNativeControlBeforeRealization [	| presenter adapter |	presenter := SpButtonPresenter new		label: 'Help target';		help: 'Initial help';		yourself.	adapter := SpWin32ButtonAdapter adapt: presenter.	self assert: adapter helpText equals: 'Initial help'.	self assert: adapter widget tooltipText equals: 'Initial help'.	self deny: adapter widget isValid]{ #category : 'tests' }SpWin32BootstrapTest >> testGenericHelpTracksPresenterChanges [	| presenter adapter |	presenter := SpButtonPresenter new		label: 'Help target';		help: 'Before';		yourself.	adapter := SpWin32ButtonAdapter adapt: presenter.	presenter help: 'After'.	self assert: adapter helpText equals: 'After'.	self assert: adapter widget tooltipText equals: 'After'.	presenter help: nil.	self assert: adapter helpText equals: ''.	self assert: adapter widget tooltipText equals: '']{ #category : 'tests' }SpWin32BootstrapTest >> testWindowFoundationNativeProtocolIsPresent [	self assert: (SpWin32NativeWindow canUnderstand: #bounds).	self assert: (SpWin32NativeWindow canUnderstand: #centerOnMonitor).	self assert: (SpWin32NativeWindow canUnderstand: #centerRelativeTo:).	self assert: (SpWin32NativeWindow canUnderstand: #owner:).	self assert: (SpWin32NativeWindow canUnderstand: #isMinimized).	self assert: (SpWin32NativeWindow canUnderstand: #isMaximized).	self assert: (SpWin32NativeWindow canUnderstand: #isForeground)]{ #category : 'tests' }SpWin32BootstrapTest >> testWindowAdapterFoundationProtocolIsPresent [	self assert: (SpWin32WindowAdapter canUnderstand: #centered).	self assert: (SpWin32WindowAdapter canUnderstand: #centeredRelativeTo:).	self assert: (SpWin32WindowAdapter canUnderstand: #ownerWindow:).	self assert: (SpWin32WindowAdapter canUnderstand: #isMinimized).	self assert: (SpWin32WindowAdapter canUnderstand: #isMaximized).	self assert: (SpWin32WindowAdapter canUnderstand: #isTopWindow)]{ #category : 'tests' }SpWin32BootstrapTest >> testAdapterBindingResolvesNumberAndSearchInputAdapters [	| bindings |	bindings := SpWin32AdapterBindings new.	self assert: (bindings adapterClass: #NumberInputFieldAdapter) equals: SpWin32NumberInputFieldAdapter.	self assert: (bindings adapterClass: #SearchInputFieldAdapter) equals: SpWin32SearchInputFieldAdapter]{ #category : 'tests' }SpWin32BootstrapTest >> testGenericEnabledTracksPresenterChanges [	| presenter adapter |	presenter := SpButtonPresenter new label: 'Enabled target'; yourself.	adapter := SpWin32ButtonAdapter adapt: presenter.	self assert: adapter widget enabled.	presenter enabled: false.	self deny: adapter widget enabled.	presenter enabled: true.	self assert: adapter widget enabled]