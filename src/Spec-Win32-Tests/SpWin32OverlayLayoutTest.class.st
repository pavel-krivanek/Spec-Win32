Class {	#name : 'SpWin32OverlayLayoutTest',	#superclass : 'TestCase',	#category : 'Spec-Win32-Tests-Layout',	#package : 'Spec-Win32-Tests',	#tag : 'Layout'}{ #category : 'private' }SpWin32OverlayLayoutTest >> controlExtent: anExtent [	^ SpWin32NativeControl		runtime: SpWin32Runtime new		kind: SpWin32Runtime controlButton		text: ''		preferredExtent: anExtent]{ #category : 'tests' }SpWin32OverlayLayoutTest >> testAdapterBindingResolvesOverlayAdapter [	self		assert: (SpWin32AdapterBindings new adapterClass: #OverlayAdapter)		equals: SpWin32OverlayAdapter]{ #category : 'tests' }SpWin32OverlayLayoutTest >> testAdapterUsesDedicatedOverlayContainer [	| layout adapter |	layout := SpOverlayLayout new.	adapter := SpWin32OverlayAdapter new.	adapter layout: layout.	self assert: adapter widget class equals: SpWin32OverlayContainer.	self assert: adapter isEmpty]{ #category : 'tests' }SpWin32OverlayLayoutTest >> testMainFillsAndOverlayDefaultsToNaturalSizeCentered [	| layout container main overlay mainConstraints overlayConstraints placements mainPlacement overlayPlacement |	layout := SpOverlayLayout new.	container := SpWin32OverlayContainer layout: layout runtime: SpWin32Runtime new.	main := self controlExtent: 80@40.	overlay := self controlExtent: 100@30.	mainConstraints := SpOverlayConstraints new.	overlayConstraints := SpOverlayConstraints new beOverlay; yourself.	container addChild: main constraints: mainConstraints.	container addChild: overlay constraints: overlayConstraints.	placements := OrderedCollection new.	container layoutIn: (10@20 extent: 300@200) collect: placements.	mainPlacement := placements first.	overlayPlacement := placements second.	self assert: mainPlacement equals: { main. 10. 20. 300. 200 }.	self assert: overlayPlacement equals: { overlay. 110. 105. 100. 30 }]{ #category : 'tests' }SpWin32OverlayLayoutTest >> testOverlayAlignmentUsesStartAndEnd [	| layout container overlay constraints placements |	layout := SpOverlayLayout new.	container := SpWin32OverlayContainer layout: layout runtime: SpWin32Runtime new.	overlay := self controlExtent: 50@20.	constraints := SpOverlayConstraints new		beOverlay;		hAlignEnd;		vAlignStart;		yourself.	container addChild: overlay constraints: constraints.	placements := OrderedCollection new.	container layoutIn: (5@7 extent: 200@100) collect: placements.	self assert: placements first equals: { overlay. 155. 7. 50. 20 }]{ #category : 'tests' }SpWin32OverlayLayoutTest >> testChildrenExposeTopmostOverlayFirstAndMainLast [	| layout container main first second |	layout := SpOverlayLayout new.	container := SpWin32OverlayContainer layout: layout runtime: SpWin32Runtime new.	main := self controlExtent: 80@40.	first := self controlExtent: 30@20.	second := self controlExtent: 40@25.	container addChild: first constraints: (SpOverlayConstraints new beOverlay; yourself).	container addChild: main constraints: SpOverlayConstraints new.	container addChild: second constraints: (SpOverlayConstraints new beOverlay; yourself).	self assert: container children equals: { second. first. main }.	self assert: container nativeControlsForZOrder equals: { main. first. second }]{ #category : 'tests' }SpWin32OverlayLayoutTest >> testPreferredExtentContainsMainAndLargestOverlay [	| layout container main overlay |	layout := SpOverlayLayout new.	container := SpWin32OverlayContainer layout: layout runtime: SpWin32Runtime new.	main := self controlExtent: 90@50.	overlay := self controlExtent: 120@30.	container addChild: main constraints: SpOverlayConstraints new.	container addChild: overlay constraints: (SpOverlayConstraints new beOverlay; yourself).	self assert: container preferredExtent equals: 120@50]{ #category : 'tests' }SpWin32OverlayLayoutTest >> testBuildPreservesSpecChildOrderingContract [	| application root main first second layout widget |	application := SpApplication new useBackend: #Win32.	root := SpPresenter newApplication: application.	main := SpLabelPresenter newApplication: application.	main label: 'Main'.	first := SpButtonPresenter newApplication: application.	first label: 'First overlay'.	second := SpButtonPresenter newApplication: application.	second label: 'Second overlay'.	layout := SpOverlayLayout new.	layout child: main.	layout addOverlay: first.	layout addOverlay: second.	root layout: layout.	root build.	widget := root adapter widget.	self assert: root adapter class equals: SpWin32OverlayAdapter.	self assert: widget class equals: SpWin32OverlayContainer.	self assert: widget children equals: { second adapter widget. first adapter widget. main adapter widget }]{ #category : 'tests' }SpWin32OverlayLayoutTest >> testRemovingOverlayKeepsMainWidget [	| application root main overlay layout widget |	application := SpApplication new useBackend: #Win32.	root := SpPresenter newApplication: application.	main := SpLabelPresenter newApplication: application.	main label: 'Main'.	overlay := SpButtonPresenter newApplication: application.	overlay label: 'Overlay'.	layout := SpOverlayLayout new.	layout child: main.	layout addOverlay: overlay.	root layout: layout.	root build.	widget := root adapter widget.	layout removeOverlay: overlay.	self assert: widget children equals: { main adapter widget }]{ #category : 'tests' }SpWin32OverlayLayoutTest >> testReplacingMainAfterOverlayKeepsOverlayAboveIt [	| application root firstMain secondMain overlay layout widget |	application := SpApplication new useBackend: #Win32.	root := SpPresenter newApplication: application.	firstMain := SpLabelPresenter newApplication: application.	firstMain label: 'First main'.	secondMain := SpLabelPresenter newApplication: application.	secondMain label: 'Second main'.	overlay := SpButtonPresenter newApplication: application.	overlay label: 'Overlay'.	layout := SpOverlayLayout new.	layout child: firstMain.	layout addOverlay: overlay.	root layout: layout.	root build.	widget := root adapter widget.	layout child: secondMain.	self assert: widget children equals: { overlay adapter widget. secondMain adapter widget }.	self assert: widget nativeControlsForZOrder equals: { secondMain adapter widget. overlay adapter widget }]{ #category : 'tests' }SpWin32OverlayLayoutTest >> testNestedExecutableOverlayContributesItsNativeLeavesToOrdering [	| layout container nested first second constraints |	layout := SpOverlayLayout new.	container := SpWin32OverlayContainer layout: layout runtime: SpWin32Runtime new.	nested := SpWin32BoxContainer layout: SpBoxLayout newLeftToRight runtime: SpWin32Runtime new.	first := self controlExtent: 20@20.	second := self controlExtent: 30@20.	nested addChild: first constraints: SpBoxConstraints new.	nested addChild: second constraints: SpBoxConstraints new.	constraints := SpOverlayConstraints new beOverlay; yourself.	container addChild: nested constraints: constraints.	self assert: container nativeControlsForZOrder equals: { first. second }]{ #category : 'tests' }SpWin32OverlayLayoutTest >> testOverlayZOrderAbiIsV029 [	self assert: SpWin32Runtime abiVersion equals: 16r00290000.	self assert: (SpWin32Runtime canUnderstand: #setControlZOrderBottomToTop:)]