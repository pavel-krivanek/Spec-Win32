Class {	#name : 'SpWin32PaginatorAdapterTest',	#superclass : 'TestCase',	#category : 'Spec-Win32-Tests-Controls',	#package : 'Spec-Win32-Tests',	#tag : 'Controls'}{ #category : 'private' }SpWin32PaginatorAdapterTest >> application [	^ SpApplication new useBackend: #Win32]{ #category : 'private' }SpWin32PaginatorAdapterTest >> newPresenterWithPages: pageCount [	| presenter |	presenter := SpPaginatorPresenter newApplication: self application.	presenter pages: (1 to: pageCount) asArray.	^ presenter]{ #category : 'private' }SpWin32PaginatorAdapterTest >> newAdapterWithTenPages [	| presenter adapter |	presenter := self newPresenterWithPages: 10.	presenter visiblePages: 2.	adapter := SpWin32PaginatorAdapter adapt: presenter.	presenter adapter: adapter.	^ adapter]{ #category : 'tests' }SpWin32PaginatorAdapterTest >> testBindingResolvesPaginatorAdapter [	self		assert: (SpWin32AdapterBindings new adapterClass: #PaginatorAdapter)		equals: SpWin32PaginatorAdapter]{ #category : 'tests' }SpWin32PaginatorAdapterTest >> testBuildUsesRenderedSurfaceAndMorphicPageGeometry [	| adapter |	adapter := self newAdapterWithTenPages.	self assert: adapter widget class equals: SpWin32PaginatorSurfaceControl.	self assert: adapter widget kind equals: SpWin32Runtime controlImage.	self assert: adapter pageWidth equals: 14.	self assert: adapter paginatorHeight equals: 22.	self assert: adapter widget preferredExtent equals: 140 @ 22.	self assert: adapter widget imageData isNil]{ #category : 'tests' }SpWin32PaginatorAdapterTest >> testInitialSelectionClampsLastPageToVisibleWindow [	| adapter presenter |	adapter := self newAdapterWithTenPages.	presenter := adapter presenter.	self assert: presenter selectedPage equals: 10.	self assert: adapter effectiveSelectedPage equals: 9.	self assert: adapter effectiveVisiblePages equals: 2]{ #category : 'tests' }SpWin32PaginatorAdapterTest >> testSelectingLastPageClampsToLastValidWindow [	| adapter presenter |	adapter := self newAdapterWithTenPages.	presenter := adapter presenter.	presenter selectPage: 5.	self assert: adapter effectiveSelectedPage equals: 5.	presenter selectPage: 10.	self assert: adapter effectiveSelectedPage equals: 9]{ #category : 'tests' }SpWin32PaginatorAdapterTest >> testClickSelectsPageAndClampsAtEnd [	| adapter presenter |	adapter := self newAdapterWithTenPages.	presenter := adapter presenter.	adapter win32MouseEventType: SpWin32Runtime eventMouseDown position: 3 @ 10 button: 1 modifiers: 0.	self assert: presenter selectedPage equals: 1.	adapter win32MouseEventType: SpWin32Runtime eventMouseDown position: 137 @ 10 button: 1 modifiers: 0.	self assert: presenter selectedPage equals: 9]{ #category : 'tests' }SpWin32PaginatorAdapterTest >> testPresenterSelectionAndVisiblePagesRedrawSurface [	| adapter presenter before |	adapter := self newAdapterWithTenPages.	presenter := adapter presenter.	adapter redraw.	before := adapter widget imageData bytes copy.	presenter selectPage: 4.	self deny: adapter widget imageData bytes equals: before.	presenter visiblePages: 3.	self assert: adapter effectiveVisiblePages equals: 3.	self assert: presenter selectedPage equals: 4]{ #category : 'tests' }SpWin32PaginatorAdapterTest >> testDynamicPagesUpdatePreferredExtentAndSelection [	| adapter presenter |	adapter := self newAdapterWithTenPages.	presenter := adapter presenter.	presenter addPage: 11.	self assert: adapter widget preferredExtent equals: 154 @ 22.	self assert: presenter selectedPage equals: 11.	self assert: adapter effectiveSelectedPage equals: 10.	presenter pages: #(a b c).	self assert: adapter widget preferredExtent equals: 42 @ 22.	self assert: presenter selectedPage equals: 2.	self assert: adapter effectiveSelectedPage equals: 2]{ #category : 'tests' }SpWin32PaginatorAdapterTest >> testDraggingSelectionPublishesDeltaAndSnapsToPage [	| adapter presenter deltas |	adapter := self newAdapterWithTenPages.	presenter := adapter presenter.	presenter selectPage: 3.	deltas := OrderedCollection new.	presenter whenDraggingDo: [ :delta | deltas add: delta ].	adapter win32MouseEventType: SpWin32Runtime eventMouseDown position: 42 @ 10 button: 1 modifiers: 0.	adapter win32MouseEventType: SpWin32Runtime eventMouseMove position: 56 @ 10 button: 1 modifiers: 0.	adapter win32MouseEventType: SpWin32Runtime eventMouseUp position: 56 @ 10 button: 1 modifiers: 0.	self denyEmpty: deltas.	self assert: presenter selectedPage equals: 4]{ #category : 'tests' }SpWin32PaginatorAdapterTest >> testResizeRightEdgeChangesVisiblePages [	| adapter presenter right |	adapter := self newAdapterWithTenPages.	presenter := adapter presenter.	presenter selectPage: 3.	right := adapter selectionX + adapter selectionWidth.	adapter win32MouseEventType: SpWin32Runtime eventMouseDown position: right @ 10 button: 1 modifiers: 0.	adapter win32MouseEventType: SpWin32Runtime eventMouseMove position: (right + 14) @ 10 button: 1 modifiers: 0.	adapter win32MouseEventType: SpWin32Runtime eventMouseUp position: (right + 14) @ 10 button: 1 modifiers: 0.	self assert: presenter visiblePages equals: 3.	self assert: presenter selectedPage equals: 3]{ #category : 'tests' }SpWin32PaginatorAdapterTest >> testWithoutResizingEdgesDisablesResizeHitZones [	| adapter presenter right |	adapter := self newAdapterWithTenPages.	presenter := adapter presenter.	presenter selectPage: 3.	adapter withoutResizingEdges.	self deny: adapter hasResizingEdges.	right := adapter selectionX + adapter selectionWidth.	adapter win32MouseEventType: SpWin32Runtime eventMouseDown position: right @ 10 button: 1 modifiers: 0.	adapter win32MouseEventType: SpWin32Runtime eventMouseMove position: (right + 14) @ 10 button: 1 modifiers: 0.	adapter win32MouseEventType: SpWin32Runtime eventMouseUp position: (right + 14) @ 10 button: 1 modifiers: 0.	self assert: presenter visiblePages equals: 2]{ #category : 'tests' }SpWin32PaginatorAdapterTest >> testMouseLeaveCancelsTransientDrag [	| adapter presenter |	adapter := self newAdapterWithTenPages.	presenter := adapter presenter.	presenter selectPage: 3.	adapter win32MouseEventType: SpWin32Runtime eventMouseDown position: 42 @ 10 button: 1 modifiers: 0.	adapter win32MouseEventType: SpWin32Runtime eventMouseMove position: 59 @ 10 button: 1 modifiers: 0.	adapter win32MouseEventType: SpWin32Runtime eventMouseLeave position: 59 @ 10 button: 0 modifiers: 0.	self assert: presenter selectedPage equals: 3.	self assert: adapter selectionX equals: 28]{ #category : 'tests' }SpWin32PaginatorAdapterTest >> testDisabledPresenterIgnoresInternalMouseNavigation [	| adapter presenter |	adapter := self newAdapterWithTenPages.	presenter := adapter presenter.	presenter selectPage: 3.	presenter enabled: false.	adapter win32MouseEventType: SpWin32Runtime eventMouseDown position: 100 @ 10 button: 1 modifiers: 0.	self assert: presenter selectedPage equals: 3]{ #category : 'tests' }SpWin32PaginatorAdapterTest >> testNativeImageClickEventIsSafelyConsumed [	| adapter |	adapter := self newAdapterWithTenPages.	self		shouldnt: [			adapter widget				nativeEventType: SpWin32Runtime eventClicked				argument1: 0				argument2: 0 ]		raise: Error]