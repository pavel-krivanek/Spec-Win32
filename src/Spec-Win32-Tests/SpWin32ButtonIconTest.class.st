Class {	#name : 'SpWin32ButtonIconTest',	#superclass : 'TestCase',	#category : 'Spec-Win32-Tests-Controls',	#package : 'Spec-Win32-Tests',	#tag : 'Controls'}{ #category : 'private' }SpWin32ButtonIconTest >> iconExtent: anExtent color: aColor [	| form |	form := Form extent: anExtent depth: 32.	form fillColor: aColor.	^ form]{ #category : 'tests' }SpWin32ButtonIconTest >> testButtonInitialIconUsesGenericImagePayload [	| form presenter adapter |	form := self iconExtent: 20 @ 18 color: Color red.	presenter := SpButtonPresenter new label: 'Run'; icon: form; yourself.	adapter := SpWin32ButtonAdapter adapt: presenter.	self assert: adapter widget imageData extent equals: 20 @ 18.	self assert: adapter widget text equals: 'Run'.	self assert: adapter widget preferredExtent x > 75.	self assert: adapter widget preferredExtent y equals: 28]{ #category : 'tests' }SpWin32ButtonIconTest >> testButtonIconOnlyUsesIconAwarePreferredExtent [	| form presenter adapter |	form := self iconExtent: 24 @ 22 color: Color blue.	presenter := SpButtonPresenter new label: ''; icon: form; yourself.	adapter := SpWin32ButtonAdapter adapt: presenter.	self assert: adapter widget preferredExtent equals: 40 @ 32]{ #category : 'tests' }SpWin32ButtonIconTest >> testButtonIconCanBeReplacedAndCleared [	| first second presenter adapter |	first := self iconExtent: 16 @ 16 color: Color red.	second := self iconExtent: 28 @ 20 color: Color green.	presenter := SpButtonPresenter new label: 'Dynamic'; icon: first; yourself.	adapter := SpWin32ButtonAdapter adapt: presenter.	presenter icon: second.	self assert: adapter widget imageData extent equals: 28 @ 20.	presenter icon: nil.	self assert: adapter widget imageData equals: nil.	self assert: adapter widget preferredExtent equals: 80 @ 28]{ #category : 'tests' }SpWin32ButtonIconTest >> testButtonLabelChangeKeepsIconInPreferredExtent [	| form presenter adapter before |	form := self iconExtent: 24 @ 24 color: Color yellow.	presenter := SpButtonPresenter new label: 'A'; icon: form; yourself.	adapter := SpWin32ButtonAdapter adapt: presenter.	before := adapter widget preferredExtent x.	presenter label: 'A much longer caption'.	self assert: adapter widget imageData extent equals: 24 @ 24.	self assert: adapter widget preferredExtent x > before]{ #category : 'tests' }SpWin32ButtonIconTest >> testToggleButtonIconSharesImageTransportAndKeepsState [	| form presenter adapter |	form := self iconExtent: 18 @ 18 color: Color magenta.	presenter := SpToggleButtonPresenter new label: 'Pinned'; icon: form; state: true; yourself.	adapter := SpWin32ToggleButtonAdapter adapt: presenter.	self assert: adapter widget imageData extent equals: 18 @ 18.	self assert: adapter widget checked.	presenter state: false.	self deny: adapter widget checked.	presenter icon: nil.	self assert: adapter widget imageData equals: nil]{ #category : 'tests' }SpWin32ButtonIconTest >> testDisabledButtonRetainsIconPayload [	| form presenter adapter |	form := self iconExtent: 16 @ 16 color: Color cyan.	presenter := SpButtonPresenter new label: 'Disabled'; icon: form; yourself.	adapter := SpWin32ButtonAdapter adapt: presenter.	adapter enabled: false.	self deny: adapter widget enabled.	self assert: adapter widget imageData extent equals: 16 @ 16]{ #category : 'tests' }SpWin32ButtonIconTest >> testButtonIconSupportKeepsV022Abi [	self assert: SpWin32Runtime abiVersion equals: 16r00290000]