Class {	#name : 'SpWin32CodeAdapterTest',	#superclass : 'TestCase',	#category : 'Spec-Win32-Tests-Code',	#package : 'Spec-Win32-Tests',	#tag : 'Code'}{ #category : 'tests' }SpWin32CodeAdapterTest >> testAdapterBindingKindAndAbi [	self		assert: (SpWin32AdapterBindings new adapterClass: #CodeAdapter)		equals: SpWin32CodeAdapter.	self assert: SpWin32Runtime controlCode equals: 30.	self assert: SpWin32Runtime abiVersion equals: 16r00290000]{ #category : 'tests' }SpWin32CodeAdapterTest >> testCodeAdapterUsesDedicatedNativeControl [	| presenter adapter |	presenter := SpCodePresenter new.	presenter text: 'self asString'.	adapter := SpWin32CodeAdapter adapt: presenter.	presenter adapter: adapter.	self assert: adapter class adaptingName equals: #CodeAdapter.	self assert: adapter widget kind equals: SpWin32Runtime controlCode.	self assert: adapter widget preferredExtent equals: 520 @ 320]{ #category : 'tests' }SpWin32CodeAdapterTest >> testLineNumbersAreRetainedByDeferredNativeControl [	| presenter adapter |	presenter := SpCodePresenter new.	presenter withLineNumbers.	adapter := SpWin32CodeAdapter adapt: presenter.	presenter adapter: adapter.	self assert: adapter widget codeLineNumbers.	presenter withoutLineNumbers.	self deny: adapter widget codeLineNumbers]{ #category : 'tests' }SpWin32CodeAdapterTest >> testSyntaxHighlightBuildsNativeColorSpans [	| presenter adapter spans |	presenter := SpCodePresenter new.	presenter beForScripting.	presenter text: 'self asString.'.	presenter withSyntaxHighlight.	adapter := SpWin32CodeAdapter adapt: presenter.	presenter adapter: adapter.	spans := adapter widget codeStyleSpans.	self denyEmpty: spans.	self assert: spans size \\ 4 equals: 0.	self assert: spans first equals: 0.	self assert: spans second > spans first]{ #category : 'tests' }SpWin32CodeAdapterTest >> testTextWithStyleUsesShoutStyling [	| presenter adapter styled firstColor fifthColor |	presenter := SpCodePresenter new.	presenter beForScripting.	presenter text: 'self asString.'.	presenter withSyntaxHighlight.	adapter := SpWin32CodeAdapter adapt: presenter.	presenter adapter: adapter.	styled := adapter textWithStyle.	firstColor := (styled attributesAt: 1) detect: [ :each | each isKindOf: TextColor ].	fifthColor := (styled attributesAt: 5) detect: [ :each | each isKindOf: TextColor ].	self deny: firstColor color equals: fifthColor color]{ #category : 'tests' }SpWin32CodeAdapterTest >> testDisablingSyntaxHighlightClearsSemanticSpansToOneBaseRun [	| presenter adapter |	presenter := SpCodePresenter new.	presenter beForScripting.	presenter text: 'self asString.'.	presenter withSyntaxHighlight.	adapter := SpWin32CodeAdapter adapt: presenter.	presenter adapter: adapter.	self assert: adapter widget codeStyleSpans size > 4.	presenter withoutSyntaxHighlight.	self assert: adapter widget codeStyleSpans size equals: 4]{ #category : 'tests' }SpWin32CodeAdapterTest >> testInheritedTextSelectionAndUnicodeSemantics [	| presenter adapter |	presenter := SpCodePresenter new.	presenter text: 'A🙂', String lf, 'beta'.	adapter := SpWin32CodeAdapter adapt: presenter.	presenter adapter: adapter.	adapter cursorPositionIndex: 5.	self assert: adapter cursorPosition equals: 2 @ 2.	self assert: adapter lineAtCursorPosition equals: 'beta']{ #category : 'tests' }SpWin32CodeAdapterTest >> testTextChangeRefreshesStyling [	| presenter adapter before after |	presenter := SpCodePresenter new.	presenter beForScripting.	presenter withSyntaxHighlight.	presenter text: 'self'.	adapter := SpWin32CodeAdapter adapt: presenter.	presenter adapter: adapter.	before := adapter widget codeStyleSpans copy.	adapter text: '10 + 42.0'.	after := adapter widget codeStyleSpans.	self deny: after equals: before.	self assert: presenter text equals: '10 + 42.0']