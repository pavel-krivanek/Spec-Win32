Class {	#name : 'SpWin32ImageTest',	#superclass : 'TestCase',	#category : 'Spec-Win32-Tests-Controls',	#package : 'Spec-Win32-Tests',	#tag : 'Controls'}{ #category : 'tests' }SpWin32ImageTest >> testBindingResolvesImageAdapter [	self		assert: (SpWin32AdapterBindings new adapterClass: #ImageAdapter)		equals: SpWin32ImageAdapter]{ #category : 'tests' }SpWin32ImageTest >> testFormConversionProducesTopDownPremultipliedBgra [	| form data half |	form := Form extent: 2 @ 1 depth: 32.	form colorAt: 0 @ 0 put: Color red.	half := Color r: 0.0 g: 1.0 b: 0.0 alpha: 0.5.	form colorAt: 1 @ 0 put: half.	data := SpWin32ImageData fromForm: form.	self assert: data extent equals: 2 @ 1.	self assert: data bytes size equals: 8.	self assert: (data bytes copyFrom: 1 to: 4) equals: #[ 0 0 255 255 ].	self assert: (data bytes at: 5) equals: 0.	self assert: (data bytes at: 6) equals: 127.	self assert: (data bytes at: 7) equals: 0.	self assert: (data bytes at: 8) equals: 127]{ #category : 'tests' }SpWin32ImageTest >> testImagePresenterUsesDedicatedKindAndInitialImage [	| form presenter adapter |	form := Form extent: 7 @ 5 depth: 32.	form fillColor: Color blue.	presenter := SpImagePresenter new image: form; yourself.	adapter := SpWin32ImageAdapter adapt: presenter.	self assert: adapter widget kind equals: SpWin32Runtime controlImage.	self assert: adapter widget imageData extent equals: 7 @ 5.	self deny: adapter widget imageAutoScale.	self assert: adapter widget preferredExtent equals: 7 @ 5]{ #category : 'tests' }SpWin32ImageTest >> testImageChangeReplacesAndNilClearsTransport [	| first second presenter adapter |	first := Form extent: 2 @ 3 depth: 32.	first fillColor: Color red.	second := Form extent: 5 @ 4 depth: 32.	second fillColor: Color green.	presenter := SpImagePresenter new image: first; yourself.	adapter := SpWin32ImageAdapter adapt: presenter.	presenter image: second.	self assert: adapter widget imageData extent equals: 5 @ 4.	self assert: adapter widget preferredExtent equals: 5 @ 4.	presenter image: nil.	self assert: adapter widget imageData equals: nil]{ #category : 'tests' }SpWin32ImageTest >> testAutoScaleIsTransferredToNativeControl [	| presenter adapter |	presenter := SpImagePresenter new autoScale: true; yourself.	adapter := SpWin32ImageAdapter adapt: presenter.	self assert: adapter widget imageAutoScale]{ #category : 'tests' }SpWin32ImageTest >> testImageClickInvokesLegacyPresenterAction [	| presenter adapter clicked |	clicked := false.	presenter := SpImagePresenter new action: [ clicked := true ]; yourself.	adapter := SpWin32ImageAdapter adapt: presenter.	adapter win32Clicked.	self assert: clicked]{ #category : 'tests' }SpWin32ImageTest >> testRuntimeExposesImageKindAndV022Abi [	self assert: SpWin32Runtime abiVersion equals: 16r00290000.	self assert: SpWin32Runtime controlImage equals: 20]