Class {	#name : 'SpWin32ColumnViewTest',	#superclass : 'TestCase',	#category : 'Spec-Win32-Tests-ListView',	#package : 'Spec-Win32-Tests',	#tag : 'ListView'}{ #category : 'private' }SpWin32ColumnViewTest >> application [	^ SpApplication new useBackend: #Win32; yourself]{ #category : 'private' }SpWin32ColumnViewTest >> newPresenter [	| presenter |	presenter := SpColumnViewPresenter newApplication: self application.	presenter		addColumnTitle: 'Name'			setup: [ :builder | builder newLabel ]			bind: [ :label :association | label label: association key ];		addColumnTitle: 'Score'			setup: [ :builder | builder newLabel ]			bind: [ :label :association | label label: association value asString ];		items: { 'Alpha' -> 20. 'Beta' -> 10. 'Český 🙂' -> 30 }.	^ presenter]{ #category : 'tests' }SpWin32ColumnViewTest >> testBindingAndNativeKind [	| presenter adapter |	presenter := self newPresenter.	adapter := SpWin32ColumnViewAdapter adapt: presenter.	self assert: adapter class adaptingName equals: #ColumnViewAdapter.	self assert: adapter widget kind equals: SpWin32Runtime controlTable.	self assert: adapter widget columnCount equals: 2.	self assert: adapter widget rowCount equals: 3]{ #category : 'tests' }SpWin32ColumnViewTest >> testColumnSetupBindBuildsCellMatrix [	| presenter adapter |	presenter := self newPresenter.	adapter := SpWin32ColumnViewAdapter adapt: presenter.	self assert: adapter cellStrings equals: #('Alpha' '20' 'Beta' '10' 'Český 🙂' '30').	self assert: adapter cellPresenters size equals: 6.	self assert: adapter widget columnTitles equals: #('Name' 'Score')]{ #category : 'tests' }SpWin32ColumnViewTest >> testImagesCanAppearInMultipleColumns [	| presenter adapter red blue |	red := Form extent: 10@12 depth: 32.	red fillColor: Color red.	blue := Form extent: 18@14 depth: 32.	blue fillColor: Color blue.	presenter := SpColumnViewPresenter newApplication: self application.	presenter		addColumnTitle: 'First'			setup: [ :builder |				| cell |				cell := builder newPresenter.				cell layout: (SpBoxLayout newLeftToRight					add: builder newImage expand: false;					add: builder newLabel;					yourself).				cell ]				bind: [ :cell :item |					cell layout children first image: red.					cell layout children second label: item ];		addColumnTitle: 'Second'			setup: [ :builder |				| cell |				cell := builder newPresenter.				cell layout: (SpBoxLayout newLeftToRight					add: builder newImage expand: false;					add: builder newLabel;					yourself).				cell ]				bind: [ :cell :item |					cell layout children first image: blue.					cell layout children second label: item asUppercase ];		items: #('alpha' 'beta').	adapter := SpWin32ColumnViewAdapter adapt: presenter.	self assert: adapter cellStrings equals: #('alpha' 'ALPHA' 'beta' 'BETA').	self assert: adapter cellImages size equals: 4.	self assert: adapter cellImages first extent equals: 10@12.	self assert: adapter cellImages second extent equals: 18@14.	self assert: adapter widget cellImages second extent equals: 18@14]{ #category : 'tests' }SpWin32ColumnViewTest >> testInteractiveCellPresenterIsExplicitlyRejected [	| presenter |	presenter := SpColumnViewPresenter newApplication: self application.	presenter		addColumnTitle: 'Action'			setup: [ :builder | builder newButton ]			bind: [ :button :item | button label: item ];		items: #('Run').	self should: [ SpWin32ColumnViewAdapter adapt: presenter ] raise: Error]{ #category : 'tests' }SpWin32ColumnViewTest >> testColumnMetadataFollowsWidthExpansionHeadersAndResizable [	| presenter adapter first second |	presenter := SpColumnViewPresenter newApplication: self application.	first := SpColumnViewColumn new		title: 'Fixed';		width: 77;		beNotExpandable;		yourself.	second := SpColumnViewColumn new title: 'Flexible'; yourself.	presenter addColumn: first; addColumn: second; items: #('x').	adapter := SpWin32ColumnViewAdapter adapt: presenter.	self assert: adapter widget columnWidths equals: #(77 100).	self assert: adapter widget columnExpandables equals: #(false true).	self assert: adapter widget headersVisible.	self deny: adapter widget resizable.	presenter hideColumnHeaders.	presenter addColumnTitle: 'Third' setup: [ :b | b newLabel ] bind: [ :l :i | l label: i ].	self deny: adapter widget headersVisible.	presenter beResizable.	self assert: adapter widget resizable]{ #category : 'tests' }SpWin32ColumnViewTest >> testSelectionSynchronizesBothWays [	| presenter adapter |	presenter := self newPresenter.	adapter := SpWin32ColumnViewAdapter adapt: presenter.	presenter adapter: adapter.	presenter selectIndex: 2.	self assert: adapter selectedIndexes equals: #(2).	adapter win32ListSelectionChanged: #(3) changedIndex: 3 selected: true.	self assert: presenter selectedItem key equals: 'Český 🙂']{ #category : 'tests' }SpWin32ColumnViewTest >> testActivationUsesColumnViewPresenter [	| presenter adapter activated |	presenter := self newPresenter.	activated := nil.	presenter whenActivatedDo: [ :selection | activated := selection selectedItem ].	adapter := SpWin32ColumnViewAdapter adapt: presenter.	presenter adapter: adapter.	adapter win32ActivatedAt: 2 source: 2.	self assert: activated key equals: 'Beta']{ #category : 'tests' }SpWin32ColumnViewTest >> testSortableHeaderClickChangesVisibleOrderAndPreservesSelection [	| presenter content adapter score |	presenter := SpEasyColumnViewPresenter newApplication: self application.	presenter		addColumn: (SpStringTableColumn title: 'Name' evaluated: #key);		addColumn: ((SpStringTableColumn title: 'Score' evaluated: #value) beSortable; yourself);		items: { 'Alpha' -> 20. 'Beta' -> 10. 'Gamma' -> 30 }.	content := presenter contentView.	adapter := SpWin32ColumnViewAdapter adapt: content.	content adapter: adapter.	content selectIndex: 1.	score := content columns second.	self assert: score isSortable.	adapter win32ColumnClicked: 2.	self assert: (adapter elementAt: 1) key equals: 'Beta'.	self assert: content selectedItem key equals: 'Alpha'.	self assert: content selectedIndex equals: 2.	adapter win32ColumnClicked: 2.	self assert: (adapter elementAt: 1) key equals: 'Gamma']{ #category : 'tests' }SpWin32ColumnViewTest >> testModelRefreshRebuildsTextAndImages [	| presenter adapter icon |	icon := Form extent: 8@8 depth: 32.	icon fillColor: Color green.	presenter := SpColumnViewPresenter newApplication: self application.	presenter		addColumnTitle: 'Cell'			setup: [ :builder |				| cell |				cell := builder newPresenter.				cell layout: (SpBoxLayout newLeftToRight					add: builder newImage expand: false;					add: builder newLabel;					yourself).				cell ]				bind: [ :cell :item |					cell layout children first image: icon.					cell layout children second label: item ];		items: #('Old').	adapter := SpWin32ColumnViewAdapter adapt: presenter.	presenter adapter: adapter.	presenter items: #('New one' 'New two').	self assert: adapter cellStrings equals: #('New one' 'New two').	self assert: adapter widget rowCount equals: 2.	self assert: adapter widget cellImages size equals: 2]{ #category : 'tests' }SpWin32ColumnViewTest >> testEasyColumnViewBuildsWithWin32Adapter [	| easy widget content |	easy := SpEasyColumnViewPresenter newApplication: self application.	easy		addColumn: (SpStringTableColumn title: 'Name' evaluated: #yourself);		items: #('Alpha' 'Beta').	widget := easy build.	content := easy contentView.	self assert: widget notNil.	self assert: content adapter class equals: SpWin32ColumnViewAdapter.	self assert: content adapter cellStrings equals: #('Alpha' 'Beta')]{ #category : 'tests' }SpWin32ColumnViewTest >> testSelectedRowPresenterRemainsNilForNativeItemPath [	| presenter adapter |	presenter := self newPresenter.	adapter := SpWin32ColumnViewAdapter adapt: presenter.	presenter adapter: adapter.	presenter selectIndex: 1.	self assert: presenter selectedRowPresenter isNil]{ #category : 'tests' }SpWin32ColumnViewTest >> testSelectionAfterSortAndModelRefreshUsesVisibleIndex [	| presenter content adapter |	presenter := SpEasyColumnViewPresenter newApplication: self application.	presenter		addColumn: ((SpStringTableColumn title: 'Score' evaluated: #value) beSortable; yourself);		items: { 'Alpha' -> 20. 'Beta' -> 10. 'Gamma' -> 30 }.	content := presenter contentView.	adapter := SpWin32ColumnViewAdapter adapt: content.	content adapter: adapter.	content selectIndex: 2.	adapter win32ColumnClicked: 1.	content items: { 'One' -> 101. 'Two' -> 202. 'Three' -> 303 }.	content selectIndex: 3.	self assert: content selectedIndex equals: 3.	self assert: adapter selectedIndexes equals: #(3)]