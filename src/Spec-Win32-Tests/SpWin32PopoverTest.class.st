Class {	#name : 'SpWin32PopoverTest',	#superclass : 'TestCase',	#category : 'Spec-Win32-Tests-Popover',	#package : 'Spec-Win32-Tests',	#tag : 'Popover'}{ #category : 'private' }SpWin32PopoverTest >> application [	^ SpApplication new useBackend: #Win32; yourself]{ #category : 'tests' }SpWin32PopoverTest >> testAdapterBindingsResolvePopoverFamily [	| bindings |	bindings := SpWin32AdapterBindings new.	self assert: (bindings adapterClass: #PopoverAdapter) equals: SpWin32PopoverAdapter.	self		assert: (bindings adapterClass: #ToolbarPopoverButtonAdapter)		equals: SpWin32ToolbarPopoverButtonAdapter]{ #category : 'tests' }SpWin32PopoverTest >> testGeometryPositionsAroundAnchor [	| anchor extent |	anchor := 100 @ 100 extent: 80 @ 30.	extent := 60 @ 40.	self		assert: (SpWin32PopoverGeometry originForPosition: SpPopoverPosition top anchor: anchor extent: extent)		equals: 110 @ 60.	self		assert: (SpWin32PopoverGeometry originForPosition: SpPopoverPosition bottom anchor: anchor extent: extent)		equals: 110 @ 130.	self		assert: (SpWin32PopoverGeometry originForPosition: SpPopoverPosition left anchor: anchor extent: extent)		equals: 40 @ 95.	self		assert: (SpWin32PopoverGeometry originForPosition: SpPopoverPosition right anchor: anchor extent: extent)		equals: 180 @ 95]{ #category : 'tests' }SpWin32PopoverTest >> testToolbarPopoverButtonUsesNativeButton [	| toolbar button |	toolbar := SpToolbarPresenter newApplication: self application.	button := SpToolbarPopoverButtonPresenter new		label: 'Details';		content: [ SpLabelPresenter newApplication: toolbar application ];		yourself.	toolbar addItem: button.	SpWin32ToolbarAdapter adapt: toolbar.	self assert: button adapter class equals: SpWin32ToolbarPopoverButtonAdapter.	self assert: button adapter widget kind equals: SpWin32Runtime controlButton.	self assert: button adapter widget text equals: 'Details']{ #category : 'tests' }SpWin32PopoverTest >> testToolbarPopoverContentBlockIsResolvedLazily [	| toolbar button value first second |	toolbar := SpToolbarPresenter newApplication: self application.	value := 'One'.	button := SpToolbarPopoverButtonPresenter new		label: 'Details';		content: [ (SpLabelPresenter newApplication: toolbar application) label: value; yourself ];		yourself.	toolbar addItem: button.	SpWin32ToolbarAdapter adapt: toolbar.	first := button adapter resolvedContentPresenter.	self assert: first label equals: 'One'.	value := 'Two'.	second := button adapter resolvedContentPresenter.	self assert: second label equals: 'Two'.	self deny: first identicalTo: second]{ #category : 'tests' }SpWin32PopoverTest >> testPopoverRuntimeAbiIsV023 [	self assert: SpWin32Runtime abiVersion equals: 16r00290000.	self assert: SpWin32Runtime eventPopupDismissRequested equals: 27.	self assert: SpWin32Runtime swShowNoActivate equals: 4]{ #category : 'tests' }SpWin32PopoverTest >> testPopoverAdapterDeclaresLifecycleProtocol [	self assert: (SpWin32PopoverAdapter canUnderstand: #popupModal:pointingTo:).	self assert: (SpWin32PopoverAdapter canUnderstand: #dismiss).	self assert: (SpWin32PopoverAdapter canUnderstand: #win32PopupDismissRequested).	self assert: (SpWin32PopoverAdapter canUnderstand: #win32ResizedFrom:to:).	self assert: (SpWin32PopoverAdapter canUnderstand: #rebuildContent)]{ #category : 'tests' }SpWin32PopoverTest >> testGeometryClampsPopupToMonitorWorkArea [	| work |	work := -1920 @ 0 extent: 1920 @ 1040.	self		assert: (SpWin32PopoverGeometry clampOrigin: -1940 @ -20 extent: 220 @ 120 toWorkArea: work)		equals: -1920 @ 0.	self		assert: (SpWin32PopoverGeometry clampOrigin: -80 @ 1000 extent: 220 @ 120 toWorkArea: work)		equals: -220 @ 920]