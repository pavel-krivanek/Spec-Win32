Class {	#name : 'SpWin32DialogWindowTest',	#superclass : 'TestCase',	#category : 'Spec-Win32-Tests-Windows',	#package : 'Spec-Win32-Tests',	#tag : 'Windows'}{ #category : 'tests' }SpWin32DialogWindowTest >> testAdapterBindingResolvesDialogWindowAdapter [	self		assert: (SpWin32AdapterBindings new adapterClass: #DialogWindowAdapter)		equals: SpWin32DialogWindowAdapter]{ #category : 'tests' }SpWin32DialogWindowTest >> testDialogAdapterProvidesEscapeAndReturnShortcuts [	| group matcher commands |	group := SpWin32DialogWindowAdapter new defaultActionGroup.	commands := group allCommands.	matcher := SpWin32ShortcutMatcher new.	self assert: commands size equals: 2.	self assert: (commands anySatisfy: [ :command |		matcher			matches: command shortcutKey			event: (SpWin32KeyEvent keyValue: 16r1B modifiers: 0) ]).	self assert: (commands anySatisfy: [ :command |		matcher			matches: command shortcutKey			event: (SpWin32KeyEvent keyValue: 16r0D modifiers: 0) ])]{ #category : 'tests' }SpWin32DialogWindowTest >> testDialogContainerButtonBarVisibilityControlsHeight [	| first second container runtime |	runtime := SpWin32Runtime default.	first := SpWin32NativeControl		runtime: runtime		kind: SpWin32Runtime controlButton		text: 'Cancel'		preferredExtent: 75@28.	second := SpWin32NativeControl		runtime: runtime		kind: SpWin32Runtime controlButton		text: 'Ok'		preferredExtent: 75@28.	container := SpWin32DialogContainer		content: nil		buttons: { first. second }		runtime: runtime.	self assert: container buttonBarHeight equals: 48.	container buttonsVisible: false.	self assert: container buttonBarHeight equals: 0.	self deny: first isVisible.	self deny: second isVisible.	container buttonsVisible: true.	self assert: container buttonBarHeight equals: 48.	self assert: first isVisible.	self assert: second isVisible]{ #category : 'tests' }SpWin32DialogWindowTest >> testDialogWindowAdapterKeepsWindowFoundationProtocol [	self assert: (SpWin32DialogWindowAdapter canUnderstand: #centeredRelativeTo:).	self assert: (SpWin32DialogWindowAdapter canUnderstand: #ownerWindow:).	self assert: (SpWin32DialogWindowAdapter canUnderstand: #isMinimized).	self assert: (SpWin32DialogWindowAdapter canUnderstand: #isTopWindow)]