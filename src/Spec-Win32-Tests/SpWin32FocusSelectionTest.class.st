Class {	#name : 'SpWin32FocusSelectionTest',	#superclass : 'TestCase',	#category : 'Spec-Win32-Tests-Focus',	#package : 'Spec-Win32-Tests',	#tag : 'Focus'}{ #category : 'tests' }SpWin32FocusSelectionTest >> testAbiAndFocusEventCodesAreExplicit [	self assert: SpWin32Runtime abiVersion equals: 16r00290000.	self assert: SpWin32Runtime eventFocusReceived equals: 10.	self assert: SpWin32Runtime eventFocusLost equals: 11]{ #category : 'tests' }SpWin32FocusSelectionTest >> testDeferredEditSelectionUsesSpecIntervalSemantics [	| presenter adapter |	presenter := SpTextInputFieldPresenter new		text: 'A🙂BC';		selectionInterval: (2 to: 2);		yourself.	adapter := SpWin32TextInputFieldAdapter adapt: presenter.	self assert: adapter widget selectionOffsets equals: 1 @ 2.	self assert: adapter selection equals: (2 to: 2)]{ #category : 'tests' }SpWin32FocusSelectionTest >> testDeferredCaretRoundTripsThroughSelectionOffsets [	| presenter adapter |	presenter := SpTextInputFieldPresenter new text: 'abcdef'; yourself.	adapter := SpWin32TextInputFieldAdapter adapt: presenter.	adapter cursorPositionIndex: 4.	self assert: adapter widget selectionOffsets equals: 3 @ 3.	self assert: adapter selection isEmpty.	self assert: adapter cursorPositionIndex equals: 4]{ #category : 'tests' }SpWin32FocusSelectionTest >> testSelectAllUpdatesDeferredNativeSelection [	| presenter adapter |	presenter := SpTextInputFieldPresenter new text: 'hello'; yourself.	adapter := SpWin32TextInputFieldAdapter adapt: presenter.	adapter selectAll.	self assert: adapter widget selectionOffsets equals: 0 @ 5.	self assert: adapter selection equals: (1 to: 5)]{ #category : 'tests' }SpWin32FocusSelectionTest >> testFocusEventsRegisteredBeforeAdapterBuildAreDispatched [	| presenter adapter received lost |	received := 0.	lost := 0.	presenter := SpTextInputFieldPresenter new.	presenter eventHandler		whenFocusReceivedDo: [ received := received + 1 ];		whenFocusLostDo: [ lost := lost + 1 ].	adapter := SpWin32TextInputFieldAdapter adapt: presenter.	adapter win32FocusReceived.	adapter win32FocusLost.	self assert: received equals: 1.	self assert: lost equals: 1]{ #category : 'tests' }SpWin32FocusSelectionTest >> testFocusEventsRegisteredAfterAdapterBuildAreDispatched [	| presenter adapter received |	received := false.	presenter := SpTextInputFieldPresenter new.	adapter := SpWin32TextInputFieldAdapter adapt: presenter.	presenter adapter: adapter.	presenter eventHandler whenFocusReceivedDo: [ received := true ].	adapter win32FocusReceived.	self assert: received]{ #category : 'tests' }SpWin32FocusSelectionTest >> testNativeFocusEventsUpdateDeferredFocusState [	| presenter adapter control |	presenter := SpTextInputFieldPresenter new.	adapter := SpWin32TextInputFieldAdapter adapt: presenter.	control := adapter widget.	self deny: control hasKeyboardFocus.	control		nativeEventType: SpWin32Runtime eventFocusReceived		argument1: 0		argument2: 0.	self assert: control hasKeyboardFocus.	control		nativeEventType: SpWin32Runtime eventFocusLost		argument1: 0		argument2: 0.	self deny: control hasKeyboardFocus]{ #category : 'tests' }SpWin32FocusSelectionTest >> testTakeKeyboardFocusSelectsTextButWithoutSelectingPreservesSelection [	| presenter adapter |	presenter := SpTextInputFieldPresenter new text: 'abcdef'; yourself.	adapter := SpWin32TextInputFieldAdapter adapt: presenter.	adapter cursorPositionIndex: 3.	adapter takeKeyboardFocusWithoutSelecting.	self assert: adapter widget selectionOffsets equals: 2 @ 2.	adapter takeKeyboardFocus.	self assert: adapter widget selectionOffsets equals: 0 @ 6]{ #category : 'tests' }SpWin32FocusSelectionTest >> testNativeTextChangeDoesNotResetDeferredCaret [	| presenter adapter control |	presenter := SpTextInputFieldPresenter new text: 'abc'; yourself.	adapter := SpWin32TextInputFieldAdapter adapt: presenter.	presenter adapter: adapter.	control := adapter widget.	control text: 'abcd'.	control selectionStart: 1 end: 1.	adapter win32TextChanged: 'abcd'.	self assert: presenter text equals: 'abcd'.	self assert: control selectionOffsets equals: 1 @ 1]