Class {	#name : 'SpWin32DiffUnifiedAdapterTest',	#superclass : 'TestCase',	#category : 'Spec-Win32-Tests-Code',	#package : 'Spec-Win32-Tests',	#tag : 'Code'}{ #category : 'private' }SpWin32DiffUnifiedAdapterTest >> newAdaptedPresenter [	| presenter adapter |	presenter := SpDiffUnifiedPresenter new.	presenter		leftText: 'same', String lf, 'gone', String lf, 'tail';		rightText: 'same', String lf, 'added', String lf, 'tail'.	adapter := SpWin32DiffUnifiedAdapter adapt: presenter.	presenter adapter: adapter.	^ { presenter. adapter }]{ #category : 'tests' }SpWin32DiffUnifiedAdapterTest >> testBindingAndAbiRemainStable [	self		assert: (SpWin32AdapterBindings new adapterClass: #DiffUnifiedAdapter)		equals: SpWin32DiffUnifiedAdapter.	self assert: SpWin32Runtime abiVersion equals: 16r00290000]{ #category : 'tests' }SpWin32DiffUnifiedAdapterTest >> testDefaultModeShowsOnlyUnifiedDestinationPane [	| pair presenter adapter |	pair := self newAdaptedPresenter.	presenter := pair first.	adapter := pair second.	self assert: presenter showOnlyDestination.	self deny: adapter leftControl isVisible.	self assert: adapter rightControl isVisible.	self deny: adapter rightControl editable.	self deny: adapter rightControl codeLineNumbers]{ #category : 'tests' }SpWin32DiffUnifiedAdapterTest >> testUnifiedProjectionContainsMatchDeleteInsertAndMatch [	| adapter lines decorations |	adapter := self newAdaptedPresenter second.	lines := adapter rightControl text lines.	self assert: lines equals: #('same' 'gone' 'added' 'tail').	decorations := adapter rightControl codeLineDecorations.	self assert: decorations size equals: 8.	self assert: decorations first equals: 1.	self assert: decorations third equals: 2.	self assert: decorations fifth equals: 2.	self assert: decorations seventh equals: 1]{ #category : 'tests' }SpWin32DiffUnifiedAdapterTest >> testSourcePaneKeepsOriginalSourceWithoutDecorations [	| adapter |	adapter := self newAdaptedPresenter second.	self assert: adapter leftControl text lines equals: #('same' 'gone' 'tail').	self assert: adapter leftControl codeLineDecorations isEmpty]{ #category : 'tests' }SpWin32DiffUnifiedAdapterTest >> testInheritedSourceAndBothModesRemainUsable [	| pair presenter adapter |	pair := self newAdaptedPresenter.	presenter := pair first.	adapter := pair second.	presenter showOnlyDestination: false.	presenter showOnlySource: true.	self assert: adapter leftControl isVisible.	self deny: adapter rightControl isVisible.	presenter showBoth.	self assert: adapter leftControl isVisible.	self assert: adapter rightControl isVisible]{ #category : 'tests' }SpWin32DiffUnifiedAdapterTest >> testLiveTextReplacementKeepsNativeControls [	| pair presenter adapter left right |	pair := self newAdaptedPresenter.	presenter := pair first.	adapter := pair second.	left := adapter leftControl.	right := adapter rightControl.	presenter leftText: 'one', String lf, 'two'.	presenter rightText: 'one', String lf, 'three', String lf, 'four'.	self assert: adapter leftControl identicalTo: left.	self assert: adapter rightControl identicalTo: right.	self assert: adapter leftControl text lines equals: #('one' 'two').	self assert: adapter rightControl text lines equals: #('one' 'three' 'four' 'two')]{ #category : 'tests' }SpWin32DiffUnifiedAdapterTest >> testWrapAndProtocolUpdatesReuseDiffInfrastructure [	| pair presenter adapter |	pair := self newAdaptedPresenter.	presenter := pair first.	adapter := pair second.	presenter beWrapped: false.	self deny: adapter leftControl textWrapWord.	self deny: adapter rightControl textWrapWord.	presenter leftLabel: 'Before'.	presenter rightLabel: 'Unified'.	presenter showOptions: false.	presenter contextClass: Object.	self assert: adapter rightControl notNil]