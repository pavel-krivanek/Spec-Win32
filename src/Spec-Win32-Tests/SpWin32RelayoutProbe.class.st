Class {	#name : 'SpWin32RelayoutProbe',	#superclass : 'Object',	#instVars : [		'count'	],	#category : 'Spec-Win32-Tests-Support',	#package : 'Spec-Win32-Tests',	#tag : 'Support'}{ #category : 'initialization' }SpWin32RelayoutProbe >> initialize [	super initialize.	count := 0]{ #category : 'accessing' }SpWin32RelayoutProbe >> count [	^ count]{ #category : 'layout' }SpWin32RelayoutProbe >> requestRelayout [	count := count + 1]