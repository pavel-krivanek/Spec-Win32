Class {	#name : 'SpWin32AlexandrieAdapterTest',	#superclass : 'TestCase',	#category : 'Spec-Win32-Tests-Controls',	#package : 'Spec-Win32-Tests',	#tag : 'Controls'}{ #category : 'private' }SpWin32AlexandrieAdapterTest >> newApplication [	^ SpApplication new useBackend: #Win32]{ #category : 'private' }SpWin32AlexandrieAdapterTest >> newPresenter [	| presenter |	presenter := SpWin32AlexandrieTestPresenter newApplication: self newApplication.	presenter		surfaceExtent: 80 @ 60;		drawBlock: [ :context | context fillHalfAlphaRed ].	^ presenter]{ #category : 'private' }SpWin32AlexandrieAdapterTest >> newAdapterFor: aPresenter [	^ SpWin32AlexandrieAdapterTestDouble adapt: aPresenter]{ #category : 'tests' }SpWin32AlexandrieAdapterTest >> testBindingResolvesAlexandrieAdapter [	self		assert: (SpWin32AdapterBindings new adapterClass: #AlexandrieAdapter)		equals: SpWin32AlexandrieAdapter]{ #category : 'tests' }SpWin32AlexandrieAdapterTest >> testBackendLoadsWithoutAlexandrieInstalled [	(Smalltalk globals includesKey: #AeCairoImageSurface) ifTrue: [ ^ self ].	self		should: [ (SpWin32AlexandrieAdapter adapt: self newPresenter) redraw ]		raise: Error		whoseDescriptionIncludes: 'Alexandrie is not loaded'		description: 'The optional dependency should be checked only when the adapter is rendered.']{ #category : 'tests' }SpWin32AlexandrieAdapterTest >> testBuildUsesSharedResizeAwareImageSurfaceAndPresenterExtent [	| adapter widget |	adapter := self newAdapterFor: self newPresenter.	widget := adapter widget.	self assert: widget class equals: SpWin32AlexandrieSurfaceControl.	self assert: (widget isKindOf: SpWin32RenderedSurfaceControl).	self assert: widget kind equals: SpWin32Runtime controlImage.	self assert: widget preferredExtent equals: 80 @ 60.	self deny: widget imageAutoScale]{ #category : 'tests' }SpWin32AlexandrieAdapterTest >> testRedrawPassesContextAndBoundingBox [	| presenter adapter receivedContext receivedBounds |	presenter := self newPresenter.	presenter drawBlock: [ :context :bounds |		receivedContext := context.		receivedBounds := bounds.		context fillHalfAlphaRed ].	adapter := self newAdapterFor: presenter.	adapter redraw.	self assert: (receivedContext isKindOf: SpWin32AlexandrieTestContext).	self assert: receivedBounds equals: (0 @ 0 extent: 80 @ 60).	self assert: adapter surface extent equals: 80 @ 60.	self assert: adapter widget imageData extent equals: 80 @ 60]{ #category : 'tests' }SpWin32AlexandrieAdapterTest >> testOneArgumentDrawBlockIsSupported [	| presenter adapter receivedContext |	presenter := self newPresenter.	presenter drawBlock: [ :context |		receivedContext := context.		context fillHalfAlphaRed ].	adapter := self newAdapterFor: presenter.	adapter redraw.	self assert: (receivedContext isKindOf: SpWin32AlexandrieTestContext)]{ #category : 'tests' }SpWin32AlexandrieAdapterTest >> testChangingDrawBlockRedrawsStoredImage [	| presenter adapter count |	presenter := self newPresenter.	count := 0.	presenter drawBlock: [ :context | count := count + 1 ].	adapter := self newAdapterFor: presenter.	presenter adapter: adapter.	adapter redraw.	self assert: count equals: 1.	presenter drawBlock: [ :context | count := count + 10 ].	self assert: count equals: 11.	self assert: adapter widget imageData extent equals: 80 @ 60]{ #category : 'tests' }SpWin32AlexandrieAdapterTest >> testSurfaceExtentChangeUpdatesPreferredExtentAndSurface [	| presenter adapter |	presenter := self newPresenter.	adapter := self newAdapterFor: presenter.	presenter adapter: adapter.	adapter redraw.	presenter surfaceExtent: 123 @ 77.	self assert: adapter widget preferredExtent equals: 123 @ 77.	self assert: adapter surface extent equals: 123 @ 77.	self assert: adapter widget imageData extent equals: 123 @ 77]{ #category : 'tests' }SpWin32AlexandrieAdapterTest >> testExplicitRedrawReusesSurfaceAtSameExtent [	| adapter firstSurface |	adapter := self newAdapterFor: self newPresenter.	adapter redraw.	firstSurface := adapter surface.	adapter redraw.	self assert: adapter surface identicalTo: firstSurface.	self assert: adapter surface contextCount equals: 2]{ #category : 'tests' }SpWin32AlexandrieAdapterTest >> testNativeImageClickEventIsSafelyConsumed [	| adapter |	adapter := self newAdapterFor: self newPresenter.	self		shouldnt: [			adapter widget				nativeEventType: SpWin32Runtime eventClicked				argument1: 0				argument2: 0 ]		raise: Error]{ #category : 'tests' }SpWin32AlexandrieAdapterTest >> testRenderedSurfaceUsesBulkPremultipliedBGRATransport [	| presenter adapter imageData bytes |	presenter := self newPresenter.	presenter surfaceExtent: 3 @ 2.	adapter := self newAdapterFor: presenter.	adapter redraw.	imageData := adapter widget imageData.	bytes := imageData bytes.	self assert: imageData extent equals: 3 @ 2.	self assert: bytes size equals: 24.	self assert: (bytes copyFrom: 1 to: 4) equals: #[ 0 0 127 127 ]]{ #category : 'tests' }SpWin32AlexandrieAdapterTest >> testSharedPointerTransportCompactsPaddedStride [	| pointer imageData |	pointer := ExternalAddress allocate: 24.	[		1 to: 24 do: [ :index | pointer unsignedByteAt: index put: index ].		imageData := SpWin32ImageData			fromPremultipliedBGRAPointer: pointer			width: 2			height: 2			stride: 12.		self assert: imageData bytes equals: #[ 1 2 3 4 5 6 7 8 13 14 15 16 17 18 19 20 ]	] ensure: [ pointer free ]]