Class {	#name : 'SpWin32BlockedDialogWindowTest',	#superclass : 'TestCase',	#category : 'Spec-Win32-Tests-Windows',	#package : 'Spec-Win32-Tests',	#tag : 'Windows'}{ #category : 'tests' }SpWin32BlockedDialogWindowTest >> testAdapterBindingResolvesBlockedDialogWindowAdapter [	self		assert: (SpWin32AdapterBindings new adapterClass: #BlockedDialogWindowAdapter)		equals: SpWin32BlockedDialogWindowAdapter]{ #category : 'tests' }SpWin32BlockedDialogWindowTest >> testBlockedDialogAdapterExtendsDialogNotModalAdapter [	self assert: SpWin32BlockedDialogWindowAdapter superclass equals: SpWin32DialogWindowAdapter.	self deny: (SpWin32BlockedDialogWindowAdapter inheritsFrom: SpWin32ModalWindowAdapter)]{ #category : 'tests' }SpWin32BlockedDialogWindowTest >> testBlockedDialogAdapterProvidesBlockingCompletionProtocol [	self assert: (SpWin32BlockedDialogWindowAdapter canUnderstand: #openWithDeferredAction:).	self assert: (SpWin32BlockedDialogWindowAdapter canUnderstand: #waitForBlockedCompletion).	self assert: (SpWin32BlockedDialogWindowAdapter canUnderstand: #completeBlocked).	self assert: (SpWin32BlockedDialogWindowAdapter canUnderstand: #windowClosed)]{ #category : 'tests' }SpWin32BlockedDialogWindowTest >> testBlockedDialogAdapterDoesNotUseModalWindowDisablingProtocol [	self deny: (SpWin32BlockedDialogWindowAdapter canUnderstand: #prepareModalState).	self deny: (SpWin32BlockedDialogWindowAdapter canUnderstand: #restoreModalState).	self deny: (SpWin32BlockedDialogWindowAdapter canUnderstand: #candidateWindowPresenters)]