Class {	#name : 'SpWin32TabLayoutTest',	#superclass : 'TestCase',	#category : 'Spec-Win32-Tests-Layout',	#package : 'Spec-Win32-Tests',	#tag : 'Layout'}{ #category : 'private' }SpWin32TabLayoutTest >> buildTwoPageTabInitialIndex: anIndex [	| application root first second layout |	application := SpApplication new useBackend: #Win32.	root := SpPresenter newApplication: application.	first := SpLabelPresenter newApplication: application.	first label: 'First content'.	second := SpButtonPresenter newApplication: application.	second label: 'Second content'.	layout := SpTabLayout new		initialPageIndex: anIndex;		add: first label: 'First';		add: second label: 'Second';		yourself.	root layout: layout.	root build.	^ { root. first. second. layout }]{ #category : 'tests' }SpWin32TabLayoutTest >> testAdapterBindingResolvesTabAdapter [	self		assert: (SpWin32AdapterBindings new adapterClass: #TabAdapter)		equals: SpWin32TabAdapter]{ #category : 'tests' }SpWin32TabLayoutTest >> testBuildUsesDedicatedTabContainerAndLabels [	| built root first second layout widget |	built := self buildTwoPageTabInitialIndex: 1.	root := built first.	first := built second.	second := built third.	layout := built fourth.	widget := root adapter widget.	self assert: root adapter class equals: SpWin32TabAdapter.	self assert: widget class equals: SpWin32TabContainer.	self assert: widget numberOfTabs equals: 2.	self assert: widget items equals: #('First' 'Second').	self assert: widget children equals: { first adapter widget. second adapter widget }.	self assert: layout adapter identicalTo: root adapter]{ #category : 'tests' }SpWin32TabLayoutTest >> testInitialPageIndexIsPreserved [	| built root second |	built := self buildTwoPageTabInitialIndex: 2.	root := built first.	second := built third.	self assert: root adapter widget selectedIndex equals: 2.	self assert: root adapter widget selectedPageWidget identicalTo: second adapter widget]{ #category : 'tests' }SpWin32TabLayoutTest >> testProgrammaticSelectionAnnouncesUnselectedThenSelected [	| built root first second layout events |	built := self buildTwoPageTabInitialIndex: 2.	root := built first.	first := built second.	second := built third.	layout := built fourth.	events := OrderedCollection new.	layout whenTabUnselectedDo: [ :announcement | events add: #unselected -> announcement presenter ].	layout whenTabSelectedDo: [ :announcement | events add: #selected -> announcement presenter ].	layout selectIndex: 1.	self assert: root adapter widget selectedIndex equals: 1.	self assert: events asArray equals: { #unselected -> second. #selected -> first }]{ #category : 'tests' }SpWin32TabLayoutTest >> testNativeSelectionPathUpdatesSelectionAndAnnouncements [	| built root first second layout events |	built := self buildTwoPageTabInitialIndex: 1.	root := built first.	first := built second.	second := built third.	layout := built fourth.	events := OrderedCollection new.	layout whenTabUnselectedDo: [ :announcement | events add: #unselected -> announcement presenter ].	layout whenTabSelectedDo: [ :announcement | events add: #selected -> announcement presenter ].	root adapter widget instVarNamed: 'selectedIndex' put: 2.	root adapter win32SelectionChanged: 2.	self assert: root adapter widget selectedIndex equals: 2.	self assert: events asArray equals: { #unselected -> first. #selected -> second }]{ #category : 'tests' }SpWin32TabLayoutTest >> testDynamicAddAndSelectedRemovalKeepConsistentPage [	| built root second layout third |	built := self buildTwoPageTabInitialIndex: 2.	root := built first.	second := built third.	layout := built fourth.	third := SpLabelPresenter newApplication: root application.	third label: 'Third content'.	layout add: third label: 'Third'.	self assert: root adapter widget numberOfTabs equals: 3.	self assert: root adapter widget items equals: #('First' 'Second' 'Third').	layout remove: second.	self assert: root adapter widget numberOfTabs equals: 2.	self assert: root adapter widget selectedIndex equals: 2.	self assert: root adapter widget selectedPageWidget identicalTo: third adapter widget.	self assert: root adapter widget items equals: #('First' 'Third')]{ #category : 'tests' }SpWin32TabLayoutTest >> testNestedExecutableLayoutIsKeptAsPageWidget [	| application root nested label tabs widget |	application := SpApplication new useBackend: #Win32.	root := SpPresenter newApplication: application.	label := SpLabelPresenter newApplication: application.	label label: 'Nested'.	nested := SpBoxLayout newTopToBottom		add: label;		yourself.	tabs := SpTabLayout new		add: nested label: 'Nested page';		yourself.	root layout: tabs.	root build.	widget := root adapter widget pageWidgetAt: 1.	self assert: widget class equals: SpWin32BoxContainer.	self assert: widget children equals: { label adapter widget }]{ #category : 'tests' }SpWin32TabLayoutTest >> testTabContentControlKindAndAbiAreReserved [	self assert: SpWin32Runtime controlTabContent equals: 25.	self assert: SpWin32Runtime abiVersion equals: 16r00290000]{ #category : 'tests' }SpWin32TabLayoutTest >> testRootCompositeSupportsWindowLifecycleProtocol [	self assert: (SpWin32TabContainer canUnderstand: #realizeIn:extent:).	self assert: (SpWin32TabContainer canUnderstand: #relayoutExtent:)]