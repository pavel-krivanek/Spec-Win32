Class {	#name : 'SpWin32PanedLayoutTest',	#superclass : 'TestCase',	#category : 'Spec-Win32-Tests-Layout',	#package : 'Spec-Win32-Tests',	#tag : 'Layout'}{ #category : 'private' }SpWin32PanedLayoutTest >> controlExtent: anExtent [	^ SpWin32NativeControl		runtime: SpWin32Runtime new		kind: SpWin32Runtime controlButton		text: ''		preferredExtent: anExtent]{ #category : 'tests' }SpWin32PanedLayoutTest >> testAdapterBindingResolvesPanedAdapter [	self		assert: (SpWin32AdapterBindings new adapterClass: #PanedAdapter)		equals: SpWin32PanedAdapter]{ #category : 'tests' }SpWin32PanedLayoutTest >> testAdapterUsesDedicatedPanedContainer [	| layout adapter |	layout := SpPanedLayout newLeftToRight.	adapter := SpWin32PanedAdapter new.	adapter layout: layout.	self assert: adapter widget class equals: SpWin32PanedContainer.	self assert: adapter isEmpty]{ #category : 'tests' }SpWin32PanedLayoutTest >> testChildrenKeepExplicitPaneOrder [	| layout container first second firstConstraints secondConstraints |	layout := SpPanedLayout newLeftToRight.	container := SpWin32PanedContainer layout: layout runtime: SpWin32Runtime new.	first := self controlExtent: 80@30.	second := self controlExtent: 90@40.	firstConstraints := SpPanedConstraints new.	secondConstraints := SpPanedConstraints new.	container child: second at: 2 constraints: secondConstraints.	container child: first at: 1 constraints: firstConstraints.	self assert: container children asArray equals: { first. second }]{ #category : 'tests' }SpWin32PanedLayoutTest >> testFixedInitialPositionIsInPixels [	| layout container |	layout := SpPanedLayout newLeftToRight positionOfSlider: 135; yourself.	container := SpWin32PanedContainer layout: layout runtime: SpWin32Runtime new.	self assert: (container initialPositionForExtent: 500@300) equals: 135]{ #category : 'tests' }SpWin32PanedLayoutTest >> testPercentageInitialPositionUsesMainAxis [	| horizontal vertical |	horizontal := SpWin32PanedContainer		layout: (SpPanedLayout newLeftToRight positionOfSlider: 40 percent; yourself)		runtime: SpWin32Runtime new.	vertical := SpWin32PanedContainer		layout: (SpPanedLayout newTopToBottom positionOfSlider: 25 percent; yourself)		runtime: SpWin32Runtime new.	self assert: (horizontal initialPositionForExtent: 500@300) equals: 200.	self assert: (vertical initialPositionForExtent: 500@300) equals: 75]{ #category : 'tests' }SpWin32PanedLayoutTest >> testPreferredExtentCombinesChildrenAlongMainAxis [	| layout container first second |	layout := SpPanedLayout newLeftToRight.	container := SpWin32PanedContainer layout: layout runtime: SpWin32Runtime new.	first := self controlExtent: 80@30.	second := self controlExtent: 90@40.	container child: first at: 1 constraints: SpPanedConstraints new.	container child: second at: 2 constraints: SpPanedConstraints new.	container instVarNamed: 'firstNaturalExtent' put: 80@30.	container instVarNamed: 'secondNaturalExtent' put: 90@40.	self assert: container preferredExtent equals: 176@40]{ #category : 'tests' }SpWin32PanedLayoutTest >> testRemoveChildKeepsOtherPane [	| layout container first second |	layout := SpPanedLayout newLeftToRight.	container := SpWin32PanedContainer layout: layout runtime: SpWin32Runtime new.	first := self controlExtent: 80@30.	second := self controlExtent: 90@40.	container child: first at: 1 constraints: SpPanedConstraints new.	container child: second at: 2 constraints: SpPanedConstraints new.	container removeChildWidget: first.	self assert: container children asArray equals: { second }.	self assert: container secondChild identicalTo: second]{ #category : 'tests' }SpWin32PanedLayoutTest >> testPanedControlKindsAndEventAreReserved [	self assert: SpWin32Runtime controlPaned equals: 23.	self assert: SpWin32Runtime controlPanedContent equals: 24.	self assert: SpWin32Runtime eventPanedPositionChanged equals: 29]{ #category : 'tests' }SpWin32PanedLayoutTest >> testVerticalPreferredExtentCombinesChildrenAlongMainAxis [	| layout container first second |	layout := SpPanedLayout newTopToBottom.	container := SpWin32PanedContainer layout: layout runtime: SpWin32Runtime new.	first := self controlExtent: 80@30.	second := self controlExtent: 90@40.	container child: first at: 1 constraints: SpPanedConstraints new.	container child: second at: 2 constraints: SpPanedConstraints new.	container instVarNamed: 'firstNaturalExtent' put: 80@30.	container instVarNamed: 'secondNaturalExtent' put: 90@40.	self assert: container preferredExtent equals: 90@76]{ #category : 'tests' }SpWin32PanedLayoutTest >> testRootCompositeSupportsWindowLifecycleProtocol [	self assert: (SpWin32PanedContainer canUnderstand: #realizeIn:extent:).	self assert: (SpWin32PanedContainer canUnderstand: #relayoutExtent:)]