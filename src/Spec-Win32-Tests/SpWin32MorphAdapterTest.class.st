Class {	#name : 'SpWin32MorphAdapterTest',	#superclass : 'TestCase',	#category : 'Spec-Win32-Tests-Morphic',	#package : 'Spec-Win32-Tests',	#tag : 'Morphic'}{ #category : 'private' }SpWin32MorphAdapterTest >> application [	^ SpApplication new useBackend: #Win32]{ #category : 'private' }SpWin32MorphAdapterTest >> newPresenterWithMorph: aMorph [	| presenter |	presenter := SpMorphPresenter newApplication: self application.	presenter morph: aMorph.	^ presenter]{ #category : 'private' }SpWin32MorphAdapterTest >> newAdapterWithMorph: aMorph [	| presenter adapter |	presenter := self newPresenterWithMorph: aMorph.	adapter := SpWin32MorphAdapter adapt: presenter.	presenter adapter: adapter.	^ adapter]{ #category : 'private' }SpWin32MorphAdapterTest >> simpleMorph [	^ Morph new		color: Color red;		extent: 120 @ 80;		yourself]{ #category : 'tests' }SpWin32MorphAdapterTest >> testBindingResolvesMorphAdapter [	self		assert: (SpWin32AdapterBindings new adapterClass: #MorphAdapter)		equals: SpWin32MorphAdapter]{ #category : 'tests' }SpWin32MorphAdapterTest >> testBuildUsesPrivateWorldHandAndRenderedSurface [	| morph adapter |	morph := self simpleMorph.	adapter := self newAdapterWithMorph: morph.	self assert: adapter widget class equals: SpWin32MorphSurfaceControl.	self assert: adapter widget kind equals: SpWin32Runtime controlImage.	self assert: adapter widget preferredExtent equals: 120 @ 80.	self assert: adapter hostedMorph identicalTo: morph.	self assert: morph owner identicalTo: adapter hostWorld.	self assert: adapter hostWorld activeHand identicalTo: adapter hand.	self assert: adapter widget imageData extent equals: 120 @ 80]{ #category : 'tests' }SpWin32MorphAdapterTest >> testNestedMorphRendersIntoImageSurface [	| root child adapter bytes offset |	root := Morph new color: Color white; extent: 80 @ 60; yourself.	child := Morph new color: Color red; position: 10 @ 10; extent: 20 @ 20; yourself.	root addMorph: child.	adapter := self newAdapterWithMorph: root.	adapter redraw.	bytes := adapter widget imageData bytes.	offset := ((15 * 80 + 15) * 4) + 1.	self assert: (bytes copyFrom: offset to: offset + 3) equals: #[ 0 0 255 255 ]]{ #category : 'tests' }SpWin32MorphAdapterTest >> testMorphDamageAutomaticallyRefreshesImage [	| morph adapter before |	morph := self simpleMorph.	adapter := self newAdapterWithMorph: morph.	adapter redraw.	before := adapter widget imageData bytes copy.	morph color: Color green.	self deny: adapter widget imageData bytes equals: before]{ #category : 'tests' }SpWin32MorphAdapterTest >> testChangingPresenterMorphReparentsAndUpdatesExtent [	| first second presenter adapter |	first := self simpleMorph.	second := Morph new color: Color green; extent: 90 @ 45; yourself.	presenter := self newPresenterWithMorph: first.	adapter := SpWin32MorphAdapter adapt: presenter.	presenter adapter: adapter.	presenter morph: second.	self assert: adapter hostedMorph identicalTo: second.	self assert: first owner isNil.	self assert: second owner identicalTo: adapter hostWorld.	self assert: adapter widget preferredExtent equals: 90 @ 45.	self assert: adapter widget imageData extent equals: 120 @ 80]{ #category : 'tests' }SpWin32MorphAdapterTest >> testResizableMorphFollowsNativeSurfaceExtent [	| morph adapter |	morph := self simpleMorph.	morph hResizing: #spaceFill; vResizing: #spaceFill.	adapter := self newAdapterWithMorph: morph.	adapter surfaceExtentChanged: 210 @ 130 on: adapter widget.	self assert: morph extent equals: 210 @ 130.	self assert: adapter hostWorld extent equals: 210 @ 130.	self assert: adapter widget imageData extent equals: 210 @ 130]{ #category : 'tests' }SpWin32MorphAdapterTest >> testRigidMorphKeepsOwnExtentWhenSurfaceGrows [	| morph adapter |	morph := self simpleMorph.	adapter := self newAdapterWithMorph: morph.	adapter surfaceExtentChanged: 210 @ 130 on: adapter widget.	self assert: morph extent equals: 120 @ 80.	self assert: adapter hostWorld extent equals: 210 @ 130.	self assert: adapter widget imageData extent equals: 210 @ 130]{ #category : 'tests' }SpWin32MorphAdapterTest >> testMouseInputIsDispatchedThroughPrivateMorphicHand [	| root child adapter clicks |	clicks := 0.	root := Morph new color: Color white; extent: 120 @ 80; yourself.	child := Morph new color: Color red; position: 20 @ 20; extent: 50 @ 30; yourself.	child on: #mouseDown send: #value to: [ clicks := clicks + 1 ].	root addMorph: child.	adapter := self newAdapterWithMorph: root.	adapter win32MouseEventType: SpWin32Runtime eventMouseDown position: 30 @ 30 button: 1 modifiers: 0.	adapter win32MouseEventType: SpWin32Runtime eventMouseUp position: 30 @ 30 button: 1 modifiers: 0.	self assert: clicks equals: 1]{ #category : 'tests' }SpWin32MorphAdapterTest >> testKeyboardInputUsesMorphicKeyboardFocus [	| morph adapter down stroke |	down := 0.	stroke := 0.	morph := self simpleMorph.	morph on: #keyDown send: #value to: [ down := down + 1 ].	morph on: #keyStroke send: #value to: [ stroke := stroke + 1 ].	adapter := self newAdapterWithMorph: morph.	adapter hand newKeyboardFocus: morph.	adapter win32KeyDownValue: 65 modifiers: 0.	self assert: down equals: 1.	self assert: stroke equals: 1.	adapter win32KeyUpValue: 65 modifiers: 0]{ #category : 'tests' }SpWin32MorphAdapterTest >> testWin32ModifierFlagsTranslateToMorphicMasks [	| adapter |	adapter := self newAdapterWithMorph: self simpleMorph.	self assert: (adapter morphicModifierMaskFor: 1) equals: 8.	self assert: (adapter morphicModifierMaskFor: 2) equals: 16.	self assert: (adapter morphicModifierMaskFor: 4) equals: 32.	self assert: (adapter morphicModifierMaskFor: 8) equals: 64.	self assert: (adapter morphicModifierMaskFor: 15) equals: 120]{ #category : 'tests' }SpWin32MorphAdapterTest >> testPrivateWorldRunsMorphicSteppingAndDamageRefresh [	| morph adapter before |	morph := self simpleMorph.	adapter := self newAdapterWithMorph: morph.	adapter redraw.	before := adapter widget imageData bytes copy.	adapter hostWorld		startStepping: morph		at: Time millisecondClockValue - 1		selector: #color:		arguments: { Color green }		stepTime: 1000.	adapter hostWorld runStepMethods.	self assert: morph color equals: Color green.	self deny: adapter widget imageData bytes equals: before]{ #category : 'tests' }SpWin32MorphAdapterTest >> testDisabledPresenterDoesNotForwardMorphInput [	| root adapter clicks |	clicks := 0.	root := self simpleMorph.	root on: #mouseDown send: #value to: [ clicks := clicks + 1 ].	adapter := self newAdapterWithMorph: root.	adapter presenter enabled: false.	adapter win32MouseEventType: SpWin32Runtime eventMouseDown position: 10 @ 10 button: 1 modifiers: 0.	self assert: clicks equals: 0]{ #category : 'tests' }SpWin32MorphAdapterTest >> testNativeImageClickEventIsSafelyConsumed [	| adapter |	adapter := self newAdapterWithMorph: self simpleMorph.	self		shouldnt: [			adapter widget				nativeEventType: SpWin32Runtime eventClicked				argument1: 0				argument2: 0 ]		raise: Error]{ #category : 'tests' }SpWin32MorphAdapterTest >> testUnsubscribeStopsSteppingProcess [	| presenter adapter process |	presenter := self newPresenterWithMorph: self simpleMorph.	adapter := SpWin32MorphAdapter adapt: presenter.	presenter adapter: adapter.	adapter startSteppingLoop.	process := adapter instVarNamed: 'steppingProcess'.	self deny: process isNil.	adapter unsubscribe.	self assert: (adapter instVarNamed: 'steppingProcess') isNil]