Class {	#name : 'SpWin32MillerLayoutTest',	#superclass : 'TestCase',	#category : 'Spec-Win32-Tests-Layout',	#package : 'Spec-Win32-Tests',	#tag : 'Layout'}{ #category : 'private' }SpWin32MillerLayoutTest >> controlExtent: anExtent [	^ SpWin32NativeControl		runtime: SpWin32Runtime new		kind: SpWin32Runtime controlButton		text: ''		preferredExtent: anExtent]{ #category : 'tests' }SpWin32MillerLayoutTest >> testAdapterBindingResolvesMillerAdapter [	self		assert: (SpWin32AdapterBindings new adapterClass: #MillerAdapter)		equals: SpWin32MillerAdapter]{ #category : 'tests' }SpWin32MillerLayoutTest >> testAdapterUsesDedicatedMillerContainer [	| layout adapter |	layout := SpMillerLayout newHorizontal.	adapter := SpWin32MillerAdapter new.	adapter layout: layout.	self assert: adapter widget class equals: SpWin32MillerContainer.	self assert: adapter childrenWidgets isEmpty]{ #category : 'tests' }SpWin32MillerLayoutTest >> testHorizontalPageWidthUsesVisiblePages [	| layout container pageExtent |	layout := SpMillerLayout newHorizontal		visiblePages: 3;		spacing: 6;		borderWidth: 4;		yourself.	container := SpWin32MillerContainer layout: layout runtime: SpWin32Runtime new.	1 to: 4 do: [ :index |		container addPage: (self controlExtent: 80@30) constraints: SpLayoutConstraints new ].	pageExtent := container pageExtentForViewport: 620@300.	self assert: pageExtent x equals: 200.	self assert: pageExtent y equals: 292]{ #category : 'tests' }SpWin32MillerLayoutTest >> testVerticalPageHeightUsesVisiblePages [	| layout container pageExtent |	layout := SpMillerLayout newVertical		visiblePages: 2;		spacing: 8;		borderWidth: 5;		yourself.	container := SpWin32MillerContainer layout: layout runtime: SpWin32Runtime new.	1 to: 3 do: [ :index |		container addPage: (self controlExtent: 80@30) constraints: SpLayoutConstraints new ].	pageExtent := container pageExtentForViewport: 400@318.	self assert: pageExtent x equals: 390.	self assert: pageExtent y equals: 150]{ #category : 'tests' }SpWin32MillerLayoutTest >> testAddingPagesKeepsNewestDepthVisible [	| layout container |	layout := SpMillerLayout newHorizontal visiblePages: 2; yourself.	container := SpWin32MillerContainer layout: layout runtime: SpWin32Runtime new.	1 to: 4 do: [ :index |		container addPage: (self controlExtent: 80@30) constraints: SpLayoutConstraints new ].	self assert: (container instVarNamed: 'firstShowingPageIndex') equals: 3]{ #category : 'tests' }SpWin32MillerLayoutTest >> testSelectPageOverridesAutomaticLastPageTarget [	| layout container |	layout := SpMillerLayout newHorizontal visiblePages: 2; yourself.	container := SpWin32MillerContainer layout: layout runtime: SpWin32Runtime new.	1 to: 4 do: [ :index |		container addPage: (self controlExtent: 80@30) constraints: SpLayoutConstraints new ].	container selectPage: 2.	self assert: (container instVarNamed: 'firstShowingPageIndex') equals: 2]{ #category : 'tests' }SpWin32MillerLayoutTest >> testRemovingPageRecomputesLastVisibleGroup [	| layout container controls |	layout := SpMillerLayout newHorizontal visiblePages: 2; yourself.	container := SpWin32MillerContainer layout: layout runtime: SpWin32Runtime new.	controls := (1 to: 4) collect: [ :index | self controlExtent: 80@30 ].	controls do: [ :each | container addPage: each constraints: SpLayoutConstraints new ].	container removePageWidget: controls last.	self assert: container children size equals: 3.	self assert: (container instVarNamed: 'firstShowingPageIndex') equals: 2]{ #category : 'tests' }SpWin32MillerLayoutTest >> testPreferredExtentShowsOnlyConfiguredNaturalPageCount [	| layout container |	layout := SpMillerLayout newHorizontal		visiblePages: 2;		spacing: 10;		borderWidth: 5;		yourself.	container := SpWin32MillerContainer layout: layout runtime: SpWin32Runtime new.	container addPage: (self controlExtent: 120@40) constraints: SpLayoutConstraints new.	container addPage: (self controlExtent: 90@60) constraints: SpLayoutConstraints new.	container addPage: (self controlExtent: 200@50) constraints: SpLayoutConstraints new.	self assert: container preferredExtent equals: 420@70]{ #category : 'tests' }SpWin32MillerLayoutTest >> testMillerCanHideScrollbarWithoutDisablingScrollAxis [	self assert: SpWin32Runtime scrollPolicyDisabled equals: 0.	self assert: SpWin32Runtime scrollPolicyAutomatic equals: 1.	self assert: SpWin32Runtime scrollPolicyHidden equals: 2.	self assert: SpWin32Runtime scrollPolicyAlways equals: 3.	self assert: (SpWin32Runtime canUnderstand:		#configureScrollViewport:content:extent:horizontalPolicy:verticalPolicy:).	self assert: (SpWin32Runtime canUnderstand:		#primScrollViewConfigurePolicies:contentId:width:height:horizontalPolicy:verticalPolicy:)]{ #category : 'tests' }SpWin32MillerLayoutTest >> testRootCompositeSupportsWindowLifecycleProtocol [	self assert: (SpWin32MillerContainer canUnderstand: #realizeIn:extent:).	self assert: (SpWin32MillerContainer canUnderstand: #relayoutExtent:)]