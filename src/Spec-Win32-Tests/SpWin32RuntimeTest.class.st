Class {	#name : 'SpWin32RuntimeTest',	#superclass : 'TestCase',	#category : 'Spec-Win32-Tests-Runtime',	#package : 'Spec-Win32-Tests',	#tag : 'Runtime'}{ #category : 'tests' }SpWin32RuntimeTest >> testCloseRequestedEventIsNormalized [	| runtime window handler |	runtime := SpWin32Runtime new.	window := SpWin32NativeWindow runtime: runtime objectId: 41 extent: 100 @ 80.	handler := SpWin32RuntimeTestHandler new.	window eventHandler: handler.	window		nativeEventType: SpWin32Runtime eventCloseRequested		argument1: 0		argument2: 0.	self assert: handler closeRequested]{ #category : 'tests' }SpWin32RuntimeTest >> testDestroyEventInvalidatesAndUnregistersObject [	| runtime window handler |	runtime := SpWin32Runtime new.	window := SpWin32NativeWindow runtime: runtime objectId: 42 extent: 100 @ 80.	handler := SpWin32RuntimeTestHandler new.	window eventHandler: handler.	runtime registerObject: window.	window		nativeEventType: SpWin32Runtime eventDestroyed		argument1: 0		argument2: 0.	self assert: window isDestroyed.	self deny: window isValid.	self assert: handler destroyed.	self assert: runtime objectCount equals: 0]{ #category : 'tests' }SpWin32RuntimeTest >> testEventBufferLayoutMatchesNativeAbi [	| runtime window handler buffer |	runtime := SpWin32Runtime new.	window := SpWin32NativeWindow runtime: runtime objectId: 16r1122334455667788 extent: 10 @ 20.	handler := SpWin32RuntimeTestHandler new.	window eventHandler: handler.	runtime registerObject: window.	buffer := ExternalAddress allocate: 32.	[		buffer unsignedLongAt: 1 put: SpWin32Runtime eventResized.		buffer unsignedLongAt: 5 put: 0.		buffer unsignedLongLongAt: 9 put: window objectId.		buffer signedLongLongAt: 17 put: 640.		buffer signedLongLongAt: 25 put: 480.		runtime dispatchEventFrom: buffer	] ensure: [ buffer free ].	self assert: handler resizeOld equals: 10 @ 20.	self assert: handler resizeNew equals: 640 @ 480.	self assert: window extent equals: 640 @ 480]{ #category : 'tests' }SpWin32RuntimeTest >> testRuntimeRegistryUsesStableObjectIds [	| runtime first second |	runtime := SpWin32Runtime new.	first := SpWin32NativeWindow runtime: runtime objectId: 1001 extent: 1 @ 1.	second := SpWin32NativeWindow runtime: runtime objectId: 1002 extent: 1 @ 1.	runtime registerObject: first.	runtime registerObject: second.	self assert: (runtime objectAtId: 1001) identicalTo: first.	self assert: (runtime objectAtId: 1002) identicalTo: second.	self assert: runtime objectCount equals: 2.	runtime unregisterObjectId: 1001.	self assert: runtime objectCount equals: 1]{ #category : 'tests' }SpWin32RuntimeTest >> testUtf8BoundaryUsesUtf8BytesAndExplicitLength [	| runtime bytes |	runtime := SpWin32Runtime new.	runtime withUtf8String: 'AŽ🙂' do: [ :buffer :length |		bytes := ByteArray new: length.		1 to: length do: [ :index |			bytes at: index put: (buffer unsignedByteAt: index) ] ].	self		assert: bytes		equals: ((ZnCharacterEncoder newForEncoding: 'utf-8') encodeString: 'AŽ🙂')]{ #category : 'tests' }SpWin32RuntimeTest >> testButtonClickEventIsNormalized [	| runtime control handler |	runtime := SpWin32Runtime new.	control := SpWin32NativeControl		runtime: runtime		kind: SpWin32Runtime controlButton		text: 'Push'		preferredExtent: 80@28.	control objectId: 43.	handler := SpWin32RuntimeTestHandler new.	control eventHandler: handler.	control nativeEventType: SpWin32Runtime eventClicked argument1: 0 argument2: 0.	self assert: handler clicked]{ #category : 'tests' }SpWin32RuntimeTest >> testHorizontalBoxLayoutComputesControlPlacements [	| runtime layout container first second firstConstraints secondConstraints placements |	runtime := SpWin32Runtime new.	layout := SpBoxLayout newLeftToRight		borderWidth: 5;		spacing: 10;		yourself.	container := SpWin32BoxContainer layout: layout runtime: runtime.	first := SpWin32NativeControl runtime: runtime kind: SpWin32Runtime controlLabel text: 'A' preferredExtent: 20@22.	second := SpWin32NativeControl runtime: runtime kind: SpWin32Runtime controlButton text: 'B' preferredExtent: 75@28.	firstConstraints := SpBoxConstraints new width: 50; yourself.	secondConstraints := SpBoxConstraints new.	container addChild: first constraints: firstConstraints.	container addChild: second constraints: secondConstraints.	placements := OrderedCollection new.	container layoutIn: (0@0 extent: 300@100) collect: placements.	self assert: placements size equals: 2.	self assert: placements first equals: { first. 5. 5. 50. 90 }.	self assert: placements second equals: { second. 65. 5. 230. 90 }]{ #category : 'tests' }SpWin32RuntimeTest >> testVerticalBoxLayoutComputesControlPlacements [	| runtime layout container first second firstConstraints secondConstraints placements |	runtime := SpWin32Runtime new.	layout := SpBoxLayout newTopToBottom spacing: 4; yourself.	container := SpWin32BoxContainer layout: layout runtime: runtime.	first := SpWin32NativeControl runtime: runtime kind: SpWin32Runtime controlLabel text: 'A' preferredExtent: 20@22.	second := SpWin32NativeControl runtime: runtime kind: SpWin32Runtime controlButton text: 'B' preferredExtent: 75@28.	firstConstraints := SpBoxConstraints new height: 30; yourself.	secondConstraints := SpBoxConstraints new.	container addChild: first constraints: firstConstraints.	container addChild: second constraints: secondConstraints.	placements := OrderedCollection new.	container layoutIn: (0@0 extent: 200@120) collect: placements.	self assert: placements size equals: 2.	self assert: placements first equals: { first. 0. 0. 200. 30 }.	self assert: placements second equals: { second. 0. 34. 200. 86 }]{ #category : 'tests' }SpWin32RuntimeTest >> testHorizontalBoxLayoutKeepsSpacingBetweenEndPlacedControls [	| runtime layout container first second firstConstraints secondConstraints placements |	runtime := SpWin32Runtime new.	layout := SpBoxLayout newLeftToRight spacing: 10; yourself.	container := SpWin32BoxContainer layout: layout runtime: runtime.	first := SpWin32NativeControl runtime: runtime kind: SpWin32Runtime controlButton text: 'A' preferredExtent: 50@28.	second := SpWin32NativeControl runtime: runtime kind: SpWin32Runtime controlButton text: 'B' preferredExtent: 60@28.	firstConstraints := SpBoxConstraints new		width: 50;		bePlacedAtEnd;		yourself.	secondConstraints := SpBoxConstraints new		width: 60;		bePlacedAtEnd;		yourself.	container addChild: first constraints: firstConstraints.	container addChild: second constraints: secondConstraints.	placements := OrderedCollection new.	container layoutIn: (0@0 extent: 300@80) collect: placements.	self assert: placements size equals: 2.	self assert: (placements includes: { first. 180. 0. 50. 80 }).	self assert: (placements includes: { second. 240. 0. 60. 80 })]{ #category : 'tests' }SpWin32RuntimeTest >> testToggleEventIsNormalized [	| runtime control handler |	runtime := SpWin32Runtime new.	control := SpWin32NativeControl		runtime: runtime		kind: SpWin32Runtime controlCheckBox		text: 'Check'		preferredExtent: 90@22.	control objectId: 44.	handler := SpWin32RuntimeTestHandler new.	control eventHandler: handler.	control		nativeEventType: SpWin32Runtime eventToggled		argument1: 1		argument2: 0.	self assert: control checked.	self assert: handler toggled.	control		nativeEventType: SpWin32Runtime eventToggled		argument1: 0		argument2: 0.	self deny: control checked.	self deny: handler toggled]{ #category : 'tests' }SpWin32RuntimeTest >> testDropListSelectionEventIsNormalized [	| runtime control handler |	runtime := SpWin32Runtime new.	control := SpWin32NativeControl		runtime: runtime		kind: SpWin32Runtime controlDropList		text: ''		preferredExtent: 100 @ 24.	control objectId: 45.	handler := SpWin32RuntimeTestHandler new.	control eventHandler: handler.	control		nativeEventType: SpWin32Runtime eventSelectionChanged		argument1: 3		argument2: 0.	self assert: control selectedIndex equals: 3.	self assert: handler selectionChanged equals: 3]{ #category : 'tests' }SpWin32RuntimeTest >> testPackedDropListItemsUseLengthPrefixedUtf8 [	| runtime bytes |	runtime := SpWin32Runtime new.	runtime withPackedUtf8Items: #( 'A' 'Ž🙂' ) do: [ :buffer :length :count |		bytes := ByteArray new: length.		1 to: length do: [ :index | bytes at: index put: (buffer unsignedByteAt: index) ].		self assert: count equals: 2 ].	self assert: (bytes copyFrom: 1 to: 4) equals: #[ 1 0 0 0 ].	self assert: (bytes at: 5) equals: $A asciiValue.	self assert: (bytes copyFrom: 6 to: 9) equals: #[ 6 0 0 0 ].	self		assert: (bytes copyFrom: 10 to: bytes size)		equals: ((ZnCharacterEncoder newForEncoding: 'utf-8') encodeString: 'Ž🙂')]{ #category : 'tests' }SpWin32RuntimeTest >> testPopupDismissEventIsNormalized [	| runtime window handler |	runtime := SpWin32Runtime new.	window := SpWin32NativeWindow runtime: runtime objectId: 1042 extent: 100 @ 80.	handler := SpWin32RuntimeTestHandler new.	window eventHandler: handler.	window		nativeEventType: SpWin32Runtime eventPopupDismissRequested		argument1: 0		argument2: 0.	self assert: handler popupDismissRequested]