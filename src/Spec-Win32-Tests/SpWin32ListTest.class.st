Class {	#name : 'SpWin32ListTest',	#superclass : 'TestCase',	#category : 'Spec-Win32-Tests-Controls',	#package : 'Spec-Win32-Tests',	#tag : 'Controls'}{ #category : 'private' }SpWin32ListTest >> newApplication [	^ SpApplication new useBackend: #Win32]{ #category : 'tests' }SpWin32ListTest >> testBindingResolvesListAdapter [	self assert: (SpWin32AdapterBindings new adapterClass: #ListAdapter) equals: SpWin32ListAdapter]{ #category : 'tests' }SpWin32ListTest >> testDeferredListUsesDisplayBlockAndSelection [	| presenter adapter |	presenter := SpListPresenter newApplication: self newApplication.	presenter		display: [ :each | 'item-', each asString ];		items: #(1 22 333);		selectIndex: 2.	adapter := SpWin32ListAdapter adapt: presenter.	self assert: adapter widget items equals: #('item-1' 'item-22' 'item-333').	self assert: adapter selectedIndexes equals: #(2).	self deny: adapter widget multipleSelection]{ #category : 'tests' }SpWin32ListTest >> testPresenterSelectionUpdatesDeferredNativeSelection [	| presenter adapter |	presenter := SpListPresenter newApplication: self newApplication.	presenter items: #(10 20 30).	adapter := SpWin32ListAdapter adapt: presenter.	presenter selectIndex: 3.	self assert: adapter selectedIndexes equals: #(3).	presenter unselectAll.	self assert: adapter selectedIndexes isEmpty]{ #category : 'tests' }SpWin32ListTest >> testMultipleSelectionIsPreserved [	| presenter adapter |	presenter := SpListPresenter newApplication: self newApplication.	presenter beMultipleSelection; items: #(10 20 30 40).	adapter := SpWin32ListAdapter adapt: presenter.	presenter selectIndex: 1; selectIndex: 3.	self assert: adapter selectedIndexes asArray equals: #(1 3).	self assert: adapter widget multipleSelection]{ #category : 'tests' }SpWin32ListTest >> testAdapterSelectIndexEmulatesSingleSelection [	| presenter adapter |	presenter := SpListPresenter newApplication: self newApplication.	presenter items: #(10 20 30).	adapter := SpWin32ListAdapter adapt: presenter.	adapter selectIndex: 2.	self assert: presenter selectedIndex equals: 2.	self assert: adapter selectedIndexes equals: #(2).	adapter selectIndex: 0.	self assert: presenter selection isEmpty]{ #category : 'tests' }SpWin32ListTest >> testAdapterSelectIndexAddsInMultipleSelection [	| presenter adapter |	presenter := SpListPresenter newApplication: self newApplication.	presenter beMultipleSelection; items: #(10 20 30).	adapter := SpWin32ListAdapter adapt: presenter.	adapter selectIndex: 1.	adapter selectIndex: 3.	self assert: presenter selection selectedIndexes asArray equals: #(1 3).	self assert: adapter selectedIndexes equals: #(1 3)]{ #category : 'tests' }SpWin32ListTest >> testNativeSelectionEventUpdatesPresenter [	| presenter adapter |	presenter := SpListPresenter newApplication: self newApplication.	presenter beMultipleSelection; items: #(10 20 30).	adapter := SpWin32ListAdapter adapt: presenter.	adapter widget selectedIndexes: #(1 3).	adapter win32ListSelectionChanged: #(1 3) changedIndex: 3 selected: true.	self assert: presenter selection selectedIndexes asArray equals: #(1 3)]{ #category : 'tests' }SpWin32ListTest >> testSingleClickActivationUsesNewlySelectedIndex [	| presenter adapter activated |	presenter := SpListPresenter newApplication: self newApplication.	presenter items: #(alpha beta gamma); activateOnSingleClick.	presenter whenActivatedDo: [ :selection | activated := selection selectedIndex ].	adapter := SpWin32ListAdapter adapt: presenter.	adapter win32ListSelectionChanged: #(2) changedIndex: 2 selected: true.	self assert: activated equals: 2]{ #category : 'tests' }SpWin32ListTest >> testDoubleClickActivationHonorsPresenterMode [	| presenter adapter activated |	presenter := SpListPresenter newApplication: self newApplication.	presenter items: #(alpha beta gamma); activateOnDoubleClick.	presenter whenActivatedDo: [ :selection | activated := selection selectedIndex ].	adapter := SpWin32ListAdapter adapt: presenter.	adapter win32ActivatedAt: 3 source: 1.	self assert: activated equals: 3]{ #category : 'tests' }SpWin32ListTest >> testEnterActivationWorksRegardlessOfClickActivationMode [	| presenter adapter activated |	presenter := SpListPresenter newApplication: self newApplication.	presenter items: #(alpha beta gamma); activateOnSingleClick.	presenter whenActivatedDo: [ :selection | activated := selection selectedIndex ].	adapter := SpWin32ListAdapter adapt: presenter.	adapter win32ActivatedAt: 1 source: 2.	self assert: activated equals: 1]{ #category : 'tests' }SpWin32ListTest >> testHeaderStateFollowsPresenter [	| presenter adapter |	presenter := SpListPresenter newApplication: self newApplication.	presenter items: #(a b); headerTitle: 'Names'.	adapter := SpWin32ListAdapter adapt: presenter.	self assert: adapter widget headerVisible.	self assert: adapter widget headerText equals: 'Names'.	presenter hideHeaderTitle.	self deny: adapter widget headerVisible]{ #category : 'tests' }SpWin32ListTest >> testModelAndDisplayChangesRefreshDeferredItems [	| presenter adapter |	presenter := SpListPresenter newApplication: self newApplication.	presenter items: #(a b).	adapter := SpWin32ListAdapter adapt: presenter.	presenter display: [ :each | each asString asUppercase ].	self assert: adapter widget items equals: #('A' 'B').	presenter items: #(x y z).	self assert: adapter widget items equals: #('X' 'Y' 'Z')]