Class {	#name : 'SpWin32TableTest',	#superclass : 'TestCase',	#category : 'Spec-Win32-Tests-Controls',	#package : 'Spec-Win32-Tests',	#tag : 'Controls'}{ #category : 'private' }SpWin32TableTest >> newApplication [	^ SpApplication new useBackend: #Win32]{ #category : 'private' }SpWin32TableTest >> newPresenter [	| presenter |	presenter := SpTablePresenter newApplication: self newApplication.	presenter		addColumn: ((SpIndexTableColumn title: '#') width: 38; beNotExpandable; yourself);		addColumn: (SpStringTableColumn title: 'Name' evaluated: #key);		addColumn: ((SpStringTableColumn title: 'Score' evaluated: #value)			width: 80;			displayAlignment: [ :item | SpColumnAlignment right ];			yourself);		items: { 'Alpha' -> 20. 'Beta' -> 10. 'Český 🙂' -> 30 }.	^ presenter]{ #category : 'tests' }SpWin32TableTest >> testBindingResolvesTableAdapter [	self assert: (SpWin32AdapterBindings new adapterClass: #TableAdapter) equals: SpWin32TableAdapter]{ #category : 'tests' }SpWin32TableTest >> testDeferredTableBuildsColumnMetadataAndCells [	| presenter adapter |	presenter := self newPresenter.	adapter := SpWin32TableAdapter adapt: presenter.	self assert: adapter widget columnTitles equals: #('#' 'Name' 'Score').	self assert: adapter widget columnCount equals: 3.	self assert: adapter widget rowCount equals: 3.	self assert: adapter widget columnAlignments equals: #(0 0 1).	self assert: adapter widget cellStrings equals: #('1' 'Alpha' '20' '2' 'Beta' '10' '3' 'Český 🙂' '30')]{ #category : 'tests' }SpWin32TableTest >> testHeadersAndResizableStateFollowPresenter [	| presenter adapter |	presenter := self newPresenter.	adapter := SpWin32TableAdapter adapt: presenter.	self assert: adapter widget headersVisible.	self deny: adapter widget resizable.	presenter hideColumnHeaders.	self deny: adapter widget headersVisible.	presenter beResizable.	self assert: adapter widget resizable]{ #category : 'tests' }SpWin32TableTest >> testModelChangeRefreshesCellMatrix [	| presenter adapter |	presenter := self newPresenter.	adapter := SpWin32TableAdapter adapt: presenter.	presenter items: { 'Delta' -> 7. 'Echo' -> 9 }.	self assert: adapter widget rowCount equals: 2.	self assert: adapter widget cellStrings equals: #('1' 'Delta' '7' '2' 'Echo' '9')]{ #category : 'tests' }SpWin32TableTest >> testColumnChangeRefreshesNativeDefinition [	| presenter adapter |	presenter := self newPresenter.	adapter := SpWin32TableAdapter adapt: presenter.	presenter addColumn: (SpStringTableColumn title: 'Again' evaluated: #key).	self assert: adapter widget columnCount equals: 4.	self assert: adapter widget columnTitles equals: #('#' 'Name' 'Score' 'Again').	self assert: adapter widget cellStrings size equals: 12]{ #category : 'tests' }SpWin32TableTest >> testSelectionUsesVisibleRows [	| presenter adapter |	presenter := self newPresenter.	adapter := SpWin32TableAdapter adapt: presenter.	presenter selectIndex: 2.	self assert: adapter selectedIndexes equals: #(2).	self assert: presenter selectedItem key equals: 'Beta']{ #category : 'tests' }SpWin32TableTest >> testNativeSelectionEventUpdatesPresenter [	| presenter adapter |	presenter := self newPresenter.	presenter beMultipleSelection.	adapter := SpWin32TableAdapter adapt: presenter.	adapter widget selectedIndexes: #(1 3).	adapter win32ListSelectionChanged: #(1 3) changedIndex: 3 selected: true.	self assert: presenter selection selectedIndexes asArray equals: #(1 3)]{ #category : 'tests' }SpWin32TableTest >> testSortableHeaderClickChangesVisibleOrderAndToggles [	| presenter adapter |	presenter := self newPresenter.	adapter := SpWin32TableAdapter adapt: presenter.	adapter clickOnColumnHeaderAt: 3.	self assert: (adapter elementAt: 1) key equals: 'Beta'.	self assert: (adapter elementAt: 3) key equals: 'Český 🙂'.	adapter clickOnColumnHeaderAt: 3.	self assert: (adapter elementAt: 1) key equals: 'Český 🙂'.	self assert: (adapter elementAt: 3) key equals: 'Beta']{ #category : 'tests' }SpWin32TableTest >> testNativeColumnClickUsesSameSortingPath [	| presenter adapter |	presenter := self newPresenter.	adapter := SpWin32TableAdapter adapt: presenter.	adapter win32ColumnClicked: 3.	self assert: (adapter elementAt: 1) value equals: 10]{ #category : 'tests' }SpWin32TableTest >> testSortStateIsReappliedWhenModelChanges [	| presenter adapter |	presenter := self newPresenter.	adapter := SpWin32TableAdapter adapt: presenter.	adapter clickOnColumnHeaderAt: 3.	presenter items: { 'High' -> 99. 'Low' -> 1 }.	self assert: (adapter elementAt: 1) key equals: 'Low'.	self assert: (adapter elementAt: 2) key equals: 'High']{ #category : 'tests' }SpWin32TableTest >> testFallbackColumnWhenNoColumnsDefined [	| presenter adapter |	presenter := SpTablePresenter newApplication: self newApplication.	presenter items: #(alpha beta).	adapter := SpWin32TableAdapter adapt: presenter.	self assert: adapter widget columnCount equals: 1.	self assert: adapter widget cellStrings equals: #('alpha' 'beta')]{ #category : 'tests' }SpWin32TableTest >> testCheckBoxColumnHasTextualBootstrapRendering [	| presenter adapter |	presenter := SpTablePresenter newApplication: self newApplication.	presenter		addColumn: (SpCheckBoxTableColumn title: 'Enabled' evaluated: #yourself);		items: #(true false).	adapter := SpWin32TableAdapter adapt: presenter.	self assert: adapter widget cellStrings equals: #('☑' '☐')]{ #category : 'tests' }SpWin32TableTest >> testAdapterReportsEditableStringColumn [	| presenter adapter column |	presenter := SpTablePresenter newApplication: self newApplication.	column := SpStringTableColumn title: 'Editable' evaluated: #yourself.	column beEditable.	presenter addColumn: column; items: #('a').	adapter := SpWin32TableAdapter adapt: presenter.	self deny: (adapter isNonEditableRow: 1 column: 1)]{ #category : 'tests' }SpWin32TableTest >> testSortingPreservesSelectedItemInVisibleOrder [	| presenter adapter |	presenter := self newPresenter.	adapter := SpWin32TableAdapter adapt: presenter.	presenter adapter: adapter.	presenter selectIndex: 1.	adapter clickOnColumnHeaderAt: 3.	self assert: presenter selectedItem key equals: 'Alpha'.	self assert: presenter selection selectedIndex equals: 2.	self assert: adapter selectedIndexes equals: #(2)]{ #category : 'tests' }SpWin32TableTest >> testEmptyTableDoesNotEvaluatePerItemAlignmentBlock [	| presenter adapter column |	presenter := SpTablePresenter newApplication: self newApplication.	column := SpStringTableColumn title: 'Value' evaluated: #yourself.	column displayAlignment: [ :item |		item size > 3			ifTrue: [ SpColumnAlignment right ]			ifFalse: [ SpColumnAlignment left ] ].	presenter addColumn: column; items: #().	adapter := SpWin32TableAdapter adapt: presenter.	self assert: adapter widget columnAlignments equals: #(0)]