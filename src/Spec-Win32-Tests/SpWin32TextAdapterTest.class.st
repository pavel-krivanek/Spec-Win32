Class {	#name : 'SpWin32TextAdapterTest',	#superclass : 'TestCase',	#category : 'Spec-Win32-Tests-Text',	#package : 'Spec-Win32-Tests',	#tag : 'Text'}{ #category : 'tests' }SpWin32TextAdapterTest >> testTextAdapterBindingAndKind [	| presenter adapter |	presenter := SpTextPresenter new text: 'one', String lf, 'two'; yourself.	adapter := SpWin32TextAdapter adapt: presenter.	self assert: adapter class adaptingName equals: #TextAdapter.	self assert: adapter widget kind equals: SpWin32Runtime controlTextArea.	self assert: SpWin32Runtime controlTextArea equals: 27]{ #category : 'tests' }SpWin32TextAdapterTest >> testMultilineSelectionUsesSpecIndexes [	| presenter adapter |	presenter := SpTextPresenter new text: 'one', String lf, 'two', String lf, 'three'; yourself.	adapter := SpWin32TextAdapter adapt: presenter.	presenter adapter: adapter.	adapter cursorPositionIndex: 6.	self assert: adapter cursorPositionIndex equals: 6.	self assert: adapter cursorPosition equals: 2 @ 2.	self assert: adapter lineAtCursorPosition equals: 'two']{ #category : 'tests' }SpWin32TextAdapterTest >> testSelectLineAcrossLfText [	| presenter adapter |	presenter := SpTextPresenter new text: 'Text for tests.', String lf, 'with multiple', String lf, 'lines'; yourself.	adapter := SpWin32TextAdapter adapt: presenter.	presenter adapter: adapter.	adapter cursorPositionIndex: 17.	adapter selectLine.	self assert: presenter selectionInterval equals: (17 to: 29)]{ #category : 'tests' }SpWin32TextAdapterTest >> testAppendAndInsertDeferred [	| presenter adapter |	presenter := SpTextPresenter new text: 'one'; yourself.	adapter := SpWin32TextAdapter adapt: presenter.	presenter adapter: adapter.	adapter appendText: String lf, 'two'.	self assert: presenter text equals: 'one', String lf, 'two'.	adapter insert: 'X' at: 2.	self assert: presenter text equals: 'oXne', String lf, 'two']{ #category : 'tests' }SpWin32TextAdapterTest >> testReadOnlyBlocksDeferredTyping [	| presenter adapter |	presenter := SpTextPresenter new text: 'fixed'; beNotEditable; yourself.	adapter := SpWin32TextAdapter adapt: presenter.	presenter adapter: adapter.	adapter typeByChar: 'x'.	self assert: presenter text equals: 'fixed']{ #category : 'tests' }SpWin32TextAdapterTest >> testTextAreaDefaultsToWrapAndScrollBars [	| presenter adapter control |	presenter := SpTextPresenter new.	adapter := SpWin32TextAdapter adapt: presenter.	control := adapter widget.	self assert: presenter isWrapWord.	self assert: presenter hasScrollBars.	self assert: control preferredExtent equals: 320 @ 160]{ #category : 'tests' }SpWin32TextAdapterTest >> testCursorPositionAcrossUnicodeAndLines [	| presenter adapter |	presenter := SpTextPresenter new text: 'A🙂', String lf, 'βeta'; yourself.	adapter := SpWin32TextAdapter adapt: presenter.	presenter adapter: adapter.	adapter cursorPositionIndex: 5.	self assert: adapter cursorPosition equals: 2 @ 2]{ #category : 'tests' }SpWin32TextAdapterTest >> testAbiAdvancedForMultilineText [	self assert: SpWin32Runtime abiVersion equals: 16r00290000]