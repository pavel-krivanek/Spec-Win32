Class {	#name : 'SpWin32ContextMenuTest',	#superclass : 'TestCase',	#category : 'Spec-Win32-Tests-Actions',	#package : 'Spec-Win32-Tests',	#tag : 'Actions'}{ #category : 'tests' }SpWin32ContextMenuTest >> testVisibleActionEnablesContextMenuOnNativeWidget [	| presenter adapter |	presenter := SpButtonPresenter new.	presenter actionsWith: [ :group |		group addActionWith: [ :action |			action name: 'Open'; action: [ ] ] ].	adapter := SpWin32ButtonAdapter adapt: presenter.	self assert: adapter hasContextMenu.	self assert: adapter widget contextMenuEnabled]{ #category : 'tests' }SpWin32ContextMenuTest >> testShortcutOnlyActionDoesNotEnableContextMenu [	| presenter adapter |	presenter := SpButtonPresenter new.	presenter addShortcutWith: [ :action |		action shortcutKey: $k ctrl; action: [ ] ].	adapter := SpWin32ButtonAdapter adapt: presenter.	self deny: adapter hasContextMenu.	self deny: adapter widget contextMenuEnabled]{ #category : 'tests' }SpWin32ContextMenuTest >> testInvisibleActionsAreOmittedAndGroupsBecomeSections [	| presenter adapter entries |	presenter := SpButtonPresenter new.	presenter actionsWith: [ :group |		group addActionWith: [ :action | action name: 'One'; action: [ ] ].		group addActionWith: [ :action | action name: 'Hidden'; actionVisible: [ false ]; action: [ ] ].		group addGroupWith: [ :subgroup |			subgroup addActionWith: [ :action | action name: 'Two'; action: [ ] ] ] ].	adapter := SpWin32ButtonAdapter adapt: presenter.	entries := adapter ensureActionManager contextMenuEntries.	self assert: entries size equals: 3.	self assert: entries first name equals: 'One'.	self assert: entries second isNil.	self assert: entries third name equals: 'Two']{ #category : 'tests' }SpWin32ContextMenuTest >> testDisabledAndCheckedFlagsReflectCurrentActionState [	| presenter adapter entries manager disabled checked |	presenter := SpButtonPresenter new.	presenter actionsWith: [ :group |		group addActionWith: [ :action |			action name: 'Disabled'; actionEnabled: [ false ]; action: [ ] ].		group addActionWith: [ :action |			action name: 'Checked'; state: true; action: [ ] ] ].	adapter := SpWin32ButtonAdapter adapt: presenter.	manager := adapter ensureActionManager.	entries := manager contextMenuEntries.	disabled := manager flagsForContextMenuEntry: entries first.	checked := manager flagsForContextMenuEntry: entries second.	self assert: (disabled bitAnd: SpWin32Runtime menuItemEnabledFlag) equals: 0.	self assert: (checked bitAnd: SpWin32Runtime menuItemEnabledFlag) equals: SpWin32Runtime menuItemEnabledFlag.	self assert: (checked bitAnd: SpWin32Runtime menuItemCheckedFlag) equals: SpWin32Runtime menuItemCheckedFlag]{ #category : 'tests' }SpWin32ContextMenuTest >> testDynamicGroupIsResolvedWhenMenuEntriesAreRequested [	| presenter adapter counter names |	counter := 0.	presenter := SpButtonPresenter new.	presenter actionsWith: [ :group |		group addDynamicGroupWith: [ :dynamic |			counter := counter + 1.			dynamic addActionWith: [ :action |				action name: 'Run ', counter asString; action: [ ] ] ] ].	adapter := SpWin32ButtonAdapter adapt: presenter.	names := adapter ensureActionManager contextMenuEntries collect: #name.	self assert: names equals: #( 'Run 1' ).	names := adapter ensureActionManager contextMenuEntries collect: #name.	self assert: names equals: #( 'Run 2' )]{ #category : 'tests' }SpWin32ContextMenuTest >> testActionsReplacementUpdatesNativeContextMenuAvailability [	| presenter adapter |	presenter := SpButtonPresenter new.	presenter actionsWith: [ :group |		group addActionWith: [ :action | action name: 'Run'; action: [ ] ] ].	adapter := SpWin32ButtonAdapter adapt: presenter.	presenter adapter: adapter.	self assert: adapter widget contextMenuEnabled.	presenter actionsWith: [ :group |		group addShortcutWith: [ :action | action shortcutKey: $r ctrl; action: [ ] ] ].	self deny: adapter widget contextMenuEnabled]