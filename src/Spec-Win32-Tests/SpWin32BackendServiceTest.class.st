Class {	#name : 'SpWin32BackendServiceTest',	#superclass : 'TestCase',	#category : 'Spec-Win32-Tests-Backend',	#package : 'Spec-Win32-Tests'}{ #category : 'tests' }SpWin32BackendServiceTest >> testBackendServiceAbiVersion [	self assert: SpWin32Runtime abiVersion equals: 16r00290000]{ #category : 'tests' }SpWin32BackendServiceTest >> testFileDialogFilterStringContainsNativePairs [	| backend filter null |	backend := SpWin32Backend new.	null := Character null.	filter := backend fileDialogFilterStringFor: #( 'jpg' '*.png' ).	self assert: (filter includesSubstring: '*.jpg', null asString, '*.jpg').	self assert: (filter includesSubstring: '*.png', null asString, '*.png').	self assert: (filter endsWith: '*.*', null asString, null asString)]{ #category : 'tests' }SpWin32BackendServiceTest >> testFileDialogModeMapping [	| backend application dialog |	backend := SpWin32Backend new.	application := SpApplication new useBackend: #Win32.	dialog := SpFileDialog newApplication: application.	self assert: (backend fileDialogModeFor: dialog) equals: SpWin32Runtime fileDialogOpen.	dialog beSaveFile.	self assert: (backend fileDialogModeFor: dialog) equals: SpWin32Runtime fileDialogSave.	dialog beOpenDirectory.	self assert: (backend fileDialogModeFor: dialog) equals: SpWin32Runtime fileDialogDirectory]{ #category : 'tests' }SpWin32BackendServiceTest >> testNotificationMessageAcceptsStringAndTextObject [	| backend item |	backend := SpWin32Backend new.	item := SpNotificationItem with: 'hello'.	self assert: (backend messageFromNotification: 'direct') equals: 'direct'.	self assert: (backend messageFromNotification: item) equals: 'hello']