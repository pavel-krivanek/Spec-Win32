Class {	#name : 'SpWin32NotebookTest',	#superclass : 'TestCase',	#category : 'Spec-Win32-Tests-Controls',	#package : 'Spec-Win32-Tests',	#tag : 'Controls'}{ #category : 'private' }SpWin32NotebookTest >> newApplication [	^ SpApplication new useBackend: #Win32]{ #category : 'private' }SpWin32NotebookTest >> notebookWithApplication: application [	| notebook |	notebook := SpNotebookPresenter newApplication: application.	notebook		addPage: (SpNotebookPage title: 'General' provider: [			(SpLabelPresenter newApplication: application) label: 'General page'; yourself ]);		addPage: (SpNotebookPage title: 'Advanced' provider: [			(SpButtonPresenter newApplication: application) label: 'Advanced page'; yourself ]).	^ notebook]{ #category : 'tests' }SpWin32NotebookTest >> testBindingResolvesNotebookAdapter [	self		assert: (SpWin32AdapterBindings new adapterClass: #NotebookAdapter)		equals: SpWin32NotebookAdapter]{ #category : 'tests' }SpWin32NotebookTest >> testNotebookUsesNativeTabControl [	| application notebook widget |	application := self newApplication.	notebook := self notebookWithApplication: application.	widget := notebook build.	self assert: notebook adapter class equals: SpWin32NotebookAdapter.	self assert: widget class equals: SpWin32NotebookContainer.	self assert: widget tabControl kind equals: SpWin32Runtime controlNotebook]{ #category : 'tests' }SpWin32NotebookTest >> testInitialPagesPopulateTabsAndSelectFirst [	| application notebook widget |	application := self newApplication.	notebook := self notebookWithApplication: application.	widget := notebook build.	self assert: widget numberOfTabs equals: 2.	self assert: widget tabControl items equals: #( 'General' 'Advanced' ).	self assert: notebook selectedPageIndex equals: 1.	self assert: widget selectedIndex equals: 1]{ #category : 'tests' }SpWin32NotebookTest >> testOnlySelectedPageContentIsBuiltLazily [	| application notebook widget firstPage secondPage |	application := self newApplication.	notebook := self notebookWithApplication: application.	firstPage := notebook pages first.	secondPage := notebook pages second.	widget := notebook build.	self assert: (widget pageWidgetAt: firstPage) notNil.	self assert: (widget pageWidgetAt: secondPage) isNil.	notebook selectPageIndex: 2.	self assert: (widget pageWidgetAt: secondPage) notNil]{ #category : 'tests' }SpWin32NotebookTest >> testPresenterSelectionUpdatesNativeTabState [	| application notebook widget |	application := self newApplication.	notebook := self notebookWithApplication: application.	widget := notebook build.	notebook selectPageIndex: 2.	self assert: widget selectedIndex equals: 2.	self assert: widget tabControl selectedIndex equals: 2.	self assert: notebook adapter selectedPageName equals: 'Advanced']{ #category : 'tests' }SpWin32NotebookTest >> testNativeSelectionUpdatesPresenter [	| application notebook |	application := self newApplication.	notebook := self notebookWithApplication: application.	notebook build.	notebook adapter win32SelectionChanged: 2.	self assert: notebook selectedPageIndex equals: 2.	self assert: notebook adapter selectedPageName equals: 'Advanced']{ #category : 'tests' }SpWin32NotebookTest >> testAddingAndRemovingPagesUpdatesTabs [	| application notebook third |	application := self newApplication.	notebook := self notebookWithApplication: application.	notebook build.	third := SpNotebookPage title: 'Diagnostics' provider: [		(SpLabelPresenter newApplication: application) label: 'Diagnostics'; yourself ].	notebook addPage: third.	self assert: notebook adapter numberOfTabs equals: 3.	self assert: notebook adapter widget tabControl items equals: #( 'General' 'Advanced' 'Diagnostics' ).	notebook removePageAt: 2.	self assert: notebook adapter numberOfTabs equals: 2.	self assert: notebook adapter widget tabControl items equals: #( 'General' 'Diagnostics' )]{ #category : 'tests' }SpWin32NotebookTest >> testRemovingMiddlePagePreservesSelectedLastPage [	| application notebook third |	application := self newApplication.	notebook := self notebookWithApplication: application.	third := SpNotebookPage title: 'Diagnostics' provider: [		(SpLabelPresenter newApplication: application) label: 'Diagnostics'; yourself ].	notebook addPage: third.	notebook build.	notebook selectPageIndex: 3.	notebook removePageAt: 2.	self assert: notebook selectedPage identicalTo: third.	self assert: notebook selectedPageIndex equals: 2.	self assert: notebook adapter widget selectedIndex equals: 2]{ #category : 'tests' }SpWin32NotebookTest >> testPageTitleUpdateRefreshesTabTitles [	| application notebook page |	application := self newApplication.	notebook := self notebookWithApplication: application.	notebook build.	page := notebook pages second.	page title: 'Expert'.	self assert: notebook adapter widget tabControl items equals: #( 'General' 'Expert' )]{ #category : 'tests' }SpWin32NotebookTest >> testResetSelectedPageContentRebuildsWidget [	| application notebook page widget oldWidget newWidget |	application := self newApplication.	notebook := self notebookWithApplication: application.	widget := notebook build.	page := notebook pages first.	oldWidget := widget pageWidgetAt: page.	page resetContent.	newWidget := widget pageWidgetAt: page.	self assert: newWidget notNil.	self deny: newWidget identicalTo: oldWidget]{ #category : 'tests' }SpWin32NotebookTest >> testNativeSelectionEventIsDecodedByNativeControl [	| runtime control handler |	runtime := SpWin32Runtime new.	control := SpWin32NativeControl		runtime: runtime		kind: SpWin32Runtime controlNotebook		text: ''		preferredExtent: 180 @ 140.	control objectId: 109.	handler := SpWin32RuntimeTestHandler new.	control eventHandler: handler.	control		nativeEventType: SpWin32Runtime eventSelectionChanged		argument1: 3		argument2: 0.	self assert: control selectedIndex equals: 3.	self assert: handler selectionChanged equals: 3]{ #category : 'tests' }SpWin32NotebookTest >> testSwitchingPagesHidesOldContentAndShowsNewContent [	| application notebook widget firstPage secondPage firstWidget secondWidget |	application := self newApplication.	notebook := self notebookWithApplication: application.	firstPage := notebook pages first.	secondPage := notebook pages second.	widget := notebook build.	firstWidget := widget pageWidgetAt: firstPage.	self assert: firstWidget isVisible.	notebook selectPageIndex: 2.	secondWidget := widget pageWidgetAt: secondPage.	self deny: firstWidget isVisible.	self assert: secondWidget isVisible]{ #category : 'tests' }SpWin32NotebookTest >> testNotebookLayoutPlacesTabBeforeSelectedPageContent [	| application notebook widget placements selectedWidget |	application := self newApplication.	notebook := self notebookWithApplication: application.	widget := notebook build.	placements := OrderedCollection new.	widget layoutIn: (0 @ 0 extent: 400 @ 300) collect: placements.	selectedWidget := widget pageWidgetAt: notebook selectedPage.	self assert: placements size equals: 2.	self assert: placements first first identicalTo: widget tabControl.	self assert: placements second first identicalTo: selectedWidget.	self assert: placements second third >= 30]