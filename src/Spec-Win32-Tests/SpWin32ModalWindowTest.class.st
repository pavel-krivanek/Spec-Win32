Class {	#name : 'SpWin32ModalWindowTest',	#superclass : 'TestCase',	#category : 'Spec-Win32-Tests-Windows',	#package : 'Spec-Win32-Tests',	#tag : 'Windows'}{ #category : 'tests' }SpWin32ModalWindowTest >> testAdapterBindingResolvesModalWindowAdapter [	self		assert: (SpWin32AdapterBindings new adapterClass: #ModalWindowAdapter)		equals: SpWin32ModalWindowAdapter]{ #category : 'tests' }SpWin32ModalWindowTest >> testModalAdapterExtendsDialogAdapter [	self assert: SpWin32ModalWindowAdapter superclass equals: SpWin32DialogWindowAdapter.	self assert: (SpWin32ModalWindowAdapter canUnderstand: #openWithDeferredAction:).	self assert: (SpWin32ModalWindowAdapter canUnderstand: #windowClosed).	self assert: (SpWin32ModalWindowAdapter canUnderstand: #chooseModalOwnerFrom:).	self assert: (SpWin32ModalWindowAdapter canUnderstand: #completeModal).	self assert: (SpWin32ModalWindowAdapter canUnderstand: #centeredRelativeTo:)]{ #category : 'tests' }SpWin32ModalWindowTest >> testRuntimeAbiIsV022 [	self assert: SpWin32Runtime abiVersion equals: 16r00290000]{ #category : 'tests' }SpWin32ModalWindowTest >> testNativeWindowSupportsModalEnableState [	self assert: (SpWin32NativeWindow canUnderstand: #enabled:).	self assert: (SpWin32NativeWindow canUnderstand: #isEnabled)]