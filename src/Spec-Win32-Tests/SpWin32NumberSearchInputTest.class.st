Class {	#name : 'SpWin32NumberSearchInputTest',	#superclass : 'TestCase',	#category : 'Spec-Win32-Tests-Controls',	#package : 'Spec-Win32-Tests',	#tag : 'Controls'}{ #category : 'tests - number' }SpWin32NumberSearchInputTest >> testNumberInputUsesDedicatedNativeKind [	| presenter adapter |	presenter := SpNumberInputFieldPresenter new number: 4; yourself.	adapter := SpWin32NumberInputFieldAdapter adapt: presenter.	self assert: adapter widget kind equals: SpWin32Runtime controlNumberInput.	self assert: adapter getText equals: '4']{ #category : 'tests - number' }SpWin32NumberSearchInputTest >> testNumberStepUsesClimbRateAndBounds [	| presenter adapter |	presenter := SpNumberInputFieldPresenter new		beInteger;		rangeMinimum: 0 maximum: 5;		climbRate: 2;		number: 4;		yourself.	adapter := SpWin32NumberInputFieldAdapter adapt: presenter.	adapter win32NumberStep: 1.	self assert: presenter number equals: 5.	self assert: adapter getText equals: '5'.	adapter win32NumberStep: -1.	self assert: presenter number equals: 3]{ #category : 'tests - number' }SpWin32NumberSearchInputTest >> testFloatNumberStepHonorsDigits [	| presenter adapter |	presenter := SpNumberInputFieldPresenter new		beFloat;		digits: 2;		climbRate: 0.25;		number: 1.5;		yourself.	adapter := SpWin32NumberInputFieldAdapter adapt: presenter.	adapter increase.	self assert: adapter getText equals: '1.75'.	self assert: presenter number equals: 1.75]{ #category : 'tests - number' }SpWin32NumberSearchInputTest >> testNumberInputNormalizesToBoundsOnFocusLost [	| presenter adapter |	presenter := SpNumberInputFieldPresenter new		beInteger;		rangeMinimum: 10 maximum: 20;		number: 30;		yourself.	adapter := SpWin32NumberInputFieldAdapter adapt: presenter.	adapter win32FocusLost.	self assert: presenter number equals: 20.	self assert: adapter getText equals: '20']{ #category : 'tests - search' }SpWin32NumberSearchInputTest >> testSearchInputUsesDedicatedNativeKindAndTextInfrastructure [	| presenter adapter |	presenter := SpSearchInputFieldPresenter new		placeholder: 'Search here';		text: 'needle';		yourself.	adapter := SpWin32SearchInputFieldAdapter adapt: presenter.	self assert: adapter widget kind equals: SpWin32Runtime controlSearchInput.	self assert: adapter placeHolderText equals: 'Search here'.	self assert: adapter getText equals: 'needle']{ #category : 'tests - search' }SpWin32NumberSearchInputTest >> testSearchClearTextUpdatesPresenter [	| presenter adapter |	presenter := SpSearchInputFieldPresenter new text: 'needle'; yourself.	adapter := SpWin32SearchInputFieldAdapter adapt: presenter.	adapter clearText.	self assert: presenter text equals: ''.	self assert: adapter getText equals: '']