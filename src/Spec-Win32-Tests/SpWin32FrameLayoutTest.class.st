Class {	#name : 'SpWin32FrameLayoutTest',	#superclass : 'TestCase',	#category : 'Spec-Win32-Tests-Layout',	#package : 'Spec-Win32-Tests',	#tag : 'Layout'}{ #category : 'private' }SpWin32FrameLayoutTest >> buildFrameLabel: aLabel child: aChild [	| application root layout |	application := SpApplication new useBackend: #Win32.	root := SpPresenter newApplication: application.	layout := SpFrameLayout new		label: aLabel;		child: aChild;		yourself.	root layout: layout.	root build.	^ { root. layout }]{ #category : 'private' }SpWin32FrameLayoutTest >> controlExtent: anExtent [	^ SpWin32NativeControl		runtime: SpWin32Runtime new		kind: SpWin32Runtime controlButton		text: ''		preferredExtent: anExtent]{ #category : 'tests' }SpWin32FrameLayoutTest >> testAdapterBindingResolvesFrameLayoutAdapter [	self		assert: (SpWin32AdapterBindings new adapterClass: #FrameLayoutAdapter)		equals: SpWin32FrameLayoutAdapter]{ #category : 'tests' }SpWin32FrameLayoutTest >> testBuildUsesDedicatedNativeFrameAndLabel [	| application child built root layout widget |	application := SpApplication new useBackend: #Win32.	child := SpLabelPresenter newApplication: application.	child label: 'Inside'.	built := self buildFrameLabel: 'Options' child: child.	root := built first.	layout := built second.	widget := root adapter widget.	self assert: root adapter class equals: SpWin32FrameLayoutAdapter.	self assert: widget class equals: SpWin32FrameContainer.	self assert: widget kind equals: SpWin32Runtime controlFrame.	self assert: widget text equals: 'Options'.	self assert: widget child identicalTo: child adapter widget.	self assert: layout adapter identicalTo: root adapter]{ #category : 'tests' }SpWin32FrameLayoutTest >> testNilLabelBecomesEmptyNativeTitle [	| application child built |	application := SpApplication new useBackend: #Win32.	child := SpLabelPresenter newApplication: application.	child label: 'Inside'.	built := self buildFrameLabel: nil child: child.	self assert: built first adapter widget text equals: '']{ #category : 'tests' }SpWin32FrameLayoutTest >> testNestedExecutableLayoutIsKeptInsideFrame [	| application root nested label frame widget |	application := SpApplication new useBackend: #Win32.	root := SpPresenter newApplication: application.	label := SpLabelPresenter newApplication: application.	label label: 'Nested'.	nested := SpBoxLayout newTopToBottom		add: label;		yourself.	frame := SpFrameLayout newLabel: 'Nested frame'.	frame child: nested.	root layout: frame.	root build.	widget := root adapter widget child.	self assert: widget class equals: SpWin32BoxContainer.	self assert: widget children equals: { label adapter widget }]{ #category : 'tests' }SpWin32FrameLayoutTest >> testReplacingChildRebuildsNativeSubtree [	| application first second built root layout oldWidget |	application := SpApplication new useBackend: #Win32.	first := SpLabelPresenter newApplication: application.	first label: 'First'.	second := SpButtonPresenter newApplication: application.	second label: 'Second'.	built := self buildFrameLabel: 'Replace' child: first.	root := built first.	layout := built second.	oldWidget := first adapter widget.	layout replace: first with: second.	self assert: root adapter widget child identicalTo: second adapter widget.	self deny: root adapter widget child identicalTo: oldWidget]{ #category : 'tests' }SpWin32FrameLayoutTest >> testRemoveAllLeavesEmptyFrame [	| application child built root layout |	application := SpApplication new useBackend: #Win32.	child := SpLabelPresenter newApplication: application.	child label: 'Inside'.	built := self buildFrameLabel: 'Frame' child: child.	root := built first.	layout := built second.	layout removeAll.	self assert: root adapter widget child isNil.	self assert: root adapter isEmpty]{ #category : 'tests' }SpWin32FrameLayoutTest >> testPreferredExtentAddsFrameInsetsAndTitleWidth [	| layout container child |	layout := SpFrameLayout newLabel: 'Title'.	container := SpWin32FrameContainer layout: layout runtime: SpWin32Runtime new.	child := self controlExtent: 80@30.	container child: child constraints: SpFrameConstraints new.	container instVarNamed: 'childNaturalExtent' put: 80@30.	container preferredExtent: 60@22.	self assert: container preferredExtent equals: 104@60]{ #category : 'tests' }SpWin32FrameLayoutTest >> testFrameControlKindAndAbiAreReserved [	self assert: SpWin32Runtime controlFrame equals: 26.	self assert: SpWin32Runtime abiVersion equals: 16r00290000]{ #category : 'tests' }SpWin32FrameLayoutTest >> testRootCompositeSupportsWindowLifecycleProtocol [	self assert: (SpWin32FrameContainer canUnderstand: #realizeIn:extent:).	self assert: (SpWin32FrameContainer canUnderstand: #relayoutExtent:)]