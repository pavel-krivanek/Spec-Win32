Class {	#name : 'SpWin32RuntimeTestHandler',	#superclass : 'Object',	#instVars : [		'closeRequested',		'destroyed',		'resizeOld',		'resizeNew',		'clicked',		'toggled',		'textChanged',		'selectionChanged',		'valueChanged',		'popupDismissRequested'	],	#category : 'Spec-Win32-Tests-Support',	#package : 'Spec-Win32-Tests',	#tag : 'Support'}{ #category : 'accessing' }SpWin32RuntimeTestHandler >> closeRequested [	^ closeRequested]{ #category : 'accessing' }SpWin32RuntimeTestHandler >> destroyed [	^ destroyed]{ #category : 'initialization' }SpWin32RuntimeTestHandler >> initialize [	super initialize.	closeRequested := false.	destroyed := false.	clicked := false.	toggled := nil.	textChanged := nil.	selectionChanged := nil.	valueChanged := nil.	popupDismissRequested := false]{ #category : 'accessing' }SpWin32RuntimeTestHandler >> resizeNew [	^ resizeNew]{ #category : 'accessing' }SpWin32RuntimeTestHandler >> resizeOld [	^ resizeOld]{ #category : 'native events' }SpWin32RuntimeTestHandler >> win32CloseRequested [	closeRequested := true]{ #category : 'native events' }SpWin32RuntimeTestHandler >> win32Destroyed [	destroyed := true]{ #category : 'native events' }SpWin32RuntimeTestHandler >> win32ResizedFrom: oldExtent to: newExtent [	resizeOld := oldExtent.	resizeNew := newExtent]{ #category : 'accessing' }SpWin32RuntimeTestHandler >> clicked [ ^ clicked ]{ #category : 'native events' }SpWin32RuntimeTestHandler >> win32Clicked [ clicked := true ]{ #category : 'accessing' }SpWin32RuntimeTestHandler >> toggled [	^ toggled]{ #category : 'accessing' }SpWin32RuntimeTestHandler >> textChanged [	^ textChanged]{ #category : 'native events' }SpWin32RuntimeTestHandler >> win32Toggled: aBoolean [	toggled := aBoolean]{ #category : 'native events' }SpWin32RuntimeTestHandler >> win32TextChanged: aString [	textChanged := aString]{ #category : 'accessing' }SpWin32RuntimeTestHandler >> selectionChanged [	^ selectionChanged]{ #category : 'native events' }SpWin32RuntimeTestHandler >> win32SelectionChanged: anInteger [	selectionChanged := anInteger]{ #category : 'accessing' }SpWin32RuntimeTestHandler >> valueChanged [	^ valueChanged]{ #category : 'native events' }SpWin32RuntimeTestHandler >> win32ValueChanged: aNumber [	valueChanged := aNumber]{ #category : 'accessing' }SpWin32RuntimeTestHandler >> popupDismissRequested [	^ popupDismissRequested]{ #category : 'native events' }SpWin32RuntimeTestHandler >> win32PopupDismissRequested [	popupDismissRequested := true]