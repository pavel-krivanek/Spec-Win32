Class {	#name : 'SpWin32DiffAdapterTest',	#superclass : 'TestCase',	#category : 'Spec-Win32-Tests-Code',	#package : 'Spec-Win32-Tests',	#tag : 'Code'}{ #category : 'private' }SpWin32DiffAdapterTest >> newAdaptedPresenter [	| presenter adapter |	presenter := SpDiffPresenter new.	presenter		leftText: 'same', String lf, 'gone', String lf, 'tail';		rightText: 'same', String lf, 'added', String lf, 'tail'.	adapter := SpWin32DiffAdapter adapt: presenter.	presenter adapter: adapter.	^ { presenter. adapter }]{ #category : 'tests' }SpWin32DiffAdapterTest >> testBindingBackendAndAbiRemainStable [	self		assert: (SpWin32AdapterBindings new adapterClass: #DiffAdapter)		equals: SpWin32DiffAdapter.	self assert: SpWin32Backend new diffClass equals: SpDiffPresenter.	self assert: SpWin32Runtime abiVersion equals: 16r00290000]{ #category : 'tests' }SpWin32DiffAdapterTest >> testBuildsTwoReadOnlyCodeSurfaces [	| pair adapter |	pair := self newAdaptedPresenter.	adapter := pair second.	self assert: adapter children size equals: 2.	self assert: adapter leftControl kind equals: SpWin32Runtime controlCode.	self assert: adapter rightControl kind equals: SpWin32Runtime controlCode.	self deny: adapter leftControl editable.	self deny: adapter rightControl editable.	self deny: adapter leftControl codeLineNumbers.	self deny: adapter rightControl codeLineNumbers]{ #category : 'tests' }SpWin32DiffAdapterTest >> testRawTextsAreProjectedThroughDiffBuilder [	| pair adapter |	pair := self newAdaptedPresenter.	adapter := pair second.	self assert: adapter leftControl text lines equals: #('same' 'gone' 'tail').	self assert: adapter rightControl text lines equals: #('same' 'added' 'tail').	self assert: adapter leftControl codeLineDecorations size equals: 4.	self assert: adapter rightControl codeLineDecorations size equals: 4.	self assert: adapter leftControl codeLineDecorations third equals: 2.	self assert: adapter rightControl codeLineDecorations third equals: 1]{ #category : 'tests' }SpWin32DiffAdapterTest >> testLiveTextReplacementKeepsControls [	| pair presenter adapter left right |	pair := self newAdaptedPresenter.	presenter := pair first.	adapter := pair second.	left := adapter leftControl.	right := adapter rightControl.	presenter leftText: 'one', String lf, 'two'.	presenter rightText: 'one', String lf, 'three', String lf, 'four'.	self assert: adapter leftControl identicalTo: left.	self assert: adapter rightControl identicalTo: right.	self assert: adapter leftControl text lines equals: #('one' 'two').	self assert: adapter rightControl text lines equals: #('one' 'three' 'four')]{ #category : 'tests' }SpWin32DiffAdapterTest >> testWrapPolicyUpdatesBothPanes [	| pair presenter adapter |	pair := self newAdaptedPresenter.	presenter := pair first.	adapter := pair second.	self assert: presenter beWrapped.	presenter beWrapped: false.	self deny: adapter leftControl textWrapWord.	self deny: adapter rightControl textWrapWord.	presenter beWrapped: true.	self assert: adapter leftControl textWrapWord.	self assert: adapter rightControl textWrapWord]{ #category : 'tests' }SpWin32DiffAdapterTest >> testShowOnlySourceDestinationAndBothCollapseLayoutPanes [	| pair presenter adapter |	pair := self newAdaptedPresenter.	presenter := pair first.	adapter := pair second.	presenter showOnlySource: true.	self assert: adapter leftControl isVisible.	self deny: adapter rightControl isVisible.	presenter showOnlySource: false.	presenter showOnlyDestination: true.	self deny: adapter leftControl isVisible.	self assert: adapter rightControl isVisible.	presenter showBoth.	self assert: adapter leftControl isVisible.	self assert: adapter rightControl isVisible]{ #category : 'tests' }SpWin32DiffAdapterTest >> testLabelsOptionsAndContextUpdatesRemainProtocolSafe [	| pair presenter adapter |	pair := self newAdaptedPresenter.	presenter := pair first.	adapter := pair second.	presenter leftLabel: 'Before'.	presenter rightLabel: 'After'.	presenter showOptions: false.	presenter contextClass: Object.	self assert: adapter leftControl notNil.	self assert: adapter rightControl notNil]{ #category : 'tests' }SpWin32DiffAdapterTest >> testDiffContainerDoesNotRequireNativeMeasurementBeforeRealization [	| pair adapter |	pair := self newAdaptedPresenter.	adapter := pair second.	self		shouldnt: [ adapter widget refreshPreferredExtentsIn: Object new ]		raise: Error.	self assert: adapter widget preferredExtent equals: 641 @ 320]