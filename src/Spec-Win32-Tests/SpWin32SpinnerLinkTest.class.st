Class {	#name : 'SpWin32SpinnerLinkTest',	#superclass : 'TestCase',	#category : 'Spec-Win32-Tests-Controls',	#package : 'Spec-Win32-Tests',	#tag : 'Controls'}{ #category : 'tests' }SpWin32SpinnerLinkTest >> testBindingsResolveSpinnerAndLink [	| bindings |	bindings := SpWin32AdapterBindings new.	self assert: (bindings adapterClass: #SpinnerAdapter) equals: SpWin32SpinnerAdapter.	self assert: (bindings adapterClass: #LinkAdapter) equals: SpWin32LinkAdapter]{ #category : 'tests' }SpWin32SpinnerLinkTest >> testSpinnerUsesDedicatedNativeKind [	| presenter adapter |	presenter := SpSpinnerPresenter new.	adapter := SpWin32SpinnerAdapter adapt: presenter.	self assert: adapter widget kind equals: SpWin32Runtime controlSpinner.	self assert: adapter widget preferredExtent equals: 32 @ 32]{ #category : 'tests' }SpWin32SpinnerLinkTest >> testLinkUsesDedicatedNativeKindAndTracksLabel [	| presenter adapter |	presenter := SpLinkPresenter new label: 'Before'; action: [ ]; yourself.	adapter := SpWin32LinkAdapter adapt: presenter.	self assert: adapter widget kind equals: SpWin32Runtime controlLink.	self assert: adapter widget text equals: 'Before'.	presenter label: 'After'.	self assert: adapter widget text equals: 'After']{ #category : 'tests' }SpWin32SpinnerLinkTest >> testLinkNativeClickInvokesPresenterAction [	| presenter adapter invoked |	invoked := false.	presenter := SpLinkPresenter new		label: 'Run';		action: [ invoked := true ];		yourself.	adapter := SpWin32LinkAdapter adapt: presenter.	adapter win32Clicked.	self assert: invoked]{ #category : 'tests' }SpWin32SpinnerLinkTest >> testRuntimeAbiIsV022 [	self assert: SpWin32Runtime abiVersion equals: 16r00290000.	self assert: SpWin32Runtime controlSpinner equals: 16.	self assert: SpWin32Runtime controlLink equals: 17]