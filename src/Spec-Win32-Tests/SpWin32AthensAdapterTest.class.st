Class {	#name : 'SpWin32AthensAdapterTest',	#superclass : 'TestCase',	#category : 'Spec-Win32-Tests-Controls',	#package : 'Spec-Win32-Tests',	#tag : 'Controls'}{ #category : 'private' }SpWin32AthensAdapterTest >> newApplication [	^ SpApplication new useBackend: #Win32]{ #category : 'private' }SpWin32AthensAdapterTest >> newPresenter [	| presenter |	presenter := SpAthensPresenter newApplication: self newApplication.	presenter		surfaceExtent: 80 @ 60;		drawBlock: [ :canvas |			canvas surface clear: Color transparent.			canvas setPaint: Color red.			canvas drawShape: (5 @ 5 extent: 30 @ 20) ].	^ presenter]{ #category : 'tests' }SpWin32AthensAdapterTest >> testBindingResolvesAthensAdapter [	self		assert: (SpWin32AdapterBindings new adapterClass: #AthensAdapter)		equals: SpWin32AthensAdapter]{ #category : 'tests' }SpWin32AthensAdapterTest >> testBuildUsesResizeAwareImageSurfaceAndPresenterExtent [	| adapter widget |	adapter := SpWin32AthensAdapter adapt: self newPresenter.	widget := adapter widget.	self assert: widget class equals: SpWin32AthensSurfaceControl.	self assert: widget kind equals: SpWin32Runtime controlImage.	self assert: widget preferredExtent equals: 80 @ 60.	self deny: widget imageAutoScale]{ #category : 'tests' }SpWin32AthensAdapterTest >> testRedrawPassesAthensCanvasAndBoundingBox [	| presenter adapter receivedCanvas receivedBounds |	presenter := self newPresenter.	presenter drawBlock: [ :canvas :bounds |		receivedCanvas := canvas.		receivedBounds := bounds ].	adapter := SpWin32AthensAdapter adapt: presenter.	adapter redraw.	self assert: (receivedCanvas isKindOf: AthensCanvas).	self assert: receivedBounds equals: (0 @ 0 extent: 80 @ 60).	self assert: adapter surface extent equals: 80 @ 60.	self assert: adapter widget imageData extent equals: 80 @ 60]{ #category : 'tests' }SpWin32AthensAdapterTest >> testOneArgumentDrawBlockIsSupported [	| presenter adapter receivedCanvas |	presenter := self newPresenter.	presenter drawBlock: [ :canvas | receivedCanvas := canvas ].	adapter := SpWin32AthensAdapter adapt: presenter.	adapter redraw.	self assert: (receivedCanvas isKindOf: AthensCanvas)]{ #category : 'tests' }SpWin32AthensAdapterTest >> testChangingDrawBlockRedrawsStoredImage [	| presenter adapter count |	presenter := self newPresenter.	count := 0.	presenter drawBlock: [ :canvas | count := count + 1 ].	adapter := SpWin32AthensAdapter adapt: presenter.	presenter adapter: adapter.	adapter redraw.	self assert: count equals: 1.	presenter drawBlock: [ :canvas | count := count + 10 ].	self assert: count equals: 11.	self assert: adapter widget imageData extent equals: 80 @ 60]{ #category : 'tests' }SpWin32AthensAdapterTest >> testSurfaceExtentChangeUpdatesPreferredExtentAndSurface [	| presenter adapter |	presenter := self newPresenter.	adapter := SpWin32AthensAdapter adapt: presenter.	presenter adapter: adapter.	adapter redraw.	presenter surfaceExtent: 123 @ 77.	self assert: adapter widget preferredExtent equals: 123 @ 77.	self assert: adapter surface extent equals: 123 @ 77.	self assert: adapter widget imageData extent equals: 123 @ 77]{ #category : 'tests' }SpWin32AthensAdapterTest >> testRefreshPreferredExtentDoesNotReplaceSurfaceExtentWithImageDefault [	| adapter widget |	adapter := SpWin32AthensAdapter adapt: self newPresenter.	widget := adapter widget.	self assert: (widget refreshPreferredExtentIn: nil) equals: 80 @ 60.	self assert: widget preferredExtent equals: 80 @ 60]{ #category : 'tests' }SpWin32AthensAdapterTest >> testExplicitRedrawReusesSurfaceAtSameExtent [	| adapter firstSurface |	adapter := SpWin32AthensAdapter adapt: self newPresenter.	adapter redraw.	firstSurface := adapter surface.	adapter redraw.	self assert: adapter surface identicalTo: firstSurface]{ #category : 'tests' }SpWin32AthensAdapterTest >> testNativeImageClickEventIsSafelyConsumed [	| adapter |	adapter := SpWin32AthensAdapter adapt: self newPresenter.	self		shouldnt: [			adapter widget				nativeEventType: SpWin32Runtime eventClicked				argument1: 0				argument2: 0 ]		raise: Error]{ #category : 'tests' }SpWin32AthensAdapterTest >> testRenderedSurfaceUsesBulkPremultipliedBGRATransport [	| presenter adapter imageData bytes |	presenter := self newPresenter.	presenter surfaceExtent: 3 @ 2.	presenter drawBlock: [ :canvas :bounds |		canvas surface clear: Color transparent.		canvas setPaint: (Color r: 1 g: 0 b: 0 alpha: 0.5).		canvas drawShape: bounds ].	adapter := SpWin32AthensAdapter adapt: presenter.	adapter redraw.	imageData := adapter widget imageData.	bytes := imageData bytes.	self assert: imageData extent equals: 3 @ 2.	self assert: bytes size equals: 24.	self assert: (bytes copyFrom: 1 to: 4) equals: #[ 0 0 127 127 ]]