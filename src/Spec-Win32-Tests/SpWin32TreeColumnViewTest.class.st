Class {	#name : 'SpWin32TreeColumnViewTest',	#superclass : 'TestCase',	#category : 'Spec-Win32-Tests-ListView',	#package : 'Spec-Win32-Tests',	#tag : 'ListView'}{ #category : 'private' }SpWin32TreeColumnViewTest >> application [	^ SpApplication new useBackend: #Win32]{ #category : 'private' }SpWin32TreeColumnViewTest >> newPresenter [	| presenter |	presenter := SpTreeColumnViewPresenter newApplication: self application.	presenter		addColumnTitle: 'Name'			setup: [ :builder | builder newLabel ]			bind: [ :label :association | label label: association key ];		addColumnTitle: 'Score'			setup: [ :builder | builder newLabel ]			bind: [ :label :association | label label: association value asString ];		roots: { 'A' -> 1. 'B' -> 2 };		children: [ :association |			association key = 'A'				ifTrue: [ { 'A1' -> 11. 'A2' -> 12 } ]				ifFalse: [					association key = 'A1'						ifTrue: [ { 'A11' -> 111 } ]						ifFalse: [ #() ] ] ].	^ presenter]{ #category : 'tests' }SpWin32TreeColumnViewTest >> testBindingAndNativeKind [	| adapter |	self assert: (SpWin32AdapterBindings new adapterClass: #TreeColumnViewAdapter) equals: SpWin32TreeColumnViewAdapter.	adapter := SpWin32TreeColumnViewAdapter adapt: self newPresenter.	self assert: adapter class adaptingName equals: #TreeColumnViewAdapter.	self assert: adapter widget kind equals: SpWin32Runtime controlTreeColumn.	self assert: adapter widget columnCount equals: 2.	self assert: adapter widget rowCount equals: 2]{ #category : 'tests' }SpWin32TreeColumnViewTest >> testColumnSetupBindBuildsTreeAndCellMatrices [	| adapter |	adapter := SpWin32TreeColumnViewAdapter adapt: self newPresenter.	self assert: adapter widget treeLabels equals: #('A' 'A1' 'A11' 'A2' 'B').	self assert: adapter widget parentTokens equals: #(0 1 2 1 0).	self assert: adapter cellStrings equals: #('A' '1' 'A1' '11' 'A11' '111' 'A2' '12' 'B' '2').	self assert: adapter visibleCellStrings equals: #('A' '1' 'B' '2').	self assert: adapter cellPresenters size equals: 10.	self assert: adapter widget columnTitles equals: #('Name' 'Score')]{ #category : 'tests' }SpWin32TreeColumnViewTest >> testExpansionChangesVisibleTableProjection [	| adapter |	adapter := SpWin32TreeColumnViewAdapter adapt: self newPresenter.	adapter expandPath: #(1).	self assert: adapter visiblePaths equals: #(#(1) #(1 1) #(1 2) #(2)).	self assert: adapter widget rowCount equals: 4.	self assert: adapter visibleCellStrings equals: #('A' '1' 'A1' '11' 'A2' '12' 'B' '2').	adapter expandPath: #(1 1).	self assert: adapter visiblePaths equals: #(#(1) #(1 1) #(1 1 1) #(1 2) #(2)).	self assert: adapter widget rowCount equals: 5.	adapter collapsePath: #(1).	self assert: adapter widget rowCount equals: 2]{ #category : 'tests' }SpWin32TreeColumnViewTest >> testNativeExpansionEventTracksStateAndProjection [	| adapter |	adapter := SpWin32TreeColumnViewAdapter adapt: self newPresenter.	adapter win32TreeExpansionChangedToken: 1 expanded: true.	self assert: (adapter isExpanded: #(1)).	self assert: adapter widget rowCount equals: 4.	adapter win32TreeExpansionChangedToken: 1 expanded: false.	self deny: (adapter isExpanded: #(1)).	self assert: adapter widget rowCount equals: 2]{ #category : 'tests' }SpWin32TreeColumnViewTest >> testNativeSelectionAndActivationMapBackToTreePath [	| presenter adapter activated |	presenter := self newPresenter.	activated := nil.	presenter whenActivatedDo: [ :selection | activated := selection selectedItem ].	adapter := SpWin32TreeColumnViewAdapter adapt: presenter.	presenter adapter: adapter.	adapter win32TreeSelectionChangedToken: 4.	self assert: presenter selection selectedPath equals: #(1 2).	self assert: presenter selectedItem key equals: 'A2'.	adapter win32ActivatedAt: 4 source: 1.	self assert: activated key equals: 'A2']{ #category : 'tests' }SpWin32TreeColumnViewTest >> testProgrammaticSelectionUsesTreeToken [	| presenter adapter |	presenter := self newPresenter.	adapter := SpWin32TreeColumnViewAdapter adapt: presenter.	presenter adapter: adapter.	adapter expandPath: #(1).	presenter selectPath: #(1 2).	self assert: adapter widget selectedToken equals: 4]{ #category : 'tests' }SpWin32TreeColumnViewTest >> testColumnMetadataFollowsWidthExpansionHeadersAndResizable [	| presenter adapter first second |	presenter := SpTreeColumnViewPresenter newApplication: self application.	first := SpColumnViewColumn new		title: 'Fixed';		width: 77;		beNotExpandable;		yourself.	second := SpColumnViewColumn new title: 'Flexible'; yourself.	presenter addColumn: first; addColumn: second; roots: #('x'); children: [ :each | #() ].	adapter := SpWin32TreeColumnViewAdapter adapt: presenter.	presenter adapter: adapter.	self assert: adapter widget columnWidths equals: #(77 100).	self assert: adapter widget columnExpandables equals: #(false true).	self assert: adapter widget headersVisible.	self assert: adapter widget resizable.	presenter hideColumnHeaders.	self deny: adapter widget headersVisible.	presenter beNotResizable.	self deny: adapter widget resizable]{ #category : 'tests' }SpWin32TreeColumnViewTest >> testImagesCanAppearInMultipleColumns [	| presenter adapter red blue |	red := Form extent: 10@12 depth: 32.	red fillColor: Color red.	blue := Form extent: 18@14 depth: 32.	blue fillColor: Color blue.	presenter := SpTreeColumnViewPresenter newApplication: self application.	presenter		addColumnTitle: 'First'			setup: [ :builder |				| cell |				cell := builder newPresenter.				cell layout: (SpBoxLayout newLeftToRight					add: builder newImage expand: false;					add: builder newLabel;					yourself).				cell ]			bind: [ :cell :item |				cell layout children first image: red.				cell layout children second label: item ];		addColumnTitle: 'Second'			setup: [ :builder |				| cell |				cell := builder newPresenter.				cell layout: (SpBoxLayout newLeftToRight					add: builder newImage expand: false;					add: builder newLabel;					yourself).				cell ]			bind: [ :cell :item |				cell layout children first image: blue.				cell layout children second label: item asUppercase ];		roots: #('alpha' 'beta');		children: [ :each | #() ].	adapter := SpWin32TreeColumnViewAdapter adapt: presenter.	self assert: adapter cellStrings equals: #('alpha' 'ALPHA' 'beta' 'BETA').	self assert: adapter widget treeImages size equals: 2.	self assert: adapter widget treeImages first extent equals: 10@12.	self assert: adapter widget cellImages second extent equals: 18@14]{ #category : 'tests' }SpWin32TreeColumnViewTest >> testInteractiveCellPresenterIsExplicitlyRejected [	| presenter |	presenter := SpTreeColumnViewPresenter newApplication: self application.	presenter		addColumnTitle: 'Action'			setup: [ :builder | builder newButton ]			bind: [ :button :item | button label: item ];		roots: #('Run');		children: [ :each | #() ].	self should: [ SpWin32TreeColumnViewAdapter adapt: presenter ] raise: Error]{ #category : 'tests' }SpWin32TreeColumnViewTest >> testRefreshRebindsCellsAndPreservesExpansion [	| presenter adapter prefix |	prefix := 'before-'.	presenter := self newPresenter.	presenter columns first bind: [ :label :association | label label: prefix, association key ].	adapter := SpWin32TreeColumnViewAdapter adapt: presenter.	presenter adapter: adapter.	adapter expandPath: #(1).	prefix := 'after-'.	presenter refresh.	self assert: adapter widget treeLabels first equals: 'after-A'.	self assert: adapter visibleCellStrings third equals: 'after-A1'.	self assert: (adapter isExpanded: #(1))]{ #category : 'tests' }SpWin32TreeColumnViewTest >> testRootsChangeRebuildsTreeAndDropsExpansion [	| presenter adapter |	presenter := self newPresenter.	adapter := SpWin32TreeColumnViewAdapter adapt: presenter.	presenter adapter: adapter.	adapter expandPath: #(1).	presenter roots: { 'X' -> 9 }.	self assert: adapter widget treeLabels equals: #('X').	self assert: adapter widget rowCount equals: 1.	self deny: (adapter isExpanded: #(1))]{ #category : 'tests' }SpWin32TreeColumnViewTest >> testEasyTreeColumnViewBuildsWithWin32Adapter [	| easy widget content |	easy := SpEasyTreeColumnViewPresenter newApplication: self application.	easy		addColumn: (SpStringTableColumn title: 'Name' evaluated: #yourself);		roots: #('Alpha' 'Beta');		children: [ :each | #() ].	widget := easy build.	content := easy contentView.	self assert: widget notNil.	self assert: content adapter class equals: SpWin32TreeColumnViewAdapter.	self assert: content adapter cellStrings equals: #('Alpha' 'Beta')]{ #category : 'tests' }SpWin32TreeColumnViewTest >> testSortableHeaderSortsSiblingsAndPreservesSelectionPath [	| easy content adapter score |	easy := SpEasyTreeColumnViewPresenter newApplication: self application.	easy		addColumn: (SpStringTableColumn title: 'Name' evaluated: #key);		addColumn: ((SpStringTableColumn title: 'Score' evaluated: #value) beSortable; yourself);		roots: { 'Alpha' -> 20. 'Beta' -> 10. 'Gamma' -> 30 };		children: [ :each | #() ].	content := easy contentView.	adapter := SpWin32TreeColumnViewAdapter adapt: content.	content adapter: adapter.	content selectPath: #(1).	score := content columns second.	self assert: score isSortable.	adapter win32ColumnClicked: 2.	self assert: adapter widget treeLabels first equals: 'Beta'.	self assert: content selectedItem key equals: 'Alpha'.	self assert: adapter widget selectedToken equals: 2.	adapter win32ColumnClicked: 2.	self assert: adapter widget treeLabels first equals: 'Gamma']{ #category : 'tests' }SpWin32TreeColumnViewTest >> testSelectedRowPresenterRemainsNilForNativeSnapshotPath [	| presenter adapter |	presenter := self newPresenter.	adapter := SpWin32TreeColumnViewAdapter adapt: presenter.	presenter adapter: adapter.	presenter selectPath: #(1).	self assert: presenter selectedRowPresenter isNil]