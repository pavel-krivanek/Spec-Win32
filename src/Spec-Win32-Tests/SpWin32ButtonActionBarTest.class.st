Class {	#name : 'SpWin32ButtonActionBarTest',	#superclass : 'TestCase',	#category : 'Spec-Win32-Tests-Controls',	#package : 'Spec-Win32-Tests',	#tag : 'Controls'}{ #category : 'private' }SpWin32ButtonActionBarTest >> application [	^ SpApplication new useBackend: #Win32]{ #category : 'private' }SpWin32ButtonActionBarTest >> buttonIn: anApplication label: aString [	^ (SpButtonPresenter newApplication: anApplication)		label: aString;		yourself]{ #category : 'tests' }SpWin32ButtonActionBarTest >> testActionBarAdapterBinding [	self		assert: (SpWin32AdapterBindings new adapterClass: #ActionBarAdapter)		equals: SpWin32ActionBarAdapter]{ #category : 'tests' }SpWin32ButtonActionBarTest >> testActionBarBuildsLeftRightAndCenterWidgets [	| application presenter left right center widget |	application := self application.	presenter := SpActionBarPresenter newApplication: application.	left := self buttonIn: application label: 'Left'.	right := self buttonIn: application label: 'Right'.	center := (SpLabelPresenter newApplication: application) label: 'Center'; yourself.	presenter add: left; addLast: right; centerPresenter: center.	widget := presenter build.	self assert: widget class equals: SpWin32ActionBarContainer.	self assert: widget children size equals: 3.	self assert: (widget children includes: left adapter widget).	self assert: (widget children includes: right adapter widget).	self assert: (widget children includes: center adapter widget)]{ #category : 'tests' }SpWin32ButtonActionBarTest >> testActionBarCentersCenterPresenterBetweenSides [	| application presenter left right center widget placements centerPlacement |	application := self application.	presenter := SpActionBarPresenter newApplication: application.	left := self buttonIn: application label: 'Left'.	right := self buttonIn: application label: 'Right'.	center := (SpLabelPresenter newApplication: application) label: 'Center'; yourself.	presenter add: left; addLast: right; centerPresenter: center.	widget := presenter build.	placements := OrderedCollection new.	widget layoutIn: (0@0 extent: 500@40) collect: placements.	centerPlacement := placements detect: [ :each | each first == center adapter widget ].	self assert: centerPlacement second > 150.	self assert: centerPlacement second < 350.	self assert: placements first second < centerPlacement second.	self assert: placements second second > centerPlacement second]{ #category : 'tests' }SpWin32ButtonActionBarTest >> testActionBarReplacesCenterPresenterDynamically [	| application presenter first second widget oldWidget |	application := self application.	presenter := SpActionBarPresenter newApplication: application.	first := (SpLabelPresenter newApplication: application) label: 'First'; yourself.	second := (SpLabelPresenter newApplication: application) label: 'Second'; yourself.	presenter centerPresenter: first.	widget := presenter build.	oldWidget := first adapter widget.	presenter centerPresenter: second.	self deny: (widget children includes: oldWidget).	self assert: (widget children includes: second adapter widget)]{ #category : 'tests' }SpWin32ButtonActionBarTest >> testButtonBarAdapterBinding [	self		assert: (SpWin32AdapterBindings new adapterClass: #ButtonBarAdapter)		equals: SpWin32ButtonBarAdapter]{ #category : 'tests' }SpWin32ButtonActionBarTest >> testButtonBarBuildsButtonWidgets [	| application presenter first second widget |	application := self application.	presenter := SpButtonBarPresenter newApplication: application.	first := self buttonIn: application label: 'OK'.	second := self buttonIn: application label: 'Cancel'.	presenter add: first; add: second.	widget := presenter build.	self assert: widget class equals: SpWin32ButtonBarContainer.	self assert: widget children equals: { first adapter widget. second adapter widget }]{ #category : 'tests' }SpWin32ButtonActionBarTest >> testButtonBarPlacesButtonsAtEndByDefault [	| application presenter first second widget placements |	application := self application.	presenter := SpButtonBarPresenter newApplication: application.	first := self buttonIn: application label: 'OK'.	second := self buttonIn: application label: 'Cancel'.	presenter add: first; add: second.	widget := presenter build.	placements := OrderedCollection new.	widget layoutIn: (0@0 extent: 400@40) collect: placements.	self assert: placements first second > 150.	self assert: placements second second > placements first second]{ #category : 'tests' }SpWin32ButtonActionBarTest >> testButtonBarPlacesButtonsAtStart [	| application presenter first second widget placements |	application := self application.	presenter := SpButtonBarPresenter newApplication: application.	presenter placeAtStart.	first := self buttonIn: application label: 'One'.	second := self buttonIn: application label: 'Two'.	presenter add: first; add: second.	widget := presenter build.	placements := OrderedCollection new.	widget layoutIn: (0@0 extent: 400@40) collect: placements.	self assert: placements first second equals: 5.	self assert: placements second second > placements first second]{ #category : 'tests' }SpWin32ButtonActionBarTest >> testActionBarCenterReplacementBubblesRelayoutToOwningLayout [	| application presenter first second widget probe |	application := self application.	presenter := SpActionBarPresenter newApplication: application.	first := (SpLabelPresenter newApplication: application) label: 'First'; yourself.	second := (SpLabelPresenter newApplication: application) label: 'Second'; yourself.	presenter centerPresenter: first.	widget := presenter build.	probe := SpWin32RelayoutProbe new.	widget layoutOwner: probe.	presenter centerPresenter: second.	self assert: probe count > 0]