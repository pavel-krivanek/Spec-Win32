Class {	#name : 'SpWin32BackendCorrectnessTest',	#superclass : 'TestCase',	#category : 'Spec-Win32-Tests-Backend',	#package : 'Spec-Win32-Tests',	#tag : 'Backend'}{ #category : 'private' }SpWin32BackendCorrectnessTest >> backend [	^ SpWin32Backend new]{ #category : 'tests' }SpWin32BackendCorrectnessTest >> testComponentListAdvertisesImplementedPresenter [	self assert: self backend componentListClass equals: SpComponentListPresenter]{ #category : 'tests' }SpWin32BackendCorrectnessTest >> testDiffAdvertisesImplementedPresenter [	self assert: self backend diffClass equals: SpDiffPresenter]