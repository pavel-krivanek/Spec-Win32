Class {	#name : 'SpWin32PatchSideBySideAdapterTest',	#superclass : 'TestCase',	#category : 'Spec-Win32-Tests-Code',	#package : 'Spec-Win32-Tests',	#tag : 'Code'}{ #category : 'tests' }SpWin32PatchSideBySideAdapterTest >> testBindingAndAbi [	self		assert: (SpWin32AdapterBindings new adapterClass: #PatchSideBySideAdapter)		equals: SpWin32PatchSideBySideAdapter.	self assert: SpWin32Runtime abiVersion equals: 16r00290000]{ #category : 'tests' }SpWin32PatchSideBySideAdapterTest >> testVisitorMatchesGtkProjectionContract [	| model visitor |	model := SpPatchModel		newFrom: 'same', String lf, 'gone', String lf, 'tail'		to: 'same', String lf, 'added', String lf, 'tail'.	visitor := SpWin32PatchSideBySideVisitor new visitPatch: model patch; yourself.	self assert: visitor leftText lines equals: #('same' 'gone' 'tail').	self assert: visitor rightText lines equals: #('same' 'added' 'tail').	self assert: visitor leftMarks asArray equals: { 2 -> #delete }.	self assert: visitor rightMarks asArray equals: { 2 -> #insert }]{ #category : 'tests' }SpWin32PatchSideBySideAdapterTest >> testPureDeleteDoesNotInventRightPlaceholder [	| model visitor |	model := SpPatchModel newFrom: 'one', String lf, 'two' to: 'one'.	visitor := SpWin32PatchSideBySideVisitor new visitPatch: model patch; yourself.	self assert: visitor leftText lines equals: #('one' 'two').	self assert: visitor rightText lines equals: #('one').	self assert: visitor leftMarks asArray equals: { 2 -> #delete }.	self assertEmpty: visitor rightMarks]{ #category : 'tests' }SpWin32PatchSideBySideAdapterTest >> testBuildsTwoReadOnlyCodeSurfaces [	| presenter adapter |	presenter := SpPatchSideBySidePresenter new.	presenter withoutLineNumbers.	presenter patchFrom: 'old' to: 'new'.	adapter := SpWin32PatchSideBySideAdapter adapt: presenter.	presenter adapter: adapter.	self assert: adapter children size equals: 2.	self assert: adapter leftControl kind equals: SpWin32Runtime controlCode.	self assert: adapter rightControl kind equals: SpWin32Runtime controlCode.	self deny: adapter leftControl editable.	self deny: adapter rightControl editable.	self deny: adapter leftControl codeLineNumbers.	self deny: adapter rightControl codeLineNumbers]{ #category : 'tests' }SpWin32PatchSideBySideAdapterTest >> testDecorationsAreIndependentPerSide [	| presenter adapter |	presenter := SpPatchSideBySidePresenter new.	presenter patchFrom: 'same', String lf, 'gone' to: 'same', String lf, 'added'.	adapter := SpWin32PatchSideBySideAdapter adapt: presenter.	presenter adapter: adapter.	self assert: adapter leftControl codeLineDecorations size equals: 4.	self assert: adapter rightControl codeLineDecorations size equals: 4.	self assert: adapter leftControl codeLineDecorations third equals: 2.	self assert: adapter rightControl codeLineDecorations third equals: 1]{ #category : 'tests' }SpWin32PatchSideBySideAdapterTest >> testLineNumberPolicyUpdatesBothPanes [	| presenter adapter |	presenter := SpPatchSideBySidePresenter new.	presenter withoutLineNumbers.	adapter := SpWin32PatchSideBySideAdapter adapt: presenter.	presenter adapter: adapter.	presenter withLineNumbers.	self assert: adapter leftControl codeLineNumbers.	self assert: adapter rightControl codeLineNumbers.	presenter withoutLineNumbers.	self deny: adapter leftControl codeLineNumbers.	self deny: adapter rightControl codeLineNumbers]{ #category : 'tests' }SpWin32PatchSideBySideAdapterTest >> testPatchReplacementKeepsBothControlsAndRefreshesProjection [	| presenter adapter left right |	presenter := SpPatchSideBySidePresenter new.	presenter patchFrom: 'old' to: 'new'.	adapter := SpWin32PatchSideBySideAdapter adapt: presenter.	presenter adapter: adapter.	left := adapter leftControl.	right := adapter rightControl.	presenter patchFrom: 'same', String lf, 'gone' to: 'same', String lf, 'added'.	self assert: adapter leftControl identicalTo: left.	self assert: adapter rightControl identicalTo: right.	self assert: adapter leftControl text lines equals: #('same' 'gone').	self assert: adapter rightControl text lines equals: #('same' 'added')]{ #category : 'tests' }SpWin32PatchSideBySideAdapterTest >> testEmptyPatchClearsBothSides [	| presenter adapter |	presenter := SpPatchSideBySidePresenter new.	presenter patchFrom: 'old' to: 'new'.	adapter := SpWin32PatchSideBySideAdapter adapt: presenter.	presenter adapter: adapter.	presenter patchFrom: '' to: ''.	self assert: adapter leftControl text equals: ''.	self assert: adapter rightControl text equals: ''.	self assertEmpty: adapter leftControl codeLineDecorations.	self assertEmpty: adapter rightControl codeLineDecorations]