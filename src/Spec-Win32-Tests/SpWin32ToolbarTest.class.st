Class {	#name : 'SpWin32ToolbarTest',	#superclass : 'TestCase',	#category : 'Spec-Win32-Tests-Toolbar',	#package : 'Spec-Win32-Tests',	#tag : 'Toolbar'}{ #category : 'private' }SpWin32ToolbarTest >> iconExtent: anExtent color: aColor [	| form |	form := Form extent: anExtent depth: 32.	form fillColor: aColor.	^ form]{ #category : 'private' }SpWin32ToolbarTest >> newToolbar [	^ SpToolbarPresenter newApplication: (SpApplication new		useBackend: #Win32;		yourself)]{ #category : 'private' }SpWin32ToolbarTest >> newButtonLabel: aString icon: aFormOrNil action: aBlock [	^ SpToolbarButtonPresenter new		label: aString;		icon: aFormOrNil;		action: aBlock;		yourself]{ #category : 'tests' }SpWin32ToolbarTest >> testToolbarBuildsLeftAndRightItems [	| toolbar left right adapter |	toolbar := self newToolbar.	left := self newButtonLabel: 'Left' icon: nil action: [ ].	right := self newButtonLabel: 'Right' icon: nil action: [ ].	toolbar addItem: left.	toolbar addItem: right position: SpToolbarItemPosition right.	adapter := SpWin32ToolbarAdapter adapt: toolbar.	self assert: adapter numberOfItems equals: 2.	self assert: adapter widget leftWidgets size equals: 1.	self assert: adapter widget rightWidgets size equals: 1.	self assert: adapter widget leftWidgets first identicalTo: left adapter widget.	self assert: adapter widget rightWidgets first identicalTo: right adapter widget]{ #category : 'tests' }SpWin32ToolbarTest >> testToolbarButtonExecutesActionAndHonorsEnabledState [	| count toolbar button adapter |	count := 0.	toolbar := self newToolbar.	button := self newButtonLabel: 'Run' icon: nil action: [ count := count + 1 ].	toolbar addItem: button.	adapter := SpWin32ToolbarAdapter adapt: toolbar.	button adapter clicked.	self assert: count equals: 1.	button enabled: false.	button adapter clicked.	self assert: count equals: 1.	self deny: button adapter widget enabled.	self assert: adapter numberOfItems equals: 1]{ #category : 'tests' }SpWin32ToolbarTest >> testToolbarDisplayModesControlLabelAndIcon [	| toolbar icon button adapter |	icon := self iconExtent: 18 @ 16 color: Color blue.	toolbar := self newToolbar.	button := self newButtonLabel: 'Build' icon: icon action: [ ].	toolbar addItem: button.	adapter := SpWin32ToolbarAdapter adapt: toolbar.	self assert: button adapter widget text equals: 'Build'.	self assert: button adapter widget imageData extent equals: 18 @ 16.	toolbar beIcons.	self assert: button adapter widget text equals: ''.	self assert: button adapter widget imageData extent equals: 18 @ 16.	toolbar beText.	self assert: button adapter widget text equals: 'Build'.	self assert: button adapter widget imageData equals: nil.	toolbar beBoth.	self assert: button adapter widget text equals: 'Build'.	self assert: button adapter widget imageData extent equals: 18 @ 16.	self assert: adapter numberOfItems equals: 1]{ #category : 'tests' }SpWin32ToolbarTest >> testToolbarButtonLiveLabelAndIconUpdatesRespectDisplayMode [	| toolbar first second button |	first := self iconExtent: 12 @ 12 color: Color red.	second := self iconExtent: 22 @ 20 color: Color green.	toolbar := self newToolbar.	button := self newButtonLabel: 'One' icon: first action: [ ].	toolbar addItem: button.	SpWin32ToolbarAdapter adapt: toolbar.	button label: 'Longer caption'.	button icon: second.	self assert: button adapter widget text equals: 'Longer caption'.	self assert: button adapter widget imageData extent equals: 22 @ 20.	toolbar beText.	button icon: first.	self assert: button adapter widget imageData equals: nil.	toolbar beIcons.	button label: 'Hidden'.	self assert: button adapter widget text equals: '']{ #category : 'tests' }SpWin32ToolbarTest >> testToolbarToggleUpdatesStateActionAndAssociatedButtons [	| toolbar first second observed |	observed := OrderedCollection new.	toolbar := self newToolbar.	first := SpToolbarToggleButtonPresenter new		label: 'A';		action: [ :state | observed add: state ];		yourself.	second := SpToolbarToggleButtonPresenter new		label: 'B';		action: [ :state | observed add: state ];		yourself.	first associatedToggleButtons: { second }.	toolbar addItem: first; addItem: second.	SpWin32ToolbarAdapter adapt: toolbar.	first adapter clicked.	self assert: first state.	self assert: first adapter widget checked.	second adapter clicked.	self deny: first state.	self assert: second state.	self deny: first adapter widget checked.	self assert: second adapter widget checked.	self assert: observed asArray equals: #(true true)]{ #category : 'tests' }SpWin32ToolbarTest >> testToolbarCanAddItemAfterBuild [	| toolbar first second adapter |	toolbar := self newToolbar.	first := self newButtonLabel: 'One' icon: nil action: [ ].	toolbar addItem: first.	adapter := SpWin32ToolbarAdapter adapt: toolbar.	self assert: adapter numberOfItems equals: 1.	second := self newButtonLabel: 'Two' icon: nil action: [ ].	toolbar addItem: second.	self assert: adapter numberOfItems equals: 2.	self assert: adapter widget leftWidgets size equals: 2.	self assert: adapter widget leftWidgets second identicalTo: second adapter widget]{ #category : 'tests' }SpWin32ToolbarTest >> testToolbarUsesExistingV022ImageAbi [	self assert: SpWin32Runtime abiVersion equals: 16r00290000]{ #category : 'tests' }SpWin32ToolbarTest >> testAdapterBindingsResolveToolbarFamily [	| bindings |	bindings := SpWin32AdapterBindings new.	self assert: (bindings adapterClass: #ToolbarAdapter) equals: SpWin32ToolbarAdapter.	self assert: (bindings adapterClass: #ToolbarButtonAdapter) equals: SpWin32ToolbarButtonAdapter.	self assert: (bindings adapterClass: #ToolbarToggleButtonAdapter) equals: SpWin32ToolbarToggleButtonAdapter]{ #category : 'tests' }SpWin32ToolbarTest >> testWindowToolbarUsesDedicatedTopContentContainer [	| toolbarContent mainContent composite |	toolbarContent := SpWin32ToolbarContainer runtime: nil.	mainContent := SpWin32ToolbarContainer runtime: nil.	composite := SpWin32WindowContentContainer		toolbar: toolbarContent		content: mainContent		runtime: nil.	self assert: (SpWin32WindowAdapter canUnderstand: #buildWindowContentWithSpecLayout:).	self assert: composite children size equals: 2.	self assert: composite children first identicalTo: toolbarContent.	self assert: composite children second identicalTo: mainContent.	self assert: SpWin32WindowContentContainer superclass equals: SpWin32LayoutContainer]{ #category : 'tests' }SpWin32ToolbarTest >> testToolbarDisplayModeCanChangeAfterPresenterBuild [	| toolbar icon button |	icon := self iconExtent: 16 @ 16 color: Color blue.	toolbar := self newToolbar.	button := self newButtonLabel: 'Run' icon: icon action: [ ].	toolbar addItem: button.	toolbar build.	toolbar beIcons.	self assert: button adapter widget text equals: ''.	self assert: button adapter widget imageData notNil.	toolbar beText.	self assert: button adapter widget text equals: 'Run'.	self assert: button adapter widget imageData isNil.	toolbar beBoth.	self assert: button adapter widget text equals: 'Run'.	self assert: button adapter widget imageData notNil]