Class {	#name : 'SpWin32ScrollableLayoutTest',	#superclass : 'TestCase',	#category : 'Spec-Win32-Tests-Layout',	#package : 'Spec-Win32-Tests',	#tag : 'Layout'}{ #category : 'tests' }SpWin32ScrollableLayoutTest >> testAdapterUsesDedicatedScrollableContainer [	| layout adapter |	layout := SpScrollableLayout new.	adapter := SpWin32ScrollableAdapter new.	adapter layout: layout.	self assert: adapter widget class equals: SpWin32ScrollableContainer.	self assert: adapter isEmpty]{ #category : 'tests' }SpWin32ScrollableLayoutTest >> testChildReplacementKeepsSingleChild [	| layout container first second |	layout := SpScrollableLayout new.	container := SpWin32ScrollableContainer layout: layout runtime: SpWin32Runtime default.	first := SpWin32NativeControl		runtime: SpWin32Runtime default		kind: SpWin32Runtime controlButton		text: 'first'		preferredExtent: 80@24.	second := SpWin32NativeControl		runtime: SpWin32Runtime default		kind: SpWin32Runtime controlButton		text: 'second'		preferredExtent: 80@24.	container child: first.	container child: second.	self assert: container children size equals: 1.	self assert: container child identicalTo: second]{ #category : 'tests' }SpWin32ScrollableLayoutTest >> testPreferredExtentHonorsPropagationFlags [	| layout container child |	layout := SpScrollableLayout new.	child := SpWin32NativeControl		runtime: SpWin32Runtime default		kind: SpWin32Runtime controlButton		text: 'child'		preferredExtent: 240@180.	container := SpWin32ScrollableContainer layout: layout runtime: SpWin32Runtime default.	container child: child.	container instVarNamed: 'childNaturalExtent' put: 240@180.	self assert: container preferredExtent equals: 100@100.	layout propagateNaturalWidth: true.	layout propagateNaturalHeight: true.	self assert: container preferredExtent equals: 240@180]{ #category : 'tests' }SpWin32ScrollableLayoutTest >> testScrollableControlKindsAreReserved [	self assert: SpWin32Runtime controlScrollViewport equals: 21.	self assert: SpWin32Runtime controlScrollContent equals: 22]{ #category : 'tests' }SpWin32ScrollableLayoutTest >> testScrollToStoresNonNegativePixelPosition [	| layout container |	layout := SpScrollableLayout new.	container := SpWin32ScrollableContainer layout: layout runtime: SpWin32Runtime default.	container scrollTo: -3@27.	self assert: (container instVarNamed: 'scrollPosition') equals: 0@27]{ #category : 'tests' }SpWin32ScrollableLayoutTest >> testRootCompositeSupportsWindowLifecycleProtocol [	self assert: (SpWin32ScrollableContainer canUnderstand: #realizeIn:extent:).	self assert: (SpWin32ScrollableContainer canUnderstand: #relayoutExtent:)]{ #category : 'tests' }SpWin32ScrollableLayoutTest >> testRuntimeExposesEffectiveScrollablePageExtent [	self assert: (SpWin32Runtime canUnderstand: #scrollViewportPageExtent:).	self assert: (SpWin32Runtime canUnderstand: #primScrollViewGetPageExtent:width:height:)]