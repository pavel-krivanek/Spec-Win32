Class {	#name : 'SpWin32PatchAdapterTest',	#superclass : 'TestCase',	#category : 'Spec-Win32-Tests-Code',	#package : 'Spec-Win32-Tests',	#tag : 'Code'}{ #category : 'tests' }SpWin32PatchAdapterTest >> testBindingAndAbi [	self		assert: (SpWin32AdapterBindings new adapterClass: #PatchAdapter)		equals: SpWin32PatchAdapter.	self assert: SpWin32Runtime abiVersion equals: 16r00290000]{ #category : 'tests' }SpWin32PatchAdapterTest >> testVisitorProducesUnifiedPatchAndMarks [	| model visitor |	model := SpPatchModel		newFrom: 'same', String lf, 'gone'		to: 'same', String lf, 'added'.	visitor := SpWin32PatchLineVisitor new visitPatch: model patch; yourself.	self assert: visitor contents lines equals: #('same' 'gone' 'added').	self assert: visitor lineMarks asArray equals: { 2 -> #delete. 3 -> #insert }]{ #category : 'tests' }SpWin32PatchAdapterTest >> testPatchUsesReadOnlyCodeSurfaceWithDecorations [	| presenter adapter decorations |	presenter := SpPatchPresenter new.	presenter patchFrom: 'same', String lf, 'gone' to: 'same', String lf, 'added'.	adapter := SpWin32PatchAdapter adapt: presenter.	presenter adapter: adapter.	self assert: adapter widget kind equals: SpWin32Runtime controlCode.	self deny: adapter widget editable.	self deny: adapter widget codeLineNumbers.	decorations := adapter widget codeLineDecorations.	self assert: decorations size equals: 8.	self assert: (decorations copyFrom: 1 to: 4) third equals: 2.	self assert: (decorations copyFrom: 5 to: 8) third equals: 1]{ #category : 'tests' }SpWin32PatchAdapterTest >> testPatchReplacementRefreshesTextAndDecorations [	| presenter adapter before |	presenter := SpPatchPresenter new.	presenter patchFrom: 'one' to: 'two'.	adapter := SpWin32PatchAdapter adapt: presenter.	presenter adapter: adapter.	before := adapter widget codeLineDecorations copy.	presenter patchFrom: 'same' to: 'same', String lf, 'extra'.	self assert: adapter widget text lines equals: #('extra').	self deny: adapter widget codeLineDecorations equals: before.	self assert: adapter widget codeLineDecorations size equals: 4]{ #category : 'tests' }SpWin32PatchAdapterTest >> testEmptyPatchClearsTextAndDecorations [	| presenter adapter |	presenter := SpPatchPresenter new.	presenter patchFrom: 'one' to: 'two'.	adapter := SpWin32PatchAdapter adapt: presenter.	presenter adapter: adapter.	presenter patchFrom: '' to: ''.	self assert: adapter widget text equals: ''.	self assertEmpty: adapter widget codeLineDecorations]{ #category : 'tests' }SpWin32PatchAdapterTest >> testCustomMarkColorsAreTransported [	| presenter adapter deleteMark entries |	presenter := SpPatchPresenter new.	deleteMark := SpPatchMark newName: #delete.	deleteMark backgroundColor: (Color blue alpha: 0.25); iconName: #changeRemove.	presenter marks: {		deleteMark.		(SpPatchMark newName: #insert) backgroundColor: (Color green alpha: 0.1); iconName: #changeAdd; yourself }.	presenter patchFrom: 'old' to: 'new'.	adapter := SpWin32PatchAdapter adapt: presenter.	presenter adapter: adapter.	entries := adapter widget codeLineDecorations.	self assert: entries size equals: 8.	self assert: (entries copyFrom: 1 to: 4) fourth equals: 16r0000FF]{ #category : 'tests' }SpWin32PatchAdapterTest >> testProgrammaticRichEditChangeNotificationIsIgnored [	| presenter adapter beforeModel |	presenter := SpPatchPresenter new.	presenter patchFrom: 'old' to: 'new'.	adapter := SpWin32PatchAdapter adapt: presenter.	presenter adapter: adapter.	beforeModel := presenter model.	self shouldnt: [ adapter win32TextChanged: 'native formatting notification' ] raise: Error.	self assert: presenter model identicalTo: beforeModel]