Class {	#name : 'SpWin32ToggleSwitchTest',	#superclass : 'TestCase',	#category : 'Spec-Win32-Tests-Controls',	#package : 'Spec-Win32-Tests',	#tag : 'Controls'}{ #category : 'tests' }SpWin32ToggleSwitchTest >> testBindingsResolveToggleButtonAndSwitch [	| bindings |	bindings := SpWin32AdapterBindings new.	self assert: (bindings adapterClass: #ToggleButtonAdapter) equals: SpWin32ToggleButtonAdapter.	self assert: (bindings adapterClass: #SwitchAdapter) equals: SpWin32SwitchAdapter]{ #category : 'tests' }SpWin32ToggleSwitchTest >> testToggleButtonUsesDedicatedNativeKindAndTracksState [	| presenter adapter |	presenter := SpToggleButtonPresenter new label: 'Toggle'; state: true; yourself.	adapter := SpWin32ToggleButtonAdapter adapt: presenter.	self assert: adapter widget kind equals: SpWin32Runtime controlToggleButton.	self assert: adapter widget checked.	presenter state: false.	self deny: adapter widget checked.	adapter win32Toggled: true.	self assert: presenter state]{ #category : 'tests' }SpWin32ToggleSwitchTest >> testAssociatedToggleButtonActivationDeactivatesPeer [	| first second firstAdapter secondAdapter |	first := SpToggleButtonPresenter new label: 'One'; yourself.	second := SpToggleButtonPresenter new label: 'Two'; yourself.	first associatedToggleButtons: { second }.	firstAdapter := SpWin32ToggleButtonAdapter adapt: first.	secondAdapter := SpWin32ToggleButtonAdapter adapt: second.	firstAdapter win32Toggled: true.	self assert: first state.	self deny: second state.	secondAdapter win32Toggled: true.	self deny: first state.	self assert: second state.	self deny: firstAdapter widget checked.	self assert: secondAdapter widget checked]{ #category : 'tests' }SpWin32ToggleSwitchTest >> testAssociatedToggleButtonCanLeaveGroupWithNoActiveButton [	| first second adapter |	first := SpToggleButtonPresenter new label: 'One'; yourself.	second := SpToggleButtonPresenter new label: 'Two'; yourself.	first associatedToggleButtons: { second }.	adapter := SpWin32ToggleButtonAdapter adapt: first.	adapter win32Toggled: true.	adapter win32Toggled: false.	self deny: first state.	self deny: second state]{ #category : 'tests' }SpWin32ToggleSwitchTest >> testSwitchUsesDedicatedNativeKindAndTracksState [	| presenter adapter |	presenter := SpSwitchPresenter new state: true; yourself.	adapter := SpWin32SwitchAdapter adapt: presenter.	self assert: adapter widget kind equals: SpWin32Runtime controlSwitch.	self assert: adapter widget preferredExtent equals: 46 @ 24.	self assert: adapter widget checked.	presenter state: false.	self deny: adapter widget checked.	adapter win32Toggled: true.	self assert: presenter state]{ #category : 'tests' }SpWin32ToggleSwitchTest >> testNativeToggleEventDecodesForSwitch [	| runtime control presenter adapter |	runtime := SpWin32Runtime new.	presenter := SpSwitchPresenter new.	adapter := SpWin32SwitchAdapter adapt: presenter.	control := adapter widget.	control		nativeEventType: SpWin32Runtime eventToggled		argument1: 1		argument2: 0.	self assert: presenter state.	self assert: control checked]{ #category : 'tests' }SpWin32ToggleSwitchTest >> testRuntimeExposesNewControlKindsAndAbi [	self assert: SpWin32Runtime abiVersion equals: 16r00290000.	self assert: SpWin32Runtime controlToggleButton equals: 14.	self assert: SpWin32Runtime controlSwitch equals: 15]