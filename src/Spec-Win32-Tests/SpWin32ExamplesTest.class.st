Class {	#name : 'SpWin32ExamplesTest',	#superclass : 'TestCase',	#category : 'Spec-Win32-Tests-Examples',	#package : 'Spec-Win32-Tests',	#tag : 'Examples'}{ #category : 'tests' }SpWin32ExamplesTest >> testAllExampleBuildersBuildWithWin32Backend [	| selectors |	selectors := #(		allFeaturesOn:		basicControlsOn:		toggleAndSwitchOn:		spinnerAndLinkOn:		numberAndSearchOn:		imageOn:		athensOn:		buttonIconsOn:		toolbarOn:		menuOn:		menuButtonOn:		boxLayoutOn:		gridLayoutOn:		textInputOn:		textOn:		backendServicesOn:		focusAndSelectionOn:		listOn:		tableOn:		treeOn:		treeTableOn:		dropListOn:		sliderAndProgressOn:		notebookOn:		dynamicUpdatesOn:		millerColumnOn:		modernListViewOn:		modernColumnViewOn:		modernTreeListViewOn:		modernTreeColumnViewOn:		componentListOn: ).	selectors do: [ :selector |		| application root widget |		application := SpWin32Examples application.		root := SpWin32Examples perform: selector with: application.		widget := root build.		self assert: widget notNil ]]{ #category : 'tests' }SpWin32ExamplesTest >> testExecutableExampleEntryPointsArePresent [	#(		openCatalog		openAllFeatures		openBasicControls		openToggleAndSwitch		openSpinnerAndLink		openNumberAndSearch		openImage		openAthens		openButtonIcons		openToolbar		openMenusAndToolbarMenu		openMenuButton		openStatusBar		openBoxLayout		openGridLayout		openTextInput		openText		openBackendServices		openFocusAndSelection		openList		openTable		openTree		openTreeTable		openDropList		openSliderAndProgress		openNotebook		openDynamicUpdates		openWindowLifecycle		openMillerLayout		openModernListView		openModernColumnView		openModernTreeListView		openModernTreeColumnView		openComponentList ) do: [ :selector |		self assert: (SpWin32Examples class includesSelector: selector) ]]{ #category : 'tests' }SpWin32ExamplesTest >> testExampleMethodsCarryExamplePragma [	#(		openCatalog		openAllFeatures		openBasicControls		openToggleAndSwitch		openSpinnerAndLink		openNumberAndSearch		openImage		openAthens		openButtonIcons		openToolbar		openMenusAndToolbarMenu		openMenuButton		openStatusBar		openBoxLayout		openGridLayout		openTextInput		openText		openBackendServices		openFocusAndSelection		openList		openTable		openTree		openTreeTable		openDropList		openSliderAndProgress		openNotebook		openDynamicUpdates		openWindowLifecycle		openMillerLayout		openModernListView		openModernColumnView		openModernTreeListView		openModernTreeColumnView		openComponentList ) do: [ :selector |		| method |		method := SpWin32Examples class >> selector.		self assert: (method pragmas anySatisfy: [ :pragma | pragma selector = #example ]) ]]