Class {	#name : 'SpWin32AlexandrieTestPresenter',	#superclass : 'SpAbstractWidgetPresenter',	#instVars : [		'drawBlock',		'surfaceExtent',		'drawBlockChangedActions',		'extentChangedActions'	],	#category : 'Spec-Win32-Tests-Support',	#package : 'Spec-Win32-Tests',	#tag : 'Support'}{ #category : 'specs' }SpWin32AlexandrieTestPresenter class >> adapterName [	^ #AlexandrieAdapter]{ #category : 'initialization' }SpWin32AlexandrieTestPresenter >> initialize [	super initialize.	surfaceExtent := 300 @ 300.	drawBlockChangedActions := OrderedCollection new.	extentChangedActions := OrderedCollection new]{ #category : 'accessing' }SpWin32AlexandrieTestPresenter >> drawBlock [	^ drawBlock]{ #category : 'accessing' }SpWin32AlexandrieTestPresenter >> drawBlock: aBlock [	drawBlock := aBlock.	drawBlockChangedActions do: [ :action | action cull: aBlock ]]{ #category : 'accessing' }SpWin32AlexandrieTestPresenter >> surfaceExtent [	^ surfaceExtent]{ #category : 'accessing' }SpWin32AlexandrieTestPresenter >> surfaceExtent: anExtent [	surfaceExtent := anExtent.	extentChangedActions do: [ :action | action cull: anExtent ]]{ #category : 'events' }SpWin32AlexandrieTestPresenter >> whenDrawBlockChangedDo: aBlock [	drawBlockChangedActions add: aBlock]{ #category : 'events' }SpWin32AlexandrieTestPresenter >> whenExtentChangedDo: aBlock [	extentChangedActions add: aBlock]{ #category : 'api' }SpWin32AlexandrieTestPresenter >> redraw [	self withAdapterDo: [ :anAdapter | anAdapter redraw ]]