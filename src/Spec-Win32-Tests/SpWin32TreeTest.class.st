Class {	#name : 'SpWin32TreeTest',	#superclass : 'TestCase',	#category : 'Spec-Win32-Tests-Controls',	#package : 'Spec-Win32-Tests',	#tag : 'Controls'}{ #category : 'private' }SpWin32TreeTest >> newApplication [ ^ SpApplication new useBackend: #Win32 ]{ #category : 'private' }SpWin32TreeTest >> newPresenter [	| presenter |	presenter := SpTreePresenter newApplication: self newApplication.	presenter		roots: #( A B );		children: [ :each | each = #A ifTrue: [ #( A1 A2 ) ] ifFalse: [ each = #A1 ifTrue: [ #( A11 ) ] ifFalse: [ #() ] ] ];		display: [ :each | each asString ].	^ presenter]{ #category : 'tests' }SpWin32TreeTest >> testBindingResolvesTreeAdapter [	self assert: (SpWin32AdapterBindings new adapterClass: #TreeAdapter) equals: SpWin32TreeAdapter]{ #category : 'tests' }SpWin32TreeTest >> testDeferredTreeFlattensPreorderWithParentTokens [	| adapter |	adapter := SpWin32TreeAdapter adapt: self newPresenter.	self assert: adapter widget treeLabels equals: #( 'A' 'A1' 'A11' 'A2' 'B' ).	self assert: adapter widget parentTokens equals: #( 0 1 2 1 0 )]{ #category : 'tests' }SpWin32TreeTest >> testNativeSelectionTokenUpdatesPresenterPath [	| presenter adapter |	presenter := self newPresenter.	adapter := SpWin32TreeAdapter adapt: presenter.	adapter win32TreeSelectionChangedToken: 4.	self assert: presenter selection selectedPath equals: #( 1 2 ).	self assert: presenter selectedItem equals: #A2]{ #category : 'tests' }SpWin32TreeTest >> testPresenterSelectionUpdatesDeferredNativeToken [	| presenter adapter |	presenter := self newPresenter.	adapter := SpWin32TreeAdapter adapt: presenter.	presenter selectPath: #( 1 1 1 ).	self assert: adapter widget selectedToken equals: 3]{ #category : 'tests' }SpWin32TreeTest >> testExpandCollapseAndIsExpanded [	| adapter |	adapter := SpWin32TreeAdapter adapt: self newPresenter.	adapter expandPath: #( 1 1 ).	self assert: (adapter isExpanded: #( 1 1 )).	adapter collapsePath: #( 1 1 ).	self deny: (adapter isExpanded: #( 1 1 ))]{ #category : 'tests' }SpWin32TreeTest >> testExpandRoots [	| adapter |	adapter := SpWin32TreeAdapter adapt: self newPresenter.	adapter expandRoots.	self assert: (adapter isExpanded: #( 1 )).	self assert: (adapter isExpanded: #( 2 ))]{ #category : 'tests' }SpWin32TreeTest >> testExpandAllAndCollapseAll [	| adapter |	adapter := SpWin32TreeAdapter adapt: self newPresenter.	adapter expandAll.	self assert: (adapter isExpanded: #( 1 1 )).	adapter collapseAll.	self deny: (adapter isExpanded: #( 1 )).	self deny: (adapter isExpanded: #( 1 1 ))]{ #category : 'tests' }SpWin32TreeTest >> testRootsChangeRebuildsTree [	| presenter adapter |	presenter := self newPresenter.	adapter := SpWin32TreeAdapter adapt: presenter.	presenter roots: #( X ).	self assert: adapter widget treeLabels equals: #( 'X' ).	self assert: adapter widget parentTokens equals: #( 0 )]{ #category : 'tests' }SpWin32TreeTest >> testNativeExpansionEventUpdatesExpandedState [	| adapter |	adapter := SpWin32TreeAdapter adapt: self newPresenter.	adapter win32TreeExpansionChangedToken: 2 expanded: true.	self assert: (adapter isExpanded: #( 1 1 )).	adapter win32TreeExpansionChangedToken: 2 expanded: false.	self deny: (adapter isExpanded: #( 1 1 ))]{ #category : 'tests' }SpWin32TreeTest >> testDoubleClickActivationUsesTreePath [	| presenter adapter activated |	presenter := self newPresenter.	activated := nil.	presenter whenActivatedDo: [ :selection | activated := selection selectedItem ].	adapter := SpWin32TreeAdapter adapt: presenter.	adapter win32ActivatedAt: 4 source: 1.	self assert: activated equals: #A2]{ #category : 'tests' }SpWin32TreeTest >> testSingleClickActivation [	| presenter adapter activated |	presenter := self newPresenter.	presenter activateOnSingleClick.	activated := nil.	presenter whenActivatedDo: [ :selection | activated := selection selectedItem ].	adapter := SpWin32TreeAdapter adapt: presenter.	adapter win32TreeSelectionChangedToken: 5.	self assert: activated equals: #B]{ #category : 'tests' }SpWin32TreeTest >> testItemAtPathResolvesTreeItem [	| adapter |	adapter := SpWin32TreeAdapter adapt: self newPresenter.	self assert: (adapter itemAtPath: #( 1 1 1 )) equals: #A11]