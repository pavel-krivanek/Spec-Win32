Class {	#name : 'SpWin32AlexandrieAdapter',	#superclass : 'SpWin32AbstractAdapter',	#instVars : [		'surface',		'surfaceExtent'	],	#category : 'Spec-Win32-Adapters-Controls',	#package : 'Spec-Win32-Adapters',	#tag : 'Controls'}{ #category : 'factory' }SpWin32AlexandrieAdapter >> buildWidget [	| extent control |	extent := self normalizedDrawingExtent: self presenter surfaceExtent.	control := SpWin32AlexandrieSurfaceControl		runtime: SpWin32Runtime default		preferredExtent: extent		extentChangedAction: [ :newExtent | self redrawAtExtent: newExtent on: control ].	control eventHandler: self.	self presenter whenDrawBlockChangedDo: [ :newBlock | self redraw ].	self presenter whenExtentChangedDo: [ :newExtent | self updateSurfaceExtent: newExtent ].	^ control]{ #category : 'private - drawing' }SpWin32AlexandrieAdapter >> alexandrieSurfaceClass [	^ Smalltalk globals		at: #AeCairoImageSurface		ifAbsent: [ self error: 'Alexandrie is not loaded (AeCairoImageSurface is missing)' ]]{ #category : 'drawing' }SpWin32AlexandrieAdapter >> redraw [	self widgetDo: [ :control |		self			redrawAtExtent: (self drawingExtentFor: control)			on: control ]]{ #category : 'private - drawing' }SpWin32AlexandrieAdapter >> redrawAtExtent: anExtent on: control [	| extent block |	extent := self normalizedDrawingExtent: anExtent.	self ensureSurfaceExtent: extent.	block := self presenter drawBlock.	block ifNotNil: [		self withSurfaceContextDo: [ :context |			block				cull: context				cull: (0 @ 0 extent: extent) ] ].	control imageData: self imageDataFromSurface]{ #category : 'private - drawing' }SpWin32AlexandrieAdapter >> withSurfaceContextDo: aBlock [	(surface respondsTo: #newContextDo:) ifTrue: [		^ surface newContextDo: aBlock ].	^ aBlock value: surface newContext]{ #category : 'private - drawing' }SpWin32AlexandrieAdapter >> imageDataFromSurface [	surface flush.	^ SpWin32ImageData		fromPremultipliedBGRAPointer: surface data		width: surface width		height: surface height		stride: surface stride]{ #category : 'private - drawing' }SpWin32AlexandrieAdapter >> drawingExtentFor: control [	control isValid ifTrue: [ ^ self normalizedDrawingExtent: control bounds extent ].	^ self normalizedDrawingExtent: control preferredExtent]{ #category : 'private - drawing' }SpWin32AlexandrieAdapter >> ensureSurfaceExtent: anExtent [	(surface isNil or: [ surfaceExtent ~= anExtent ]) ifTrue: [		surfaceExtent := anExtent.		surface := self alexandrieSurfaceClass extent: surfaceExtent ]]{ #category : 'private - drawing' }SpWin32AlexandrieAdapter >> normalizedDrawingExtent: anExtent [	| extent |	extent := anExtent ifNil: [ 1 @ 1 ].	^ (extent x asInteger max: 1) @ (extent y asInteger max: 1)]{ #category : 'accessing' }SpWin32AlexandrieAdapter >> surface [	^ surface]{ #category : 'private - updating' }SpWin32AlexandrieAdapter >> updateSurfaceExtent: anExtent [	| normalized |	normalized := self normalizedDrawingExtent: anExtent.	self widgetDo: [ :control |		control preferredExtent: normalized.		control requestRelayout.		self redraw ]]{ #category : 'native events' }SpWin32AlexandrieAdapter >> win32Clicked [	"The shared native Image surface emits a convenience click event for	SpImagePresenter. Alexandrie uses Spec generic mouse events instead."]