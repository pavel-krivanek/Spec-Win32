Class {	#name : 'SpWin32CheckBoxAdapter',	#superclass : 'SpWin32AbstractAdapter',	#category : 'Spec-Win32-Adapters-Controls',	#package : 'Spec-Win32-Adapters',	#tag : 'Controls'}{ #category : 'factory' }SpWin32CheckBoxAdapter >> buildWidget [	| text control |	text := self getLabelText.	control := SpWin32NativeControl		runtime: SpWin32Runtime default		kind: SpWin32Runtime controlCheckBox		text: text		preferredExtent: (((text size * 7) + 28) max: 24) @ 22.	control		eventHandler: self;		checked: self presenter state.	self presenter whenLabelChangedDo: [ self updateLabel ].	self presenter whenChangedDo: [ self updateState ].	^ control]{ #category : 'emulating' }SpWin32CheckBoxAdapter >> clicked [	self presenter toggleState]{ #category : 'private' }SpWin32CheckBoxAdapter >> getLabelText [	^ self presenter label		ifNil: [ '' ]		ifNotNil: [ :aString | aString localizedForPresenter: self presenter ]]{ #category : 'accessing' }SpWin32CheckBoxAdapter >> helpText [	^ self presenter help]{ #category : 'accessing' }SpWin32CheckBoxAdapter >> label [	^ self getLabelText]{ #category : 'accessing' }SpWin32CheckBoxAdapter >> labelClickable [	^ self presenter labelClickable]{ #category : 'spec protocol' }SpWin32CheckBoxAdapter >> labelOnLeft [	"Native left-side labels require a style change/recreation. Keep the normal	right-side Win32 checkbox layout until that styling slice is implemented."]{ #category : 'spec protocol' }SpWin32CheckBoxAdapter >> labelOnRight []{ #category : 'accessing' }SpWin32CheckBoxAdapter >> state [	^ self presenter state]{ #category : 'accessing' }SpWin32CheckBoxAdapter >> state: aBoolean [	^ self presenter state: aBoolean]{ #category : 'private - updating' }SpWin32CheckBoxAdapter >> updateLabel [	| text |	text := self getLabelText.	self widget text: text.	self widget isValid ifFalse: [		self widget preferredExtent: (((text size * 7) + 28) max: 24) @ 22 ]]{ #category : 'private - updating' }SpWin32CheckBoxAdapter >> updateState [	self widget checked: self presenter state]{ #category : 'native events' }SpWin32CheckBoxAdapter >> win32Toggled: aBoolean [	self presenter state: aBoolean]