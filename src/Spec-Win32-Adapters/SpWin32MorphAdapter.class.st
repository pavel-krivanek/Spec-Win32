Class {	#name : 'SpWin32MorphAdapter',	#superclass : 'SpWin32AbstractAdapter',	#instVars : [		'hostWorld',		'hand',		'hostedMorph',		'morphicButtons',		'steppingProcess',		'internalUpdate'	],	#category : 'Spec-Win32-Adapters-Morphic',	#package : 'Spec-Win32-Adapters',	#tag : 'Morphic'}{ #category : 'initialization' }SpWin32MorphAdapter >> initialize [	super initialize.	morphicButtons := 0.	internalUpdate := false]{ #category : 'factory' }SpWin32MorphAdapter >> buildWidget [	| control extent |	extent := self preferredExtentForMorph: self presenter morph.	self initializeHostWorldAt: extent.	control := SpWin32MorphSurfaceControl		runtime: SpWin32Runtime default		preferredExtent: extent		extentChangedAction: [ :newExtent | self surfaceExtentChanged: newExtent on: control ].	control eventHandler: self.	self installMorph: self presenter morph in: control.	self presenter whenMorphChangedDo: [ :aMorph | self updateMorph: aMorph ].	^ control]{ #category : 'private - host' }SpWin32MorphAdapter >> initializeHostWorldAt: anExtent [	hostWorld := SpWin32MorphWorld new.	hostWorld extent: (self normalizedExtent: anExtent).	hostWorld damageAction: [ :damage | self morphDamaged: damage ].	hand := HandMorph new.	hostWorld addHand: hand.	hostWorld activeHand: hand]{ #category : 'private - host' }SpWin32MorphAdapter >> installMorph: aMorph in: control [	| morph |	morph := aMorph ifNil: [ Morph new color: Color transparent ].	self detachHostedMorph.	hostedMorph := morph.	(hostedMorph respondsTo: #presenter:) ifTrue: [ hostedMorph presenter: self presenter ].	internalUpdate := true.	[		hostWorld addMorph: hostedMorph.		hostedMorph position: 0 @ 0.		self resizeHostedMorphTo: hostWorld extent	] ensure: [ internalUpdate := false ].	control preferredExtent: (self preferredExtentForMorph: hostedMorph).	self redrawOn: control extent: hostWorld extent]{ #category : 'private - host' }SpWin32MorphAdapter >> detachHostedMorph [	hostedMorph ifNil: [ ^ self ].	hostedMorph owner == hostWorld ifTrue: [ hostWorld removeMorph: hostedMorph ].	hostedMorph := nil.	hand ifNotNil: [		hand mouseFocus: nil.		hand keyboardFocus: nil ]]{ #category : 'private - sizing' }SpWin32MorphAdapter >> preferredExtentForMorph: aMorph [	aMorph ifNil: [ ^ 64 @ 64 ].	^ self normalizedExtent: aMorph extent]{ #category : 'private - sizing' }SpWin32MorphAdapter >> normalizedExtent: anExtent [	| extent |	extent := anExtent ifNil: [ 1 @ 1 ].	^ (extent x asInteger max: 1) @ (extent y asInteger max: 1)]{ #category : 'private - sizing' }SpWin32MorphAdapter >> morphIsResizable [	hostedMorph ifNil: [ ^ false ].	^ ((hostedMorph vResizing = #rigid) and: [ hostedMorph hResizing = #rigid ]) not]{ #category : 'private - sizing' }SpWin32MorphAdapter >> resizeHostedMorphTo: anExtent [	self morphIsResizable ifFalse: [ ^ self ].	hostedMorph extent: (self normalizedExtent: anExtent)]{ #category : 'private - sizing' }SpWin32MorphAdapter >> surfaceExtentChanged: anExtent on: control [	| extent |	extent := self normalizedExtent: anExtent.	internalUpdate := true.	[		hostWorld extent: extent.		self resizeHostedMorphTo: extent	] ensure: [ internalUpdate := false ].	self redrawOn: control extent: extent.	self ensureSteppingLoop]{ #category : 'drawing' }SpWin32MorphAdapter >> redraw [	self widgetDo: [ :control |		self redrawOn: control extent: (self drawingExtentFor: control) ]]{ #category : 'private - drawing' }SpWin32MorphAdapter >> drawingExtentFor: control [	control isValid ifTrue: [ ^ self normalizedExtent: control bounds extent ].	^ self normalizedExtent: control preferredExtent]{ #category : 'private - drawing' }SpWin32MorphAdapter >> redrawOn: control extent: anExtent [	| extent canvas |	extent := self normalizedExtent: anExtent.	internalUpdate := true.	[		hostWorld extent = extent ifFalse: [ hostWorld extent: extent ].		self resizeHostedMorphTo: extent.		canvas := FormCanvas extent: extent depth: 32.		canvas fillRectangle: (0 @ 0 extent: extent) color: Color transparent.		hostWorld fullDrawOn: canvas.		control imageData: (SpWin32ImageData fromForm: canvas form)	] ensure: [ internalUpdate := false ]]{ #category : 'private - drawing' }SpWin32MorphAdapter >> morphDamaged: aRectangle [	internalUpdate ifTrue: [ ^ self ].	self redraw]{ #category : 'updating' }SpWin32MorphAdapter >> updateMorph: aMorph [	self widgetDo: [ :control |		self installMorph: aMorph in: control.		control requestRelayout ]]{ #category : 'accessing' }SpWin32MorphAdapter >> hostedMorph [	^ hostedMorph]{ #category : 'accessing' }SpWin32MorphAdapter >> hostWorld [	^ hostWorld]{ #category : 'accessing' }SpWin32MorphAdapter >> hand [	^ hand]{ #category : 'private - stepping' }SpWin32MorphAdapter >> ensureSteppingLoop [	(steppingProcess isNil or: [ steppingProcess isTerminated ]) ifTrue: [		self startSteppingLoop ]]{ #category : 'private - stepping' }SpWin32MorphAdapter >> startSteppingLoop [	self stopSteppingLoop.	steppingProcess := [		[ self steppingLoopShouldContinue ] whileTrue: [			(Delay forMilliseconds: 16) wait.			hostWorld ifNotNil: [ hostWorld runStepMethods ] ]	] forkAt: Processor userBackgroundPriority named: 'Spec Win32 Morph host stepping']{ #category : 'private - stepping' }SpWin32MorphAdapter >> steppingLoopShouldContinue [	^ self widget notNil and: [ self widget isDestroyed not ]]{ #category : 'private - stepping' }SpWin32MorphAdapter >> stopSteppingLoop [	steppingProcess ifNotNil: [ :process |		process == Processor activeProcess ifFalse: [			process isTerminated ifFalse: [ process terminate ] ] ].	steppingProcess := nil]{ #category : 'releasing' }SpWin32MorphAdapter >> unsubscribe [	self stopSteppingLoop.	super unsubscribe]{ #category : 'private - events' }SpWin32MorphAdapter >> morphicButtonMaskFor: buttonCode [	buttonCode = 1 ifTrue: [ ^ 4 ].	buttonCode = 2 ifTrue: [ ^ 1 ].	buttonCode = 3 ifTrue: [ ^ 2 ].	^ 0]{ #category : 'private - events' }SpWin32MorphAdapter >> morphicModifierMaskFor: modifiers [	| result |	result := 0.	(modifiers bitAnd: 1) ~= 0 ifTrue: [ result := result bitOr: 8 ].	(modifiers bitAnd: 2) ~= 0 ifTrue: [ result := result bitOr: 16 ].	(modifiers bitAnd: 4) ~= 0 ifTrue: [ result := result bitOr: 32 ].	(modifiers bitAnd: 8) ~= 0 ifTrue: [ result := result bitOr: 64 ].	^ result]{ #category : 'private - events' }SpWin32MorphAdapter >> morphicPositionFor: aPoint [	hostedMorph ifNil: [ ^ aPoint ].	^ aPoint + hostedMorph position]{ #category : 'private - events' }SpWin32MorphAdapter >> dispatchMouseButtonType: aSymbol position: aPoint button: buttonCode modifiers: modifiers down: isDown [	| changedButton modifierMask event |	changedButton := self morphicButtonMaskFor: buttonCode.	isDown		ifTrue: [ morphicButtons := morphicButtons bitOr: changedButton ]		ifFalse: [ morphicButtons := morphicButtons bitAnd: changedButton bitInvert ].	modifierMask := self morphicModifierMaskFor: modifiers.	event := MouseButtonEvent new		setType: aSymbol		position: (self morphicPositionFor: aPoint)		which: changedButton		buttons: (morphicButtons bitOr: modifierMask)		hand: hand		stamp: Time millisecondClockValue.	hand handleEvent: event]{ #category : 'private - events' }SpWin32MorphAdapter >> dispatchMouseMoveType: aSymbol position: aPoint modifiers: modifiers [	| event |	event := MouseMoveEvent new		setType: aSymbol		position: (self morphicPositionFor: aPoint)		buttons: (morphicButtons bitOr: (self morphicModifierMaskFor: modifiers))		hand: hand.	hand handleEvent: event]{ #category : 'private - events' }SpWin32MorphAdapter >> dispatchKeyboardType: aSymbol keyValue: keyValue modifiers: modifiers [	| nativeEvent character event buttons |	nativeEvent := SpWin32KeyEvent keyValue: keyValue modifiers: modifiers.	character := [ nativeEvent keyCharacter ] on: Error do: [ Character null ].	buttons := self morphicModifierMaskFor: modifiers.	event := KeyboardEvent new		setType: aSymbol		buttons: buttons		position: hand position		keyValue: keyValue		charCode: character codePoint		hand: hand		stamp: Time millisecondClockValue.	hand handleEvent: event]{ #category : 'native events' }SpWin32MorphAdapter >> win32MouseEventType: eventType position: position button: button modifiers: modifiers [	super win32MouseEventType: eventType position: position button: button modifiers: modifiers.	self presenter isEnabled ifFalse: [ ^ self ].	eventType = SpWin32Runtime eventMouseDown ifTrue: [		self widget takeKeyboardFocus.		self dispatchMouseButtonType: #mouseDown position: position button: button modifiers: modifiers down: true.		^ self ].	eventType = SpWin32Runtime eventMouseUp ifTrue: [		self dispatchMouseButtonType: #mouseUp position: position button: button modifiers: modifiers down: false.		^ self ].	eventType = SpWin32Runtime eventMouseMove ifTrue: [		self dispatchMouseMoveType: #mouseMove position: position modifiers: modifiers.		^ self ].	eventType = SpWin32Runtime eventMouseEnter ifTrue: [		self dispatchMouseMoveType: #mouseEnter position: position modifiers: modifiers.		^ self ].	eventType = SpWin32Runtime eventMouseLeave ifTrue: [		self dispatchMouseMoveType: #mouseLeave position: position modifiers: modifiers ]]{ #category : 'native events' }SpWin32MorphAdapter >> win32KeyDownValue: keyValue modifiers: modifiers [	super win32KeyDownValue: keyValue modifiers: modifiers.	self presenter isEnabled ifFalse: [ ^ self ].	self dispatchKeyboardType: #keyDown keyValue: keyValue modifiers: modifiers.	self dispatchKeyboardType: #keystroke keyValue: keyValue modifiers: modifiers]{ #category : 'native events' }SpWin32MorphAdapter >> win32KeyUpValue: keyValue modifiers: modifiers [	super win32KeyUpValue: keyValue modifiers: modifiers.	self presenter isEnabled ifFalse: [ ^ self ].	self dispatchKeyboardType: #keyUp keyValue: keyValue modifiers: modifiers]{ #category : 'native events' }SpWin32MorphAdapter >> win32FocusLost [	super win32FocusLost.	hand ifNotNil: [ hand newKeyboardFocus: nil ]]{ #category : 'native events' }SpWin32MorphAdapter >> win32Clicked [	"The native Image control emits a convenience click event in addition to the	generic mouse stream. Morphic interaction is driven only by the latter."]