Class {	#name : 'SpWin32TreeListViewAdapter',	#superclass : 'SpWin32AbstractModernListAdapter',	#instVars : [		'paths',		'pathToToken',		'parentTokens',		'expandedPaths'	],	#category : 'Spec-Win32-Adapters-ListView',	#package : 'Spec-Win32-Adapters',	#tag : 'ListView'}{ #category : 'initialization' }SpWin32TreeListViewAdapter >> initialize [	super initialize.	paths := #().	pathToToken := Dictionary new.	parentTokens := #().	expandedPaths := Set new]{ #category : 'factory' }SpWin32TreeListViewAdapter >> buildWidget [	| control |	self rebuildTreeSnapshots.	control := SpWin32NativeTreeControl		runtime: SpWin32Runtime default		kind: SpWin32Runtime controlTree		text: ''		preferredExtent: 260 @ 180.	control eventHandler: self.	self configureTreeOn: control.	self presenter whenRootsChangedDo: [ self rootsChanged ].	self presenter whenSelectionChangedDo: [ self refreshSelection ].	self presenter whenMultiSelectionChangedDo: [ self refreshSelection ].	self presenter verticalAlignment whenChangedDo: [ self scrollToSelection ].	^ control]{ #category : 'private - tree' }SpWin32TreeListViewAdapter >> rebuildTreeSnapshots [	| presenters strings images newPaths map parents |	presenters := OrderedCollection new.	strings := OrderedCollection new.	images := OrderedCollection new.	newPaths := OrderedCollection new.	map := Dictionary new.	parents := OrderedCollection new.	self presenter traverseTreeDo: [ :item :path |		| token parentPath row |		token := newPaths size + 1.		newPaths add: path asArray.		map at: path asArray put: token.		parentPath := path size > 1 ifTrue: [ path allButLast asArray ] ifFalse: [ #() ].		parents add: (parentPath isEmpty ifTrue: [ 0 ] ifFalse: [ map at: parentPath ifAbsent: [ 0 ] ]).		row := self newRowPresenterFor: item.		presenters add: row.		strings add: (self displayStringForRowPresenter: row item: item).		images add: (self imageDataForRowPresenter: row) ].	paths := newPaths asArray.	pathToToken := map.	parentTokens := parents asArray.	rowPresenters := presenters asArray.	displayStrings := strings asArray.	rowImages := images asArray]{ #category : 'private - tree' }SpWin32TreeListViewAdapter >> configureTreeOn: control [	control labels: displayStrings parentTokens: parentTokens images: rowImages.	expandedPaths do: [ :path |		(self tokenForPath: path) ifNotNil: [ :token | control token: token expanded: true ] ].	self refreshSelectionOn: control]{ #category : 'private - tree' }SpWin32TreeListViewAdapter >> tokenForPath: aPath [	^ pathToToken at: aPath asArray ifAbsent: [ nil ]]{ #category : 'private - tree' }SpWin32TreeListViewAdapter >> pathForToken: token [	(token between: 1 and: paths size) ifFalse: [ ^ nil ].	^ paths at: token]{ #category : 'accessing' }SpWin32TreeListViewAdapter >> itemAtPath: aPath [	^ self presenter		itemAt: aPath first		of: self presenter roots		then: aPath allButFirst]{ #category : 'accessing' }SpWin32TreeListViewAdapter >> elementAt: token [	| path |	path := self pathForToken: token.	^ path ifNil: [ nil ] ifNotNil: [ self itemAtPath: path ]]{ #category : 'refreshing' }SpWin32TreeListViewAdapter >> refreshTree [	self rebuildTreeSnapshots.	self configureTreeOn: self widget]{ #category : 'refreshing' }SpWin32TreeListViewAdapter >> refreshList [ self refreshTree ]{ #category : 'refreshing' }SpWin32TreeListViewAdapter >> refreshWidgetList [ self refreshTree ]{ #category : 'refreshing' }SpWin32TreeListViewAdapter >> rootsChanged [	expandedPaths removeAll.	self refreshTree]{ #category : 'selection' }SpWin32TreeListViewAdapter >> refreshSelection [ self refreshSelectionOn: self widget ]{ #category : 'selection' }SpWin32TreeListViewAdapter >> refreshSelectionOn: control [	| path token |	control ifNil: [ ^ self ].	path := self presenter selection selectedPath.	token := (path isNil or: [ path isEmpty ])		ifTrue: [ 0 ]		ifFalse: [ self tokenForPath: path ].	control selectedToken: (token ifNil: [ 0 ])]{ #category : 'accessing' }SpWin32TreeListViewAdapter >> selectedIndexes [	| path |	path := self presenter selection selectedPath.	^ (path isNil or: [ path isEmpty ]) ifTrue: [ #() ] ifFalse: [ { path } ]]{ #category : 'api - selection' }SpWin32TreeListViewAdapter >> selectedRowPresenter [	"Rows are snapshots rendered by SysTreeView32, not realized presenter HWNDs."	^ nil]{ #category : 'api' }SpWin32TreeListViewAdapter >> expandPath: aPath [	(self tokenForPath: aPath) ifNotNil: [ :token |		self widget token: token expanded: true.		expandedPaths add: aPath asArray ]]{ #category : 'api' }SpWin32TreeListViewAdapter >> collapsePath: aPath [	(self tokenForPath: aPath) ifNotNil: [ :token |		self widget token: token expanded: false.		expandedPaths remove: aPath asArray ifAbsent: [ ] ]]{ #category : 'api' }SpWin32TreeListViewAdapter >> expandRoots [	1 to: self presenter roots size do: [ :index | self expandPath: { index } ]]{ #category : 'api' }SpWin32TreeListViewAdapter >> expandAll [ paths do: [ :path | self expandPath: path ] ]{ #category : 'api' }SpWin32TreeListViewAdapter >> collapseAll [ paths reversed do: [ :path | self collapsePath: path ] ]{ #category : 'testing' }SpWin32TreeListViewAdapter >> isExpanded: aPath [ ^ expandedPaths includes: aPath asArray ]{ #category : 'scrolling' }SpWin32TreeListViewAdapter >> scrollToSelection [	| path token |	path := self presenter selection selectedPath.	(path isNil or: [ path isEmpty ]) ifTrue: [ ^ self ].	token := self tokenForPath: path.	token ifNotNil: [ self widget ensureVisibleToken: token ]]{ #category : 'native events' }SpWin32TreeListViewAdapter >> win32TreeSelectionChangedToken: token [	| path |	path := self pathForToken: token.	path ifNil: [ ^ self ].	self presenter selection selectedPath = path ifFalse: [ self presenter selectPath: path ].	self presenter isActiveOnSingleClick ifTrue: [ self presenter doActivateAtPath: path ]]{ #category : 'native events' }SpWin32TreeListViewAdapter >> win32TreeExpansionChangedToken: token expanded: expanded [	| path |	path := self pathForToken: token.	path ifNil: [ ^ self ].	expanded		ifTrue: [ expandedPaths add: path ]		ifFalse: [ expandedPaths remove: path ifAbsent: [ ] ].	(Smalltalk at: #SpTreeExpansionChanged ifAbsent: [ nil ]) ifNotNil: [ :announcementClass |		self presenter announce: (announcementClass new			item: (self itemAtPath: path);			expanded: expanded;			yourself) ]]{ #category : 'native events' }SpWin32TreeListViewAdapter >> win32ActivatedAt: token source: source [	| path |	path := self pathForToken: token.	path ifNil: [ ^ self ].	(source = 2 or: [ self presenter isActiveOnDoubleClick ]) ifTrue: [		self presenter doActivateAtPath: path ]]{ #category : 'protocol compatibility' }SpWin32TreeListViewAdapter >> alternateRowsColor [	"SysTreeView32 does not provide alternate-row styling on this native fast path."]{ #category : 'protocol compatibility' }SpWin32TreeListViewAdapter >> updateMenu [ self updateActions ]