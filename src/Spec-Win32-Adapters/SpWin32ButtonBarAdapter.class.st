Class {	#name : 'SpWin32ButtonBarAdapter',	#superclass : 'SpWin32AbstractAdapter',	#category : 'Spec-Win32-Adapters-Controls',	#package : 'Spec-Win32-Adapters',	#tag : 'Controls'}{ #category : 'factory' }SpWin32ButtonBarAdapter >> buildWidget [	| bar widgets |	bar := SpWin32ButtonBarContainer runtime: SpWin32Runtime default.	widgets := self presenter items collect: [ :each | each build ].	bar		widgets: widgets;		placeAtStart: self presenter isPlaceAtStart.	^ bar]