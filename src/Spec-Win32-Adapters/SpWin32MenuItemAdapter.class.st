Class {	#name : 'SpWin32MenuItemAdapter',	#superclass : 'SpWin32AbstractAdapter',	#category : 'Spec-Win32-Adapters-Menu',	#package : 'Spec-Win32-Adapters',	#tag : 'Menu'}{ #category : 'factory' }SpWin32MenuItemAdapter >> buildWidget [	| entry |	entry := (SpWin32MenuBuilder for: self presenter)		entryForMenuItemPresenter: self presenter.	self presenter whenNameChangedDo: [ self updateSnapshot ].	self presenter whenIconChangedDo: [ self updateSnapshot ].	^ entry]{ #category : 'private - updating' }SpWin32MenuItemAdapter >> updateSnapshot [	| updated |	updated := (SpWin32MenuBuilder for: self presenter)		entryForMenuItemPresenter: self presenter.	self widget		label: updated label;		iconData: updated iconData;		enabled: updated enabled;		checked: updated checked;		children: updated children;		action: updated action]{ #category : 'testing' }SpWin32MenuItemAdapter >> widgetName [ ^ self widget label ]{ #category : 'testing' }SpWin32MenuItemAdapter >> widgetIcon [ ^ self widget iconData ]