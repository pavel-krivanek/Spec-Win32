Class {	#name : 'SpWin32StatusBarAdapter',	#superclass : 'SpWin32AbstractAdapter',	#instVars : [		'pushedMessages'	],	#category : 'Spec-Win32-Adapters-Controls',	#package : 'Spec-Win32-Adapters',	#tag : 'Controls'}{ #category : 'initialization' }SpWin32StatusBarAdapter >> initialize [	super initialize.	pushedMessages := OrderedCollection new]{ #category : 'factory' }SpWin32StatusBarAdapter >> buildWidget [	| text control |	text := ''.	self presenter message ifNotNil: [ :message |		pushedMessages add: message.		text := self textForMessage: message ].	control := SpWin32NativeControl		runtime: SpWin32Runtime default		kind: SpWin32Runtime controlLabel		text: text		preferredExtent: 160 @ 24.	control eventHandler: self.	^ control]{ #category : 'private' }SpWin32StatusBarAdapter >> textForMessage: aMessage [	| text |	aMessage ifNil: [ ^ '' ].	text := aMessage.	(text respondsTo: #localizedForPresenter:) ifTrue: [		text := text localizedForPresenter: self presenter ].	^ text asString]{ #category : 'api' }SpWin32StatusBarAdapter >> pushMessage [	| message |	message := self presenter message.	message ifNil: [ ^ self ].	pushedMessages add: message.	self widgetDo: [ :w | w text: (self textForMessage: message) ]]{ #category : 'api' }SpWin32StatusBarAdapter >> popMessage [	| message |	pushedMessages ifNotEmpty: [ pushedMessages removeLast ].	message := pushedMessages ifEmpty: [ nil ] ifNotEmpty: [ pushedMessages last ].	self widgetDo: [ :w | w text: (self textForMessage: message) ]]{ #category : 'testing' }SpWin32StatusBarAdapter >> pushedMessageCount [	^ pushedMessages size]{ #category : 'updating' }SpWin32StatusBarAdapter >> update: aSymbol [	aSymbol = #pushMessage ifTrue: [ self pushMessage ].	aSymbol = #popMessage ifTrue: [ self popMessage ].	^ super update: aSymbol]