Class {	#name : 'SpWin32LabelAdapter',	#superclass : 'SpWin32AbstractAdapter',	#category : 'Spec-Win32-Adapters-Controls',	#package : 'Spec-Win32-Adapters',	#tag : 'Controls'}{ #category : 'accessing' }SpWin32LabelAdapter >> beJustifyCenter [ ]{ #category : 'accessing' }SpWin32LabelAdapter >> beJustifyLeft [ ]{ #category : 'accessing' }SpWin32LabelAdapter >> beJustifyRight [ ]{ #category : 'accessing' }SpWin32LabelAdapter >> beNotWrap [ ]{ #category : 'accessing' }SpWin32LabelAdapter >> beWrap [ ]{ #category : 'factory' }SpWin32LabelAdapter >> buildWidget [	| text control |	text := self getText.	control := SpWin32NativeControl		runtime: SpWin32Runtime default		kind: SpWin32Runtime controlLabel		text: text		preferredExtent: (((text size * 7) + 8) max: 20) @ 22.	control eventHandler: self.	self presenter whenLabelChangedDo: [ self updateLabel ].	^ control]{ #category : 'accessing' }SpWin32LabelAdapter >> getText [	^ (self presenter label ifNil: [ '' ]) localizedForPresenter: self presenter]{ #category : 'accessing' }SpWin32LabelAdapter >> isWrap [ ^ false ]{ #category : 'accessing' }SpWin32LabelAdapter >> label [ ^ self getText ]{ #category : 'private - updating' }SpWin32LabelAdapter >> updateLabel [	| text |	text := self getText.	self widget text: text.	self widget isValid ifFalse: [		self widget preferredExtent: ((((text size * 7) + 8) max: 20) @ 22) ]]{ #category : 'accessing' }SpWin32LabelAdapter >> useMarkup [ ]