Class {	#name : 'SpWin32MenuButtonAdapter',	#superclass : 'SpWin32ButtonAdapter',	#category : 'Spec-Win32-Adapters-Controls',	#package : 'Spec-Win32-Adapters',	#tag : 'Controls'}{ #category : 'emulating' }SpWin32MenuButtonAdapter >> clicked [	^ self showMenu]{ #category : 'private - menu' }SpWin32MenuButtonAdapter >> menuEntries [	| menu |	menu := self resolvedMenu.	menu ifNil: [ ^ #() ].	^ (SpWin32MenuBuilder for: self presenter) entriesForMenuPresenter: menu]{ #category : 'private - menu' }SpWin32MenuButtonAdapter >> resolvedMenu [	| menu |	menu := self presenter menu.	menu ifNil: [ ^ nil ].	((menu isBlock) or: [ menu isMessageSend ]) ifTrue: [ menu := menu value ].	menu ifNil: [ ^ nil ].	(menu respondsTo: #owner:) ifTrue: [ menu owner: self presenter ].	^ menu]{ #category : 'private - menu' }SpWin32MenuButtonAdapter >> showMenu [	| entries bounds selected |	entries := self menuEntries.	entries ifEmpty: [ ^ false ].	self widget isValid ifFalse: [ ^ false ].	bounds := SpWin32Runtime default screenBoundsOf: self widget.	selected := SpWin32Runtime default		showPopupMenuEntries: entries		owner: self widget		at: bounds bottomLeft.	selected ifNil: [ ^ false ].	selected execute.	^ true]{ #category : 'native events' }SpWin32MenuButtonAdapter >> win32Clicked [	^ self showMenu]