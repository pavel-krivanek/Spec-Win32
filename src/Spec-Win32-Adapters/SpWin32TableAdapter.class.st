Class {	#name : 'SpWin32TableAdapter',	#superclass : 'SpWin32ListAdapter',	#instVars : [		'visibleItems',		'sortColumnIndex',		'sortDescending'	],	#category : 'Spec-Win32-Adapters-Controls',	#package : 'Spec-Win32-Adapters',	#tag : 'Controls'}{ #category : 'initialization' }SpWin32TableAdapter >> initialize [	super initialize.	visibleItems := #().	sortColumnIndex := nil.	sortDescending := false]{ #category : 'factory' }SpWin32TableAdapter >> buildWidget [	| control |	self rebuildVisibleItems.	control := SpWin32NativeTableControl		runtime: SpWin32Runtime default		kind: SpWin32Runtime controlTable		text: ''		preferredExtent: 320 @ 160.	control		eventHandler: self;		items: visibleItems;		multipleSelection: self presenter selection isMultipleSelection.	self configureColumnsOn: control.	self configureCellsOn: control.	control selectedIndexes: self presenter selection selectedIndexes.	self presenter whenModelChangedDo: [ self refreshModel ].	self presenter whenColumnsChangedDo: [ self refreshColumns ].	self presenter whenShowColumnHeadersChangedDo: [ self refreshColumns ].	self presenter whenIsResizableChangedDo: [ self refreshColumns ].	self presenter selection whenChangedDo: [ self refreshWidgetSelection ].	self presenter whenSelectionModeChangedDo: [ self selectionModeChangedOnPresenter ].	^ control]{ #category : 'private - model' }SpWin32TableAdapter >> rebuildVisibleItems [	visibleItems := self presenter items asArray.	sortColumnIndex ifNotNil: [ :index |		| column function |		(index between: 1 and: self presenter columns size) ifTrue: [			column := self presenter columns at: index.			column isSortable ifTrue: [				function := column sortFunction.				function ifNotNil: [					sortDescending ifTrue: [ function := function reversed ].					visibleItems := visibleItems sorted: function ] ] ] ]]{ #category : 'accessing' }SpWin32TableAdapter >> elementAt: anIndex [	^ visibleItems at: anIndex]{ #category : 'testing' }SpWin32TableAdapter >> columns [	^ self presenter columns]{ #category : 'testing' }SpWin32TableAdapter >> isResizable [	^ self presenter isResizable]{ #category : 'testing' }SpWin32TableAdapter >> isShowingColumnHeaders [	^ self presenter isShowingColumnHeaders]{ #category : 'testing' }SpWin32TableAdapter >> isShowColumnHeaders [	^ self presenter isShowingColumnHeaders]{ #category : 'private - columns' }SpWin32TableAdapter >> effectiveColumnCount [	^ self presenter columns		ifEmpty: [ 1 ]		ifNotEmpty: [ :columns | columns size ]]{ #category : 'private - columns' }SpWin32TableAdapter >> columnTitles [	self presenter columns ifEmpty: [ ^ #('') ].	^ self presenter columns collect: [ :column | column title ifNil: [ '' ] ]]{ #category : 'private - columns' }SpWin32TableAdapter >> columnWidths [	self presenter columns ifEmpty: [ ^ #(200) ].	^ self presenter columns collect: [ :column |		column width ifNil: [ 100 ] ]]{ #category : 'private - columns' }SpWin32TableAdapter >> columnExpandables [	self presenter columns ifEmpty: [ ^ #(true) ].	^ self presenter columns collect: [ :column | column isExpandable ]]{ #category : 'private - columns' }SpWin32TableAdapter >> columnAlignments [	self presenter columns ifEmpty: [ ^ #(0) ].	^ self presenter columns collect: [ :column | self alignmentCodeFor: column ]]{ #category : 'private - columns' }SpWin32TableAdapter >> alignmentCodeFor: aColumn [	| block alignment sample |	block := aColumn displayAlignment.	block ifNil: [ ^ 0 ].	visibleItems ifEmpty: [ ^ 0 ].	sample := visibleItems first.	alignment := block cull: sample.	alignment == SpColumnAlignment right ifTrue: [ ^ 1 ].	alignment == SpColumnAlignment center ifTrue: [ ^ 2 ].	^ 0]{ #category : 'private - columns' }SpWin32TableAdapter >> configureColumnsOn: control [	control		columnsTitles: self columnTitles		widths: self columnWidths		alignments: self columnAlignments		expandables: self columnExpandables		headersVisible: self presenter isShowingColumnHeaders		resizable: self presenter isResizable]{ #category : 'private - cells' }SpWin32TableAdapter >> configureCellsOn: control [	| cells columns |	columns := self effectiveColumnCount.	cells := OrderedCollection new: visibleItems size * columns.	visibleItems withIndexDo: [ :item :row |		1 to: columns do: [ :columnIndex |			cells add: (self displayStringFor: item row: row column: columnIndex) ] ].	control		items: visibleItems;		cells: cells asArray rowCount: visibleItems size columnCount: columns]{ #category : 'private - cells' }SpWin32TableAdapter >> displayStringFor: item row: rowIndex column: columnIndex [	| column value parts |	self presenter columns ifEmpty: [ ^ item displayString ].	column := self presenter columns at: columnIndex.	(column isKindOf: SpIndexTableColumn) ifTrue: [ ^ rowIndex asString ].	(column isKindOf: SpCheckBoxTableColumn) ifTrue: [		value := column evaluateObject: item.		^ value = true ifTrue: [ '☑' ] ifFalse: [ '☐' ] ].	column isComposite ifTrue: [		parts := column columns collect: [ :nested |			(self textualValueFor: nested item: item) ].		^ (parts reject: #isEmpty) joinUsing: ' ' ].	(column isKindOf: SpImageTableColumn) ifTrue: [ ^ '' ].	^ self textualValueFor: column item: item]{ #category : 'private - cells' }SpWin32TableAdapter >> textualValueFor: aColumn item: item [	| value |	value := aColumn readObject: item.	^ value ifNil: [ '' ] ifNotNil: [ value asString ]]{ #category : 'refreshing' }SpWin32TableAdapter >> refreshModel [	self rebuildVisibleItems.	self configureCellsOn: self widget.	self refreshWidgetSelection]{ #category : 'refreshing' }SpWin32TableAdapter >> refreshColumns [	(sortColumnIndex notNil and: [ sortColumnIndex > self presenter columns size ]) ifTrue: [		sortColumnIndex := nil.		sortDescending := false ].	self rebuildVisibleItems.	self configureColumnsOn: self widget.	self configureCellsOn: self widget.	self refreshWidgetSelection]{ #category : 'widget API' }SpWin32TableAdapter >> refreshList [	self refreshModel]{ #category : 'widget API' }SpWin32TableAdapter >> refreshWidgetList [	self refreshModel]{ #category : 'widget API' }SpWin32TableAdapter >> refreshWidgetHeaderTitle [	self refreshColumns]{ #category : 'sorting' }SpWin32TableAdapter >> clickOnColumnHeaderAt: anIndex [	| column selectedItems newIndexes |	(anIndex between: 1 and: self presenter columns size) ifFalse: [ ^ self ].	column := self presenter columns at: anIndex.	column isSortable ifFalse: [ ^ self ].	selectedItems := self presenter selection selectedItems.	sortColumnIndex = anIndex		ifTrue: [ sortDescending := sortDescending not ]		ifFalse: [ sortColumnIndex := anIndex. sortDescending := false ].	self rebuildVisibleItems.	self configureCellsOn: self widget.	newIndexes := (selectedItems collect: [ :each | visibleItems indexOf: each ]) reject: [ :each | each = 0 ].	self presenter selection selectIndexes: newIndexes]{ #category : 'native events' }SpWin32TableAdapter >> win32ColumnClicked: anIndex [	self clickOnColumnHeaderAt: anIndex]{ #category : 'testing' }SpWin32TableAdapter >> isNonEditableRow: aRow column: aColumn [	(aColumn between: 1 and: self presenter columns size) ifFalse: [ ^ true ].	^ (self presenter columns at: aColumn) isEditable not]{ #category : 'protocol compatibility' }SpWin32TableAdapter >> alternateRowsColor [	"Native alternate-row custom drawing is not implemented yet."]