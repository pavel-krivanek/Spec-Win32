Class {	#name : 'SpWin32AthensAdapter',	#superclass : 'SpWin32AbstractAdapter',	#instVars : [		'surface',		'surfaceExtent'	],	#category : 'Spec-Win32-Adapters-Controls',	#package : 'Spec-Win32-Adapters',	#tag : 'Controls'}{ #category : 'factory' }SpWin32AthensAdapter >> buildWidget [	| extent control |	extent := self normalizedDrawingExtent: self presenter surfaceExtent.	control := SpWin32AthensSurfaceControl		runtime: SpWin32Runtime default		preferredExtent: extent		extentChangedAction: [ :newExtent | self redrawAtExtent: newExtent on: control ].	control eventHandler: self.	self presenter whenDrawBlockChangedDo: [ :newBlock | self redraw ].	self presenter whenExtentChangedDo: [ :newExtent | self updateSurfaceExtent: newExtent ].	^ control]{ #category : 'drawing' }SpWin32AthensAdapter >> redraw [	self widgetDo: [ :control |		self			redrawAtExtent: (self drawingExtentFor: control)			on: control ]]{ #category : 'private - drawing' }SpWin32AthensAdapter >> redrawAtExtent: anExtent on: control [	| extent block |	extent := self normalizedDrawingExtent: anExtent.	self ensureSurfaceExtent: extent.	block := self presenter drawBlock.	surface drawDuring: [ :canvas |		block			ifNil: [ surface clear ]			ifNotNil: [				block					cull: canvas					cull: (0 @ 0 extent: extent) ] ].	control imageData: self imageDataFromSurface]{ #category : 'private - drawing' }SpWin32AthensAdapter >> imageDataFromSurface [	surface flush.	^ SpWin32ImageData		fromPremultipliedBGRAPointer: surface getDataPtr		width: surface width		height: surface height		stride: surface stride]{ #category : 'private - drawing' }SpWin32AthensAdapter >> drawingExtentFor: control [	control isValid ifTrue: [ ^ self normalizedDrawingExtent: control bounds extent ].	^ self normalizedDrawingExtent: control preferredExtent]{ #category : 'private - drawing' }SpWin32AthensAdapter >> ensureSurfaceExtent: anExtent [	(surface isNil or: [ surfaceExtent ~= anExtent ]) ifTrue: [		surfaceExtent := anExtent.		surface := AthensCairoSurface extent: surfaceExtent ]]{ #category : 'private - drawing' }SpWin32AthensAdapter >> normalizedDrawingExtent: anExtent [	| extent |	extent := anExtent ifNil: [ 1 @ 1 ].	^ (extent x asInteger max: 1) @ (extent y asInteger max: 1)]{ #category : 'accessing' }SpWin32AthensAdapter >> surface [	^ surface]{ #category : 'private - updating' }SpWin32AthensAdapter >> updateSurfaceExtent: anExtent [	| normalized |	normalized := self normalizedDrawingExtent: anExtent.	self widgetDo: [ :control |		control preferredExtent: normalized.		control requestRelayout.		self redraw ]]{ #category : 'native events' }SpWin32AthensAdapter >> win32Clicked [	"The shared native Image surface emits a convenience click event for	SpImagePresenter. Athens uses Spec generic mouse events instead."]