Class {	#name : 'SpWin32ToggleButtonAdapter',	#superclass : 'SpWin32CheckBoxAdapter',	#category : 'Spec-Win32-Adapters-Controls',	#package : 'Spec-Win32-Adapters',	#tag : 'Controls'}{ #category : 'factory' }SpWin32ToggleButtonAdapter >> buildWidget [	| text iconData control |	text := self getLabelText.	iconData := self imageDataFor: self presenter icon.	control := SpWin32NativeControl		runtime: SpWin32Runtime default		kind: SpWin32Runtime controlToggleButton		text: text		preferredExtent: (self preferredExtentForText: text iconData: iconData).	control		eventHandler: self;		checked: self presenter state;		imageData: iconData.	self presenter whenLabelChangedDo: [ self updateLabel ].	self presenter whenChangedDo: [ self updateState ].	self presenter whenIconChangedDo: [ self updateIcon ].	^ control]{ #category : 'emulating' }SpWin32ToggleButtonAdapter >> clicked [	self win32Toggled: self presenter state not]{ #category : 'private - images' }SpWin32ToggleButtonAdapter >> imageDataFor: aFormOrNil [	^ SpWin32ImageData fromForm: aFormOrNil]{ #category : 'accessing' }SpWin32ToggleButtonAdapter >> icon [	^ self presenter icon]{ #category : 'private - layout' }SpWin32ToggleButtonAdapter >> preferredExtentForText: text iconData: iconData [	| width height |	width := ((text size * 8) + 24) max: 75.	height := 28.	iconData ifNil: [ ^ width @ height ].	height := height max: iconData height + 10.	width := text isEmpty		ifTrue: [ iconData width + 16 ]		ifFalse: [ (text size * 8) + iconData width + 34 ].	^ (width max: iconData width + 16) @ height]{ #category : 'private - updating' }SpWin32ToggleButtonAdapter >> updateIcon [	| iconData |	iconData := self imageDataFor: self presenter icon.	self widget imageData: iconData.	self updatePreferredExtent]{ #category : 'private - updating' }SpWin32ToggleButtonAdapter >> updateLabel [	self widget text: self getLabelText.	self updatePreferredExtent]{ #category : 'private - updating' }SpWin32ToggleButtonAdapter >> updatePreferredExtent [	self widget preferredExtent: (self		preferredExtentForText: self getLabelText		iconData: self widget imageData).	self widget requestRelayout]{ #category : 'native events' }SpWin32ToggleButtonAdapter >> win32Toggled: aBoolean [	aBoolean ifTrue: [		self presenter associatedToggleButtons do: [ :each | each state: false ] ].	self presenter state: aBoolean]