Class {	#name : 'SpWin32DiffAdapter',	#superclass : 'SpWin32PatchSideBySideAdapter',	#instVars : [		'diffContainer'	],	#category : 'Spec-Win32-Adapters-Code',	#package : 'Spec-Win32-Adapters',	#tag : 'Code'}{ #category : 'initialization' }SpWin32DiffAdapter >> adapt: aPresenter [	super adapt: aPresenter.	"SpWin32AbstractAdapter applies the presenter's overall visibility to the	container after #buildWidget. Layout containers propagate that visibility to	all children, so restore Diff's independent source/destination pane state."	self applyPaneVisibility]{ #category : 'factory' }SpWin32DiffAdapter >> buildWidget [	diffContainer := SpWin32DiffContainer new.	diffContainer runtime: SpWin32Runtime default.	leftControl := self newDiffCodeControl.	rightControl := self newDiffCodeControl.	diffContainer addChild: leftControl constraints: SpBoxConstraints new.	diffContainer addChild: rightControl constraints: SpBoxConstraints new.	self refreshDiff.	self applyPaneVisibility.	^ diffContainer]{ #category : 'factory' }SpWin32DiffAdapter >> newDiffCodeControl [	^ (SpWin32NativeControl		runtime: SpWin32Runtime default		kind: SpWin32Runtime controlCode		text: ''		preferredExtent: 320 @ 320)		eventHandler: self;		editable: false;		configureTextWrapWord: self presenter beWrapped scrollBars: true undoEnabled: false;		codeLineNumbers: false;		codeStyleSpans: #() foreground: self baseForegroundRgb background: self baseBackgroundRgb;		yourself]{ #category : 'private - updating' }SpWin32DiffAdapter >> refreshDiff [	| patch visitor |	(leftControl isNil or: [ rightControl isNil ]) ifTrue: [ ^ self ].	patch := DiffBuilder		buildPatchFrom: (self presenter leftText ifNil: [ '' ]) lines		to: (self presenter rightText ifNil: [ '' ]) lines.	visitor := SpWin32PatchSideBySideVisitor new		visitPatch: patch;		yourself.	leftControl text: visitor leftText.	rightControl text: visitor rightText.	leftControl codeLineDecorations: (self lineDecorationEntriesFor: visitor leftMarks).	rightControl codeLineDecorations: (self lineDecorationEntriesFor: visitor rightMarks)]{ #category : 'private - marks' }SpWin32DiffAdapter >> lineDecorationEntriesFor: lineMarks [	| entries background |	entries := OrderedCollection new.	background := self baseBackgroundRgb.	lineMarks do: [ :association |		| color |		color := self markColorFor: association value.		entries			add: association key - 1;			add: (self blendedRgbForColor: color over: background);			add: (self nativeMarkKindFor: association value);			add: (self rgbIntegerForColor: color) ].	^ entries asArray]{ #category : 'private - marks' }SpWin32DiffAdapter >> markColorFor: aSymbol [	aSymbol = #insert ifTrue: [ ^ Color green alpha: 0.1 ].	aSymbol = #delete ifTrue: [ ^ Color red alpha: 0.1 ].	aSymbol = #change ifTrue: [ ^ Color gray alpha: 0.1 ].	^ Color gray alpha: 0.1]{ #category : 'private - visibility' }SpWin32DiffAdapter >> applyPaneVisibility [	| sourceOnly destinationOnly showLeft showRight |	(leftControl isNil or: [ rightControl isNil ]) ifTrue: [ ^ self ].	sourceOnly := self presenter showOnlySource.	destinationOnly := self presenter showOnlyDestination.	(sourceOnly and: [ destinationOnly ])		ifTrue: [ showLeft := true. showRight := true ]		ifFalse: [			showLeft := destinationOnly not.			showRight := sourceOnly not ].	leftControl visible: showLeft.	rightControl visible: showRight.	diffContainer ifNotNil: [ diffContainer requestRelayout ]]{ #category : 'widget API' }SpWin32DiffAdapter >> leftText: aString [	self refreshDiff]{ #category : 'widget API' }SpWin32DiffAdapter >> rightText: aString [	self refreshDiff]{ #category : 'widget API' }SpWin32DiffAdapter >> leftLabel: aString [	"Gtk Diff does not currently render labels either. Keep the protocol safe without inventing a Win32-only chrome contract."	^ self]{ #category : 'widget API' }SpWin32DiffAdapter >> rightLabel: aString [	"Gtk Diff does not currently render labels either."	^ self]{ #category : 'widget API' }SpWin32DiffAdapter >> contextClass: aClass [	"The structural Diff slice does not yet apply syntax styling. Keep the presenter protocol live; code styling depth is tracked separately."	^ self]{ #category : 'widget API' }SpWin32DiffAdapter >> showOptions: aBoolean [	"Gtk's current Diff adapter has no options chrome."	^ self]{ #category : 'widget API' }SpWin32DiffAdapter >> beWrapped: aBoolean [	leftControl ifNotNil: [		leftControl configureTextWrapWord: aBoolean scrollBars: true undoEnabled: false ].	rightControl ifNotNil: [		rightControl configureTextWrapWord: aBoolean scrollBars: true undoEnabled: false ]]{ #category : 'widget API' }SpWin32DiffAdapter >> showOnlySource: aBoolean [	self applyPaneVisibility]{ #category : 'widget API' }SpWin32DiffAdapter >> showOnlyDestination: aBoolean [	self applyPaneVisibility]{ #category : 'widget API' }SpWin32DiffAdapter >> showBoth [	self applyPaneVisibility]{ #category : 'native events' }SpWin32DiffAdapter >> win32ScrollPositionChanged: aPoint source: sourceControl [	(leftControl isNil or: [ rightControl isNil ]) ifTrue: [ ^ self ].	(leftControl isVisible and: [ rightControl isVisible ]) ifFalse: [ ^ self ].	^ super win32ScrollPositionChanged: aPoint source: sourceControl]