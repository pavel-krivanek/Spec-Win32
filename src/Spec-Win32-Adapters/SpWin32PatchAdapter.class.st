Class {	#name : 'SpWin32PatchAdapter',	#superclass : 'SpWin32AbstractAdapter',	#category : 'Spec-Win32-Adapters-Code',	#package : 'Spec-Win32-Adapters',	#tag : 'Code'}{ #category : 'factory' }SpWin32PatchAdapter >> buildWidget [	| control |	control := SpWin32NativeControl		runtime: SpWin32Runtime default		kind: SpWin32Runtime controlCode		text: ''		preferredExtent: 520 @ 320.	control		eventHandler: self;		editable: false;		configureTextWrapWord: false scrollBars: true undoEnabled: false;		codeLineNumbers: false;		codeStyleSpans: #() foreground: self baseForegroundRgb background: self baseBackgroundRgb.	self setPatchModel: self presenter model on: control.	self presenter whenPatchChangedDo: [ :aPatchModel |		self setPatchModel: aPatchModel on: control ].	^ control]{ #category : 'private - colors' }SpWin32PatchAdapter >> baseBackgroundRgb [	^ 16rFFFFFF]{ #category : 'private - colors' }SpWin32PatchAdapter >> baseForegroundRgb [	^ 16r202020]{ #category : 'private - colors' }SpWin32PatchAdapter >> rgbIntegerForColor: aColor [	| red green blue |	red := ((aColor red * 255) rounded max: 0) min: 255.	green := ((aColor green * 255) rounded max: 0) min: 255.	blue := ((aColor blue * 255) rounded max: 0) min: 255.	^ (red bitShift: 16) + (green bitShift: 8) + blue]{ #category : 'private - colors' }SpWin32PatchAdapter >> blendedRgbForColor: aColor over: backgroundRgb [	| alpha backRed backGreen backBlue red green blue |	alpha := aColor alpha.	backRed := (backgroundRgb bitShift: -16) bitAnd: 255.	backGreen := (backgroundRgb bitShift: -8) bitAnd: 255.	backBlue := backgroundRgb bitAnd: 255.	red := ((aColor red * 255 * alpha) + (backRed * (1 - alpha))) rounded.	green := ((aColor green * 255 * alpha) + (backGreen * (1 - alpha))) rounded.	blue := ((aColor blue * 255 * alpha) + (backBlue * (1 - alpha))) rounded.	^ (red bitShift: 16) + (green bitShift: 8) + blue]{ #category : 'private - marks' }SpWin32PatchAdapter >> nativeMarkKindFor: aSymbol [	aSymbol = #insert ifTrue: [ ^ 1 ].	aSymbol = #delete ifTrue: [ ^ 2 ].	aSymbol = #change ifTrue: [ ^ 3 ].	^ 4]{ #category : 'private - marks' }SpWin32PatchAdapter >> lineDecorationEntriesFor: lineMarks [	| entries background |	entries := OrderedCollection new.	background := self baseBackgroundRgb.	lineMarks do: [ :association |		| mark color |		mark := self presenter marks at: association value.		color := mark backgroundColor.		entries			add: association key - 1;			add: (self blendedRgbForColor: color over: background);			add: (self nativeMarkKindFor: association value);			add: (self rgbIntegerForColor: color) ].	^ entries asArray]{ #category : 'private - updating' }SpWin32PatchAdapter >> setPatchModel: aPatchModel on: control [	| visitor |	(aPatchModel isNil or: [ aPatchModel isEmpty ]) ifTrue: [		control text: ''.		control codeLineDecorations: #().		^ self ].	visitor := SpWin32PatchLineVisitor new		visitPatch: aPatchModel patch;		yourself.	control text: visitor contents.	control codeLineDecorations: (self lineDecorationEntriesFor: visitor lineMarks)]{ #category : 'native events' }SpWin32PatchAdapter >> win32TextChanged: aString [	"The patch surface is deliberately read-only. RichEdit may still emit EN_CHANGE	during programmatic text/format updates, so consume that notification without	feeding it back into the presenter."	^ self]{ #category : 'accessing' }SpWin32PatchAdapter >> lineMarks [	| visitor model |	model := self presenter model.	(model isNil or: [ model isEmpty ]) ifTrue: [ ^ #() ].	visitor := SpWin32PatchLineVisitor new visitPatch: model patch; yourself.	^ visitor lineMarks]