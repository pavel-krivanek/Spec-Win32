Class {	#name : 'SpWin32ToolbarBaseButtonAdapter',	#superclass : 'SpWin32AbstractAdapter',	#category : 'Spec-Win32-Adapters-Toolbar',	#package : 'Spec-Win32-Adapters',	#tag : 'Toolbar'}{ #category : 'testing' }SpWin32ToolbarBaseButtonAdapter class >> isAbstract [	^ self == SpWin32ToolbarBaseButtonAdapter]{ #category : 'private' }SpWin32ToolbarBaseButtonAdapter >> displayMode [	| owner |	owner := self presenter owner.	(owner notNil and: [ owner respondsTo: #displayMode ]) ifTrue: [ ^ owner displayMode ].	^ SpToolbarDisplayMode default]{ #category : 'private' }SpWin32ToolbarBaseButtonAdapter >> getLabelText [	self displayMode hasLabel ifFalse: [ ^ '' ].	^ (self presenter label ifNil: [ '' ]) localizedForPresenter: self presenter]{ #category : 'private - images' }SpWin32ToolbarBaseButtonAdapter >> imageDataForCurrentMode [	self displayMode hasIcon ifFalse: [ ^ nil ].	^ SpWin32ImageData fromForm: self presenter icon]{ #category : 'accessing' }SpWin32ToolbarBaseButtonAdapter >> icon [	^ self presenter icon]{ #category : 'accessing' }SpWin32ToolbarBaseButtonAdapter >> label [	^ self presenter label]{ #category : 'private - layout' }SpWin32ToolbarBaseButtonAdapter >> preferredExtentForText: text iconData: iconData [	| modeExtent width height |	modeExtent := self displayMode extent.	width := 14.	height := 24.	text isEmpty ifFalse: [ width := width + (text size * 7) ].	iconData ifNotNil: [		width := width + iconData width + (text isEmpty ifTrue: [ 0 ] ifFalse: [ 6 ]).		height := height max: iconData height + 8 ].	width := width max: modeExtent x.	height := height max: modeExtent y.	^ width @ height]{ #category : 'private - updating' }SpWin32ToolbarBaseButtonAdapter >> updateDisplayMode [	| text iconData |	text := self getLabelText.	iconData := self imageDataForCurrentMode.	self widget		text: text;		imageData: iconData;		preferredExtent: (self preferredExtentForText: text iconData: iconData);		requestRelayout]{ #category : 'private - updating' }SpWin32ToolbarBaseButtonAdapter >> updateIcon [	self updateDisplayMode]{ #category : 'private - updating' }SpWin32ToolbarBaseButtonAdapter >> updateLabel [	self updateDisplayMode]