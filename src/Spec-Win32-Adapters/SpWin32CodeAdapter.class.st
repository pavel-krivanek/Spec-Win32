Class {	#name : 'SpWin32CodeAdapter',	#superclass : 'SpWin32TextAdapter',	#category : 'Spec-Win32-Adapters-Code',	#package : 'Spec-Win32-Adapters',	#tag : 'Code'}{ #category : 'factory' }SpWin32CodeAdapter >> buildWidget [	| control |	control := super buildWidget.	control codeLineNumbers: self presenter hasLineNumbers.	self presenter whenLineNumbersChangedDo: [ :value | control codeLineNumbers: value ].	self presenter whenSyntaxHighlightChangedDo: [ :value | self refreshStyling ].	self presenter whenSyntaxHighlightThemeChangedDo: [ :value | self refreshStyling ].	self presenter whenStyleSchemeChangedDo: [ :value | self refreshStyling ].	self refreshStylingOn: control.	^ control]{ #category : 'factory' }SpWin32CodeAdapter >> nativeControlKind [	^ SpWin32Runtime controlCode]{ #category : 'factory' }SpWin32CodeAdapter >> preferredTextExtent [	^ 520 @ 320]{ #category : 'testing' }SpWin32CodeAdapter >> hasSyntaxHighlightEnabled [	^ self presenter hasSyntaxHighlight]{ #category : 'styling' }SpWin32CodeAdapter >> refreshStyling [	self widgetDo: [ :control | self refreshStylingOn: control ]]{ #category : 'styling' }SpWin32CodeAdapter >> refreshStylingOn: control [	| styled colors defaultRgb backgroundRgb spans |	styled := self textWithStyle.	colors := self rgbColorsFor: styled.	defaultRgb := self defaultForegroundRgbFor: colors.	backgroundRgb := self backgroundRgbForForeground: defaultRgb.	spans := self styleSpansForColors: colors default: defaultRgb.	control		codeStyleSpans: spans		foreground: defaultRgb		background: backgroundRgb]{ #category : 'styling' }SpWin32CodeAdapter >> textWithStyle [	| source text ast styler |	source := self presenter text ifNil: [ '' ].	text := source asText.	(self presenter hasSyntaxHighlight and: [ source notEmpty ]) ifFalse: [ ^ text ].	[		ast := (self presenter isScripting or: [ self presenter behavior isNil ])			ifTrue: [ RBParser parseExpression: source ]			ifFalse: [ RBParser parseMethod: source ].		styler := self newTextStyler.		^ styler style: text ast: ast	] on: Error do: [ :error | ^ text ]]{ #category : 'styling' }SpWin32CodeAdapter >> newTextStyler [	| theme themedStylerClass |	theme := self presenter syntaxHighlightTheme.	(theme notNil and: [ theme notEmpty ]) ifTrue: [		themedStylerClass := Smalltalk globals at: #SpMorphicCodeTextStyler ifAbsent: [ nil ].		themedStylerClass ifNotNil: [			[ ^ themedStylerClass newWithAttributeTableNamed: theme ] on: Error do: [ :error | ] ] ].	^ SHRBTextStyler new]{ #category : 'styling' }SpWin32CodeAdapter >> rgbColorsFor: styledText [	^ (1 to: styledText size) collect: [ :index |		| attribute |		attribute := (styledText attributesAt: index)			detect: [ :each | each isKindOf: TextColor ]			ifNone: [ nil ].		attribute ifNil: [ nil ] ifNotNil: [ self rgbIntegerForColor: attribute color ] ]]{ #category : 'styling' }SpWin32CodeAdapter >> rgbIntegerForColor: aColor [	| red green blue |	red := ((aColor red * 255) rounded max: 0) min: 255.	green := ((aColor green * 255) rounded max: 0) min: 255.	blue := ((aColor blue * 255) rounded max: 0) min: 255.	^ (red bitShift: 16) + (green bitShift: 8) + blue]{ #category : 'styling' }SpWin32CodeAdapter >> defaultForegroundRgbFor: colors [	| defaultAttributes textColor |	defaultAttributes := SHRBTextStyler initialTextAttributes at: #default ifAbsent: [ #() ].	textColor := defaultAttributes		detect: [ :each | each isKindOf: TextColor ]		ifNone: [ nil ].	textColor ifNotNil: [ ^ self rgbIntegerForColor: textColor color ].	^ colors detect: [ :each | each notNil ] ifNone: [ 16r202020 ]]{ #category : 'styling' }SpWin32CodeAdapter >> backgroundRgbForForeground: foregroundRgb [	| red green blue brightness |	red := (foregroundRgb bitShift: -16) bitAnd: 255.	green := (foregroundRgb bitShift: -8) bitAnd: 255.	blue := foregroundRgb bitAnd: 255.	brightness := red + green + blue.	^ brightness > 420 ifTrue: [ 16r202020 ] ifFalse: [ 16rFFFFFF ]]{ #category : 'styling' }SpWin32CodeAdapter >> styleSpansForColors: colors default: defaultRgb [	| spans start previous current |	colors isEmpty ifTrue: [ ^ #() ].	spans := OrderedCollection new.	start := 1.	previous := (colors first ifNil: [ defaultRgb ]).	2 to: colors size + 1 do: [ :index |		current := index <= colors size			ifTrue: [ (colors at: index) ifNil: [ defaultRgb ] ]			ifFalse: [ nil ].		(index > colors size or: [ current ~= previous ]) ifTrue: [			spans				add: start - 1;				add: index - 1;				add: previous;				add: 0.			start := index.			previous := current ] ].	^ spans asArray]{ #category : 'native events' }SpWin32CodeAdapter >> win32TextChanged: aString [	super win32TextChanged: aString.	self refreshStyling]{ #category : 'accessing' }SpWin32CodeAdapter >> text: aString [	super text: aString.	self refreshStyling]{ #category : 'widget API' }SpWin32CodeAdapter >> interactionModel: anInteractionModel [	self refreshStyling]{ #category : 'private - shout' }SpWin32CodeAdapter >> classOrMetaClass: aClass [	self refreshStyling]{ #category : 'widget API' }SpWin32CodeAdapter >> behavior [	^ self presenter behavior]{ #category : 'widget API' }SpWin32CodeAdapter >> doItContext [	^ self presenter doItContext]{ #category : 'widget API' }SpWin32CodeAdapter >> doItReceiver [	^ self presenter doItReceiver]{ #category : 'widget API' }SpWin32CodeAdapter >> isScripting [	^ self presenter isScripting]{ #category : 'widget API' }SpWin32CodeAdapter >> selectedBehavior [	^ self presenter selectedBehavior]{ #category : 'widget API' }SpWin32CodeAdapter >> selectedClassOrMetaClass [	^ self presenter behavior]{ #category : 'private - shout' }SpWin32CodeAdapter >> bindingOf: aString [	^ self presenter bindingOf: aString]{ #category : 'private - shout' }SpWin32CodeAdapter >> hasBindingOf: aString [	^ self presenter hasBindingOf: aString]{ #category : 'accessing' }SpWin32CodeAdapter >> bindings [	^ self presenter bindings]{ #category : 'widget API' }SpWin32CodeAdapter >> userActionDuring: aBlock [	^ aBlock value]{ #category : 'widget API' }SpWin32CodeAdapter >> insertPopoverAfterCurrentSelection: aPresenter style: styleName [	"Native editor popovers are a later parity slice. Keep evaluation callers safe for now."	^ self]