Class {	#name : 'SpWin32DropDownAdapter',	#superclass : 'SpWin32AbstractModernListAdapter',	#category : 'Spec-Win32-Adapters-ListView',	#package : 'Spec-Win32-Adapters',	#tag : 'ListView'}{ #category : 'factory' }SpWin32DropDownAdapter >> buildWidget [	| control |	self rebuildRowSnapshots.	control := SpWin32NativeControl		runtime: SpWin32Runtime default		kind: SpWin32Runtime controlDropList		text: ''		preferredExtent: (self estimatedPreferredExtentFor: self displayStrings).	control		eventHandler: self;		items: self displayStrings;		selectedIndex: self presenter selectedIndex.	self presenter selection whenChangedDo: [ self refreshWidgetSelection ].	^ control]{ #category : 'private' }SpWin32DropDownAdapter >> estimatedPreferredExtentFor: strings [	| maximumLength |	maximumLength := strings		ifEmpty: [ 0 ]		ifNotEmpty: [ (strings collect: #size) max ].	^ (((maximumLength * 7) + 36) max: 90) @ 24]{ #category : 'accessing' }SpWin32DropDownAdapter >> elementAt: anIndex [	^ self presenter items at: anIndex ifAbsent: [ nil ]]{ #category : 'updating' }SpWin32DropDownAdapter >> refreshList [	self rebuildRowSnapshots.	self widget items: self displayStrings.	self widget preferredExtent: (self estimatedPreferredExtentFor: self displayStrings).	self refreshWidgetSelection]{ #category : 'updating' }SpWin32DropDownAdapter >> refreshWidgetSelection [	self widget selectedIndex: self presenter selectedIndex]{ #category : 'selecting' }SpWin32DropDownAdapter >> selectIndex: anInteger [	anInteger = 0		ifTrue: [ self presenter resetSelection ]		ifFalse: [ self presenter selectIndex: anInteger ]]{ #category : 'native events' }SpWin32DropDownAdapter >> win32SelectionChanged: anInteger [	self presenter selectedIndex = anInteger ifTrue: [ ^ self ].	anInteger = 0		ifTrue: [ self presenter resetSelection ]		ifFalse: [ self presenter selectIndex: anInteger ]]