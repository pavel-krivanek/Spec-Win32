Class {	#name : 'SpWin32OverlayAdapter',	#superclass : 'SpWin32LayoutAdapter',	#category : 'Spec-Win32-Adapters-Layout',	#package : 'Spec-Win32-Adapters',	#tag : 'Layout'}{ #category : 'accessing' }SpWin32OverlayAdapter >> add: aPresenter constraints: constraints [	| childWidget |	aPresenter owner: self model.	childWidget := aPresenter buildWithSelector: constraints spec.	widget addChild: childWidget constraints: constraints]{ #category : 'factory' }SpWin32OverlayAdapter >> adapterWasBuilt []{ #category : 'factory' }SpWin32OverlayAdapter >> layout: aLayout [	layout := aLayout.	widget ifNil: [		widget := SpWin32OverlayContainer			layout: aLayout			runtime: SpWin32Runtime default ].	aLayout whenChildrenAddedDo: [ :announcement |		self add: announcement child constraints: (aLayout constraintsFor: announcement child) ].	aLayout whenChildrenRemovedDo: [ :announcement |		announcement child adapter ifNotNil: [ :adapter |			widget removeChildWidget: adapter widget ] ]]{ #category : 'accessing' }SpWin32OverlayAdapter >> removeAll [	widget removeAll]{ #category : 'factory' }SpWin32OverlayAdapter >> removeSubWidgets [	self removeAll]{ #category : 'accessing' }SpWin32OverlayAdapter >> replace: aPresenter with: otherPresenter withConstraints: constraints [	| oldWidget newWidget |	oldWidget := aPresenter adapter widget.	otherPresenter owner: self model.	newWidget := otherPresenter buildWithSelector: constraints spec.	widget replaceChildWidget: oldWidget with: newWidget constraints: constraints]