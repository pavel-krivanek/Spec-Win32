Class {	#name : 'SpWin32ComponentListAdapter',	#superclass : 'SpWin32AbstractAdapter',	#instVars : [		'rowHosts',		'selectionAnchor'	],	#category : 'Spec-Win32-Adapters-Controls',	#package : 'Spec-Win32-Adapters',	#tag : 'Controls'}{ #category : 'specs' }SpWin32ComponentListAdapter class >> adaptingAliases [	^ #(FastTableAdapter)]{ #category : 'factory' }SpWin32ComponentListAdapter >> buildWidget [	| container |	rowHosts := OrderedCollection new.	selectionAnchor := nil.	container := SpWin32ComponentListContainer runtime: SpWin32Runtime default.	container eventHandler: container.	self rebuildRowsIn: container.	self presenter whenPresentersChangedDo: [ self rebuildRows ].	self presenter selection whenChangedDo: [ self refreshWidgetSelection ].	self presenter whenSelectionModeChangedDo: [ self refreshWidgetSelection ].	^ container]{ #category : 'accessing' }SpWin32ComponentListAdapter >> children [	^ (rowHosts collect: #child) asArray]{ #category : 'accessing' }SpWin32ComponentListAdapter >> elementAt: anIndex [	^ self presenter presenters at: anIndex]{ #category : 'testing' }SpWin32ComponentListAdapter >> isNonEditableRow: aRow column: aColumn [	^ true]{ #category : 'accessing' }SpWin32ComponentListAdapter >> items [	^ self presenter presenters]{ #category : 'private - rows' }SpWin32ComponentListAdapter >> newRowHostFor: aPresenter index: anIndex [	| childWidget |	childWidget := aPresenter build.	^ SpWin32ComponentRowHost		runtime: SpWin32Runtime default		child: childWidget		presenter: aPresenter		index: anIndex		owner: self]{ #category : 'private - rows' }SpWin32ComponentListAdapter >> rebuildRows [	self widgetDo: [ :container | self rebuildRowsIn: container ]]{ #category : 'private - rows' }SpWin32ComponentListAdapter >> rebuildRowsIn: container [	| oldByPresenter currentPresenters newHosts retained removed |	oldByPresenter := IdentityDictionary new.	rowHosts ifNotNil: [		rowHosts do: [ :row | oldByPresenter at: row rowPresenter put: row ] ].	currentPresenters := self presenter presenters asArray.	newHosts := OrderedCollection new.	retained := IdentitySet new.	currentPresenters withIndexDo: [ :rowPresenter :index |		| row |		row := oldByPresenter			at: rowPresenter			ifAbsent: [ self newRowHostFor: rowPresenter index: index ].		row index: index.		row ownerAdapter: self.		newHosts add: row.		retained add: row ].	removed := rowHosts ifNil: [ #() ] ifNotNil: [ rowHosts reject: [ :row | retained includes: row ] ].	removed do: [ :row |		| oldPresenter |		oldPresenter := row rowPresenter.		row destroy.		(oldPresenter respondsTo: #adapter:) ifTrue: [ oldPresenter adapter: nil ] ].	rowHosts := newHosts.	container rows: rowHosts.	self refreshWidgetSelection]{ #category : 'widget API' }SpWin32ComponentListAdapter >> refreshList [	self rebuildRows]{ #category : 'widget API' }SpWin32ComponentListAdapter >> refreshWidgetSelection [	self widgetDo: [ :container |		container selectedIndexes: self presenter selection selectedIndexes ]]{ #category : 'accessing' }SpWin32ComponentListAdapter >> selectedIndexes [	^ self widget selectedIndexes]{ #category : 'accessing' }SpWin32ComponentListAdapter >> selectedRowPresenter [	| index |	index := self presenter selection selectedIndex.	index = 0 ifTrue: [ ^ nil ].	^ self presenter presenters at: index ifAbsent: [ nil ]]{ #category : 'selecting' }SpWin32ComponentListAdapter >> selectIndex: anInteger [	| indexes |	anInteger = 0 ifTrue: [		self presenter selection unselectAll.		selectionAnchor := nil.		^ self ].	(anInteger between: 1 and: self presenter presenters size) ifFalse: [		self presenter selection unselectAll.		selectionAnchor := nil.		^ self ].	indexes := self presenter selection isMultipleSelection		ifTrue: [			(self presenter selection selectedIndexes asOrderedCollection				add: anInteger;				removeDuplicates;				asArray) ]		ifFalse: [ { anInteger } ].	selectionAnchor := anInteger.	self presenter selection selectIndexes: indexes]{ #category : 'selecting' }SpWin32ComponentListAdapter >> unselectAll [	self selectIndex: 0]{ #category : 'scrolling' }SpWin32ComponentListAdapter >> scrollToIndex: anInteger [	self widget scrollToIndex: anInteger]{ #category : 'focus' }SpWin32ComponentListAdapter >> takeKeyboardFocus [	| index target |	rowHosts ifNil: [ ^ super takeKeyboardFocus ].	rowHosts ifEmpty: [ ^ super takeKeyboardFocus ].	index := self presenter selection selectedIndex.	index = 0 ifTrue: [ index := 1 ].	target := rowHosts at: index ifAbsent: [ rowHosts first ].	(target child respondsTo: #takeKeyboardFocus)		ifTrue: [ target child takeKeyboardFocus ]		ifFalse: [ target takeKeyboardFocus ]]{ #category : 'private - rows' }SpWin32ComponentListAdapter >> isRowActivatable: aPresenter [	^ (aPresenter respondsTo: #isActivatable)		ifTrue: [ aPresenter isActivatable ]		ifFalse: [ true ]]{ #category : 'private - rows' }SpWin32ComponentListAdapter >> isRowSelectable: aPresenter [	^ (aPresenter respondsTo: #isSelectable)		ifTrue: [ aPresenter isSelectable ]		ifFalse: [ true ]]{ #category : 'native events' }SpWin32ComponentListAdapter >> rowActivatedAt: anIndex source: sourceKind [	| rowPresenter |	rowPresenter := self presenter presenters at: anIndex ifAbsent: [ ^ self ].	(self isRowActivatable: rowPresenter) ifFalse: [ ^ self ].	sourceKind = 2 ifTrue: [		self presenter doActivateAtIndex: anIndex.		^ self ].	self presenter isActiveOnDoubleClick ifTrue: [		self presenter doActivateAtIndex: anIndex ]]{ #category : 'native events' }SpWin32ComponentListAdapter >> rowClickedAt: anIndex modifiers: modifiers [	| rowPresenter indexes control shift anchor range |	rowPresenter := self presenter presenters at: anIndex ifAbsent: [ ^ self ].	(self isRowSelectable: rowPresenter) ifFalse: [ ^ self ].	self presenter selection isMultipleSelection ifFalse: [		selectionAnchor := anIndex.		self presenter selection selectIndexes: { anIndex }.		(self presenter isActiveOnSingleClick and: [ self isRowActivatable: rowPresenter ]) ifTrue: [			self presenter doActivateAtIndex: anIndex ].		^ self ].	control := (modifiers bitAnd: SpWin32Runtime modifierControl) ~= 0.	shift := (modifiers bitAnd: SpWin32Runtime modifierShift) ~= 0.	indexes := self presenter selection selectedIndexes asOrderedCollection.	shift ifTrue: [		anchor := selectionAnchor ifNil: [ anIndex ].		range := ((anchor min: anIndex) to: (anchor max: anIndex)) asArray.		control			ifTrue: [ indexes addAll: range; removeDuplicates ]			ifFalse: [ indexes := range asOrderedCollection ] ]	ifFalse: [		control			ifTrue: [				(indexes includes: anIndex)					ifTrue: [ indexes remove: anIndex ]					ifFalse: [ indexes add: anIndex ] ]			ifFalse: [ indexes := OrderedCollection with: anIndex ].		selectionAnchor := anIndex ].	self presenter selection selectIndexes: indexes asArray.	(self presenter isActiveOnSingleClick and: [ self isRowActivatable: rowPresenter ]) ifTrue: [		self presenter doActivateAtIndex: anIndex ]]{ #category : 'native events' }SpWin32ComponentListAdapter >> rowFocusedAt: anIndex [	| rowPresenter |	rowPresenter := self presenter presenters at: anIndex ifAbsent: [ ^ self ].	(self isRowSelectable: rowPresenter) ifFalse: [ ^ self ].	(self presenter selection selectedIndexes includes: anIndex) ifTrue: [ ^ self ].	selectionAnchor := anIndex.	self presenter selection selectIndexes: { anIndex }]{ #category : 'protocol compatibility' }SpWin32ComponentListAdapter >> updateMenu [	self updateActions]