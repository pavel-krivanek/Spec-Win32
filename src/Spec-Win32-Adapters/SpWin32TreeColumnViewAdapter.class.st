Class {	#name : 'SpWin32TreeColumnViewAdapter',	#superclass : 'SpWin32AbstractModernListAdapter',	#instVars : [		'paths',		'pathToToken',		'parentTokens',		'expandedPaths',		'cellPresenters',		'cellStrings',		'cellImages',		'visiblePaths',		'visibleItems',		'visibleCellStrings',		'visibleCellImages',		'sortColumnIndex',		'sortDescending'	],	#category : 'Spec-Win32-Adapters-ListView',	#package : 'Spec-Win32-Adapters',	#tag : 'ListView'}{ #category : 'initialization' }SpWin32TreeColumnViewAdapter >> initialize [	super initialize.	paths := #().	pathToToken := Dictionary new.	parentTokens := #().	expandedPaths := Set new.	cellPresenters := #().	cellStrings := #().	cellImages := #().	visiblePaths := #().	visibleItems := #().	visibleCellStrings := #().	visibleCellImages := #().	sortColumnIndex := nil.	sortDescending := false]{ #category : 'factory' }SpWin32TreeColumnViewAdapter >> buildWidget [	| control |	self rebuildTreeSnapshots.	self rebuildVisibleProjection.	control := SpWin32NativeTreeColumnControl		runtime: SpWin32Runtime default		kind: SpWin32Runtime controlTreeColumn		text: ''		preferredExtent: 420 @ 200.	control eventHandler: self.	self configureAllOn: control.	self presenter whenRootsChangedDo: [ self rootsChanged ].	self presenter whenColumnsChangedDo: [ self refreshColumns ].	self presenter whenShowColumnHeadersChangedDo: [ self refreshColumns ].	self presenter whenIsResizableChangedDo: [ self refreshColumns ].	self presenter whenSelectionChangedDo: [ self refreshSelection ].	self presenter whenMultiSelectionChangedDo: [ self refreshSelection ].	self presenter verticalAlignment whenChangedDo: [ self scrollToSelection ].	^ control]{ #category : 'private - model' }SpWin32TreeColumnViewAdapter >> rebuildTreeSnapshots [	| newPaths map parents presenters strings images |	newPaths := OrderedCollection new.	map := Dictionary new.	parents := OrderedCollection new.	presenters := OrderedCollection new.	strings := OrderedCollection new.	images := OrderedCollection new.	self		appendSnapshotItems: self presenter roots		parentPath: #()		parentToken: 0		paths: newPaths		map: map		parents: parents		presenters: presenters		strings: strings		images: images.	paths := newPaths asArray.	pathToToken := map.	parentTokens := parents asArray.	cellPresenters := presenters asArray.	cellStrings := strings asArray.	cellImages := images asArray.	rowPresenters := cellPresenters.	displayStrings := cellStrings.	rowImages := cellImages]{ #category : 'private - model' }SpWin32TreeColumnViewAdapter >> appendSnapshotItems: aCollection parentPath: parentPath parentToken: parentToken paths: newPaths map: map parents: parents presenters: presenters strings: strings images: images [	(self sortedIndexedItems: aCollection) do: [ :association |		| index item path token rowCells |		index := association key.		item := association value.		path := (parentPath copyWith: index) asArray.		token := newPaths size + 1.		newPaths add: path.		map at: path put: token.		parents add: parentToken.		rowCells := self snapshotsForItem: item.		rowCells do: [ :triple |			presenters add: triple first.			strings add: triple second.			images add: triple third ].		self			appendSnapshotItems: (self presenter childrenFor: item)			parentPath: path			parentToken: token			paths: newPaths			map: map			parents: parents			presenters: presenters			strings: strings			images: images ]]{ #category : 'private - cells' }SpWin32TreeColumnViewAdapter >> snapshotsForItem: item [	self presenter columns ifEmpty: [ ^ { { nil. item asString. nil } } ].	^ self presenter columns collect: [ :column |		| cell |		cell := column setupAction cull: self presenter.		cell ifNil: [ self error: 'Win32 TreeColumnView setup block returned nil.' ].		column bindAction value: cell value: item.		{			cell.			(self displayStringForRowPresenter: cell item: item).			(self imageDataForRowPresenter: cell)		} ]]{ #category : 'private - sorting' }SpWin32TreeColumnViewAdapter >> sortedIndexedItems: aCollection [	| indexed column function |	indexed := aCollection withIndexCollect: [ :item :index | index -> item ].	sortColumnIndex ifNil: [ ^ indexed ].	(sortColumnIndex between: 1 and: self presenter columns size) ifFalse: [ ^ indexed ].	column := self presenter columns at: sortColumnIndex.	column isSortable ifFalse: [ ^ indexed ].	function := column sortFunction.	function ifNil: [ ^ indexed ].	sortDescending ifTrue: [ function := function reversed ].	^ indexed sorted: [ :left :right | function value: left value value: right value ]]{ #category : 'private - projection' }SpWin32TreeColumnViewAdapter >> rebuildVisibleProjection [	| projectedPaths projectedItems strings images columns |	projectedPaths := OrderedCollection new.	projectedItems := OrderedCollection new.	strings := OrderedCollection new.	images := OrderedCollection new.	columns := self effectiveColumnCount.	paths withIndexDo: [ :path :rowIndex |		(self pathIsVisible: path) ifTrue: [			projectedPaths add: path.			projectedItems add: (self itemAtPath: path).			1 to: columns do: [ :columnIndex |				| flatIndex |				flatIndex := ((rowIndex - 1) * columns) + columnIndex.				strings add: (cellStrings at: flatIndex).				images add: (cellImages at: flatIndex) ] ] ].	visiblePaths := projectedPaths asArray.	visibleItems := projectedItems asArray.	visibleCellStrings := strings asArray.	visibleCellImages := images asArray]{ #category : 'private - projection' }SpWin32TreeColumnViewAdapter >> pathIsVisible: aPath [	aPath size <= 1 ifTrue: [ ^ true ].	1 to: aPath size - 1 do: [ :depth |		(expandedPaths includes: (aPath first: depth) asArray) ifFalse: [ ^ false ] ].	^ true]{ #category : 'private - columns' }SpWin32TreeColumnViewAdapter >> effectiveColumnCount [	^ self presenter columns ifEmpty: [ 1 ] ifNotEmpty: [ :columns | columns size ]]{ #category : 'private - columns' }SpWin32TreeColumnViewAdapter >> columnTitles [	self presenter columns ifEmpty: [ ^ #('') ].	^ self presenter columns collect: [ :column | column title ifNil: [ '' ] ]]{ #category : 'private - columns' }SpWin32TreeColumnViewAdapter >> columnWidths [	self presenter columns ifEmpty: [ ^ #(220) ].	^ self presenter columns collect: [ :column | column width ifNil: [ 100 ] ]]{ #category : 'private - columns' }SpWin32TreeColumnViewAdapter >> columnExpandables [	self presenter columns ifEmpty: [ ^ #(true) ].	^ self presenter columns collect: [ :column | column isExpandable ]]{ #category : 'private - configuring' }SpWin32TreeColumnViewAdapter >> configureAllOn: control [	| treeLabels treeImages |	treeLabels := OrderedCollection new: paths size.	treeImages := OrderedCollection new: paths size.	1 to: paths size do: [ :rowIndex |		| flatIndex |		flatIndex := ((rowIndex - 1) * self effectiveColumnCount) + 1.		treeLabels add: (cellStrings at: flatIndex).		treeImages add: (cellImages at: flatIndex) ].	control labels: treeLabels asArray parentTokens: parentTokens images: treeImages asArray.	self configureColumnsOn: control.	self configureVisibleCellsOn: control.	paths do: [ :path |		(expandedPaths includes: path) ifTrue: [			(self tokenForPath: path) ifNotNil: [ :token | control token: token expanded: true ] ] ].	self refreshSelectionOn: control]{ #category : 'private - configuring' }SpWin32TreeColumnViewAdapter >> configureColumnsOn: control [	control		columnsTitles: self columnTitles		widths: self columnWidths		alignments: (Array new: self effectiveColumnCount withAll: 0)		expandables: self columnExpandables		headersVisible: self presenter isShowingColumnHeaders		resizable: self presenter isResizable]{ #category : 'private - configuring' }SpWin32TreeColumnViewAdapter >> configureVisibleCellsOn: control [	control		items: visibleItems;		cells: visibleCellStrings		images: visibleCellImages		rowCount: visibleItems size		columnCount: self effectiveColumnCount]{ #category : 'accessing' }SpWin32TreeColumnViewAdapter >> itemAtPath: aPath [	^ self presenter		itemAt: aPath first		of: self presenter roots		then: aPath allButFirst]{ #category : 'accessing' }SpWin32TreeColumnViewAdapter >> elementAt: token [	| path |	path := self pathForToken: token.	^ path ifNil: [ nil ] ifNotNil: [ self itemAtPath: path ]]{ #category : 'accessing' }SpWin32TreeColumnViewAdapter >> pathForToken: token [	(token between: 1 and: paths size) ifFalse: [ ^ nil ].	^ paths at: token]{ #category : 'accessing' }SpWin32TreeColumnViewAdapter >> tokenForPath: aPath [	^ pathToToken at: aPath asArray ifAbsent: [ nil ]]{ #category : 'accessing' }SpWin32TreeColumnViewAdapter >> paths [ ^ paths ]{ #category : 'accessing' }SpWin32TreeColumnViewAdapter >> visiblePaths [ ^ visiblePaths ]{ #category : 'accessing' }SpWin32TreeColumnViewAdapter >> visibleItems [ ^ visibleItems ]{ #category : 'accessing' }SpWin32TreeColumnViewAdapter >> cellPresenters [ ^ cellPresenters ]{ #category : 'accessing' }SpWin32TreeColumnViewAdapter >> cellStrings [ ^ cellStrings ]{ #category : 'accessing' }SpWin32TreeColumnViewAdapter >> cellImages [ ^ cellImages ]{ #category : 'accessing' }SpWin32TreeColumnViewAdapter >> visibleCellStrings [ ^ visibleCellStrings ]{ #category : 'accessing' }SpWin32TreeColumnViewAdapter >> visibleCellImages [ ^ visibleCellImages ]{ #category : 'refreshing' }SpWin32TreeColumnViewAdapter >> refreshTree [	self rebuildTreeSnapshots.	self rebuildVisibleProjection.	self configureAllOn: self widget]{ #category : 'refreshing' }SpWin32TreeColumnViewAdapter >> refreshList [ self refreshTree ]{ #category : 'refreshing' }SpWin32TreeColumnViewAdapter >> refreshWidgetList [ self refreshTree ]{ #category : 'refreshing' }SpWin32TreeColumnViewAdapter >> refreshColumns [	(sortColumnIndex notNil and: [ sortColumnIndex > self presenter columns size ]) ifTrue: [		sortColumnIndex := nil.		sortDescending := false ].	self refreshTree]{ #category : 'refreshing' }SpWin32TreeColumnViewAdapter >> refreshVisibleProjection [	self rebuildVisibleProjection.	self configureVisibleCellsOn: self widget]{ #category : 'refreshing' }SpWin32TreeColumnViewAdapter >> rootsChanged [	expandedPaths removeAll.	self refreshTree]{ #category : 'selection' }SpWin32TreeColumnViewAdapter >> refreshSelection [ self refreshSelectionOn: self widget ]{ #category : 'selection' }SpWin32TreeColumnViewAdapter >> refreshSelectionOn: control [	| selected path token |	control ifNil: [ ^ self ].	selected := self presenter selection selectedPaths.	path := selected ifEmpty: [ nil ] ifNotEmpty: [ selected last ].	token := path ifNil: [ 0 ] ifNotNil: [ self tokenForPath: path ].	control selectedToken: (token ifNil: [ 0 ])]{ #category : 'api - selection' }SpWin32TreeColumnViewAdapter >> selectedRowPresenter [	"Cells on this bounded native tree-grid path are snapshots, not realized presenter HWNDs."	^ nil]{ #category : 'api' }SpWin32TreeColumnViewAdapter >> expandPath: aPath [	| path |	path := aPath asArray.	(self tokenForPath: path) ifNotNil: [ :token |		expandedPaths add: path.		self widget token: token expanded: true.		self refreshVisibleProjection ]]{ #category : 'api' }SpWin32TreeColumnViewAdapter >> collapsePath: aPath [	| path |	path := aPath asArray.	(self tokenForPath: path) ifNotNil: [ :token |		expandedPaths remove: path ifAbsent: [ ].		self widget token: token expanded: false.		self refreshVisibleProjection ]]{ #category : 'api' }SpWin32TreeColumnViewAdapter >> expandRoots [	1 to: self presenter roots size do: [ :index | self expandPath: { index } ]]{ #category : 'api' }SpWin32TreeColumnViewAdapter >> expandAll [	paths do: [ :path | self expandPath: path ]]{ #category : 'api' }SpWin32TreeColumnViewAdapter >> collapseAll [	paths reversed do: [ :path | self collapsePath: path ]]{ #category : 'testing' }SpWin32TreeColumnViewAdapter >> isExpanded: aPath [	^ expandedPaths includes: aPath asArray]{ #category : 'scrolling' }SpWin32TreeColumnViewAdapter >> scrollToSelection [	| path token |	path := self presenter selection selectedPath.	(path isNil or: [ path isEmpty ]) ifTrue: [ ^ self ].	token := self tokenForPath: path.	token ifNotNil: [ self widget ensureVisibleToken: token ]]{ #category : 'native events' }SpWin32TreeColumnViewAdapter >> win32TreeSelectionChangedToken: token [	| path |	path := self pathForToken: token.	path ifNil: [ ^ self ].	self presenter selection selectedPath = path ifFalse: [ self presenter selectPath: path ].	self presenter isActiveOnSingleClick ifTrue: [ self presenter doActivateAtPath: path ]]{ #category : 'native events' }SpWin32TreeColumnViewAdapter >> win32TreeExpansionChangedToken: token expanded: expanded [	| path |	path := self pathForToken: token.	path ifNil: [ ^ self ].	expanded		ifTrue: [ expandedPaths add: path ]		ifFalse: [ expandedPaths remove: path ifAbsent: [ ] ].	self refreshVisibleProjection.	(Smalltalk at: #SpTreeExpansionChanged ifAbsent: [ nil ]) ifNotNil: [ :announcementClass |		self presenter announce: (announcementClass new			item: (self itemAtPath: path);			expanded: expanded;			yourself) ]]{ #category : 'native events' }SpWin32TreeColumnViewAdapter >> win32ActivatedAt: token source: source [	| path |	path := self pathForToken: token.	path ifNil: [ ^ self ].	(source = 2 or: [ self presenter isActiveOnDoubleClick ]) ifTrue: [		self presenter doActivateAtPath: path ]]{ #category : 'sorting' }SpWin32TreeColumnViewAdapter >> clickOnColumnHeaderAt: anIndex [	| column |	(anIndex between: 1 and: self presenter columns size) ifFalse: [ ^ self ].	column := self presenter columns at: anIndex.	column isSortable ifFalse: [ ^ self ].	sortColumnIndex = anIndex		ifTrue: [ sortDescending := sortDescending not ]		ifFalse: [ sortColumnIndex := anIndex. sortDescending := false ].	self refreshTree]{ #category : 'native events' }SpWin32TreeColumnViewAdapter >> win32ColumnClicked: anIndex [	self clickOnColumnHeaderAt: anIndex]{ #category : 'enumerating' }SpWin32TreeColumnViewAdapter >> traversePresentersDo: aBlock excluding: aSet [	cellPresenters do: [ :cell |		cell ifNotNil: [ cell traversePresentersDo: aBlock excluding: aSet ] ]]{ #category : 'protocol compatibility' }SpWin32TreeColumnViewAdapter >> alternateRowsColor [	"The native tree-grid fast path does not custom-draw alternate rows yet."]{ #category : 'protocol compatibility' }SpWin32TreeColumnViewAdapter >> updateMenu [ self updateActions ]