Class {	#name : 'SpWin32ToolbarPopoverButtonAdapter',	#superclass : 'SpWin32ToolbarBaseButtonAdapter',	#instVars : [		'activePopover'	],	#category : 'Spec-Win32-Adapters-Toolbar',	#package : 'Spec-Win32-Adapters',	#tag : 'Toolbar'}{ #category : 'factory' }SpWin32ToolbarPopoverButtonAdapter >> buildWidget [	| text iconData control |	text := self getLabelText.	iconData := self imageDataForCurrentMode.	control := SpWin32NativeControl		runtime: SpWin32Runtime default		kind: SpWin32Runtime controlButton		text: text		preferredExtent: (self preferredExtentForText: text iconData: iconData).	control		eventHandler: self;		imageData: iconData.	self presenter whenLabelChangedDo: [ self updateLabel ].	self presenter whenIconChangedDo: [ self updateIcon ].	^ control]{ #category : 'private' }SpWin32ToolbarPopoverButtonAdapter >> resolvedContentPresenter [	| content |	content := self presenter content.	content ifNil: [ ^ nil ].	(content isBlock or: [ content isMessageSend ]) ifTrue: [ ^ content value ].	^ content]{ #category : 'private' }SpWin32ToolbarPopoverButtonAdapter >> showPopover [	| content popover |	self presenter isEnabled ifFalse: [ ^ false ].	content := self resolvedContentPresenter.	content ifNil: [ ^ false ].	activePopover ifNotNil: [ :old | old dismiss ].	popover := self presenter newPopover.	popover		addStyle: 'popoverButton';		relativeTo: self presenter;		presenter: content.	activePopover := popover.	popover whenClosedDo: [ activePopover == popover ifTrue: [ activePopover := nil ] ].	popover popup.	^ true]{ #category : 'native events' }SpWin32ToolbarPopoverButtonAdapter >> win32Clicked [	self showPopover]{ #category : 'emulating' }SpWin32ToolbarPopoverButtonAdapter >> clicked [	self showPopover]{ #category : 'testing' }SpWin32ToolbarPopoverButtonAdapter >> activePopover [	^ activePopover]