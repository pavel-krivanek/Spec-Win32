Class {	#name : 'SpWin32ListViewAdapter',	#superclass : 'SpWin32AbstractModernListAdapter',	#category : 'Spec-Win32-Adapters-ListView',	#package : 'Spec-Win32-Adapters',	#tag : 'ListView'}{ #category : 'factory' }SpWin32ListViewAdapter >> buildWidget [	| control |	self rebuildRowSnapshots.	control := SpWin32NativeControl		runtime: SpWin32Runtime default		kind: SpWin32Runtime controlList		text: ''		preferredExtent: 220 @ 140.	control		eventHandler: self;		items: self displayStrings rowImages: self rowImages;		multipleSelection: self presenter selection isMultipleSelection;		headerText: (self presenter headerTitle ifNil: [ '' ]) visible: self presenter hasHeaderTitle;		selectedIndexes: self presenter selection selectedIndexes.	self presenter selection whenChangedDo: [ self refreshWidgetSelection ].	self presenter whenSelectionModeChangedDo: [ self refreshWidgetSelection ].	self presenter verticalAlignment whenChangedDo: [		self scrollToSelectionIfNeeded: self presenter verticalAlignment desiredVisibleRow ].	^ control]{ #category : 'accessing' }SpWin32ListViewAdapter >> elementAt: anIndex [	^ self presenter items at: anIndex ifAbsent: [ nil ]]{ #category : 'updating' }SpWin32ListViewAdapter >> refreshList [	self rebuildRowSnapshots.	self widget items: self displayStrings rowImages: self rowImages.	self widget		headerText: (self presenter headerTitle ifNil: [ '' ])		visible: self presenter hasHeaderTitle.	self refreshWidgetSelection]{ #category : 'updating' }SpWin32ListViewAdapter >> refreshWidgetList [	self refreshList]{ #category : 'updating' }SpWin32ListViewAdapter >> refreshWidgetSelection [	self widget multipleSelection: self presenter selection isMultipleSelection.	self widget selectedIndexes: self presenter selection selectedIndexes]{ #category : 'accessing' }SpWin32ListViewAdapter >> selectedIndexes [	^ self widget selectedIndexes]{ #category : 'api - selection' }SpWin32ListViewAdapter >> selectedRowPresenter [	"The Win32 text-row path snapshots the row presenter but does not realize it as an HWND.	 Returning nil is safer than exposing a non-display presenter as a popover anchor."	^ nil]{ #category : 'selecting' }SpWin32ListViewAdapter >> selectIndex: anInteger [	anInteger = 0 ifTrue: [		self presenter selection unselectAll.		^ self ].	(anInteger between: 1 and: self presenter items size) ifFalse: [		self presenter selection unselectAll.		^ self ].	self presenter selection isMultipleSelection		ifTrue: [ self presenter selection selectIndexes: (self presenter selection selectedIndexes copyWith: anInteger) ]		ifFalse: [ self presenter selection selectIndex: anInteger ]]{ #category : 'selecting' }SpWin32ListViewAdapter >> unselectAll [	self presenter selection unselectAll]{ #category : 'scrolling' }SpWin32ListViewAdapter >> scrollToIndex: anInteger [	self scrollToSelectionIfNeeded: anInteger]{ #category : 'private - scrolling' }SpWin32ListViewAdapter >> scrollToSelectionIfNeeded: anInteger [	(anInteger between: 1 and: self presenter items size) ifTrue: [		self widget ensureVisibleIndex: anInteger ]]{ #category : 'native events' }SpWin32ListViewAdapter >> win32ListSelectionChanged: indexes changedIndex: changedIndex selected: wasSelected [	self presenter selection selectedIndexes asArray = indexes asArray ifFalse: [		self presenter selection selectIndexes: indexes ].	(wasSelected and: [ self presenter isActiveOnSingleClick ]) ifTrue: [		self presenter doActivateAtIndex: changedIndex ]]{ #category : 'native events' }SpWin32ListViewAdapter >> win32ActivatedAt: anIndex source: sourceKind [	(sourceKind = 2 or: [ self presenter isActiveOnDoubleClick ]) ifTrue: [		self presenter doActivateAtIndex: anIndex ]]{ #category : 'protocol compatibility' }SpWin32ListViewAdapter >> alternateRowsColor [	"Native alternate-row custom drawing is not part of the first modern ListView slice."]{ #category : 'protocol compatibility' }SpWin32ListViewAdapter >> autoDeselect: aBoolean [	"SysListView32 keeps standard Windows selection semantics."]{ #category : 'protocol compatibility' }SpWin32ListViewAdapter >> updateMenu [	self updateActions]