Class {	#name : 'SpWin32MenuBuilder',	#superclass : 'Object',	#instVars : [		'presenter'	],	#category : 'Spec-Win32-Adapters-Menu',	#package : 'Spec-Win32-Adapters',	#tag : 'Menu'}{ #category : 'instance creation' }SpWin32MenuBuilder class >> for: aPresenter [	^ self new		presenter: aPresenter;		yourself]{ #category : 'accessing' }SpWin32MenuBuilder >> presenter: aPresenter [ presenter := aPresenter ]{ #category : 'private' }SpWin32MenuBuilder >> resolve: aValue for: aModel [	aValue ifNil: [ ^ nil ].	((aValue isBlock) or: [ aValue isMessageSend ]) ifTrue: [ ^ aValue cull: aModel ].	^ aValue]{ #category : 'private' }SpWin32MenuBuilder >> localizedLabel: aValue for: aModel [	| value |	value := self resolve: aValue for: aModel.	value ifNil: [ ^ '' ].	(value respondsTo: #localizedForPresenter:) ifTrue: [		value := value localizedForPresenter: presenter ].	^ value asString copyReplaceAll: '&' with: '&&']{ #category : 'private' }SpWin32MenuBuilder >> shortcutTextFor: aShortcut [	| shortcut |	shortcut := self resolve: aShortcut for: presenter.	shortcut ifNil: [ ^ '' ].	[ ^ KMShortcutPrinter toString: shortcut asKeyCombination ]		on: Error		do: [ :error | ^ shortcut asString ]]{ #category : 'private' }SpWin32MenuBuilder >> label: aLabel shortcut: aShortcut [	| shortcutText |	shortcutText := self shortcutTextFor: aShortcut.	shortcutText isEmpty ifTrue: [ ^ aLabel ].	^ aLabel , String tab , shortcutText]{ #category : 'building - presenters' }SpWin32MenuBuilder >> entriesForMenuPresenter: aMenuPresenter [	| result groups |	result := OrderedCollection new.	groups := aMenuPresenter menuGroups reject: [ :each | each isEmpty ].	groups do: [ :group |		result ifNotEmpty: [ result add: SpWin32MenuEntry separator ].		group menuItems do: [ :item |			result add: (self entryForMenuItemPresenter: item) ] ].	^ result asArray]{ #category : 'building - presenters' }SpWin32MenuBuilder >> entryForMenuItemPresenter: anItem [	| entry enabledValue stateValue iconValue subMenu |	entry := SpWin32MenuEntry new.	entry		source: anItem;		label: (self			label: (self localizedLabel: anItem name for: anItem)			shortcut: anItem shortcut).	enabledValue := self resolve: anItem isEnabled for: anItem.	entry enabled: enabledValue ~= false.	stateValue := self resolve: anItem state for: anItem.	entry checked: stateValue = true.	iconValue := self resolve: anItem icon for: anItem.	entry iconData: (SpWin32ImageData fromForm: iconValue).	subMenu := self resolve: anItem subMenu for: anItem.	subMenu		ifNil: [ entry action: [ anItem performMenuActionWith: anItem ] ]		ifNotNil: [ entry children: (self entriesForMenuPresenter: subMenu) ].	^ entry]{ #category : 'building - actions' }SpWin32MenuBuilder >> entriesForActionGroup: anActionGroup [	| group result |	anActionGroup ifNil: [ ^ #() ].	group := self resolvedActionGroup: anActionGroup.	result := OrderedCollection new.	self appendActionGroup: group to: result root: true.	^ result asArray]{ #category : 'building - actions' }SpWin32MenuBuilder >> resolvedActionGroup: aGroup [	(aGroup isKindOf: SpDynamicActionGroup) ifFalse: [ ^ aGroup ].	^ SpActionGroup new		in: [ :resolved | aGroup dynamicBuilder value: resolved ];		yourself]{ #category : 'building - actions' }SpWin32MenuBuilder >> appendActionGroup: aGroup to: result root: isRoot [	| group entries |	group := self resolvedActionGroup: aGroup.	entries := group entries.	entries do: [ :each |		(each isKindOf: SpAction)			ifTrue: [ each isVisible ifTrue: [ result add: (self entryForAction: each) ] ]			ifFalse: [				(each respondsTo: #entries) ifTrue: [					(each isKindOf: SpDynamicActionGroup)						ifTrue: [ | dynamicEntries |							dynamicEntries := self entriesForActionGroup: each.							result addAll: dynamicEntries ]						ifFalse: [ (self actionGroupShouldBeSubmenu: each)						ifTrue: [ | child |							child := SpWin32MenuEntry new								source: each;								label: (self localizedLabel: each name for: each);								enabled: true;								children: (self entriesForActionGroup: each);								yourself.							child children ifNotEmpty: [ result add: child ] ]						ifFalse: [ | nested |							nested := self entriesForActionGroup: each.							nested ifNotEmpty: [								result ifNotEmpty: [ result add: SpWin32MenuEntry separator ].								result addAll: nested ] ] ] ] ] ]]{ #category : 'private - actions' }SpWin32MenuBuilder >> actionGroupShouldBeSubmenu: aGroup [	| strategyName |	(aGroup respondsTo: #displayStrategy) ifFalse: [ ^ false ].	strategyName := aGroup displayStrategy class name asString.	^ strategyName includesSubstring: 'SubMenu']{ #category : 'building - actions' }SpWin32MenuBuilder >> entryForAction: anAction [	| entry label icon |	entry := SpWin32MenuEntry new.	label := anAction dynamicName ifNil: [ anAction name ifNil: [ '' ] ].	entry		source: anAction;		label: (self			label: (self localizedLabel: label for: anAction)			shortcut: (anAction hasShortcutKey ifTrue: [ anAction shortcutKey ] ifFalse: [ nil ]));		enabled: anAction canBeExecuted;		checked: (anAction hasState and: [ anAction state = true ]).	icon := [ anAction icon ] on: Error do: [ :error | nil ].	entry iconData: (SpWin32ImageData fromForm: icon).	entry action: [		anAction canBeExecuted ifTrue: [			anAction hasState ifTrue: [ anAction toggleState ].			anAction execute ] ].	^ entry]