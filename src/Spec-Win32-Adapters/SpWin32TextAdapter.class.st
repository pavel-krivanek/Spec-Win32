Class {	#name : 'SpWin32TextAdapter',	#superclass : 'SpWin32TextInputFieldAdapter',	#category : 'Spec-Win32-Adapters-Controls',	#package : 'Spec-Win32-Adapters',	#tag : 'Controls'}{ #category : 'factory' }SpWin32TextAdapter >> buildWidget [	| control |	control := SpWin32NativeControl		runtime: SpWin32Runtime default		kind: self nativeControlKind		text: self presenter text		preferredExtent: self preferredTextExtent.	control		eventHandler: self;		editable: self presenter isEditable;		placeholder: self getPlaceholderText;		configureTextWrapWord: self presenter isWrapWord			scrollBars: self presenter hasScrollBars			undoEnabled: self presenter hasUndoRedoHistory.	self presenter whenPlaceholderChangedDo: [ :text | control placeholder: (text ifNil: [ '' ]) ].	self presenter whenEditableChangedDo: [ :value | control editable: value ].	self presenter whenWrapWordChangedDo: [ :value |		control			configureTextWrapWord: value			scrollBars: self presenter hasScrollBars			undoEnabled: self presenter hasUndoRedoHistory ].	selection := self normalizedSelection: self presenter selectionInterval.	self applySelection: selection to: control.	^ control]{ #category : 'factory' }SpWin32TextAdapter >> nativeControlKind [	^ SpWin32Runtime controlTextArea]{ #category : 'factory' }SpWin32TextAdapter >> preferredTextExtent [	| text lines width height |	text := self presenter text ifNil: [ '' ].	lines := text lines ifEmpty: [ { '' } ].	width := 320.	height := 160.	self presenter isPropagateNaturalWidth ifTrue: [		width := ((lines collect: #size) max * 8 + 24) max: 80 ].	self presenter isPropagateNaturalHeight ifTrue: [		height := (lines size * 18 + 18) max: 28 ].	^ width @ height]{ #category : 'testing' }SpWin32TextAdapter >> backendIncludesEditionMenu [	^ true]{ #category : 'api' }SpWin32TextAdapter >> appendText: aString [	self cursorPositionIndex: self getText size + 1.	self replaceCurrentSelectionWith: aString]{ #category : 'api' }SpWin32TextAdapter >> insert: aString at: positionIndex [	self cursorPositionIndex: positionIndex.	self replaceCurrentSelectionWith: aString]{ #category : 'private' }SpWin32TextAdapter >> replaceCurrentSelectionWith: aString [	self presenter isEditable ifFalse: [ ^ self ].	self widget isValid		ifTrue: [			self widget replaceSelectionWith: aString.			self presenter acceptText: self widget text ]		ifFalse: [			| current interval start finish updated |			current := self getText.			interval := self selection.			start := interval first max: 1.			finish := interval isEmpty ifTrue: [ start - 1 ] ifFalse: [ interval last ].			updated := (current copyFrom: 1 to: start - 1), aString,				(current copyFrom: finish + 1 to: current size).			self widget text: updated.			self presenter acceptText: updated.			self cursorPositionIndex: start + aString size ]]{ #category : 'selection' }SpWin32TextAdapter >> selectLine [	| text caret start finish |	text := self getText.	caret := self cursorPositionIndex.	start := caret.	[ start > 1 and: [ (text at: start - 1) ~= Character lf ] ] whileTrue: [ start := start - 1 ].	finish := caret min: text size.	[ finish < text size and: [ (text at: finish + 1) ~= Character lf ] ] whileTrue: [ finish := finish + 1 ].	(finish >= start and: [ finish > 0 ])		ifTrue: [ self presenter selectionInterval: (start to: finish). self setSelectionFromModel: (start to: finish) ]		ifFalse: [ self presenter selectionInterval: (1 to: 0). self setSelectionFromModel: (1 to: 0) ]]{ #category : 'api' }SpWin32TextAdapter >> lineAtCursorPosition [	| text caret start finish |	text := self getText.	text isEmpty ifTrue: [ ^ '' ].	caret := (self cursorPositionIndex max: 1) min: text size + 1.	start := caret min: text size.	[ start > 1 and: [ (text at: start - 1) ~= Character lf ] ] whileTrue: [ start := start - 1 ].	finish := (caret min: text size).	[ finish < text size and: [ (text at: finish + 1) ~= Character lf ] ] whileTrue: [ finish := finish + 1 ].	^ text copyFrom: start to: finish]{ #category : 'api' }SpWin32TextAdapter >> cursorPosition [	| text index row lineStart |	text := self getText.	index := (self cursorPositionIndex max: 1) min: text size + 1.	row := 1.	lineStart := 1.	1 to: index - 1 do: [ :each |		(text at: each) = Character lf ifTrue: [ row := row + 1. lineStart := each + 1 ] ].	^ (index - lineStart + 1) @ row]{ #category : 'initialization' }SpWin32TextAdapter >> setScrollValue: aPoint [	self widget scrollToTextLine: aPoint y]{ #category : 'commands' }SpWin32TextAdapter >> copyText [	self widget performTextCommand: SpWin32Runtime textCommandCopy]{ #category : 'commands' }SpWin32TextAdapter >> cutText [	self presenter isEditable ifFalse: [ ^ self ].	self widget performTextCommand: SpWin32Runtime textCommandCut.	self syncPresenterTextFromNative]{ #category : 'commands' }SpWin32TextAdapter >> pasteText [	self presenter isEditable ifFalse: [ ^ self ].	self widget performTextCommand: SpWin32Runtime textCommandPaste.	self syncPresenterTextFromNative]{ #category : 'commands' }SpWin32TextAdapter >> selectAndPasteText [	self pasteText]{ #category : 'commands' }SpWin32TextAdapter >> clearUndoManager [	self widget performTextCommand: SpWin32Runtime textCommandClearUndo]{ #category : 'commands' }SpWin32TextAdapter >> undoText [	self presenter isEditable ifFalse: [ ^ self ].	self widget performTextCommand: SpWin32Runtime textCommandUndo.	self syncPresenterTextFromNative]{ #category : 'commands' }SpWin32TextAdapter >> findText [	"Native find UI belongs to a richer editor layer; keep the edition command harmless."	^ self]{ #category : 'commands' }SpWin32TextAdapter >> findNextText [	^ self]{ #category : 'private' }SpWin32TextAdapter >> syncPresenterTextFromNative [	self widget isValid ifTrue: [		self widget refreshTextFromNative.		self presenter acceptText: self widget text ]]{ #category : 'emulating' }SpWin32TextAdapter >> typeByChar: aString [	self presenter isEditable ifFalse: [ ^ self ].	aString do: [ :each | self replaceCurrentSelectionWith: each asString ]]