Class {	#name : 'SpWin32NumberInputFieldAdapter',	#superclass : 'SpWin32TextInputFieldAdapter',	#category : 'Spec-Win32-Adapters-Controls',	#package : 'Spec-Win32-Adapters',	#tag : 'Controls'}{ #category : 'factory' }SpWin32NumberInputFieldAdapter >> nativeControlKind [	^ SpWin32Runtime controlNumberInput]{ #category : 'private - numbers' }SpWin32NumberInputFieldAdapter >> numericValueFrom: aString [	| normalized |	normalized := (aString ifNil: [ '' ]) copyReplaceAll: ',' with: '.'.	^ Number readFrom: normalized ifFail: [ 0 ]]{ #category : 'private - numbers' }SpWin32NumberInputFieldAdapter >> valueInBounds: aNumber [	| value |	value := aNumber.	self presenter minimum ifNotNil: [ :minimum | value := value max: minimum ].	self presenter maximum ifNotNil: [ :maximum | value := value min: maximum ].	^ value]{ #category : 'private - numbers' }SpWin32NumberInputFieldAdapter >> formattedNumber: aNumber [	^ self presenter isInteger		ifTrue: [ aNumber rounded asString ]		ifFalse: [ aNumber asFloat printShowingDecimalPlaces: self presenter digits ]]{ #category : 'private - numbers' }SpWin32NumberInputFieldAdapter >> normalizedNumberText [	^ self formattedNumber: (self valueInBounds: (self numericValueFrom: self getText))]{ #category : 'native events' }SpWin32NumberInputFieldAdapter >> win32NumberStep: direction [	| current delta value |	current := self numericValueFrom: self getText.	delta := self presenter climbRate ifNil: [ self presenter class defaultClimbRate ].	value := self valueInBounds: current + (delta * direction sign).	self text: (self formattedNumber: value)]{ #category : 'native events' }SpWin32NumberInputFieldAdapter >> win32FocusLost [	self text: self normalizedNumberText.	super win32FocusLost]{ #category : 'emulating' }SpWin32NumberInputFieldAdapter >> increase [	self win32NumberStep: 1]{ #category : 'emulating' }SpWin32NumberInputFieldAdapter >> decrease [	self win32NumberStep: -1]