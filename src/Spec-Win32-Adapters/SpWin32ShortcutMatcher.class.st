Class {	#name : 'SpWin32ShortcutMatcher',	#superclass : 'Object',	#category : 'Spec-Win32-Adapters-Actions',	#package : 'Spec-Win32-Adapters',	#tag : 'Actions'}{ #category : 'matching' }SpWin32ShortcutMatcher >> matches: aShortcut event: aKeyEvent [	| matched |	matched := false.	aShortcut combinationsDo: [ :each |		matched ifFalse: [ matched := self matchesCombination: each event: aKeyEvent ] ].	^ matched]{ #category : 'matching' }SpWin32ShortcutMatcher >> matchesCombination: aCombination event: aKeyEvent [	(aCombination isKindOf: KMPlatformSpecificKeyCombination) ifTrue: [		^ aCombination platform = #Windows			and: [ self matchesCombination: aCombination shortcut event: aKeyEvent ] ].	(aCombination isKindOf: KMKeyCombinationSequence) ifTrue: [ ^ false ].	(aCombination isKindOf: KMModifiedKeyCombination) ifTrue: [		^ (self matchesModifier: aCombination modifier event: aKeyEvent)			and: [ self matchesKey: aCombination character event: aKeyEvent ] ].	(aCombination respondsTo: #key) ifTrue: [		^ (self hasNoModifiers: aKeyEvent)			and: [ self matchesKey: aCombination key event: aKeyEvent ] ].	^ false]{ #category : 'matching' }SpWin32ShortcutMatcher >> matchesKey: aKeyOrCombination event: aKeyEvent [	| keyboardKey |	keyboardKey := (aKeyOrCombination respondsTo: #key)		ifTrue: [ aKeyOrCombination key ]		ifFalse: [ aKeyOrCombination ].	^ keyboardKey = (self windowsKeyboardKeyFor: aKeyEvent keyValue)]{ #category : 'matching' }SpWin32ShortcutMatcher >> matchesModifier: aModifier event: aKeyEvent [	| identifier |	identifier := aModifier identifier asString.	^ (aKeyEvent controlPressed = (identifier includes: $c))		and: [ (aKeyEvent shiftPressed = (identifier includes: $s))		and: [ (aKeyEvent altPressed = (identifier includes: $a))		and: [ aKeyEvent metaPressed = (identifier includes: $k) ] ] ]]{ #category : 'matching' }SpWin32ShortcutMatcher >> hasNoModifiers: aKeyEvent [	^ aKeyEvent modifiers = 0]{ #category : 'private - matching' }SpWin32ShortcutMatcher >> windowsKeyboardKeyFor: virtualKey [	virtualKey = 16r0D ifTrue: [ ^ Character cr asKeyCombination key ].	virtualKey = 16r25 ifTrue: [ ^ KeyboardKey left ].	virtualKey = 16r26 ifTrue: [ ^ KeyboardKey up ].	virtualKey = 16r27 ifTrue: [ ^ KeyboardKey right ].	virtualKey = 16r28 ifTrue: [ ^ KeyboardKey down ].	^ KeyboardKey valueForWindowsPlatform: virtualKey]