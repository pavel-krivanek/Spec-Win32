Class {	#name : 'SpWin32ToolbarButtonAdapter',	#superclass : 'SpWin32ToolbarBaseButtonAdapter',	#category : 'Spec-Win32-Adapters-Toolbar',	#package : 'Spec-Win32-Adapters',	#tag : 'Toolbar'}{ #category : 'factory' }SpWin32ToolbarButtonAdapter >> buildWidget [	| text iconData control |	text := self getLabelText.	iconData := self imageDataForCurrentMode.	control := SpWin32NativeControl		runtime: SpWin32Runtime default		kind: SpWin32Runtime controlButton		text: text		preferredExtent: (self preferredExtentForText: text iconData: iconData).	control		eventHandler: self;		imageData: iconData.	self presenter whenLabelChangedDo: [ self updateLabel ].	self presenter whenIconChangedDo: [ self updateIcon ].	^ control]{ #category : 'emulating' }SpWin32ToolbarButtonAdapter >> clicked [	self win32Clicked]{ #category : 'native events' }SpWin32ToolbarButtonAdapter >> win32Clicked [	self presenter click]