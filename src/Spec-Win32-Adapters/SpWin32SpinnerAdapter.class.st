Class {	#name : 'SpWin32SpinnerAdapter',	#superclass : 'SpWin32AbstractAdapter',	#category : 'Spec-Win32-Adapters-Controls',	#package : 'Spec-Win32-Adapters',	#tag : 'Controls'}{ #category : 'factory' }SpWin32SpinnerAdapter >> buildWidget [	| control |	control := SpWin32NativeControl		runtime: SpWin32Runtime default		kind: SpWin32Runtime controlSpinner		text: ''		preferredExtent: 32 @ 32.	control eventHandler: self.	^ control]