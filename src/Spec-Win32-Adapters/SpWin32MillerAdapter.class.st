Class {	#name : 'SpWin32MillerAdapter',	#superclass : 'SpWin32LayoutAdapter',	#category : 'Spec-Win32-Adapters-Layout',	#package : 'Spec-Win32-Adapters',	#tag : 'Layout'}{ #category : 'accessing' }SpWin32MillerAdapter >> add: aPresenter [	self add: aPresenter constraints: SpLayoutConstraints new]{ #category : 'private' }SpWin32MillerAdapter >> add: aPresenter constraints: constraints [	| childWidget |	aPresenter owner: self model.	childWidget := aPresenter buildWithSelector: constraints spec.	widget addPage: childWidget constraints: constraints]{ #category : 'factory' }SpWin32MillerAdapter >> adapterWasBuilt []{ #category : 'accessing' }SpWin32MillerAdapter >> childrenWidgets [	^ widget children]{ #category : 'factory' }SpWin32MillerAdapter >> disableHScrollBar [	widget horizontalScrollBar: false]{ #category : 'factory' }SpWin32MillerAdapter >> enableHScrollBar [	widget horizontalScrollBar: true]{ #category : 'factory' }SpWin32MillerAdapter >> layout: aLayout [	layout := aLayout.	widget ifNil: [		widget := SpWin32MillerContainer			layout: aLayout			runtime: SpWin32Runtime default ].	self presenter		ifNil: [ widget horizontalScrollBar: true ]		ifNotNil: [ :aPresenter |			(aPresenter respondsTo: #hasHorizontalScrollBar)				ifTrue: [ widget horizontalScrollBar: aPresenter hasHorizontalScrollBar ].			(aPresenter respondsTo: #whenHorizontalScrollBarChangedDo:) ifTrue: [				aPresenter whenHorizontalScrollBarChangedDo: [ :show |					widget horizontalScrollBar: show ] ] ].	aLayout whenVisiblePagesChangedDo: [ widget visiblePagesChanged ].	aLayout whenChildrenAddedDo: [ :announcement |		self add: announcement child constraints: (aLayout constraintsFor: announcement child) ].	aLayout whenChildrenRemovedDo: [ :announcement |		announcement child adapter ifNotNil: [ :adapter |			widget removePageWidget: adapter widget ] ]]{ #category : 'accessing' }SpWin32MillerAdapter >> remove: aPresenter [	aPresenter adapter ifNotNil: [ :adapter |		widget removePageWidget: adapter widget ]]{ #category : 'accessing' }SpWin32MillerAdapter >> removeAll [	widget removeAllPages]{ #category : 'factory' }SpWin32MillerAdapter >> removeSubWidgets [	self removeAll]{ #category : 'paginator' }SpWin32MillerAdapter >> scrollByDeltaPercent: percent [	widget scrollByDeltaPercent: percent]{ #category : 'accessing' }SpWin32MillerAdapter >> selectPage: aNumber [	widget selectPage: aNumber]