Class {	#name : 'SpWin32ToolbarToggleButtonAdapter',	#superclass : 'SpWin32ToolbarBaseButtonAdapter',	#category : 'Spec-Win32-Adapters-Toolbar',	#package : 'Spec-Win32-Adapters',	#tag : 'Toolbar'}{ #category : 'factory' }SpWin32ToolbarToggleButtonAdapter >> buildWidget [	| text iconData control |	text := self getLabelText.	iconData := self imageDataForCurrentMode.	control := SpWin32NativeControl		runtime: SpWin32Runtime default		kind: SpWin32Runtime controlToggleButton		text: text		preferredExtent: (self preferredExtentForText: text iconData: iconData).	control		eventHandler: self;		checked: self presenter state;		imageData: iconData.	self presenter whenLabelChangedDo: [ self updateLabel ].	self presenter whenIconChangedDo: [ self updateIcon ].	self presenter whenToggledDo: [ self updateState ].	^ control]{ #category : 'emulating' }SpWin32ToolbarToggleButtonAdapter >> clicked [	self win32Toggled: self presenter state not]{ #category : 'private - updating' }SpWin32ToolbarToggleButtonAdapter >> updateState [	self widget checked: self presenter state]{ #category : 'native events' }SpWin32ToolbarToggleButtonAdapter >> win32Toggled: aBoolean [	aBoolean ifTrue: [		self presenter associatedToggleButtons do: [ :each | each state: false ] ].	self presenter execute: aBoolean]