Class {	#name : 'SpWin32DropListAdapter',	#superclass : 'SpWin32AbstractAdapter',	#category : 'Spec-Win32-Adapters-Controls',	#package : 'Spec-Win32-Adapters',	#tag : 'Controls'}{ #category : 'factory' }SpWin32DropListAdapter >> buildWidget [	| strings control |	strings := self displayStrings.	control := SpWin32NativeControl		runtime: SpWin32Runtime default		kind: SpWin32Runtime controlDropList		text: ''		preferredExtent: (self estimatedPreferredExtentFor: strings).	control		eventHandler: self;		items: strings;		selectedIndex: self presenter selectedIndex.	self presenter model whenChangedDo: [ self modelChangedOnPresenter ].	self presenter selection whenChangedDo: [ self selectionChangedOnPresenter ].	^ control]{ #category : 'private' }SpWin32DropListAdapter >> displayStrings [	^ self presenter getList collect: [ :item |		(self presenter displayForItem: item) asString ]]{ #category : 'accessing' }SpWin32DropListAdapter >> displayedIcon [	^ nil]{ #category : 'accessing' }SpWin32DropListAdapter >> elementAt: index [	^ self presenter getList at: index]{ #category : 'private' }SpWin32DropListAdapter >> estimatedPreferredExtentFor: strings [	| maximumLength |	maximumLength := strings		ifEmpty: [ 0 ]		ifNotEmpty: [ (strings collect: #size) max ].	^ (((maximumLength * 7) + 32) max: 80) @ 24]{ #category : 'private - updating' }SpWin32DropListAdapter >> modelChangedOnPresenter [	| strings |	strings := self displayStrings.	self widget items: strings.	self widget selectedIndex: self presenter selectedIndex.	self widget isValid ifFalse: [		self widget preferredExtent: (self estimatedPreferredExtentFor: strings) ]]{ #category : 'accessing' }SpWin32DropListAdapter >> selectIndex: anInteger [	self win32SelectionChanged: anInteger]{ #category : 'accessing' }SpWin32DropListAdapter >> selectedIndexes [	| index |	index := self presenter selectedIndex.	^ index = 0 ifTrue: [ #() ] ifFalse: [ { index } ]]{ #category : 'private - updating' }SpWin32DropListAdapter >> selectionChangedOnPresenter [	self widget selectedIndex: self presenter selectedIndex]{ #category : 'accessing' }SpWin32DropListAdapter >> styleName: aString [	"Kept for compatibility with tool/drop-list styling; native styling comes later."]{ #category : 'native events' }SpWin32DropListAdapter >> win32SelectionChanged: anInteger [	self presenter selectedIndex = anInteger ifTrue: [ ^ self ].	anInteger = 0		ifTrue: [ self presenter resetSelection ]		ifFalse: [ self presenter selectIndex: anInteger ]]