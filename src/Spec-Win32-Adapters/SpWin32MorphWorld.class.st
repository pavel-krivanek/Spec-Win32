Class {	#name : 'SpWin32MorphWorld',	#superclass : 'WorldMorph',	#instVars : [		'damageAction'	],	#category : 'Spec-Win32-Adapters-Morphic',	#package : 'Spec-Win32-Adapters',	#tag : 'Morphic'}{ #category : 'initialization' }SpWin32MorphWorld >> initialize [	super initialize.	self color: Color transparent]{ #category : 'accessing' }SpWin32MorphWorld >> damageAction: aBlock [	damageAction := aBlock]{ #category : 'geometry' }SpWin32MorphWorld >> invalidRect: aRectangle from: aMorph [	super invalidRect: aRectangle from: aMorph.	damageAction ifNotNil: [ :action | action cull: aRectangle ]]