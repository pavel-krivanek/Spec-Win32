Class {	#name : 'SpWin32DiffContainer',	#superclass : 'SpWin32LayoutContainer',	#category : 'Spec-Win32-Adapters-Code',	#package : 'Spec-Win32-Adapters',	#tag : 'Code'}{ #category : 'geometry' }SpWin32DiffContainer >> layoutIn: aRectangle collect: placements [	| visibleEntries count spacing available slotWidth cursor remainder |	lastExtent := aRectangle extent.	visibleEntries := children select: [ :entry |		| child |		child := entry first.		(child respondsTo: #isVisible)			ifTrue: [ child isVisible ]			ifFalse: [ true ] ].	visibleEntries ifEmpty: [ ^ self ].	count := visibleEntries size.	spacing := count > 1 ifTrue: [ 1 ] ifFalse: [ 0 ].	available := (aRectangle width - (spacing * (count - 1))) max: 0.	slotWidth := available // count.	remainder := available - (slotWidth * count).	cursor := aRectangle left.	visibleEntries withIndexDo: [ :entry :index |		| child width bounds |		child := entry first.		width := slotWidth + (index <= remainder ifTrue: [ 1 ] ifFalse: [ 0 ]).		bounds := cursor @ aRectangle top extent: (width max: 1) @ (aRectangle height max: 1).		(child respondsTo: #layoutIn:collect:)			ifTrue: [ child layoutIn: bounds collect: placements ]			ifFalse: [ placements add: { child. bounds left. bounds top. bounds width. bounds height } ].		cursor := cursor + width + spacing ]]{ #category : 'accessing' }SpWin32DiffContainer >> preferredExtent [	| visibleEntries width height |	visibleEntries := children select: [ :entry |		| child |		child := entry first.		(child respondsTo: #isVisible)			ifTrue: [ child isVisible ]			ifFalse: [ true ] ].	visibleEntries ifEmpty: [ ^ 0 @ 0 ].	width := 0.	height := 0.	visibleEntries do: [ :entry |		| extent |		extent := entry first preferredExtent.		width := width + extent x.		height := height max: extent y ].	visibleEntries size > 1 ifTrue: [ width := width + visibleEntries size - 1 ].	^ width @ height]{ #category : 'geometry' }SpWin32DiffContainer >> refreshPreferredExtentsIn: aNativeWindow [	"Diff panes have an explicit editor extent. Avoid asking the native window to measure	RichEdit controls before their HWNDs are realized; the normal layout pass will realize	them directly at the available pane extent."	^ self]