Class {	#name : 'SpWin32SliderAdapter',	#superclass : 'SpWin32AbstractAdapter',	#category : 'Spec-Win32-Adapters-Controls',	#package : 'Spec-Win32-Adapters',	#tag : 'Controls'}{ #category : 'factory' }SpWin32SliderAdapter >> buildWidget [	| kind extent control |	kind := self presenter isHorizontal		ifTrue: [ SpWin32Runtime controlSliderHorizontal ]		ifFalse: [ SpWin32Runtime controlSliderVertical ].	extent := self presenter isHorizontal		ifTrue: [ 160 @ 32 ]		ifFalse: [ 32 @ 160 ].	control := SpWin32NativeControl		runtime: SpWin32Runtime default		kind: kind		text: ''		preferredExtent: extent.	control		eventHandler: self;		normalizedValue: self presenter absoluteValue.	self presenter whenAbsoluteValueChangedDo: [ :newValue |		control normalizedValue: newValue ].	^ control]{ #category : 'private' }SpWin32SliderAdapter >> valueForAbsoluteValue: anAbsoluteValue [	| raw quantum |	raw := self presenter min		+ (((anAbsoluteValue asFloat max: 0.0) min: 1.0)			* (self presenter max - self presenter min)).	quantum := self presenter quantum.	^ quantum		ifNil: [ raw ]		ifNotNil: [ raw roundTo: quantum ]]{ #category : 'debug' }SpWin32SliderAdapter >> widgetAbsoluteValue [	^ self widget normalizedValue]{ #category : 'debug' }SpWin32SliderAdapter >> widgetLabel [	^ self presenter label]{ #category : 'debug' }SpWin32SliderAdapter >> widgetValue [	^ self valueForAbsoluteValue: self widget normalizedValue]{ #category : 'debug' }SpWin32SliderAdapter >> widgetValue: aNumber [	| absolute |	absolute := self presenter valueToAbsoluteValue: aNumber.	self widget normalizedValue: absolute.	self win32ValueChanged: absolute]{ #category : 'native events' }SpWin32SliderAdapter >> win32ValueChanged: anAbsoluteValue [	| normalized |	normalized := (anAbsoluteValue asFloat max: 0.0) min: 1.0.	self widget normalizedValue = normalized ifFalse: [		self widget normalizedValue: normalized ].	self presenter value: (self valueForAbsoluteValue: normalized)]