Class {	#name : 'SpWin32MenuAdapter',	#superclass : 'SpWin32AbstractAdapter',	#category : 'Spec-Win32-Adapters-Menu',	#package : 'Spec-Win32-Adapters',	#tag : 'Menu'}{ #category : 'instance creation' }SpWin32MenuAdapter class >> adaptAsPopup: aPresenter [	^ self adapt: aPresenter]{ #category : 'factory' }SpWin32MenuAdapter >> buildWidget [	^ SpWin32MenuEntry new]{ #category : 'private' }SpWin32MenuAdapter >> nativeOwnerObject [	| window |	[ window := self presenter window ] on: Error do: [ :error | ^ nil ].	window ifNil: [ ^ nil ].	window adapter ifNil: [ ^ nil ].	^ window adapter widget]{ #category : 'private' }SpWin32MenuAdapter >> currentEntries [	^ (SpWin32MenuBuilder for: self presenter)		entriesForMenuPresenter: self presenter]{ #category : 'protocol' }SpWin32MenuAdapter >> openAt: aPoint [	self showEntries: self currentEntries at: aPoint]{ #category : 'protocol' }SpWin32MenuAdapter >> openAtPointer [	self openAt: SpWin32Runtime default cursorPosition]{ #category : 'private' }SpWin32MenuAdapter >> showEntries: entries at: aPoint [	| selected |	entries ifEmpty: [ ^ false ].	selected := SpWin32Runtime default		showPopupMenuEntries: entries		owner: self nativeOwnerObject		at: aPoint.	selected ifNil: [ ^ false ].	selected execute.	^ true]