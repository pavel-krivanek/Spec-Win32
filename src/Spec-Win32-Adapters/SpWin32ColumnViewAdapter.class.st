Class {	#name : 'SpWin32ColumnViewAdapter',	#superclass : 'SpWin32AbstractModernListAdapter',	#instVars : [		'visibleItems',		'cellPresenters',		'cellStrings',		'cellImages',		'sortColumnIndex',		'sortDescending'	],	#category : 'Spec-Win32-Adapters-ListView',	#package : 'Spec-Win32-Adapters',	#tag : 'ListView'}{ #category : 'initialization' }SpWin32ColumnViewAdapter >> initialize [	super initialize.	visibleItems := #().	cellPresenters := #().	cellStrings := #().	cellImages := #().	sortColumnIndex := nil.	sortDescending := false]{ #category : 'factory' }SpWin32ColumnViewAdapter >> buildWidget [	| control |	self rebuildVisibleItems.	self rebuildCellSnapshots.	control := SpWin32NativeTableControl		runtime: SpWin32Runtime default		kind: SpWin32Runtime controlTable		text: ''		preferredExtent: 360 @ 180.	control		eventHandler: self;		items: visibleItems;		multipleSelection: self presenter selection isMultipleSelection.	self configureColumnsOn: control.	self configureCellsOn: control.	control selectedIndexes: self presenter selection selectedIndexes.	self presenter whenModelChangedDo: [ self refreshModel ].	self presenter whenColumnsChangedDo: [ self refreshColumns ].	self presenter whenIsResizableChangedDo: [ self refreshColumns ].	self presenter selection whenChangedDo: [ self refreshWidgetSelection ].	self presenter whenSelectionModeChangedDo: [ self refreshWidgetSelection ].	self presenter verticalAlignment whenChangedDo: [		self scrollToSelectionIfNeeded: self presenter verticalAlignment desiredVisibleRow ].	^ control]{ #category : 'private - model' }SpWin32ColumnViewAdapter >> rebuildVisibleItems [	visibleItems := self presenter items asArray.	sortColumnIndex ifNotNil: [ :index |		| column function |		(index between: 1 and: self presenter columns size) ifTrue: [			column := self presenter columns at: index.			column isSortable ifTrue: [				function := column sortFunction.				function ifNotNil: [					sortDescending ifTrue: [ function := function reversed ].					visibleItems := visibleItems sorted: function ] ] ] ]]{ #category : 'private - cells' }SpWin32ColumnViewAdapter >> rebuildCellSnapshots [	| presenters strings images |	presenters := OrderedCollection new.	strings := OrderedCollection new.	images := OrderedCollection new.	self presenter columns ifEmpty: [		visibleItems do: [ :item |			presenters add: nil.			strings add: item asString.			images add: nil ].		cellPresenters := presenters asArray.		cellStrings := strings asArray.		cellImages := images asArray.		^ self ].	visibleItems do: [ :item |		self presenter columns do: [ :column |			| cell |			cell := column setupAction cull: self presenter.			cell ifNil: [ self error: 'Win32 ColumnView setup block returned nil.' ].			column bindAction value: cell value: item.			presenters add: cell.			strings add: (self displayStringForRowPresenter: cell item: item).			images add: (self imageDataForRowPresenter: cell) ] ].	cellPresenters := presenters asArray.	cellStrings := strings asArray.	cellImages := images asArray]{ #category : 'accessing' }SpWin32ColumnViewAdapter >> elementAt: anIndex [	^ visibleItems at: anIndex ifAbsent: [ nil ]]{ #category : 'accessing' }SpWin32ColumnViewAdapter >> cellPresenters [ ^ cellPresenters ]{ #category : 'accessing' }SpWin32ColumnViewAdapter >> cellStrings [ ^ cellStrings ]{ #category : 'accessing' }SpWin32ColumnViewAdapter >> cellImages [ ^ cellImages ]{ #category : 'private - columns' }SpWin32ColumnViewAdapter >> effectiveColumnCount [	^ self presenter columns ifEmpty: [ 1 ] ifNotEmpty: [ :columns | columns size ]]{ #category : 'private - columns' }SpWin32ColumnViewAdapter >> columnTitles [	self presenter columns ifEmpty: [ ^ #('') ].	^ self presenter columns collect: [ :column | column title ifNil: [ '' ] ]]{ #category : 'private - columns' }SpWin32ColumnViewAdapter >> columnWidths [	self presenter columns ifEmpty: [ ^ #(200) ].	^ self presenter columns collect: [ :column | column width ifNil: [ 100 ] ]]{ #category : 'private - columns' }SpWin32ColumnViewAdapter >> columnExpandables [	self presenter columns ifEmpty: [ ^ #(true) ].	^ self presenter columns collect: [ :column | column isExpandable ]]{ #category : 'private - columns' }SpWin32ColumnViewAdapter >> configureColumnsOn: control [	control		columnsTitles: self columnTitles		widths: self columnWidths		alignments: (Array new: self effectiveColumnCount withAll: 0)		expandables: self columnExpandables		headersVisible: self presenter isShowingColumnHeaders		resizable: self presenter isResizable]{ #category : 'private - cells' }SpWin32ColumnViewAdapter >> configureCellsOn: control [	control		items: visibleItems;		cells: cellStrings		images: cellImages		rowCount: visibleItems size		columnCount: self effectiveColumnCount]{ #category : 'updating' }SpWin32ColumnViewAdapter >> refreshModel [	self rebuildVisibleItems.	self rebuildCellSnapshots.	self configureCellsOn: self widget.	self refreshWidgetSelection]{ #category : 'updating' }SpWin32ColumnViewAdapter >> refreshColumns [	(sortColumnIndex notNil and: [ sortColumnIndex > self presenter columns size ]) ifTrue: [		sortColumnIndex := nil.		sortDescending := false ].	self rebuildVisibleItems.	self rebuildCellSnapshots.	self configureColumnsOn: self widget.	self configureCellsOn: self widget.	self refreshWidgetSelection]{ #category : 'updating' }SpWin32ColumnViewAdapter >> refreshList [ self refreshModel ]{ #category : 'updating' }SpWin32ColumnViewAdapter >> refreshWidgetList [ self refreshModel ]{ #category : 'updating' }SpWin32ColumnViewAdapter >> refreshWidgetSelection [	self widget multipleSelection: self presenter selection isMultipleSelection.	self widget selectedIndexes: self presenter selection selectedIndexes]{ #category : 'accessing' }SpWin32ColumnViewAdapter >> selectedIndexes [ ^ self widget selectedIndexes ]{ #category : 'api - selection' }SpWin32ColumnViewAdapter >> selectedRowPresenter [	"Cell presenters on the native-item path are snapshots, not realized child HWNDs."	^ nil]{ #category : 'selecting' }SpWin32ColumnViewAdapter >> selectIndex: anInteger [	anInteger = 0 ifTrue: [ self presenter selection unselectAll. ^ self ].	(anInteger between: 1 and: visibleItems size) ifFalse: [ self presenter selection unselectAll. ^ self ].	self presenter selection isMultipleSelection		ifTrue: [ self presenter selection selectIndexes: (self presenter selection selectedIndexes copyWith: anInteger) ]		ifFalse: [ self presenter selection selectIndex: anInteger ]]{ #category : 'selecting' }SpWin32ColumnViewAdapter >> unselectAll [ self presenter selection unselectAll ]{ #category : 'scrolling' }SpWin32ColumnViewAdapter >> scrollToIndex: anInteger [ self scrollToSelectionIfNeeded: anInteger ]{ #category : 'private - scrolling' }SpWin32ColumnViewAdapter >> scrollToSelectionIfNeeded: anInteger [	(anInteger between: 1 and: visibleItems size) ifTrue: [ self widget ensureVisibleIndex: anInteger ]]{ #category : 'native events' }SpWin32ColumnViewAdapter >> win32ListSelectionChanged: indexes changedIndex: changedIndex selected: wasSelected [	self presenter selection selectedIndexes asArray = indexes asArray ifFalse: [		self presenter selection selectIndexes: indexes ].	(wasSelected and: [ self presenter isActiveOnSingleClick ]) ifTrue: [		self presenter doActivateAtIndex: changedIndex ]]{ #category : 'native events' }SpWin32ColumnViewAdapter >> win32ActivatedAt: anIndex source: sourceKind [	(sourceKind = 2 or: [ self presenter isActiveOnDoubleClick ]) ifTrue: [		self presenter doActivateAtIndex: anIndex ]]{ #category : 'sorting' }SpWin32ColumnViewAdapter >> clickOnColumnHeaderAt: anIndex [	| column selectedItems newIndexes |	(anIndex between: 1 and: self presenter columns size) ifFalse: [ ^ self ].	column := self presenter columns at: anIndex.	column isSortable ifFalse: [ ^ self ].	selectedItems := self presenter selection selectedItems.	sortColumnIndex = anIndex		ifTrue: [ sortDescending := sortDescending not ]		ifFalse: [ sortColumnIndex := anIndex. sortDescending := false ].	self rebuildVisibleItems.	self rebuildCellSnapshots.	self configureCellsOn: self widget.	newIndexes := (selectedItems collect: [ :each | visibleItems indexOf: each ]) reject: [ :each | each = 0 ].	self presenter selection selectIndexes: newIndexes]{ #category : 'native events' }SpWin32ColumnViewAdapter >> win32ColumnClicked: anIndex [ self clickOnColumnHeaderAt: anIndex ]{ #category : 'enumerating' }SpWin32ColumnViewAdapter >> traversePresentersDo: aBlock excluding: aSet [	cellPresenters do: [ :cell |		cell ifNotNil: [ cell traversePresentersDo: aBlock excluding: aSet ] ]]{ #category : 'protocol compatibility' }SpWin32ColumnViewAdapter >> alternateRowsColor [	"Native alternate-row custom drawing is not implemented yet."]{ #category : 'protocol compatibility' }SpWin32ColumnViewAdapter >> autoDeselect: aBoolean [	"SysListView32 keeps standard Windows selection semantics."]{ #category : 'protocol compatibility' }SpWin32ColumnViewAdapter >> updateMenu [ self updateActions ]