Class {	#name : 'SpWin32AbstractAdapter',	#superclass : 'SpAbstractAdapter',	#instVars : [		'focusReceivedEvents',		'focusLostEvents',		'keyDownEvents',		'keyUpEvents',		'mouseDownEvents',		'mouseUpEvents',		'mouseMoveEvents',		'mouseEnterEvents',		'mouseLeaveEvents',		'mouseDoubleClickEvents',		'actionManager'	],	#category : 'Spec-Win32-Adapters-Base',	#package : 'Spec-Win32-Adapters',	#tag : 'Base'}{ #category : 'accessing' }SpWin32AbstractAdapter class >> adaptingName [ ^ (self name withoutPrefix: 'SpWin32') asSymbol ]{ #category : 'accessing' }SpWin32AbstractAdapter class >> allAdapters [ ^ self allSubclasses ]{ #category : 'testing' }SpWin32AbstractAdapter class >> isAbstract [ ^ self == SpWin32AbstractAdapter ]{ #category : 'initialization' }SpWin32AbstractAdapter >> initialize [	super initialize.	focusReceivedEvents := OrderedCollection new.	focusLostEvents := OrderedCollection new.	keyDownEvents := OrderedCollection new.	keyUpEvents := OrderedCollection new.	mouseDownEvents := OrderedCollection new.	mouseUpEvents := OrderedCollection new.	mouseMoveEvents := OrderedCollection new.	mouseEnterEvents := OrderedCollection new.	mouseLeaveEvents := OrderedCollection new.	mouseDoubleClickEvents := OrderedCollection new]{ #category : 'initialization' }SpWin32AbstractAdapter >> adapt: aPresenter [	super adapt: aPresenter.	self widget ifNotNil: [ :nativeWidget |		(nativeWidget respondsTo: #enabled:) ifTrue: [ nativeWidget enabled: aPresenter isEnabled ].		(nativeWidget respondsTo: #visible:) ifTrue: [ nativeWidget visible: aPresenter isVisible ].		((aPresenter respondsTo: #help) and: [ nativeWidget respondsTo: #tooltipText: ]) ifTrue: [			nativeWidget tooltipText: self getHelpText ] ].	aPresenter whenVisibleChangedDo: [ :visible | self visible: visible ].	(aPresenter respondsTo: #whenEnabledChangedDo:) ifTrue: [		aPresenter whenEnabledChangedDo: [ self enabled: aPresenter isEnabled ] ].	(aPresenter respondsTo: #whenHelpChangedDo:) ifTrue: [		aPresenter whenHelpChangedDo: [ self updateHelp ] ].	(aPresenter respondsTo: #whenActionsChangedDo:) ifTrue: [		aPresenter whenActionsChangedDo: [ self updateActions ] ].	self addEventsTo: self widget.	self updateActions]{ #category : 'accessing' }SpWin32AbstractAdapter >> application [ ^ self presenter application ]{ #category : 'styling' }SpWin32AbstractAdapter >> applyStyle [ ]{ #category : 'styling' }SpWin32AbstractAdapter >> addStyle: aStyleName [	"Native Win32 styling is not yet mapped to Spec style classes. Accept dynamic	style changes so presenters that use styles as state markers can still update."]{ #category : 'styling' }SpWin32AbstractAdapter >> removeStyle: aStyleName [	"See #addStyle:. The presenter remains the source of truth for its styles."]{ #category : 'private' }SpWin32AbstractAdapter >> getHelpText [	(self presenter respondsTo: #help) ifFalse: [ ^ '' ].	^ self presenter help		ifNil: [ '' ]		ifNotNil: [ :aString | aString localizedForPresenter: self presenter ]]{ #category : 'accessing' }SpWin32AbstractAdapter >> helpText [	^ self widget		ifNil: [ self getHelpText ]		ifNotNil: [ :nativeWidget |			(nativeWidget respondsTo: #tooltipText)				ifTrue: [ nativeWidget tooltipText ]				ifFalse: [ self getHelpText ] ]]{ #category : 'updating' }SpWin32AbstractAdapter >> updateHelp [	self widgetDo: [ :nativeWidget |		(nativeWidget respondsTo: #tooltipText:) ifTrue: [			nativeWidget tooltipText: self getHelpText ] ]]{ #category : 'protocol' }SpWin32AbstractAdapter >> disable [ self presenter enabled: false ]{ #category : 'protocol' }SpWin32AbstractAdapter >> enable [ self presenter enabled: true ]{ #category : 'protocol' }SpWin32AbstractAdapter >> enabled [ ^ self presenter isEnabled ]{ #category : 'protocol' }SpWin32AbstractAdapter >> enabled: aBoolean [	self widgetDo: [ :w | (w respondsTo: #enabled:) ifTrue: [ w enabled: aBoolean ] ]]{ #category : 'visibility' }SpWin32AbstractAdapter >> isVisible [	^ self widget ifNil: [ false ] ifNotNil: [ :w | (w respondsTo: #isVisible) ifTrue: [ w isVisible ] ifFalse: [ true ] ]]{ #category : 'protocol' }SpWin32AbstractAdapter >> layout: aLayout [ ]{ #category : 'factory' }SpWin32AbstractAdapter >> takeKeyboardFocus [	self widgetDo: [ :w | (w respondsTo: #takeKeyboardFocus) ifTrue: [ w takeKeyboardFocus ] ]]{ #category : 'visibility' }SpWin32AbstractAdapter >> visible: aBoolean [	self widgetDo: [ :w | (w respondsTo: #visible:) ifTrue: [ w visible: aBoolean ] ]]{ #category : 'event installing' }SpWin32AbstractAdapter >> installEvent: anEvent [	self widgetDo: [ :nativeWidget |		anEvent installOn: self target: nativeWidget ]]{ #category : 'event installing' }SpWin32AbstractAdapter >> installFocusReceivedEvent: anEvent to: aWidget [	focusReceivedEvents add: anEvent]{ #category : 'event installing' }SpWin32AbstractAdapter >> installFocusLostEvent: anEvent to: aWidget [	focusLostEvents add: anEvent]{ #category : 'native events' }SpWin32AbstractAdapter >> win32FocusReceived [	focusReceivedEvents do: [ :event |		event action cull: event ]]{ #category : 'native events' }SpWin32AbstractAdapter >> win32FocusLost [	focusLostEvents do: [ :event |		event action cull: event ]]{ #category : 'testing' }SpWin32AbstractAdapter >> hasKeyboardFocus [	^ self widget		ifNil: [ false ]		ifNotNil: [ :nativeWidget |			(nativeWidget respondsTo: #hasKeyboardFocus)				ifTrue: [ nativeWidget hasKeyboardFocus ]				ifFalse: [ false ] ]]{ #category : 'event installing' }SpWin32AbstractAdapter >> installKeyDownEvent: anEvent to: aWidget [ keyDownEvents add: anEvent ]{ #category : 'event installing' }SpWin32AbstractAdapter >> installKeyUpEvent: anEvent to: aWidget [ keyUpEvents add: anEvent ]{ #category : 'event installing' }SpWin32AbstractAdapter >> installMouseDownEvent: anEvent to: aWidget [ mouseDownEvents add: anEvent ]{ #category : 'event installing' }SpWin32AbstractAdapter >> installMouseUpEvent: anEvent to: aWidget [ mouseUpEvents add: anEvent ]{ #category : 'event installing' }SpWin32AbstractAdapter >> installMouseMoveEvent: anEvent to: aWidget [ mouseMoveEvents add: anEvent ]{ #category : 'event installing' }SpWin32AbstractAdapter >> installMouseEnterEvent: anEvent to: aWidget [ mouseEnterEvents add: anEvent ]{ #category : 'event installing' }SpWin32AbstractAdapter >> installMouseLeaveEvent: anEvent to: aWidget [ mouseLeaveEvents add: anEvent ]{ #category : 'event installing' }SpWin32AbstractAdapter >> installMouseDoubleClickEvent: anEvent to: aWidget [ mouseDoubleClickEvents add: anEvent ]{ #category : 'native events' }SpWin32AbstractAdapter >> win32KeyDownValue: keyValue modifiers: modifiers [	| event |	event := SpWin32KeyEvent keyValue: keyValue modifiers: modifiers.	self dispatchDefinitions: keyDownEvents event: event.	event wasHandled ifFalse: [ self ensureActionManager handleKeyDown: event ]]{ #category : 'native events' }SpWin32AbstractAdapter >> win32KeyUpValue: keyValue modifiers: modifiers [	self dispatchDefinitions: keyUpEvents event: (SpWin32KeyEvent keyValue: keyValue modifiers: modifiers)]{ #category : 'native events' }SpWin32AbstractAdapter >> win32MouseEventType: eventType position: position button: button modifiers: modifiers [	| definitions event |	definitions := eventType = SpWin32Runtime eventMouseDown ifTrue: [ mouseDownEvents ] ifFalse: [		eventType = SpWin32Runtime eventMouseUp ifTrue: [ mouseUpEvents ] ifFalse: [		eventType = SpWin32Runtime eventMouseMove ifTrue: [ mouseMoveEvents ] ifFalse: [		eventType = SpWin32Runtime eventMouseEnter ifTrue: [ mouseEnterEvents ] ifFalse: [		eventType = SpWin32Runtime eventMouseLeave ifTrue: [ mouseLeaveEvents ] ifFalse: [ mouseDoubleClickEvents ] ] ] ] ].	event := SpWin32MouseEvent position: position button: button modifiers: modifiers.	self dispatchDefinitions: definitions event: event]{ #category : 'native events' }SpWin32AbstractAdapter >> dispatchDefinitions: definitions event: event [	definitions do: [ :definition |		[ definition action value: event ]			on: Error			fork: [ :error | error pass ] ]]{ #category : 'private - actions' }SpWin32AbstractAdapter >> actionManagerIfPresent [	^ actionManager]{ #category : 'private - actions' }SpWin32AbstractAdapter >> ensureActionManager [	^ actionManager ifNil: [ actionManager := SpWin32ActionManager on: self ]]{ #category : 'private - actions' }SpWin32AbstractAdapter >> hasActions [	^ ((self presenter respondsTo: #actions) and: [ self presenter actions isNotNil ])		or: [ (self presenter respondsTo: #internalActions) and: [ self presenter internalActions isNotNil ] ]]{ #category : 'private - actions' }SpWin32AbstractAdapter >> addActionGroup: anActionGroup [	self ensureActionManager addActionGroup: anActionGroup.	self updateActions]{ #category : 'updating' }SpWin32AbstractAdapter >> updateActions [	| manager hasMenu |	manager := actionManager.	(manager isNil and: [ self hasActions ]) ifTrue: [ manager := self ensureActionManager ].	hasMenu := manager notNil and: [ manager hasContextMenu ].	self widgetDo: [ :nativeWidget |		(nativeWidget respondsTo: #contextMenuEnabled:) ifTrue: [			nativeWidget contextMenuEnabled: hasMenu ] ].	^ self]{ #category : 'testing - actions' }SpWin32AbstractAdapter >> hasContextMenu [	^ actionManager notNil and: [ actionManager hasContextMenu ]]{ #category : 'native events' }SpWin32AbstractAdapter >> win32ContextMenuRequestedAt: aPoint [	self ensureActionManager showContextMenuAt: aPoint]