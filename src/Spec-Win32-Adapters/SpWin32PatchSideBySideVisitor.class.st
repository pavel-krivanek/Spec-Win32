Class {	#name : 'SpWin32PatchSideBySideVisitor',	#superclass : 'DiffVisitor',	#instVars : [		'leftSide',		'rightSide'	],	#category : 'Spec-Win32-Adapters-Code',	#package : 'Spec-Win32-Adapters',	#tag : 'Code'}{ #category : 'initialization' }SpWin32PatchSideBySideVisitor >> initialize [	super initialize.	leftSide := OrderedCollection new.	rightSide := OrderedCollection new]{ #category : 'accessing' }SpWin32PatchSideBySideVisitor >> leftSide [	^ leftSide]{ #category : 'accessing' }SpWin32PatchSideBySideVisitor >> rightSide [	^ rightSide]{ #category : 'accessing' }SpWin32PatchSideBySideVisitor >> leftText [	^ String lf join: (leftSide collect: #second)]{ #category : 'accessing' }SpWin32PatchSideBySideVisitor >> rightText [	^ String lf join: (rightSide collect: #second)]{ #category : 'accessing' }SpWin32PatchSideBySideVisitor >> leftMarks [	^ (leftSide reject: [ :each | each first isNil ])		collect: [ :each | each first ]]{ #category : 'accessing' }SpWin32PatchSideBySideVisitor >> rightMarks [	^ (rightSide reject: [ :each | each first isNil ])		collect: [ :each | each first ]]{ #category : 'visiting' }SpWin32PatchSideBySideVisitor >> visitDelete: anElement [	leftSide add: { (leftSide size + 1) -> #delete. anElement element }]{ #category : 'visiting' }SpWin32PatchSideBySideVisitor >> visitInsert: anElement [	rightSide add: { (rightSide size + 1) -> #insert. anElement element }]{ #category : 'visiting' }SpWin32PatchSideBySideVisitor >> visitMatch: anElement [	leftSide add: { nil. anElement element }.	rightSide add: { nil. anElement element }]