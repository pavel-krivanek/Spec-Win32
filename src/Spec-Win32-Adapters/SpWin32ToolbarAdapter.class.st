Class {	#name : 'SpWin32ToolbarAdapter',	#superclass : 'SpWin32AbstractAdapter',	#instVars : [		'itemWidgets'	],	#category : 'Spec-Win32-Adapters-Toolbar',	#package : 'Spec-Win32-Adapters',	#tag : 'Toolbar'}{ #category : 'factory' }SpWin32ToolbarAdapter >> buildWidget [	| toolbar |	itemWidgets := IdentityDictionary new.	toolbar := SpWin32ToolbarContainer runtime: SpWin32Runtime default.	self updateItemsIn: toolbar.	self presenter whenItemsChangeDo: [ self updateItems ].	self presenter		property: #displayMode		whenChangedDo: [ self updateDisplayMode ].	^ toolbar]{ #category : 'testing' }SpWin32ToolbarAdapter >> hasButtonWithLabel: aString [	^ self presenter items anySatisfy: [ :each |		(each respondsTo: #label) and: [ each label = aString ] ]]{ #category : 'testing' }SpWin32ToolbarAdapter >> numberOfItems [	^ self presenter items size]{ #category : 'private - building' }SpWin32ToolbarAdapter >> removeStaleWidgets [	| current stale |	current := self presenter items.	stale := itemWidgets keys select: [ :each |		(current identityIncludes: each) not ].	stale do: [ :each |		| nativeWidget |		nativeWidget := itemWidgets removeKey: each.		(nativeWidget respondsTo: #destroy) ifTrue: [ nativeWidget destroy ] ]]{ #category : 'private - building' }SpWin32ToolbarAdapter >> widgetForItem: anItem [	^ itemWidgets		at: anItem		ifAbsentPut: [ anItem build ]]{ #category : 'updating' }SpWin32ToolbarAdapter >> updateDisplayMode [	itemWidgets keysDo: [ :item |		item adapter ifNotNil: [ :adapter |			(adapter respondsTo: #updateDisplayMode) ifTrue: [ adapter updateDisplayMode ] ] ].	self widget ifNotNil: [ :toolbar | toolbar requestRelayout ]]{ #category : 'updating' }SpWin32ToolbarAdapter >> updateItems [	self widgetDo: [ :toolbar | self updateItemsIn: toolbar ]]{ #category : 'private - building' }SpWin32ToolbarAdapter >> updateItemsIn: toolbar [	| left right |	self removeStaleWidgets.	left := self presenter leftItems collect: [ :each | self widgetForItem: each ].	right := self presenter rightItems collect: [ :each | self widgetForItem: each ].	toolbar leftWidgets: left rightWidgets: right]