Class {	#name : 'SpWin32BoxAdapter',	#superclass : 'SpWin32LayoutAdapter',	#category : 'Spec-Win32-Adapters-Layout',	#package : 'Spec-Win32-Adapters',	#tag : 'Layout'}{ #category : 'accessing' }SpWin32BoxAdapter >> add: aPresenter constraints: constraints [	| childWidget |	aPresenter owner: self model.	childWidget := aPresenter buildWithSelector: constraints spec.	widget addChild: childWidget constraints: constraints]{ #category : 'factory' }SpWin32BoxAdapter >> adapterWasBuilt [ ]{ #category : 'factory' }SpWin32BoxAdapter >> layout: aLayout [	layout := aLayout.	widget ifNil: [ widget := SpWin32BoxContainer layout: aLayout runtime: SpWin32Runtime default ].	aLayout whenChildrenAddedDo: [ :announcement |		self add: announcement child constraints: (aLayout constraintsFor: announcement child) ].	aLayout whenChildrenRemovedDo: [ :announcement |		announcement child adapter ifNotNil: [ :adapter | widget removeChildWidget: adapter widget ] ]]{ #category : 'accessing' }SpWin32BoxAdapter >> removeAll [ widget removeAll ]{ #category : 'factory' }SpWin32BoxAdapter >> removeSubWidgets [ widget removeAll ]{ #category : 'accessing' }SpWin32BoxAdapter >> replace: aPresenter with: otherPresenter withConstraints: constraints [	| oldWidget newWidget |	oldWidget := aPresenter adapter widget.	otherPresenter owner: self model.	newWidget := otherPresenter buildWithSelector: constraints spec.	widget replaceChildWidget: oldWidget with: newWidget constraints: constraints]{ #category : 'updating' }SpWin32BoxAdapter >> updateBorderWidth [ widget relayout ]{ #category : 'updating' }SpWin32BoxAdapter >> updateSpacing [ widget relayout ]