Class {	#name : 'SpWin32DiffUnifiedAdapter',	#superclass : 'SpWin32DiffAdapter',	#category : 'Spec-Win32-Adapters-Code',	#package : 'Spec-Win32-Adapters',	#tag : 'Code'}{ #category : 'private - updating' }SpWin32DiffUnifiedAdapter >> refreshDiff [	| patch visitor |	(leftControl isNil or: [ rightControl isNil ]) ifTrue: [ ^ self ].	patch := DiffBuilder		buildPatchFrom: (self presenter leftText ifNil: [ '' ]) lines		to: (self presenter rightText ifNil: [ '' ]) lines.	visitor := SpWin32PatchLineVisitor new		visitPatch: patch;		yourself.	leftControl		text: (self presenter leftText ifNil: [ '' ]);		codeLineDecorations: #().	rightControl		text: visitor contents;		codeLineDecorations: (self lineDecorationEntriesFor: visitor lineMarks)]