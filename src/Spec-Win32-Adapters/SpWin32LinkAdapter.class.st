Class {	#name : 'SpWin32LinkAdapter',	#superclass : 'SpWin32AbstractAdapter',	#category : 'Spec-Win32-Adapters-Controls',	#package : 'Spec-Win32-Adapters',	#tag : 'Controls'}{ #category : 'factory' }SpWin32LinkAdapter >> buildWidget [	| text control |	text := self getLabelText.	control := SpWin32NativeControl		runtime: SpWin32Runtime default		kind: SpWin32Runtime controlLink		text: text		preferredExtent: ((((text size * 8) + 8) max: 12) @ 24).	control eventHandler: self.	self presenter whenLabelChangedDo: [ self updateLabel ].	^ control]{ #category : 'emulating' }SpWin32LinkAdapter >> clicked [	self win32Clicked]{ #category : 'private' }SpWin32LinkAdapter >> getLabelText [	^ (self presenter label ifNil: [ '' ]) localizedForPresenter: self presenter]{ #category : 'accessing' }SpWin32LinkAdapter >> label [	^ self getLabelText]{ #category : 'private - updating' }SpWin32LinkAdapter >> updateLabel [	| text |	text := self getLabelText.	self widget text: text.	self widget isValid ifFalse: [		self widget preferredExtent: ((((text size * 8) + 8) max: 12) @ 24) ]]{ #category : 'native events' }SpWin32LinkAdapter >> win32Clicked [	self presenter performAction]