Class {	#name : 'SpWin32BlockedDialogWindowAdapter',	#superclass : 'SpWin32DialogWindowAdapter',	#instVars : [		'blockedCompletion',		'blockedCompleted'	],	#category : 'Spec-Win32-Adapters-Windows',	#package : 'Spec-Win32-Adapters',	#tag : 'Windows'}{ #category : 'initialization' }SpWin32BlockedDialogWindowAdapter >> initialize [	super initialize.	blockedCompleted := false]{ #category : 'private - blocking' }SpWin32BlockedDialogWindowAdapter >> completeBlocked [	blockedCompleted ifTrue: [ ^ self ].	blockedCompleted := true.	blockedCompletion ifNotNil: [ blockedCompletion signal ]]{ #category : 'private - blocking' }SpWin32BlockedDialogWindowAdapter >> waitForBlockedCompletion [	| runtime |	runtime := SpWin32Runtime default.	runtime isEventPumpProcess		ifTrue: [ runtime pumpEventsWhile: [ blockedCompleted not ] ]		ifFalse: [ blockedCompletion wait ]]{ #category : 'protocol' }SpWin32BlockedDialogWindowAdapter >> openWithDeferredAction: aBlock [	blockedCompletion := Semaphore new.	blockedCompleted := false.	[		self presenter isCentered ifTrue: [ self centered ].		self widget show.		self activate.		self windowIsOpened.		aBlock value.		blockedCompleted ifFalse: [ self waitForBlockedCompletion ]	] ensure: [		blockedCompleted ifFalse: [ self completeBlocked ] ]]{ #category : 'updating' }SpWin32BlockedDialogWindowAdapter >> windowClosed [	self completeBlocked.	super windowClosed]