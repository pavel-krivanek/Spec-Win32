Class {	#name : 'SpWin32WindowAdapter',	#superclass : 'SpWin32AbstractAdapter',	#instVars : [		'contentWidget',		'menuAdapter',		'menuEntries'	],	#category : 'Spec-Win32-Adapters-Windows',	#package : 'Spec-Win32-Adapters',	#tag : 'Windows'}{ #category : 'spec protocol' }SpWin32WindowAdapter >> activate [	self widgetDo: [ :w | w activate ]]{ #category : 'protocol' }SpWin32WindowAdapter >> addPresenterIn: aWindow withSpecLayout: aSpec [	| clientExtent |	self presenter initialPosition ifNotNil: [ :p |		aWindow moveTo: p extent: self presenter initialExtent ].	contentWidget := self buildWindowContentWithSpecLayout: aSpec.	clientExtent := SpWin32Runtime default windowClientExtent: aWindow.	self realizeContentWidget: contentWidget in: aWindow extent: clientExtent.	self installMenuBar]{ #category : 'private - building' }SpWin32WindowAdapter >> realizeContentWidget: content in: aWindow extent: anExtent [	(content respondsTo: #realizeIn:extent:) ifTrue: [		content realizeIn: aWindow extent: anExtent.		^ self ].	(content respondsTo: #realizeIn:bounds:) ifTrue: [		| rectangle |		rectangle := 0@0 extent: anExtent.		content realizeIn: aWindow bounds: rectangle.		SpWin32Runtime default setControlBoundsBatch: {			{ content. 0. 0. anExtent x. anExtent y } } ]]{ #category : 'private - building' }SpWin32WindowAdapter >> relayoutContentWidget: content extent: anExtent [	(content respondsTo: #relayoutExtent:) ifTrue: [		content relayoutExtent: anExtent.		^ self ].	(content respondsTo: #realizeIn:bounds:) ifTrue: [		content realizeIn: self widget bounds: (0@0 extent: anExtent).		SpWin32Runtime default setControlBoundsBatch: {			{ content. 0. 0. anExtent x. anExtent y } } ]]{ #category : 'private - building' }SpWin32WindowAdapter >> buildWindowContentWithSpecLayout: aSpec [	| mainContent toolbarWidget statusbarWidget |	mainContent := self presenter presenter buildWithLayout: aSpec.	(self presenter hasToolbar or: [ self presenter hasStatusbar ]) ifFalse: [ ^ mainContent ].	toolbarWidget := self presenter hasToolbar		ifTrue: [ self presenter toolbar build ]		ifFalse: [ nil ].	statusbarWidget := self presenter hasStatusbar		ifTrue: [ self presenter statusbar build ]		ifFalse: [ nil ].	^ SpWin32WindowContentContainer		toolbar: toolbarWidget		content: mainContent		statusbar: statusbarWidget		runtime: SpWin32Runtime default]{ #category : 'protocol' }SpWin32WindowAdapter >> beep [	SpWin32Runtime default beep]{ #category : 'factory' }SpWin32WindowAdapter >> buildWidget [	| initialExtent window |	initialExtent := self presenter initialExtent.	window := SpWin32Runtime default		createTopLevelWindowTitle: self presenter title		width: initialExtent x asInteger		height: initialExtent y asInteger.	window eventHandler: self.	self presenter property: #menu whenChangedDo: [ self installMenuBar ].	^ window]{ #category : 'protocol' }SpWin32WindowAdapter >> centered [	self widgetDo: [ :w | w centerOnMonitor ]]{ #category : 'protocol' }SpWin32WindowAdapter >> centeredRelativeTo: aWindowPresenter [	aWindowPresenter ifNil: [ ^ self centered ].	aWindowPresenter adapter ifNotNil: [ :adapter |		adapter widget ifNotNil: [ :ownerWindow |			self widgetDo: [ :w | w centerRelativeTo: ownerWindow ] ] ]]{ #category : 'protocol' }SpWin32WindowAdapter >> close [	self delete]{ #category : 'widget API' }SpWin32WindowAdapter >> delete [	"Destruction is asynchronous with respect to Spec notifications. The native	WM_NCDESTROY event drives #win32Destroyed, which is the single place where	Spec is told that the window has actually closed."	self widgetDo: [ :w | w destroy ]]{ #category : 'testing' }SpWin32WindowAdapter >> isDisplayed [	^ self widget ifNil: [ false ] ifNotNil: [ :w | w isVisible ]]{ #category : 'testing' }SpWin32WindowAdapter >> isMaximized [	^ self widget ifNil: [ false ] ifNotNil: [ :w | w isMaximized ]]{ #category : 'testing' }SpWin32WindowAdapter >> isMinimized [	^ self widget ifNil: [ false ] ifNotNil: [ :w | w isMinimized ]]{ #category : 'testing' }SpWin32WindowAdapter >> isResizable [	^ self presenter isResizable]{ #category : 'testing' }SpWin32WindowAdapter >> isTopWindow [	^ self widget ifNil: [ false ] ifNotNil: [ :w | w isForeground ]]{ #category : 'window management' }SpWin32WindowAdapter >> maximize [	self widgetDo: [ :w | w maximize ]]{ #category : 'window management' }SpWin32WindowAdapter >> minimize [	self widgetDo: [ :w | w minimize ]]{ #category : 'protocol' }SpWin32WindowAdapter >> moveTo: aPoint [	self widgetDo: [ :w | w moveTo: aPoint extent: w extent ]]{ #category : 'protocol' }SpWin32WindowAdapter >> open [	self openWithDeferredAction: [ ]]{ #category : 'protocol' }SpWin32WindowAdapter >> openWithDeferredAction: aBlock [	self presenter isCentered ifTrue: [ self centered ].	self widget show.	self windowIsOpened.	aBlock value]{ #category : 'protocol' }SpWin32WindowAdapter >> rebuildWithSpecLayout: aSpec [	contentWidget ifNotNil: [ :old | (old respondsTo: #destroy) ifTrue: [ old destroy ] ].	contentWidget := self buildWindowContentWithSpecLayout: aSpec.	self		realizeContentWidget: contentWidget		in: self widget		extent: (SpWin32Runtime default windowClientExtent: self widget)]{ #category : 'widget API' }SpWin32WindowAdapter >> resize: aPoint [	self widgetDo: [ :w | w moveTo: w position extent: aPoint ].	self presenter isCentered ifTrue: [ self centered ]]{ #category : 'window management' }SpWin32WindowAdapter >> restore [	self widgetDo: [ :w | w restore ]]{ #category : 'widget API' }SpWin32WindowAdapter >> size [	^ self widget ifNil: [ 0 @ 0 ] ifNotNil: [ :w | w extent ]]{ #category : 'widget API' }SpWin32WindowAdapter >> title: aString [	self widgetDo: [ :w | w title: aString ]]{ #category : 'private - menus' }SpWin32WindowAdapter >> clearMenuBar [	menuAdapter := nil.	menuEntries := #().	self widgetDo: [ :window |		window isValid ifTrue: [			SpWin32Runtime default setWindow: window menuEntries: #() ] ]]{ #category : 'private - menus' }SpWin32WindowAdapter >> installMenuBar [	self presenter hasMenu ifFalse: [ ^ self clearMenuBar ].	self presenter menu build.	menuAdapter := self presenter menu adapter.	(menuAdapter respondsTo: #whenMenuNeedsRefreshDo:) ifTrue: [		menuAdapter whenMenuNeedsRefreshDo: [ self refreshMenuBar ] ].	self refreshMenuBar]{ #category : 'private - menus' }SpWin32WindowAdapter >> refreshMenuBar [	| entries |	menuAdapter ifNil: [ ^ self clearMenuBar ].	entries := (menuAdapter respondsTo: #menuEntries)		ifTrue: [ menuAdapter menuEntries ]		ifFalse: [ (SpWin32MenuBuilder for: self presenter menu)			entriesForMenuPresenter: self presenter menu ].	self widgetDo: [ :window |		window isValid ifTrue: [			menuEntries := SpWin32Runtime default				setWindow: window				menuEntries: entries ] ]]{ #category : 'native events' }SpWin32WindowAdapter >> win32MenuCommand: commandIndex [	| entry |	entry := menuEntries at: commandIndex ifAbsent: [ ^ self ].	[ entry execute ] ensure: [ menuAdapter ifNotNil: [ self refreshMenuBar ] ]]{ #category : 'native events' }SpWin32WindowAdapter >> win32CloseRequested [	| announcement |	announcement := SpWindowWillClose new		window: self presenter;		yourself.	self presenter announce: announcement.	announcement canClose ifFalse: [ ^ self ].	self presenter requestWindowClose ifFalse: [ ^ self ].	self delete]{ #category : 'native events' }SpWin32WindowAdapter >> win32Destroyed [	self windowIsClosing.	self windowClosed]{ #category : 'native events' }SpWin32WindowAdapter >> win32ResizedFrom: oldExtent to: newExtent [	oldExtent = newExtent ifTrue: [ ^ self ].	contentWidget ifNotNil: [ :content |		self relayoutContentWidget: content extent: newExtent ].	self presenter announcer announce: (SpWindowResizing new		window: self presenter;		oldSize: oldExtent;		newSize: newExtent;		yourself)]{ #category : 'updating' }SpWin32WindowAdapter >> windowClosed [	self presenter windowClosed]{ #category : 'updating' }SpWin32WindowAdapter >> windowIsClosing [	self presenter windowIsClosing]{ #category : 'updating' }SpWin32WindowAdapter >> windowIsOpened [	self presenter windowIsOpened]{ #category : 'window management' }SpWin32WindowAdapter >> ownerWindow: aWindowPresenterOrNil [	| ownerNativeWindow |	ownerNativeWindow := aWindowPresenterOrNil		ifNil: [ nil ]		ifNotNil: [ :ownerPresenter |			ownerPresenter adapter				ifNil: [ nil ]				ifNotNil: [ :adapter | adapter widget ] ].	self widgetDo: [ :w | w owner: ownerNativeWindow ]]