Class {	#name : 'SpWin32ActionManager',	#superclass : 'Object',	#instVars : [		'adapter',		'matcher',		'additionalGroups'	],	#category : 'Spec-Win32-Adapters-Actions',	#package : 'Spec-Win32-Adapters',	#tag : 'Actions'}{ #category : 'instance creation' }SpWin32ActionManager class >> on: anAdapter [	^ self new		adapter: anAdapter;		yourself]{ #category : 'initialization' }SpWin32ActionManager >> initialize [	super initialize.	matcher := SpWin32ShortcutMatcher new.	additionalGroups := OrderedCollection new]{ #category : 'accessing' }SpWin32ActionManager >> adapter: anAdapter [	adapter := anAdapter]{ #category : 'actions' }SpWin32ActionManager >> addActionGroup: anActionGroup [	anActionGroup ifNotNil: [ additionalGroups add: anActionGroup ]]{ #category : 'events' }SpWin32ActionManager >> handleKeyDown: aKeyEvent [	| current visited |	aKeyEvent wasHandled ifTrue: [ ^ false ].	current := adapter presenter.	visited := IdentitySet new.	[ current notNil and: [ (visited includes: current) not ] ] whileTrue: [		visited add: current.		(self executeMatchingShortcutIn: current event: aKeyEvent) ifTrue: [			aKeyEvent wasHandled: true.			^ true ].		(self executeAdapterAdditionalShortcutsFor: current event: aKeyEvent) ifTrue: [			aKeyEvent wasHandled: true.			^ true ].		current := (current respondsTo: #owner)			ifTrue: [ current owner ]			ifFalse: [ nil ] ].	^ false]{ #category : 'private - actions' }SpWin32ActionManager >> executeAdapterAdditionalShortcutsFor: aPresenter event: aKeyEvent [	| presenterAdapter manager |	(aPresenter respondsTo: #adapter) ifFalse: [ ^ false ].	presenterAdapter := aPresenter adapter.	presenterAdapter ifNil: [ ^ false ].	(presenterAdapter respondsTo: #actionManagerIfPresent) ifFalse: [ ^ false ].	manager := presenterAdapter actionManagerIfPresent.	manager ifNil: [ ^ false ].	^ manager executeMatchingShortcutInAdditionalGroups: aKeyEvent]{ #category : 'private - actions' }SpWin32ActionManager >> executeMatchingShortcutIn: aPresenter event: aKeyEvent [	(aPresenter respondsTo: #actions) ifTrue: [		(self executeMatchingShortcutInGroup: aPresenter actions event: aKeyEvent) ifTrue: [ ^ true ] ].	(aPresenter respondsTo: #internalActions) ifTrue: [		(self executeMatchingShortcutInGroup: aPresenter internalActions event: aKeyEvent) ifTrue: [ ^ true ] ].	^ false]{ #category : 'private - actions' }SpWin32ActionManager >> executeMatchingShortcutInAdditionalGroups: aKeyEvent [	additionalGroups do: [ :group |		(self executeMatchingShortcutInGroup: group event: aKeyEvent) ifTrue: [			aKeyEvent wasHandled: true.			^ true ] ].	^ false]{ #category : 'private - actions' }SpWin32ActionManager >> executeMatchingShortcutInGroup: anActionGroup event: aKeyEvent [	anActionGroup ifNil: [ ^ false ].	anActionGroup allCommands do: [ :command |		(command hasShortcutKey			and: [ matcher matches: command shortcutKey event: aKeyEvent ]) ifTrue: [			command canBeExecuted ifTrue: [				command hasState ifTrue: [ command toggleState ].				command execute.				^ true ] ] ].	^ false]{ #category : 'private - menus' }SpWin32ActionManager >> contextMenuGroups [	| groups |	groups := OrderedCollection new.	((adapter presenter respondsTo: #actions) and: [ adapter presenter actions isNotNil ]) ifTrue: [		groups add: adapter presenter actions ].	groups addAll: additionalGroups.	^ groups]{ #category : 'private - menus' }SpWin32ActionManager >> appendSectionsFrom: aGroup to: sections [	| group currentSection |	group := (aGroup isKindOf: SpDynamicActionGroup)		ifTrue: [			SpActionGroup new				in: [ :resolved | aGroup dynamicBuilder value: resolved ];				yourself ]		ifFalse: [ aGroup ].	currentSection := OrderedCollection new.	group entries do: [ :entry |		(entry isKindOf: SpAction)			ifTrue: [ entry isVisible ifTrue: [ currentSection add: entry ] ]			ifFalse: [				currentSection ifNotEmpty: [					sections add: currentSection asArray.					currentSection := OrderedCollection new ].				(entry respondsTo: #entries) ifTrue: [ self appendSectionsFrom: entry to: sections ] ] ].	currentSection ifNotEmpty: [ sections add: currentSection asArray ]]{ #category : 'menus' }SpWin32ActionManager >> contextMenuEntries [	| sections result |	sections := OrderedCollection new.	self contextMenuGroups do: [ :group | self appendSectionsFrom: group to: sections ].	result := OrderedCollection new.	sections do: [ :section |		section ifNotEmpty: [			result ifNotEmpty: [ result add: nil ].			result addAll: section ] ].	^ result asArray]{ #category : 'private - testing - menus' }SpWin32ActionManager >> groupHasContextMenuCandidate: aGroup [	(aGroup isKindOf: SpDynamicActionGroup) ifTrue: [ ^ true ].	^ aGroup entries anySatisfy: [ :entry |		(entry isKindOf: SpAction)			ifTrue: [ entry isVisible ]			ifFalse: [				(entry respondsTo: #entries)					and: [ self groupHasContextMenuCandidate: entry ] ] ]]{ #category : 'testing - menus' }SpWin32ActionManager >> hasContextMenu [	^ self contextMenuGroups anySatisfy: [ :group |		self groupHasContextMenuCandidate: group ]]{ #category : 'private - menus' }SpWin32ActionManager >> labelForContextMenuAction: anAction [	| label |	label := anAction dynamicName ifNil: [ anAction name ifNil: [ '' ] ].	(label respondsTo: #localizedForPresenter:) ifTrue: [		label := label localizedForPresenter: adapter presenter ].	^ label asString copyReplaceAll: '&' with: '&&']{ #category : 'private - menus' }SpWin32ActionManager >> flagsForContextMenuEntry: anActionOrNil [	| flags |	anActionOrNil ifNil: [ ^ SpWin32Runtime menuItemSeparatorFlag ].	flags := 0.	anActionOrNil canBeExecuted ifTrue: [		flags := flags bitOr: SpWin32Runtime menuItemEnabledFlag ].	(anActionOrNil hasState and: [ anActionOrNil state = true ]) ifTrue: [		flags := flags bitOr: SpWin32Runtime menuItemCheckedFlag ].	^ flags]{ #category : 'menus' }SpWin32ActionManager >> showContextMenuAt: aPoint [	| entries labels flags selected action |	entries := self contextMenuEntries.	entries ifEmpty: [ ^ false ].	labels := entries collect: [ :entry |		entry ifNil: [ '' ] ifNotNil: [ self labelForContextMenuAction: entry ] ].	flags := entries collect: [ :entry | self flagsForContextMenuEntry: entry ].	selected := adapter widget showContextMenuLabels: labels flags: flags at: aPoint.	selected = 0 ifTrue: [ ^ false ].	action := entries at: selected ifAbsent: [ ^ false ].	action ifNil: [ ^ false ].	action canBeExecuted ifFalse: [ ^ false ].	action hasState ifTrue: [ action toggleState ].	action execute.	^ true]