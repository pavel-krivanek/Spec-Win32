Class {	#name : 'SpWin32NotebookAdapter',	#superclass : 'SpWin32AbstractAdapter',	#instVars : [		'subscribedPages'	],	#category : 'Spec-Win32-Adapters-Controls',	#package : 'Spec-Win32-Adapters',	#tag : 'Controls'}{ #category : 'private - building' }SpWin32NotebookAdapter >> buildContentForPage: aPage [	| pagePresenter |	pagePresenter := aPage retrievePresenter.	pagePresenter ifNil: [ ^ nil ].	pagePresenter owner: self presenter.	^ pagePresenter build]{ #category : 'factory' }SpWin32NotebookAdapter >> buildWidget [	| container |	container := SpWin32NotebookContainer		runtime: SpWin32Runtime default		eventHandler: self.	subscribedPages := IdentitySet new.	container pages: self presenter pages.	self subscribeToPages: self presenter pages.	self presenter whenPagesChangedDo: [ :newPages | self updatePagesWith: newPages ].	self presenter pages ifNotEmpty: [		self presenter selectedPage ifNil: [ self presenter selectPageIndex: 1 ] ].	self presenter selectedPage ifNotNil: [ :page |		self ensurePageContent: page in: container.		container selectedPage: page ].	^ container]{ #category : 'testing' }SpWin32NotebookAdapter >> clickTab: anIndex [	self win32SelectionChanged: anIndex]{ #category : 'private - building' }SpWin32NotebookAdapter >> ensurePageContent: aPage [	^ self ensurePageContent: aPage in: self widget]{ #category : 'private - building' }SpWin32NotebookAdapter >> ensurePageContent: aPage in: aContainer [	| content |	(aContainer pageWidgetAt: aPage) ifNotNil: [ :widget | ^ widget ].	content := self buildContentForPage: aPage.	content ifNotNil: [ aContainer pageWidget: content for: aPage ].	^ content]{ #category : 'testing' }SpWin32NotebookAdapter >> numberOfTabs [	^ self widget numberOfTabs]{ #category : 'updating' }SpWin32NotebookAdapter >> selectPage: aPage [	aPage ifNotNil: [ self ensurePageContent: aPage ].	self widget selectedPage: aPage]{ #category : 'testing' }SpWin32NotebookAdapter >> selectedPageName [	^ self presenter selectedPage ifNil: [ nil ] ifNotNil: [ :page | page title ]]{ #category : 'protocol' }SpWin32NotebookAdapter >> takeKeyboardFocus [	self widget tabControl takeKeyboardFocus]{ #category : 'updating' }SpWin32NotebookAdapter >> updatePageContent: aPage [	self widget resetPageWidget: aPage.	aPage == self presenter selectedPage ifTrue: [		self ensurePageContent: aPage.		self widget selectedPage: aPage ]]{ #category : 'updating' }SpWin32NotebookAdapter >> updatePageTitle: aPage [	self widget updateTitles]{ #category : 'private - subscription' }SpWin32NotebookAdapter >> subscribeToPages: aCollection [	aCollection do: [ :page |		(subscribedPages includes: page) ifFalse: [			subscribedPages add: page.			page whenTitleChangedDo: [ self updatePageTitle: page ] ] ]]{ #category : 'updating' }SpWin32NotebookAdapter >> updatePagesWith: aCollection [	| oldSelected oldIndex |	oldSelected := self presenter selectedPage.	oldIndex := 0.	oldSelected ifNotNil: [		1 to: self widget pages size do: [ :index |			(self widget pages at: index) == oldSelected ifTrue: [ oldIndex := index ] ] ].	self subscribeToPages: aCollection.	self widget pages: aCollection.	oldSelected ifNotNil: [		(aCollection identityIncludes: oldSelected)			ifTrue: [ self widget selectedPage: oldSelected ]			ifFalse: [				aCollection					ifEmpty: [ self presenter selectPage: nil ]					ifNotEmpty: [ self presenter selectPageIndex: ((oldIndex max: 1) min: aCollection size) ] ] ]]{ #category : 'native events' }SpWin32NotebookAdapter >> win32SelectionChanged: anInteger [	(anInteger between: 1 and: self presenter pages size) ifFalse: [ ^ self ].	self presenter selectedPageIndex = anInteger ifTrue: [ ^ self ].	self presenter selectPageIndex: anInteger]