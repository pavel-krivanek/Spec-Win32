Class {	#name : 'SpWin32PatchSideBySideAdapter',	#superclass : 'SpWin32PatchAdapter',	#instVars : [		'leftControl',		'rightControl'	],	#category : 'Spec-Win32-Adapters-Code',	#package : 'Spec-Win32-Adapters',	#tag : 'Code'}{ #category : 'factory' }SpWin32PatchSideBySideAdapter >> buildWidget [	| layout container constraints |	layout := SpBoxLayout newLeftToRight.	layout beHomogeneous; spacing: 1.	container := SpWin32BoxContainer layout: layout runtime: SpWin32Runtime default.	leftControl := self newPatchCodeControl.	rightControl := self newPatchCodeControl.	constraints := SpBoxConstraints new.	container addChild: leftControl constraints: constraints.	container addChild: rightControl constraints: SpBoxConstraints new.	self setPatchModel: self presenter model.	self presenter whenPatchChangedDo: [ :aPatchModel | self setPatchModel: aPatchModel ].	self presenter whenLineNumbersChangedDo: [ :aBoolean | self updateLineNumbers: aBoolean ].	^ container]{ #category : 'factory' }SpWin32PatchSideBySideAdapter >> newPatchCodeControl [	^ (SpWin32NativeControl		runtime: SpWin32Runtime default		kind: SpWin32Runtime controlCode		text: ''		preferredExtent: 320 @ 320)		eventHandler: self;		editable: false;		configureTextWrapWord: true scrollBars: true undoEnabled: false;		codeLineNumbers: self presenter hasLineNumbers;		codeStyleSpans: #() foreground: self baseForegroundRgb background: self baseBackgroundRgb;		yourself]{ #category : 'accessing' }SpWin32PatchSideBySideAdapter >> leftControl [	^ leftControl]{ #category : 'accessing' }SpWin32PatchSideBySideAdapter >> rightControl [	^ rightControl]{ #category : 'accessing' }SpWin32PatchSideBySideAdapter >> children [	^ { leftControl. rightControl }]{ #category : 'private - updating' }SpWin32PatchSideBySideAdapter >> setPatchModel: aPatchModel [	| visitor |	(aPatchModel isNil or: [ aPatchModel isEmpty ]) ifTrue: [		leftControl text: ''.		rightControl text: ''.		leftControl codeLineDecorations: #().		rightControl codeLineDecorations: #().		^ self ].	visitor := SpWin32PatchSideBySideVisitor new		visitPatch: aPatchModel patch;		yourself.	leftControl text: visitor leftText.	rightControl text: visitor rightText.	leftControl codeLineDecorations: (self lineDecorationEntriesFor: visitor leftMarks).	rightControl codeLineDecorations: (self lineDecorationEntriesFor: visitor rightMarks)]{ #category : 'private - updating' }SpWin32PatchSideBySideAdapter >> updateLineNumbers: aBoolean [	leftControl ifNotNil: [ leftControl codeLineNumbers: aBoolean ].	rightControl ifNotNil: [ rightControl codeLineNumbers: aBoolean ]]{ #category : 'native events' }SpWin32PatchSideBySideAdapter >> win32ScrollPositionChanged: aPoint source: sourceControl [	| target sourceLine targetLine |	(sourceControl == leftControl or: [ sourceControl == rightControl ]) ifFalse: [ ^ self ].	target := sourceControl == leftControl ifTrue: [ rightControl ] ifFalse: [ leftControl ].	(sourceControl isValid and: [ target isValid ]) ifFalse: [ ^ self ].	sourceLine := sourceControl firstVisibleTextLine.	targetLine := target firstVisibleTextLine.	sourceLine = targetLine ifTrue: [ ^ self ].	target scrollToTextLine: sourceLine]{ #category : 'focus' }SpWin32PatchSideBySideAdapter >> takeKeyboardFocus [	leftControl ifNotNil: [ leftControl takeKeyboardFocus ]]