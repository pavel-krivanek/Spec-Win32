Class {	#name : 'SpWin32ModalWindowAdapter',	#superclass : 'SpWin32DialogWindowAdapter',	#instVars : [		'modalCompletion',		'modalCompleted',		'disabledNativeWindows',		'modalOwnerPresenter'	],	#category : 'Spec-Win32-Adapters-Windows',	#package : 'Spec-Win32-Adapters',	#tag : 'Windows'}{ #category : 'initialization' }SpWin32ModalWindowAdapter >> initialize [	super initialize.	modalCompleted := false.	disabledNativeWindows := #()]{ #category : 'private - modal' }SpWin32ModalWindowAdapter >> candidateWindowPresenters [	^ self presenter application windows select: [ :each |		each ~~ self presenter and: [			each adapter notNil and: [				each adapter widget notNil and: [ each adapter isDisplayed ] ] ] ]]{ #category : 'private - modal' }SpWin32ModalWindowAdapter >> chooseModalOwnerFrom: candidates [	^ candidates		detect: [ :each | each adapter isTopWindow ]		ifNone: [ candidates ifEmpty: [ nil ] ifNotEmpty: [ candidates anyOne ] ]]{ #category : 'private - modal' }SpWin32ModalWindowAdapter >> prepareModalState [	| candidates enabledCandidates |	candidates := self candidateWindowPresenters.	modalOwnerPresenter ifNil: [		modalOwnerPresenter := self chooseModalOwnerFrom: candidates ].	modalOwnerPresenter ifNotNil: [ self ownerWindow: modalOwnerPresenter ].	enabledCandidates := candidates select: [ :each | each adapter widget isEnabled ].	disabledNativeWindows := enabledCandidates collect: [ :each | each adapter widget ].	disabledNativeWindows do: [ :window | window enabled: false ]]{ #category : 'private - modal' }SpWin32ModalWindowAdapter >> restoreModalState [	disabledNativeWindows do: [ :window |		window isValid ifTrue: [ window enabled: true ] ].	disabledNativeWindows := #().	modalOwnerPresenter ifNotNil: [ :owner |		owner adapter ifNotNil: [ :adapter |			adapter widget ifNotNil: [ :window |				window isValid ifTrue: [ window activate ] ] ] ]]{ #category : 'protocol' }SpWin32ModalWindowAdapter >> centeredRelativeTo: aWindowPresenter [	modalOwnerPresenter := aWindowPresenter.	super centeredRelativeTo: aWindowPresenter]{ #category : 'private - modal' }SpWin32ModalWindowAdapter >> completeModal [	modalCompleted ifTrue: [ ^ self ].	modalCompleted := true.	self restoreModalState.	modalCompletion ifNotNil: [ modalCompletion signal ]]{ #category : 'private - modal' }SpWin32ModalWindowAdapter >> waitForModalCompletion [	| runtime |	runtime := SpWin32Runtime default.	runtime isEventPumpProcess		ifTrue: [ runtime pumpEventsWhile: [ modalCompleted not ] ]		ifFalse: [ modalCompletion wait ]]{ #category : 'protocol' }SpWin32ModalWindowAdapter >> openWithDeferredAction: aBlock [	modalCompletion := Semaphore new.	modalCompleted := false.	self prepareModalState.	[		self presenter isCentered			ifTrue: [				modalOwnerPresenter					ifNil: [ self centered ]					ifNotNil: [ :owner | super centeredRelativeTo: owner ] ].		self widget show.		self activate.		self windowIsOpened.		aBlock value.		modalCompleted ifFalse: [ self waitForModalCompletion ]	] ensure: [		modalCompleted ifFalse: [ self completeModal ] ]]{ #category : 'updating' }SpWin32ModalWindowAdapter >> windowClosed [	self completeModal.	super windowClosed]