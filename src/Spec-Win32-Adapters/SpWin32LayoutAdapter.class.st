Class {	#name : 'SpWin32LayoutAdapter',	#superclass : 'SpWin32AbstractAdapter',	#instVars : [		'layout'	],	#category : 'Spec-Win32-Adapters-Layout',	#package : 'Spec-Win32-Adapters',	#tag : 'Layout'}{ #category : 'testing' }SpWin32LayoutAdapter class >> isAbstract [	^ self == SpWin32LayoutAdapter]{ #category : 'building' }SpWin32LayoutAdapter >> build [ ^ self widget ]{ #category : 'building' }SpWin32LayoutAdapter >> buildWidget [ ^ nil ]{ #category : 'building' }SpWin32LayoutAdapter >> buildWithLayout: aSpecLayout [ ^ self widget ]{ #category : 'building' }SpWin32LayoutAdapter >> buildWithSelector: aSelector [ ^ self widget ]{ #category : 'accessing' }SpWin32LayoutAdapter >> children [ ^ self widget ifNil: [ #() ] ifNotNil: [ :each | each children ] ]{ #category : 'testing' }SpWin32LayoutAdapter >> isSpLayout [ ^ true ]{ #category : 'accessing' }SpWin32LayoutAdapter >> layout [ ^ layout ]{ #category : 'factory' }SpWin32LayoutAdapter >> takeKeyboardFocus [	self presenter presentersInFocusOrder ifNotEmpty: [ :presenters | presenters first takeKeyboardFocus ]]{ #category : 'testing' }SpWin32LayoutAdapter >> isEmpty [ ^ self children isEmpty ]