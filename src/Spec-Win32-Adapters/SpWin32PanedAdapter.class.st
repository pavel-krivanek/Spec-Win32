Class {	#name : 'SpWin32PanedAdapter',	#superclass : 'SpWin32LayoutAdapter',	#category : 'Spec-Win32-Adapters-Layout',	#package : 'Spec-Win32-Adapters',	#tag : 'Layout'}{ #category : 'accessing' }SpWin32PanedAdapter >> add: aPresenter constraints: constraints [	| childWidget position |	position := self positionForPresenter: aPresenter.	aPresenter owner: self model.	childWidget := aPresenter buildWithSelector: constraints spec.	widget child: childWidget at: position constraints: constraints]{ #category : 'factory' }SpWin32PanedAdapter >> adapterWasBuilt []{ #category : 'factory' }SpWin32PanedAdapter >> layout: aLayout [	layout := aLayout.	widget ifNil: [		widget := SpWin32PanedContainer			layout: aLayout			runtime: SpWin32Runtime default ].	aLayout whenChildrenAddedDo: [ :announcement |		self add: announcement child constraints: (aLayout constraintsFor: announcement child) ].	aLayout whenChildrenRemovedDo: [ :announcement |		announcement child adapter ifNotNil: [ :adapter |			widget removeChildWidget: adapter widget ] ]]{ #category : 'private' }SpWin32PanedAdapter >> positionForPresenter: aPresenter [	| target position |	target := aPresenter isSpLayout		ifTrue: [ aPresenter layout ]		ifFalse: [ aPresenter ].	position := layout children indexOf: target.	position = 0 ifTrue: [		layout children withIndexDo: [ :each :index |			(each isSymbol and: [ (layout presenter presenterAt: each) = aPresenter ])				ifTrue: [ position := index ] ].		position = 0 ifTrue: [			position := widget firstChild				ifNil: [ 1 ]				ifNotNil: [ widget secondChild ifNil: [ 2 ] ifNotNil: [ 0 ] ] ] ].	position = 0 ifTrue: [ self error: 'Can''t find a paned child position.' ].	^ position]{ #category : 'accessing' }SpWin32PanedAdapter >> removeAll [	widget removeAll]{ #category : 'factory' }SpWin32PanedAdapter >> removeSubWidgets [	self removeAll]