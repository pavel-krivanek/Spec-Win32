Class {	#name : 'SpWin32TreeAdapter',	#superclass : 'SpWin32AbstractAdapter',	#instVars : [ 'paths', 'pathToToken', 'expandedPaths' ],	#category : 'Spec-Win32-Adapters-Controls',	#package : 'Spec-Win32-Adapters',	#tag : 'Controls'}{ #category : 'initialization' }SpWin32TreeAdapter >> initialize [	super initialize.	paths := #().	pathToToken := Dictionary new.	expandedPaths := Set new]{ #category : 'factory' }SpWin32TreeAdapter >> buildWidget [	| control |	control := SpWin32NativeTreeControl runtime: SpWin32Runtime default kind: SpWin32Runtime controlTree text: '' preferredExtent: 240 @ 180.	control eventHandler: self.	self rebuildTreeOn: control.	self presenter whenRootsChangedDo: [ self refreshTree ].	self presenter whenSelectionChangedDo: [ self refreshSelection ].	self presenter whenMultiSelectionChangedDo: [ self ensureSingleSelection ].	^ control]{ #category : 'private' }SpWin32TreeAdapter >> ensureSingleSelection [	self presenter selection isMultipleSelection ifTrue: [ self presenter beSingleSelection ]]{ #category : 'private' }SpWin32TreeAdapter >> rebuildTreeOn: control [	| labels parents newPaths map |	labels := OrderedCollection new.	parents := OrderedCollection new.	newPaths := OrderedCollection new.	map := Dictionary new.	self presenter traverseTreeDo: [ :item :path |		| token parentPath parentToken |		token := newPaths size + 1.		newPaths add: path asArray.		map at: path asArray put: token.		labels add: ((self presenter display value: item) ifNil: [ '' ]) asString.		parentPath := path size > 1 ifTrue: [ path allButLast asArray ] ifFalse: [ #() ].		parentToken := parentPath isEmpty ifTrue: [ 0 ] ifFalse: [ map at: parentPath ifAbsent: [ 0 ] ].		parents add: parentToken ].	paths := newPaths asArray.	pathToToken := map.	control labels: labels asArray parentTokens: parents asArray.	expandedPaths do: [ :path | (self tokenForPath: path) ifNotNil: [ :token | control token: token expanded: true ] ].	self refreshSelectionOn: control]{ #category : 'private' }SpWin32TreeAdapter >> tokenForPath: aPath [	^ pathToToken at: aPath asArray ifAbsent: [ nil ]]{ #category : 'private' }SpWin32TreeAdapter >> pathForToken: token [	(token between: 1 and: paths size) ifFalse: [ ^ nil ].	^ paths at: token]{ #category : 'accessing' }SpWin32TreeAdapter >> itemAtPath: aPath [	^ self presenter		itemAt: aPath first		of: self presenter roots		then: aPath allButFirst]{ #category : 'refreshing' }SpWin32TreeAdapter >> refreshTree [ self rebuildTreeOn: self widget ]{ #category : 'refreshing' }SpWin32TreeAdapter >> refreshSelection [	self refreshSelectionOn: self widget]{ #category : 'refreshing' }SpWin32TreeAdapter >> refreshSelectionOn: aControl [	| path token |	aControl ifNil: [ ^ self ].	path := self presenter selection selectedPath.	token := (path isNil or: [ path isEmpty ]) ifTrue: [ 0 ] ifFalse: [ self tokenForPath: path ].	aControl selectedToken: (token ifNil: [ 0 ])]{ #category : 'api' }SpWin32TreeAdapter >> expandPath: aPath [	(self tokenForPath: aPath) ifNotNil: [ :token | self widget token: token expanded: true. expandedPaths add: aPath asArray ]]{ #category : 'api' }SpWin32TreeAdapter >> collapsePath: aPath [	(self tokenForPath: aPath) ifNotNil: [ :token | self widget token: token expanded: false. expandedPaths remove: aPath asArray ifAbsent: [ ] ]]{ #category : 'api' }SpWin32TreeAdapter >> expandRoots [	1 to: self presenter roots size do: [ :i | self expandPath: { i } ]]{ #category : 'api' }SpWin32TreeAdapter >> expandAll [ paths do: [ :path | self expandPath: path ] ]{ #category : 'api' }SpWin32TreeAdapter >> collapseAll [ paths reversed do: [ :path | self collapsePath: path ] ]{ #category : 'testing' }SpWin32TreeAdapter >> isExpanded: aPath [	^ expandedPaths includes: aPath asArray]{ #category : 'scrolling' }SpWin32TreeAdapter >> scrollToSelection [	| path token |	path := self presenter selection selectedPath.	(path isNil or: [ path isEmpty ]) ifTrue: [ ^ self ].	token := self tokenForPath: path.	token ifNotNil: [ self widget ensureVisibleToken: token ]]{ #category : 'native events' }SpWin32TreeAdapter >> win32TreeSelectionChangedToken: token [	| path |	path := self pathForToken: token.	path ifNil: [ ^ self ].	self presenter selection selectedPath = path ifFalse: [ self presenter selectPath: path ].	self presenter isActiveOnSingleClick ifTrue: [ self presenter doActivateAtPath: path ]]{ #category : 'native events' }SpWin32TreeAdapter >> win32TreeExpansionChangedToken: token expanded: expanded [	| path |	path := self pathForToken: token.	path ifNil: [ ^ self ].	expanded ifTrue: [ expandedPaths add: path ] ifFalse: [ expandedPaths remove: path ifAbsent: [ ] ].	(Smalltalk at: #SpTreeExpansionChanged ifAbsent: [ nil ]) ifNotNil: [ :announcementClass |		self presenter announce: (announcementClass new			item: (self presenter itemAtPath: path);			expanded: expanded;			yourself) ]]{ #category : 'native events' }SpWin32TreeAdapter >> win32ActivatedAt: token source: source [	| path |	path := self pathForToken: token.	path ifNil: [ ^ self ].	(source = 2 or: [ self presenter isActiveOnDoubleClick ]) ifTrue: [ self presenter doActivateAtPath: path ]]{ #category : 'accessing' }SpWin32TreeAdapter >> selectedIndexes [	| path |	path := self presenter selection selectedPath.	^ (path isNil or: [ path isEmpty ]) ifTrue: [ #() ] ifFalse: [ { path } ]]{ #category : 'protocol compatibility' }SpWin32TreeAdapter >> updateMenu [ ]