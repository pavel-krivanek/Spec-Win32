Class {	#name : 'SpWin32ListAdapter',	#superclass : 'SpWin32AbstractAdapter',	#category : 'Spec-Win32-Adapters-Controls',	#package : 'Spec-Win32-Adapters',	#tag : 'Controls'}{ #category : 'specs' }SpWin32ListAdapter class >> adaptingAliases [	^ #(FastTableAdapter)]{ #category : 'factory' }SpWin32ListAdapter >> buildWidget [	| control |	control := SpWin32NativeControl		runtime: SpWin32Runtime default		kind: SpWin32Runtime controlList		text: ''		preferredExtent: 180 @ 120.	control		eventHandler: self;		items: self displayStrings;		multipleSelection: self presenter selection isMultipleSelection;		headerText: (self presenter headerTitle ifNil: [ '' ]) visible: self presenter hasHeaderTitle;		selectedIndexes: self presenter selection selectedIndexes.	self presenter whenModelChangedDo: [ self refreshList ].	self presenter whenDisplayChangedDo: [ self refreshWidgetList ].	self presenter property: #headerTitle whenChangedDo: [ self refreshWidgetHeaderTitle ].	self presenter selection whenChangedDo: [ self refreshWidgetSelection ].	self presenter whenSelectionModeChangedDo: [ self selectionModeChangedOnPresenter ].	^ control]{ #category : 'private' }SpWin32ListAdapter >> displayStrings [	^ self presenter items collect: [ :item |		(self presenter displayValueFor: item) asString ]]{ #category : 'accessing' }SpWin32ListAdapter >> elementAt: anIndex [	^ self presenter model at: anIndex]{ #category : 'testing' }SpWin32ListAdapter >> isNonEditableRow: aRow column: aColumn [	^ true]{ #category : 'widget API' }SpWin32ListAdapter >> refreshList [	self refreshWidgetList]{ #category : 'widget API' }SpWin32ListAdapter >> refreshWidgetList [	self widget items: self displayStrings.	self refreshWidgetSelection]{ #category : 'widget API' }SpWin32ListAdapter >> refreshWidgetHeaderTitle [	self widget		headerText: (self presenter headerTitle ifNil: [ '' ])		visible: self presenter hasHeaderTitle]{ #category : 'widget API' }SpWin32ListAdapter >> refreshWidgetSelection [	self widget selectedIndexes: self presenter selection selectedIndexes]{ #category : 'private - updating' }SpWin32ListAdapter >> selectionModeChangedOnPresenter [	self widget multipleSelection: self presenter selection isMultipleSelection.	self refreshWidgetSelection]{ #category : 'accessing' }SpWin32ListAdapter >> selectedIndexes [	^ self widget selectedIndexes]{ #category : 'selecting' }SpWin32ListAdapter >> selectIndex: anInteger [	| indexes |	anInteger = 0 ifTrue: [		self widget selectedIndexes: #().		self presenter selection unselectAll.		^ self ].	(anInteger between: 1 and: self presenter items size) ifFalse: [		self widget selectedIndexes: #().		self presenter selection unselectAll.		^ self ].	indexes := self presenter selection isMultipleSelection		ifTrue: [			(self widget selectedIndexes asOrderedCollection				add: anInteger;				removeDuplicates;				asArray) ]		ifFalse: [ { anInteger } ].	self widget selectedIndexes: indexes.	self presenter selection selectIndexes: indexes]{ #category : 'selecting' }SpWin32ListAdapter >> unselectAll [	self selectIndex: 0]{ #category : 'scrolling' }SpWin32ListAdapter >> scrollToIndex: anInteger [	(anInteger between: 1 and: self presenter items size) ifTrue: [		self widget ensureVisibleIndex: anInteger ]]{ #category : 'native events' }SpWin32ListAdapter >> win32ListSelectionChanged: indexes changedIndex: changedIndex selected: wasSelected [	self presenter selection selectedIndexes asArray = indexes asArray ifFalse: [		self presenter selection selectIndexes: indexes ].	(wasSelected and: [ self presenter isActiveOnSingleClick ]) ifTrue: [		self presenter doActivateAtIndex: changedIndex ]]{ #category : 'native events' }SpWin32ListAdapter >> win32ActivatedAt: anIndex source: sourceKind [	sourceKind = 2 ifTrue: [		self presenter doActivateAtIndex: anIndex.		^ self ].	self presenter isActiveOnDoubleClick ifTrue: [		self presenter doActivateAtIndex: anIndex ]]{ #category : 'protocol compatibility' }SpWin32ListAdapter >> autoDeselect: aBoolean [	"Native ListView currently keeps the standard Windows selection behavior."]{ #category : 'protocol compatibility' }SpWin32ListAdapter >> updateMenu [	"Context-menu integration is a later collection-control slice."]