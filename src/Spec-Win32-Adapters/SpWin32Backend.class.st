Class {	#name : 'SpWin32Backend',	#superclass : 'SpApplicationBackend',	#category : 'Spec-Win32-Adapters-Backend',	#package : 'Spec-Win32-Adapters',	#tag : 'Backend'}{ #category : 'accessing' }SpWin32Backend class >> backendName [	^ #Win32]{ #category : 'private' }SpWin32Backend >> adapterBindingsClass [	^ SpWin32AdapterBindings]{ #category : 'accessing' }SpWin32Backend >> componentListClass [	^ SpComponentListPresenter]{ #category : 'accessing' }SpWin32Backend >> defaultConfigurationFor: anApplication [	^ SpApplicationConfiguration new]{ #category : 'deferred message' }SpWin32Backend >> defer: aBlock [	"Keep Smalltalk work off the native WndProc/UI thread while preserving FIFO	ordering between Spec-level deferred operations."	^ SpWin32DeferredDispatcher default defer: aBlock]{ #category : 'accessing' }SpWin32Backend >> diffClass [	^ SpDiffPresenter]{ #category : 'accessing' }SpWin32Backend >> dropListClass [	^ SpDropListPresenter]{ #category : 'deferred message' }SpWin32Backend >> forceDefer: aBlock [	^ self defer: aBlock]{ #category : 'ui - dialogs' }SpWin32Backend >> inform: aString [	^ self runtime		showMessage: aString		title: 'Information'		kind: self runtime class messageInfo		owner: nil]{ #category : 'accessing' }SpWin32Backend >> listClass [	^ SpListPresenter]{ #category : 'ui - notifying' }SpWin32Backend >> notifyError: aSpecNotification [	^ self runtime		showMessage: (self messageFromNotification: aSpecNotification)		title: 'Error'		kind: self runtime class messageError		owner: nil]{ #category : 'ui - notifying' }SpWin32Backend >> notifyInfo: aSpecNotification [	^ self runtime		showMessage: (self messageFromNotification: aSpecNotification)		title: 'Information'		kind: self runtime class messageInfo		owner: nil]{ #category : 'ui - dialogs' }SpWin32Backend >> openFileDialog: aFileDialog [	| mode owner initial result |	mode := self fileDialogModeFor: aFileDialog.	owner := self nativeWindowFor: aFileDialog parentWindow.	initial := self initialDirectoryAndNameFor: aFileDialog path.	result := self runtime		openFileDialogMode: mode		title: (aFileDialog title ifNil: [ '' ])		initialDirectory: initial first		initialName: initial second		filterString: (self fileDialogFilterStringFor: aFileDialog filters)		owner: owner.	^ result ifNotNil: [ result asFileReference ]]{ #category : 'accessing' }SpWin32Backend >> runtime [	^ SpWin32Runtime default]{ #category : 'ui' }SpWin32Backend >> showWaitCursorWhile: aBlock inApplication: anApplication [	| windows |	windows := self nativeWindowsForApplication: anApplication.	windows do: [ :each | self runtime setWaitCursor: true forWindow: each ].	^ [ aBlock value ] ensure: [		windows do: [ :each |			each isValid ifTrue: [ self runtime setWaitCursor: false forWindow: each ] ] ]]{ #category : 'accessing' }SpWin32Backend >> tableClass [	^ SpTablePresenter]{ #category : 'accessing' }SpWin32Backend >> treeClass [	^ SpTreePresenter]{ #category : 'accessing' }SpWin32Backend >> treeTableClass [	^ SpTreeTablePresenter]{ #category : 'private - dialogs' }SpWin32Backend >> fileDialogModeFor: aFileDialog [	aFileDialog isSaveFile ifTrue: [ ^ self runtime class fileDialogSave ].	aFileDialog isOpenDirectory ifTrue: [ ^ self runtime class fileDialogDirectory ].	^ self runtime class fileDialogOpen]{ #category : 'private - dialogs' }SpWin32Backend >> initialDirectoryAndNameFor: aPathOrNil [	| path |	aPathOrNil ifNil: [ ^ { ''. '' } ].	path := aPathOrNil asFileReference.	path isDirectory ifTrue: [ ^ { path fullName. '' } ].	^ { path parent fullName. path basename }]{ #category : 'private - dialogs' }SpWin32Backend >> fileDialogFilterStringFor: aCollection [	| null |	null := Character null.	^ String streamContents: [ :stream |		aCollection do: [ :each |			| suffix pattern |			suffix := each asString reject: [ :character | '*.' includes: character ].			suffix ifNotEmpty: [				pattern := '*.', suffix.				stream					nextPutAll: pattern;					nextPut: null;					nextPutAll: pattern;					nextPut: null ] ].		stream			nextPutAll: 'All files (*.*)';			nextPut: null;			nextPutAll: '*.*';			nextPut: null;			nextPut: null ]]{ #category : 'private - dialogs' }SpWin32Backend >> nativeWindowFor: aWindowPresenterOrNil [	aWindowPresenterOrNil ifNil: [ ^ nil ].	aWindowPresenterOrNil adapter ifNil: [ ^ nil ].	^ aWindowPresenterOrNil adapter widget]{ #category : 'private - notifying' }SpWin32Backend >> messageFromNotification: aNotificationOrString [	(aNotificationOrString isString) ifTrue: [ ^ aNotificationOrString ].	(aNotificationOrString respondsTo: #message) ifTrue: [ ^ aNotificationOrString message ].	(aNotificationOrString respondsTo: #text) ifTrue: [ ^ aNotificationOrString text ].	^ aNotificationOrString asString]{ #category : 'private - cursor' }SpWin32Backend >> nativeWindowsForApplication: anApplication [	^ anApplication windows		select: [ :each |			each adapter notNil and: [				each adapter widget notNil and: [ each adapter widget isValid ] ] ]		thenCollect: [ :each | each adapter widget ]]