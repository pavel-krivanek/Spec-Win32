Class {	#name : 'SpWin32ImageAdapter',	#superclass : 'SpWin32AbstractAdapter',	#category : 'Spec-Win32-Adapters-Controls',	#package : 'Spec-Win32-Adapters',	#tag : 'Controls'}{ #category : 'factory' }SpWin32ImageAdapter >> buildWidget [	| imageData control |	imageData := self imageDataFor: self presenter image.	control := SpWin32NativeControl		runtime: SpWin32Runtime default		kind: SpWin32Runtime controlImage		text: ''		preferredExtent: (imageData ifNil: [ 64 @ 64 ] ifNotNil: [ imageData extent ]).	control		eventHandler: self;		imageAutoScale: self presenter isAutoScale;		imageData: imageData.	self presenter whenImageChangeDo: [ :newImage | self updateImage: newImage ].	^ control]{ #category : 'private' }SpWin32ImageAdapter >> imageDataFor: aFormOrNil [	^ SpWin32ImageData fromForm: aFormOrNil]{ #category : 'accessing' }SpWin32ImageAdapter >> image [	^ self presenter image]{ #category : 'private - updating' }SpWin32ImageAdapter >> updateImage: aFormOrNil [	| imageData |	imageData := self imageDataFor: aFormOrNil.	self widget imageData: imageData.	self presenter isAutoScale ifFalse: [		self widget preferredExtent: (imageData ifNil: [ 64 @ 64 ] ifNotNil: [ imageData extent ]).		self widget requestRelayout ]]{ #category : 'native events' }SpWin32ImageAdapter >> win32Clicked [	self presenter action value]