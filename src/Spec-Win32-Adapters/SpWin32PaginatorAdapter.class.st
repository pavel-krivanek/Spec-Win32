Class {	#name : 'SpWin32PaginatorAdapter',	#superclass : 'SpWin32AbstractAdapter',	#instVars : [		'pageWidth',		'paginatorHeight',		'resizingEdges',		'interactionMode',		'lastMouseX',		'transientSelectionX',		'transientSelectionWidth'	],	#category : 'Spec-Win32-Adapters-Controls',	#package : 'Spec-Win32-Adapters',	#tag : 'Controls'}{ #category : 'initialization' }SpWin32PaginatorAdapter >> initialize [	super initialize.	pageWidth := 14.	paginatorHeight := 22.	resizingEdges := true.	interactionMode := nil]{ #category : 'factory' }SpWin32PaginatorAdapter >> buildWidget [	| control initialPage |	control := SpWin32PaginatorSurfaceControl		runtime: SpWin32Runtime default		preferredExtent: self preferredPaginatorExtent		extentChangedAction: [ :newExtent | self redrawOn: control extent: newExtent ].	control eventHandler: self.	self presenter whenSelectedPageChangedDo: [ :aNumber |		self clearTransientSelection.		self redraw ].	self presenter whenVisiblePagesChangedDo: [ :aNumber |		self clearTransientSelection.		self redraw ].	self presenter whenPageAddedDo: [ :anObject |		self pageAdded ].	self presenter whenPageRemovedDo: [ :anObject |		self pagesChanged ].	self pageCount > 0 ifTrue: [		initialPage := self presenter selectedPage ifNil: [ self pageCount ].		self presenter selectPage: initialPage ].	^ control]{ #category : 'accessing' }SpWin32PaginatorAdapter >> pageWidth [	^ pageWidth]{ #category : 'accessing' }SpWin32PaginatorAdapter >> paginatorHeight [	^ paginatorHeight]{ #category : 'accessing' }SpWin32PaginatorAdapter >> pageCount [	^ self presenter pages size]{ #category : 'accessing' }SpWin32PaginatorAdapter >> effectiveVisiblePages [	self pageCount = 0 ifTrue: [ ^ 0 ].	^ (self presenter visiblePages asInteger max: 1) min: self pageCount]{ #category : 'accessing' }SpWin32PaginatorAdapter >> effectiveSelectedPage [	self pageCount = 0 ifTrue: [ ^ 0 ].	^ self clampedSelectedPage: (self presenter selectedPage ifNil: [ self pageCount ])]{ #category : 'private - selection' }SpWin32PaginatorAdapter >> clampedSelectedPage: aNumber [	| maximumStart |	self pageCount = 0 ifTrue: [ ^ 0 ].	maximumStart := (self pageCount - self effectiveVisiblePages + 1) max: 1.	^ (aNumber asInteger max: 1) min: maximumStart]{ #category : 'private - selection' }SpWin32PaginatorAdapter >> normalizeSelectionIfNeeded [	| normalized |	self pageCount = 0 ifTrue: [ ^ self ].	normalized := self effectiveSelectedPage.	self presenter selectedPage = normalized ifFalse: [		self presenter selectPage: normalized ]]{ #category : 'private - geometry' }SpWin32PaginatorAdapter >> preferredPaginatorExtent [	^ ((self pageCount max: 1) * pageWidth) @ paginatorHeight]{ #category : 'private - geometry' }SpWin32PaginatorAdapter >> selectionX [	transientSelectionX ifNotNil: [ ^ transientSelectionX ].	self pageCount = 0 ifTrue: [ ^ 0 ].	^ (self effectiveSelectedPage - 1) * pageWidth]{ #category : 'private - geometry' }SpWin32PaginatorAdapter >> selectionWidth [	transientSelectionWidth ifNotNil: [ ^ transientSelectionWidth ].	^ self effectiveVisiblePages * pageWidth]{ #category : 'private - geometry' }SpWin32PaginatorAdapter >> selectionRectangleForExtent: anExtent [	| width x |	width := self selectionWidth min: anExtent x.	x := self selectionX min: (anExtent x - width max: 0).	^ x @ 0 extent: width @ anExtent y]{ #category : 'private - colors' }SpWin32PaginatorAdapter >> panelBackgroundColor [	| configuration |	configuration := self presenter application configuration.	(configuration respondsTo: #panelBackgroundColor)		ifTrue: [ ^ configuration panelBackgroundColor ].	^ Color veryLightGray]{ #category : 'private - colors' }SpWin32PaginatorAdapter >> selectionColor [	| configuration |	configuration := self presenter application configuration.	(configuration respondsTo: #listSelectedColor)		ifTrue: [ ^ configuration listSelectedColor alpha: 0.30 ].	^ Color blue alpha: 0.30]{ #category : 'private - colors' }SpWin32PaginatorAdapter >> pageFillColor [	^ Color white alpha: 0.92]{ #category : 'private - colors' }SpWin32PaginatorAdapter >> pageBorderColor [	^ Color gray alpha: 0.65]{ #category : 'drawing' }SpWin32PaginatorAdapter >> redraw [	self widgetDo: [ :control |		self redrawOn: control extent: self currentDrawingExtent ]]{ #category : 'private - drawing' }SpWin32PaginatorAdapter >> currentDrawingExtent [	self widget isValid ifTrue: [ ^ self widget bounds extent ].	^ self widget preferredExtent]{ #category : 'private - drawing' }SpWin32PaginatorAdapter >> redrawOn: control extent: requestedExtent [	| extent canvas form selectionRect |	extent := ((requestedExtent x asInteger max: 1) @ (requestedExtent y asInteger max: 1)).	canvas := FormCanvas extent: extent depth: 32.	canvas fillRectangle: (0 @ 0 extent: extent) color: self panelBackgroundColor.	1 to: self pageCount do: [ :index |		| left rect inner |		left := (index - 1) * pageWidth.		rect := left @ 0 extent: pageWidth @ extent y.		inner := rect insetBy: 3 @ 3.		canvas			frameAndFillRectangle: inner			fillColor: self pageFillColor			borderWidth: 1			borderColor: self pageBorderColor ].	self pageCount > 0 ifTrue: [		selectionRect := self selectionRectangleForExtent: extent.		canvas fillRectangle: selectionRect color: self selectionColor.		resizingEdges ifTrue: [			canvas fillRectangle: (selectionRect left @ 2 extent: 2 @ (selectionRect height - 4 max: 1)) color: self pageBorderColor.			canvas fillRectangle: ((selectionRect right - 2) @ 2 extent: 2 @ (selectionRect height - 4 max: 1)) color: self pageBorderColor ] ].	form := canvas form.	control imageData: (SpWin32ImageData fromForm: form)]{ #category : 'private - updating' }SpWin32PaginatorAdapter >> pageAdded [	self pagesChanged.	self pageCount > 0 ifTrue: [		self presenter selectPage: (self clampedSelectedPage: self pageCount) ]]{ #category : 'private - updating' }SpWin32PaginatorAdapter >> pagesChanged [	self widgetDo: [ :control |		control preferredExtent: self preferredPaginatorExtent.		control requestRelayout ].	self clearTransientSelection.	self redraw]{ #category : 'paginator' }SpWin32PaginatorAdapter >> withoutResizingEdges [	resizingEdges := false.	self redraw]{ #category : 'testing' }SpWin32PaginatorAdapter >> hasResizingEdges [	^ resizingEdges]{ #category : 'private - interaction' }SpWin32PaginatorAdapter >> clearTransientSelection [	transientSelectionX := nil.	transientSelectionWidth := nil.	interactionMode := nil.	lastMouseX := nil]{ #category : 'private - interaction' }SpWin32PaginatorAdapter >> interactionModeForX: x [	| left right grip |	self pageCount = 0 ifTrue: [ ^ #none ].	left := self selectionX.	right := left + self selectionWidth.	grip := 4.	resizingEdges ifTrue: [		((x - left) abs <= grip) ifTrue: [ ^ #resizeLeft ].		((x - right) abs <= grip) ifTrue: [ ^ #resizeRight ] ].	(x between: left and: right) ifTrue: [ ^ #drag ].	^ #page]{ #category : 'private - interaction' }SpWin32PaginatorAdapter >> beginInteractionAt: aPoint [	| mode page |	self presenter isEnabled ifFalse: [ ^ self ].	mode := self interactionModeForX: aPoint x.	mode = #none ifTrue: [ ^ self ].	mode = #page ifTrue: [		page := ((aPoint x // pageWidth) + 1 max: 1) min: self pageCount.		self presenter selectPage: (self clampedSelectedPage: page).		^ self ].	interactionMode := mode.	lastMouseX := aPoint x.	transientSelectionX := self selectionX.	transientSelectionWidth := self selectionWidth]{ #category : 'private - interaction' }SpWin32PaginatorAdapter >> continueInteractionAt: aPoint [	| delta maxX newX right newWidth minimumWidth oldX widgetWidth deltaPercent |	interactionMode ifNil: [ ^ self ].	lastMouseX ifNil: [ ^ self ].	delta := aPoint x - lastMouseX.	delta = 0 ifTrue: [ ^ self ].	widgetWidth := self currentDrawingExtent x max: 1.	minimumWidth := pageWidth.	interactionMode = #drag ifTrue: [		maxX := (self pageCount * pageWidth - transientSelectionWidth) max: 0.		oldX := transientSelectionX.		newX := (transientSelectionX + delta max: 0) min: maxX.		transientSelectionX := newX.		deltaPercent := (newX - oldX) * 100.0 / widgetWidth.		deltaPercent ~= 0 ifTrue: [ self presenter dragging: deltaPercent ] ].	interactionMode = #resizeLeft ifTrue: [		right := transientSelectionX + transientSelectionWidth.		newX := (transientSelectionX + delta max: 0) min: (right - minimumWidth).		transientSelectionWidth := right - newX.		transientSelectionX := newX ].	interactionMode = #resizeRight ifTrue: [		newWidth := (transientSelectionWidth + delta max: minimumWidth)			min: ((self pageCount * pageWidth) - transientSelectionX).		transientSelectionWidth := newWidth ].	lastMouseX := aPoint x.	self redraw]{ #category : 'private - interaction' }SpWin32PaginatorAdapter >> finishInteraction [	| newVisible newSelected |	interactionMode ifNil: [ ^ self ].	newVisible := ((transientSelectionWidth / pageWidth) rounded max: 1) min: self pageCount.	newSelected := ((transientSelectionX / pageWidth) rounded + 1 max: 1).	self clearTransientSelection.	self presenter visiblePages ~= newVisible ifTrue: [		self presenter visiblePages: newVisible ].	self presenter selectPage: (self clampedSelectedPage: newSelected).	self redraw]{ #category : 'private - interaction' }SpWin32PaginatorAdapter >> cancelInteraction [	interactionMode ifNil: [ ^ self ].	self clearTransientSelection.	self redraw]{ #category : 'native events' }SpWin32PaginatorAdapter >> win32MouseEventType: eventType position: position button: button modifiers: modifiers [	super win32MouseEventType: eventType position: position button: button modifiers: modifiers.	eventType = SpWin32Runtime eventMouseDown ifTrue: [		button = 1 ifTrue: [ self beginInteractionAt: position ].		^ self ].	eventType = SpWin32Runtime eventMouseMove ifTrue: [		self continueInteractionAt: position.		^ self ].	eventType = SpWin32Runtime eventMouseUp ifTrue: [		interactionMode ifNotNil: [ self finishInteraction ].		^ self ].	eventType = SpWin32Runtime eventMouseLeave ifTrue: [		self cancelInteraction ]]{ #category : 'native events' }SpWin32PaginatorAdapter >> win32Clicked [	"The shared native Image surface emits a convenience click event for SpImagePresenter.	Paginator interaction is handled by the generic mouse event stream."]