Class {	#name : 'SpWin32TreeTableAdapter',	#superclass : 'SpWin32AbstractAdapter',	#instVars : [		'visibleItems',		'visiblePaths',		'expandedPaths',		'probedPaths',		'sortColumnIndex',		'sortDescending'	],	#category : 'Spec-Win32-Adapters-Controls',	#package : 'Spec-Win32-Adapters',	#tag : 'Controls'}{ #category : 'initialization' }SpWin32TreeTableAdapter >> initialize [	super initialize.	visibleItems := #().	visiblePaths := #().	expandedPaths := Set new.	probedPaths := Set new.	sortColumnIndex := nil.	sortDescending := false]{ #category : 'factory' }SpWin32TreeTableAdapter >> buildWidget [	| control |	self rebuildVisibleRows.	control := SpWin32NativeTableControl		runtime: SpWin32Runtime default		kind: SpWin32Runtime controlTable		text: ''		preferredExtent: 360 @ 190.	control		eventHandler: self;		items: visibleItems;		multipleSelection: self presenter selection isMultipleSelection.	self configureColumnsOn: control.	self configureCellsOn: control.	self refreshSelectionOn: control.	self presenter whenRootsChangedDo: [ self rootsChanged ].	self presenter whenColumnsChangedDo: [ self refreshColumns ].	self presenter whenShowColumnHeadersChangedDo: [ self refreshColumns ].	self presenter whenIsResizableChangedDo: [ self refreshColumns ].	self presenter whenSelectionChangedDo: [ self refreshSelection ].	self presenter whenMultiSelectionChangedDo: [ self refreshSelectionMode ].	^ control]{ #category : 'private - rows' }SpWin32TreeTableAdapter >> rebuildVisibleRows [	| items paths |	items := OrderedCollection new.	paths := OrderedCollection new.	self		appendItems: self presenter roots		parentPath: #()		toItems: items		paths: paths.	visibleItems := items asArray.	visiblePaths := paths asArray]{ #category : 'private - rows' }SpWin32TreeTableAdapter >> appendItems: aCollection parentPath: parentPath toItems: items paths: paths [	(self sortedIndexedItems: aCollection) do: [ :association |		| index item path children |		index := association key.		item := association value.		path := parentPath , { index }.		items add: item.		paths add: path.		(expandedPaths includes: path) ifTrue: [			probedPaths add: path.			children := self presenter childrenFor: item.			self appendItems: children parentPath: path toItems: items paths: paths ] ]]{ #category : 'private - sorting' }SpWin32TreeTableAdapter >> sortedIndexedItems: aCollection [	| indexed column function |	indexed := aCollection withIndexCollect: [ :item :index | index -> item ].	sortColumnIndex ifNil: [ ^ indexed ].	(sortColumnIndex between: 1 and: self presenter columns size) ifFalse: [ ^ indexed ].	column := self presenter columns at: sortColumnIndex.	column isSortable ifFalse: [ ^ indexed ].	function := column sortFunction.	function ifNil: [ ^ indexed ].	sortDescending ifTrue: [ function := function reversed ].	^ indexed sorted: [ :left :right | function value: left value value: right value ]]{ #category : 'private - rows' }SpWin32TreeTableAdapter >> ensureAncestorsExpandedFor: aPath [	1 to: (aPath size - 1 max: 0) do: [ :depth |		expandedPaths add: (aPath first: depth) asArray ]]{ #category : 'private - rows' }SpWin32TreeTableAdapter >> visibleIndexForPath: aPath [	^ visiblePaths indexOf: aPath asArray ifAbsent: [ 0 ]]{ #category : 'private - rows' }SpWin32TreeTableAdapter >> pathAtVisibleIndex: anIndex [	(anIndex between: 1 and: visiblePaths size) ifFalse: [ ^ nil ].	^ visiblePaths at: anIndex]{ #category : 'accessing' }SpWin32TreeTableAdapter >> itemAtPath: aPath [	^ self presenter		itemAt: aPath first		of: self presenter roots		then: aPath allButFirst]{ #category : 'accessing' }SpWin32TreeTableAdapter >> selectedItem [	| paths |	paths := self selectedPaths.	paths ifEmpty: [ ^ nil ].	^ self itemAtPath: paths last]{ #category : 'accessing' }SpWin32TreeTableAdapter >> selectedPaths [	^ self presenter selection selectedPaths]{ #category : 'accessing' }SpWin32TreeTableAdapter >> firstSelectedPath [	^ self selectedPaths ifEmpty: [ nil ] ifNotEmpty: [ :paths | paths first ]]{ #category : 'accessing' }SpWin32TreeTableAdapter >> columnCount [	^ self effectiveColumnCount]{ #category : 'accessing' }SpWin32TreeTableAdapter >> displayItems [	^ visibleItems]{ #category : 'selection' }SpWin32TreeTableAdapter >> selectPath: aPath [	aPath ifEmpty: [		self presenter selection unselectAll.		^ self ].	self presenter selection selectPath: aPath.	self refreshSelection]{ #category : 'selection' }SpWin32TreeTableAdapter >> refreshSelection [	self refreshSelectionOn: self widget]{ #category : 'selection' }SpWin32TreeTableAdapter >> refreshSelectionOn: control [	| selected visibleIndexes |	control ifNil: [ ^ self ].	selected := self presenter selection selectedPaths.	selected do: [ :path | self ensureAncestorsExpandedFor: path ].	self rebuildVisibleRows.	self configureCellsOn: control.	visibleIndexes := (selected collect: [ :path | self visibleIndexForPath: path ])		reject: [ :index | index = 0 ].	control selectedIndexes: visibleIndexes]{ #category : 'selection' }SpWin32TreeTableAdapter >> refreshSelectionMode [	self widget multipleSelection: self presenter selection isMultipleSelection.	self refreshSelection]{ #category : 'native events' }SpWin32TreeTableAdapter >> win32ListSelectionChanged: selectedIndexes changedIndex: changedIndex selected: isSelected [	| paths |	paths := selectedIndexes collect: [ :index | self pathAtVisibleIndex: index ].	paths := paths reject: [ :path | path isNil ].	self presenter selection selectPaths: paths.	self presenter isActiveOnSingleClick ifTrue: [		(self pathAtVisibleIndex: changedIndex) ifNotNil: [ :path |			isSelected ifTrue: [ self presenter doActivateAtPath: path ] ] ]]{ #category : 'native events' }SpWin32TreeTableAdapter >> win32ActivatedAt: rowIndex source: source [	| path |	path := self pathAtVisibleIndex: rowIndex.	path ifNil: [ ^ self ].	(source = 2 or: [ self presenter isActiveOnDoubleClick ]) ifTrue: [		self presenter doActivateAtPath: path ]]{ #category : 'native events' }SpWin32TreeTableAdapter >> win32ColumnClicked: anIndex [	self clickOnColumnHeaderAt: anIndex]{ #category : 'expanding' }SpWin32TreeTableAdapter >> expandPath: aPath [	| path |	path := aPath asArray.	(self pathExists: path) ifFalse: [ ^ self ].	expandedPaths add: path.	probedPaths add: path.	self refreshRowsPreservingSelection]{ #category : 'expanding' }SpWin32TreeTableAdapter >> collapsePath: aPath [	expandedPaths remove: aPath asArray ifAbsent: [ ].	self refreshRowsPreservingSelection]{ #category : 'expanding' }SpWin32TreeTableAdapter >> expandRoots [	1 to: self presenter roots size do: [ :index | expandedPaths add: { index } ].	self refreshRowsPreservingSelection]{ #category : 'expanding' }SpWin32TreeTableAdapter >> expandAll [	self addAllExpandablePathsOf: self presenter roots parentPath: #().	self refreshRowsPreservingSelection]{ #category : 'private - expanding' }SpWin32TreeTableAdapter >> addAllExpandablePathsOf: items parentPath: parentPath [	items withIndexDo: [ :item :index |		| path children |		path := parentPath , { index }.		children := self presenter childrenFor: item.		children ifNotEmpty: [			expandedPaths add: path.			probedPaths add: path.			self addAllExpandablePathsOf: children parentPath: path ] ]]{ #category : 'expanding' }SpWin32TreeTableAdapter >> collapseAll [	expandedPaths removeAll.	self refreshRowsPreservingSelection]{ #category : 'testing' }SpWin32TreeTableAdapter >> isExpanded: aPath [	^ expandedPaths includes: aPath asArray]{ #category : 'testing' }SpWin32TreeTableAdapter >> isRowMorphExpandableAt: aRow [	| path item |	path := self pathAtVisibleIndex: aRow.	path ifNil: [ ^ false ].	(self presenter shouldLazilyComputeChildren and: [ (probedPaths includes: path) not ])		ifTrue: [ ^ true ].	item := self itemAtPath: path.	^ (self presenter childrenFor: item) notEmpty]{ #category : 'expanding' }SpWin32TreeTableAdapter >> expandRowAt: aRow [	| path |	path := self pathAtVisibleIndex: aRow.	path ifNil: [ ^ self ].	probedPaths add: path.	(self presenter childrenFor: (self itemAtPath: path))		ifEmpty: [ expandedPaths remove: path ifAbsent: [ ] ]		ifNotEmpty: [ expandedPaths add: path ].	self refreshRowsPreservingSelection]{ #category : 'private - rows' }SpWin32TreeTableAdapter >> pathExists: aPath [	^ [ self itemAtPath: aPath. true ]		on: SubscriptOutOfBounds		do: [ false ]]{ #category : 'scrolling' }SpWin32TreeTableAdapter >> scrollToSelection [	| path index |	path := self presenter selection selectedPath.	(path isNil or: [ path isEmpty ]) ifTrue: [ ^ self ].	self ensureAncestorsExpandedFor: path.	self rebuildVisibleRows.	self configureCellsOn: self widget.	index := self visibleIndexForPath: path.	index > 0 ifTrue: [ self widget ensureVisibleIndex: index ]]{ #category : 'private - columns' }SpWin32TreeTableAdapter >> effectiveColumnCount [	^ self presenter columns ifEmpty: [ 1 ] ifNotEmpty: [ :columns | columns size ]]{ #category : 'private - columns' }SpWin32TreeTableAdapter >> columnTitles [	self presenter columns ifEmpty: [ ^ #('') ].	^ self presenter columns collect: [ :column | column title ifNil: [ '' ] ]]{ #category : 'private - columns' }SpWin32TreeTableAdapter >> columnWidths [	self presenter columns ifEmpty: [ ^ #(220) ].	^ self presenter columns collect: [ :column | column width ifNil: [ 110 ] ]]{ #category : 'private - columns' }SpWin32TreeTableAdapter >> columnExpandables [	self presenter columns ifEmpty: [ ^ #(true) ].	^ self presenter columns collect: [ :column | column isExpandable ]]{ #category : 'private - columns' }SpWin32TreeTableAdapter >> columnAlignments [	self presenter columns ifEmpty: [ ^ #(0) ].	^ self presenter columns withIndexCollect: [ :column :index |		index = 1 ifTrue: [ 0 ] ifFalse: [ self alignmentCodeFor: column ] ]]{ #category : 'private - columns' }SpWin32TreeTableAdapter >> alignmentCodeFor: aColumn [	| block alignment sample |	block := aColumn displayAlignment.	block ifNil: [ ^ 0 ].	visibleItems ifEmpty: [ ^ 0 ].	sample := visibleItems first.	alignment := block cull: sample.	alignment == SpColumnAlignment right ifTrue: [ ^ 1 ].	alignment == SpColumnAlignment center ifTrue: [ ^ 2 ].	^ 0]{ #category : 'private - columns' }SpWin32TreeTableAdapter >> configureColumnsOn: control [	control		columnsTitles: self columnTitles		widths: self columnWidths		alignments: self columnAlignments		expandables: self columnExpandables		headersVisible: self presenter isShowingColumnHeaders		resizable: self presenter isResizable]{ #category : 'private - cells' }SpWin32TreeTableAdapter >> configureCellsOn: control [	| cells columns |	columns := self effectiveColumnCount.	cells := OrderedCollection new: visibleItems size * columns.	visibleItems withIndexDo: [ :item :row |		1 to: columns do: [ :columnIndex |			cells add: (self displayStringFor: item path: (visiblePaths at: row) row: row column: columnIndex) ] ].	control		items: visibleItems;		cells: cells asArray rowCount: visibleItems size columnCount: columns]{ #category : 'private - cells' }SpWin32TreeTableAdapter >> displayStringFor: item path: path row: rowIndex column: columnIndex [	| text prefix column value parts |	self presenter columns ifEmpty: [ text := item displayString ] ifNotEmpty: [		column := self presenter columns at: columnIndex.		(column isKindOf: SpIndexTableColumn)			ifTrue: [ text := rowIndex asString ]			ifFalse: [				(column isKindOf: SpCheckBoxTableColumn)					ifTrue: [						value := column evaluateObject: item.						text := value = true ifTrue: [ '☑' ] ifFalse: [ '☐' ] ]					ifFalse: [						column isComposite							ifTrue: [								parts := column columns collect: [ :nested | self textualValueFor: nested item: item ].								text := (parts reject: #isEmpty) joinUsing: ' ' ]							ifFalse: [								(column isKindOf: SpImageTableColumn)									ifTrue: [ text := '' ]									ifFalse: [ text := self textualValueFor: column item: item ] ] ] ] ].	columnIndex = 1 ifFalse: [ ^ text ].	prefix := String new: ((path size - 1) * 2) withAll: Character space.	(self isPathExpandable: path)		ifTrue: [ prefix := prefix , ((expandedPaths includes: path) ifTrue: [ '▼ ' ] ifFalse: [ '▶ ' ]) ]		ifFalse: [ prefix := prefix , '  ' ].	^ prefix , text]{ #category : 'private - cells' }SpWin32TreeTableAdapter >> textualValueFor: aColumn item: item [	| value |	value := aColumn readObject: item.	^ value ifNil: [ '' ] ifNotNil: [ value asString ]]{ #category : 'private - rows' }SpWin32TreeTableAdapter >> isPathExpandable: path [	(self presenter shouldLazilyComputeChildren and: [ (probedPaths includes: path) not ])		ifTrue: [ ^ true ].	^ (self presenter childrenFor: (self itemAtPath: path)) notEmpty]{ #category : 'refreshing' }SpWin32TreeTableAdapter >> refreshRowsPreservingSelection [	self rebuildVisibleRows.	self configureCellsOn: self widget.	self refreshSelectionRowsOnly]{ #category : 'selection' }SpWin32TreeTableAdapter >> refreshSelectionRowsOnly [	| indexes |	indexes := (self presenter selection selectedPaths collect: [ :path | self visibleIndexForPath: path ])		reject: [ :index | index = 0 ].	self widget selectedIndexes: indexes]{ #category : 'refreshing' }SpWin32TreeTableAdapter >> rootsChanged [	expandedPaths removeAll.	probedPaths removeAll.	self rebuildVisibleRows.	self configureCellsOn: self widget.	self refreshSelectionRowsOnly]{ #category : 'refreshing' }SpWin32TreeTableAdapter >> refreshColumns [	(sortColumnIndex notNil and: [ sortColumnIndex > self presenter columns size ]) ifTrue: [		sortColumnIndex := nil.		sortDescending := false ].	self configureColumnsOn: self widget.	self refreshRowsPreservingSelection]{ #category : 'sorting' }SpWin32TreeTableAdapter >> clickOnColumnHeaderAt: anIndex [	| column |	(anIndex between: 1 and: self presenter columns size) ifFalse: [ ^ self ].	column := self presenter columns at: anIndex.	column isSortable ifFalse: [ ^ self ].	sortColumnIndex = anIndex		ifTrue: [ sortDescending := sortDescending not ]		ifFalse: [ sortColumnIndex := anIndex. sortDescending := false ].	self refreshRowsPreservingSelection]{ #category : 'testing' }SpWin32TreeTableAdapter >> isNonEditableRow: aRow column: aColumn [	^ true]{ #category : 'testing' }SpWin32TreeTableAdapter >> isShowingColumnHeaders [	^ self presenter isShowingColumnHeaders]{ #category : 'testing' }SpWin32TreeTableAdapter >> isResizable [	^ self presenter isResizable]{ #category : 'protocol compatibility' }SpWin32TreeTableAdapter >> alternateRowsColor [	"Native alternate-row custom drawing is not implemented yet."]{ #category : 'protocol compatibility' }SpWin32TreeTableAdapter >> updateMenu [ ]