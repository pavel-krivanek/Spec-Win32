Class {	#name : 'SpWin32DialogWindowAdapter',	#superclass : 'SpWin32WindowAdapter',	#category : 'Spec-Win32-Adapters-Windows',	#package : 'Spec-Win32-Adapters',	#tag : 'Windows'}{ #category : 'initialization' }SpWin32DialogWindowAdapter >> adapt: aPresenter [	super adapt: aPresenter.	self addActionGroup: self defaultActionGroup.	aPresenter whenButtonDecorationsChangedDo: [		self updateButtonDecorations ]]{ #category : 'protocol' }SpWin32DialogWindowAdapter >> addPresenterIn: aWindow withSpecLayout: aSpec [	| clientExtent |	self presenter initialPosition ifNotNil: [ :p |		aWindow moveTo: p extent: self presenter initialExtent ].	contentWidget := self buildDialogContainerWithSpecLayout: aSpec.	clientExtent := SpWin32Runtime default windowClientExtent: aWindow.	contentWidget realizeIn: aWindow extent: clientExtent]{ #category : 'private - building' }SpWin32DialogWindowAdapter >> buildDialogContainerWithSpecLayout: aSpec [	| mainContent buttonWidgets container |	mainContent := self presenter presenter buildWithLayout: aSpec.	buttonWidgets := self presenter buttons collect: [ :buttonPresenter |		buttonPresenter build ].	self presenter defaultButton ifNotNil: [ :defaultButton |		defaultButton adapter ifNotNil: [ :adapter |			(adapter respondsTo: #setAsDefault) ifTrue: [ adapter setAsDefault ] ] ].	container := SpWin32DialogContainer		content: mainContent		buttons: buttonWidgets		runtime: SpWin32Runtime default.	container buttonsVisible: self presenter hasButtonDecorations.	^ container]{ #category : 'private - actions' }SpWin32DialogWindowAdapter >> cancelFromKeyboard [	self presenter		beCancel;		triggerCancelAction.	self presenter isClosed ifFalse: [ self presenter close ]]{ #category : 'protocol' }SpWin32DialogWindowAdapter >> centeredRelativeTo: aWindowPresenter [	aWindowPresenter ifNil: [ ^ self centered ].	self ownerWindow: aWindowPresenter.	super centeredRelativeTo: aWindowPresenter]{ #category : 'private - actions' }SpWin32DialogWindowAdapter >> defaultActionGroup [	^ SpActionGroup new		name: 'win32DialogActions';		addShortcutWith: [ :action |			action				name: 'cancelDialog';				shortcutKey: Character escape asKeyCombination;				action: [ self cancelFromKeyboard ] ];		addShortcutWith: [ :action |			action				name: 'acceptDialog';				shortcutKey: Character cr asKeyCombination;				action: [ self defaultFromKeyboard ] ];		yourself]{ #category : 'private - actions' }SpWin32DialogWindowAdapter >> defaultFromKeyboard [	self presenter hasDefaultButton ifFalse: [ ^ self ].	self presenter		executeDefaultAction;		beOk]{ #category : 'protocol' }SpWin32DialogWindowAdapter >> rebuildWithSpecLayout: aSpec [	contentWidget ifNotNil: [ :old |		(old respondsTo: #destroy) ifTrue: [ old destroy ] ].	contentWidget := self buildDialogContainerWithSpecLayout: aSpec.	contentWidget		realizeIn: self widget		extent: (SpWin32Runtime default windowClientExtent: self widget)]{ #category : 'updating' }SpWin32DialogWindowAdapter >> updateButtonDecorations [	contentWidget ifNotNil: [ :container |		(container respondsTo: #buttonsVisible:) ifTrue: [			container buttonsVisible: self presenter hasButtonDecorations ] ]]