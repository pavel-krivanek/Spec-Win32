Class {	#name : 'SpWin32ActionBarAdapter',	#superclass : 'SpWin32AbstractAdapter',	#instVars : [		'leftWidgets',		'rightWidgets',		'centerWidget'	],	#category : 'Spec-Win32-Adapters-Controls',	#package : 'Spec-Win32-Adapters',	#tag : 'Controls'}{ #category : 'factory' }SpWin32ActionBarAdapter >> buildWidget [	| bar |	leftWidgets := (self presenter items at: #start ifAbsent: [ #() ]) collect: [ :each | each build ].	rightWidgets := (self presenter items at: #end ifAbsent: [ #() ]) collect: [ :each | each build ].	centerWidget := self buildCenterWidget.	bar := SpWin32ActionBarContainer runtime: SpWin32Runtime default.	bar leftWidgets: leftWidgets rightWidgets: rightWidgets centerWidget: centerWidget.	self presenter whenCenterPresenterChangedDo: [ :aPresenter | self updateCenterPresenter: aPresenter ].	^ bar]{ #category : 'private - building' }SpWin32ActionBarAdapter >> buildCenterWidget [	^ self presenter centerPresenter		ifNil: [ nil ]		ifNotNil: [ :aPresenter | aPresenter build ]]{ #category : 'updating' }SpWin32ActionBarAdapter >> updateCenterPresenter: aPresenter [	centerWidget ifNotNil: [ :oldWidget |		(oldWidget respondsTo: #destroy) ifTrue: [ oldWidget destroy ] ].	centerWidget := aPresenter ifNil: [ nil ] ifNotNil: [ aPresenter build ].	self widgetDo: [ :bar |		bar leftWidgets: leftWidgets rightWidgets: rightWidgets centerWidget: centerWidget ]]