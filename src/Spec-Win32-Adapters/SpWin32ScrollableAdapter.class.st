Class {	#name : 'SpWin32ScrollableAdapter',	#superclass : 'SpWin32LayoutAdapter',	#category : 'Spec-Win32-Adapters-Layout',	#package : 'Spec-Win32-Adapters',	#tag : 'Layout'}{ #category : 'accessing' }SpWin32ScrollableAdapter >> add: aPresenter constraints: constraints [	| childWidget |	aPresenter owner: self model.	childWidget := aPresenter buildWithSelector: constraints spec.	widget child: childWidget]{ #category : 'factory' }SpWin32ScrollableAdapter >> adapterWasBuilt []{ #category : 'test support' }SpWin32ScrollableAdapter >> childWidget [	^ widget child]{ #category : 'factory' }SpWin32ScrollableAdapter >> layout: aLayout [	layout := aLayout.	widget ifNil: [		widget := SpWin32ScrollableContainer			layout: aLayout			runtime: SpWin32Runtime default ].	aLayout whenChildrenAddedDo: [ :announcement |		self add: announcement child constraints: (aLayout constraintsFor: announcement child) ].	aLayout whenChildrenRemovedDo: [ :announcement |		announcement child adapter ifNotNil: [ :adapter |			widget removeChildWidget: adapter widget ] ]]{ #category : 'accessing' }SpWin32ScrollableAdapter >> removeAll [	widget child ifNotNil: [ :current | widget removeChildWidget: current ]]{ #category : 'factory' }SpWin32ScrollableAdapter >> removeSubWidgets [	self removeAll]{ #category : 'scrolling' }SpWin32ScrollableAdapter >> scrollTo: aPoint [	widget scrollTo: aPoint]