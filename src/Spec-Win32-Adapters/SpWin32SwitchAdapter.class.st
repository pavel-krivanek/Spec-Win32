Class {	#name : 'SpWin32SwitchAdapter',	#superclass : 'SpWin32AbstractAdapter',	#category : 'Spec-Win32-Adapters-Controls',	#package : 'Spec-Win32-Adapters',	#tag : 'Controls'}{ #category : 'factory' }SpWin32SwitchAdapter >> buildWidget [	| control |	control := SpWin32NativeControl		runtime: SpWin32Runtime default		kind: SpWin32Runtime controlSwitch		text: ''		preferredExtent: 46 @ 24.	control		eventHandler: self;		checked: self presenter state.	self presenter whenChangedDo: [ self updateState ].	^ control]{ #category : 'emulating' }SpWin32SwitchAdapter >> clicked [	self win32Toggled: self presenter state not]{ #category : 'accessing' }SpWin32SwitchAdapter >> state [	^ self presenter state]{ #category : 'accessing' }SpWin32SwitchAdapter >> state: aBoolean [	^ self presenter state: aBoolean]{ #category : 'private - updating' }SpWin32SwitchAdapter >> updateState [	self widget checked: self presenter state]{ #category : 'native events' }SpWin32SwitchAdapter >> win32Toggled: aBoolean [	self presenter state: aBoolean]