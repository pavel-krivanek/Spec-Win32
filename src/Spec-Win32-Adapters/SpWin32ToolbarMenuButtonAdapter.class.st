Class {	#name : 'SpWin32ToolbarMenuButtonAdapter',	#superclass : 'SpWin32ToolbarBaseButtonAdapter',	#category : 'Spec-Win32-Adapters-Toolbar',	#package : 'Spec-Win32-Adapters',	#tag : 'Toolbar'}{ #category : 'factory' }SpWin32ToolbarMenuButtonAdapter >> buildWidget [	| text iconData control |	text := self getLabelText.	iconData := self imageDataForCurrentMode.	control := SpWin32NativeControl		runtime: SpWin32Runtime default		kind: SpWin32Runtime controlButton		text: text		preferredExtent: (self preferredExtentForText: text iconData: iconData).	control		eventHandler: self;		imageData: iconData.	self presenter whenLabelChangedDo: [ self updateLabel ].	self presenter whenIconChangedDo: [ self updateIcon ].	^ control]{ #category : 'updating' }SpWin32ToolbarMenuButtonAdapter >> updateActions [	"Actions are intentionally resolved when the popup opens, including dynamic groups."	^ self]{ #category : 'native events' }SpWin32ToolbarMenuButtonAdapter >> win32Clicked [	self showMenu]{ #category : 'emulating' }SpWin32ToolbarMenuButtonAdapter >> clicked [ self showMenu ]{ #category : 'private' }SpWin32ToolbarMenuButtonAdapter >> menuEntries [	| actions legacyMenu |	actions := self presenter actions.	actions ifNotNil: [		^ (SpWin32MenuBuilder for: self presenter) entriesForActionGroup: actions ].	(self presenter respondsTo: #menu) ifTrue: [		legacyMenu := self presenter menu.		legacyMenu ifNotNil: [			legacyMenu := (legacyMenu isBlock or: [ legacyMenu isMessageSend ])				ifTrue: [ legacyMenu value ]				ifFalse: [ legacyMenu ].			legacyMenu ifNotNil: [				^ (SpWin32MenuBuilder for: self presenter) entriesForMenuPresenter: legacyMenu ] ] ].	^ #()]{ #category : 'private' }SpWin32ToolbarMenuButtonAdapter >> showMenu [	| entries bounds selected |	entries := self menuEntries.	entries ifEmpty: [ ^ false ].	self widget isValid ifFalse: [ ^ false ].	bounds := SpWin32Runtime default screenBoundsOf: self widget.	selected := SpWin32Runtime default		showPopupMenuEntries: entries		owner: self widget		at: bounds bottomLeft.	selected ifNil: [ ^ false ].	selected execute.	^ true]