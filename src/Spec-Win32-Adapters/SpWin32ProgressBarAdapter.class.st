Class {	#name : 'SpWin32ProgressBarAdapter',	#superclass : 'SpWin32AbstractAdapter',	#instVars : [		'progressProcess',		'progressState'	],	#category : 'Spec-Win32-Adapters-Controls',	#package : 'Spec-Win32-Adapters',	#tag : 'Controls'}{ #category : 'factory' }SpWin32ProgressBarAdapter >> buildWidget [	| control |	control := SpWin32NativeControl		runtime: SpWin32Runtime default		kind: SpWin32Runtime controlProgress		text: ''		preferredExtent: 160 @ 22.	self applyState: self presenter state to: control.	self presenter whenValueChangedDo: [ self updateState ].	^ control]{ #category : 'private - state' }SpWin32ProgressBarAdapter >> applyState: aState to: aControl [	aState ifNil: [		aControl indeterminate: false; normalizedValue: 0.		^ self ].	(aState isKindOf: SpFixedProgressBarState) ifTrue: [		aControl indeterminate: false.		aControl normalizedValue: aState value.		^ self ].	(aState isKindOf: SpIndeterminatedProgressBarState) ifTrue: [		aControl indeterminate: true.		^ self ].	(aState isKindOf: SpProgressingProgressBarState) ifTrue: [		aControl indeterminate: false.		aControl normalizedValue: aState currentValue.		^ self ]]{ #category : 'private - state' }SpWin32ProgressBarAdapter >> startProgressingState: aState [	progressState := aState.	progressProcess := [		[ progressState == aState ] whileTrue: [			| value |			value := (aState progression value asFloat max: 0.0) min: 1.0.			aState currentValue: value.			self widget ifNotNil: [ :control | control normalizedValue: value ].			value >= 1.0 ifTrue: [ progressState := nil ].			progressState == aState ifTrue: [ aState refreshDelay wait ] ]	] forkAt: Processor userBackgroundPriority named: 'Spec Win32 progress bar'.]{ #category : 'private - state' }SpWin32ProgressBarAdapter >> stopProgressProcess [	progressState := nil.	progressProcess ifNotNil: [ :process |		process isTerminated ifFalse: [ process terminate ] ].	progressProcess := nil]{ #category : 'updating' }SpWin32ProgressBarAdapter >> updateState [	| state |	self stopProgressProcess.	state := self presenter state.	self widgetDo: [ :control | self applyState: state to: control ].	(state isKindOf: SpProgressingProgressBarState) ifTrue: [		self startProgressingState: state ]]{ #category : 'debug' }SpWin32ProgressBarAdapter >> widgetValue [	^ self widget normalizedValue]{ #category : 'debug' }SpWin32ProgressBarAdapter >> widgetIsIndeterminate [	^ self widget indeterminate]