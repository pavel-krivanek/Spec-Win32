Class {	#name : 'SpWin32TabAdapter',	#superclass : 'SpWin32LayoutAdapter',	#instVars : [		'lastPage'	],	#category : 'Spec-Win32-Adapters-Layout',	#package : 'Spec-Win32-Adapters',	#tag : 'Layout'}{ #category : 'accessing' }SpWin32TabAdapter >> add: aPresenter constraints: constraints [	| childWidget |	aPresenter owner: self model.	childWidget := aPresenter buildWithSelector: constraints spec.	widget addPageWidget: childWidget constraints: constraints]{ #category : 'factory' }SpWin32TabAdapter >> adapterWasBuilt [	| index |	layout children ifEmpty: [		lastPage := nil.		widget selectedIndex: 0.		^ self ].	index := (layout initialPageIndex asInteger max: 1) min: layout children size.	widget selectedIndex: index.	lastPage := layout children at: index]{ #category : 'private - events' }SpWin32TabAdapter >> announceSelectionAt: anIndex [	| newPage |	newPage := (anIndex between: 1 and: layout children size)		ifTrue: [ layout children at: anIndex ]		ifFalse: [ nil ].	lastPage == newPage ifTrue: [ ^ self ].	lastPage ifNotNil: [		layout announce: (SpTabUnselected newPresenter: lastPage) ].	lastPage := newPage.	lastPage ifNotNil: [		layout announce: (SpTabSelected newPresenter: lastPage) ]]{ #category : 'factory' }SpWin32TabAdapter >> layout: aLayout [	layout := aLayout.	widget ifNil: [		widget := SpWin32TabContainer			layout: aLayout			runtime: SpWin32Runtime default			eventHandler: self ].	aLayout whenChildrenAddedDo: [ :announcement |		self add: announcement child constraints: (aLayout constraintsFor: announcement child) ].	aLayout whenChildrenRemovedDo: [ :announcement |		self remove: announcement child ]]{ #category : 'private - removing' }SpWin32TabAdapter >> nativeWidgetFor: aPresenterOrLayout [	(aPresenterOrLayout respondsTo: #adapter) ifTrue: [		aPresenterOrLayout adapter ifNotNil: [ :adapter | ^ adapter widget ] ].	(aPresenterOrLayout respondsTo: #widget) ifTrue: [ ^ aPresenterOrLayout widget ].	^ nil]{ #category : 'removing' }SpWin32TabAdapter >> remove: aPresenter [	| oldPage childWidget |	oldPage := lastPage.	childWidget := self nativeWidgetFor: aPresenter.	childWidget ifNotNil: [ widget removePageWidget: childWidget ].	lastPage := oldPage.	self announceSelectionAt: widget selectedIndex]{ #category : 'accessing' }SpWin32TabAdapter >> removeAll [	| oldPage |	oldPage := lastPage.	widget removeAll.	lastPage := oldPage.	self announceSelectionAt: 0]{ #category : 'factory' }SpWin32TabAdapter >> removeSubWidgets [	self removeAll]{ #category : 'accessing' }SpWin32TabAdapter >> selectIndex: anInteger [	(anInteger between: 1 and: layout children size) ifFalse: [ ^ self ].	widget selectedIndex = anInteger ifTrue: [ ^ self ].	widget selectedIndex: anInteger.	self announceSelectionAt: anInteger]{ #category : 'native events' }SpWin32TabAdapter >> win32SelectionChanged: anInteger [	widget selectionChangedFromNative.	self announceSelectionAt: anInteger]