Class {	#name : 'SpWin32FrameLayoutAdapter',	#superclass : 'SpWin32LayoutAdapter',	#category : 'Spec-Win32-Adapters-Layout',	#package : 'Spec-Win32-Adapters',	#tag : 'Layout'}{ #category : 'accessing' }SpWin32FrameLayoutAdapter >> add: aPresenter constraints: constraints [	| childWidget |	aPresenter owner: self model.	childWidget := aPresenter buildWithSelector: constraints spec.	widget child: childWidget constraints: constraints]{ #category : 'factory' }SpWin32FrameLayoutAdapter >> adapterWasBuilt []{ #category : 'factory' }SpWin32FrameLayoutAdapter >> layout: aLayout [	layout := aLayout.	widget ifNil: [		widget := SpWin32FrameContainer			layout: aLayout			runtime: SpWin32Runtime default ].	aLayout whenChildrenAddedDo: [ :announcement |		self add: announcement child constraints: (aLayout constraintsFor: announcement child) ].	aLayout whenChildrenRemovedDo: [ :announcement |		announcement child adapter ifNotNil: [ :adapter |			widget removeChildWidget: adapter widget ] ]]{ #category : 'accessing' }SpWin32FrameLayoutAdapter >> removeAll [	widget child ifNotNil: [ :current | widget removeChildWidget: current ]]{ #category : 'factory' }SpWin32FrameLayoutAdapter >> removeSubWidgets [	self removeAll]{ #category : 'accessing' }SpWin32FrameLayoutAdapter >> replace: aPresenter with: otherPresenter withConstraints: constraints [	| newWidget |	otherPresenter owner: self model.	newWidget := otherPresenter buildWithSelector: constraints spec.	widget child: newWidget constraints: constraints]