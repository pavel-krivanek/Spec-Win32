Class {	#name : 'SpWin32TextInputFieldAdapter',	#superclass : 'SpWin32AbstractAdapter',	#instVars : [		'selection'	],	#category : 'Spec-Win32-Adapters-Controls',	#package : 'Spec-Win32-Adapters',	#tag : 'Controls'}{ #category : 'factory' }SpWin32TextInputFieldAdapter >> buildWidget [	| control |	control := SpWin32NativeControl		runtime: SpWin32Runtime default		kind: self nativeControlKind		text: self presenter text		preferredExtent: 120 @ 24.	control		eventHandler: self;		editable: self presenter isEditable;		maxLength: self presenter maxLength;		password: self presenter isPassword;		placeholder: self getPlaceholderText.	self presenter whenPlaceholderChangedDo: [ :text | control placeholder: (text ifNil: [ '' ]) ].	self presenter whenEditableChangedDo: [ :value | control editable: value ].	self presenter whenMaxLengthChangedDo: [ :length | control maxLength: length ].	self presenter whenPasswordChangedDo: [ :isPassword | control password: isPassword ].	selection := self normalizedSelection: self presenter selectionInterval.	self applySelection: selection to: control.	^ control]{ #category : 'factory' }SpWin32TextInputFieldAdapter >> nativeControlKind [	^ SpWin32Runtime controlTextInput]{ #category : 'undo-redo' }SpWin32TextInputFieldAdapter >> clearUndoManager []{ #category : 'selection' }SpWin32TextInputFieldAdapter >> cursorPositionIndex [	| current |	current := self selection.	^ current isEmpty		ifTrue: [ current first ]		ifFalse: [ current last + 1 ]]{ #category : 'selection' }SpWin32TextInputFieldAdapter >> cursorPositionIndex: anInteger [	| index interval |	index := (anInteger asInteger max: 1) min: self getText size + 1.	interval := index to: index - 1.	self presenter selectionInterval: interval.	self setSelectionFromModel: interval]{ #category : 'private' }SpWin32TextInputFieldAdapter >> getPlaceholderText [	^ self presenter placeholder		ifNil: [ '' ]		ifNotNil: [ :aString | aString localizedForPresenter: self presenter ]]{ #category : 'accessing' }SpWin32TextInputFieldAdapter >> getText [	^ self widget text]{ #category : 'testing' }SpWin32TextInputFieldAdapter >> hasKeyboardFocus [	^ self widget hasKeyboardFocus]{ #category : 'accessing' }SpWin32TextInputFieldAdapter >> isPassword [	^ self widget password]{ #category : 'accessing' }SpWin32TextInputFieldAdapter >> pendingText [	^ self getText]{ #category : 'accessing' }SpWin32TextInputFieldAdapter >> pendingText: aString [	self text: aString]{ #category : 'accessing' }SpWin32TextInputFieldAdapter >> placeHolderText [	^ self widget placeholder]{ #category : 'accessing' }SpWin32TextInputFieldAdapter >> placeholder [	^ self widget placeholder]{ #category : 'accessing' }SpWin32TextInputFieldAdapter >> placeholder: aString [	self presenter placeholder: aString]{ #category : 'selection' }SpWin32TextInputFieldAdapter >> selectAll [	| interval |	interval := 1 to: self getText size.	self presenter selectionInterval: interval.	self setSelectionFromModel: interval]{ #category : 'selection' }SpWin32TextInputFieldAdapter >> selection [	| offsets |	offsets := self widget selectionOffsets.	selection := offsets x = offsets y		ifTrue: [ offsets x + 1 to: offsets x ]		ifFalse: [ offsets x + 1 to: offsets y ].	^ selection]{ #category : 'selection' }SpWin32TextInputFieldAdapter >> selectionInterval [	^ self selection]{ #category : 'selection' }SpWin32TextInputFieldAdapter >> setSelectionFromModel: anInterval [	selection := self normalizedSelection: anInterval.	self applySelection: selection to: self widget]{ #category : 'selection - private' }SpWin32TextInputFieldAdapter >> normalizedSelection: anInterval [	| interval textSize first last |	interval := anInterval ifNil: [ 1 to: 0 ].	textSize := self presenter text size.	(interval first <= 0 or: [ interval last <= 0 ]) ifTrue: [ ^ 1 to: 0 ].	interval isEmpty ifTrue: [		first := (interval first max: 1) min: textSize + 1.		^ first to: first - 1 ].	first := (interval first max: 1) min: textSize + 1.	last := (interval last max: first - 1) min: textSize.	^ first to: last]{ #category : 'selection - private' }SpWin32TextInputFieldAdapter >> applySelection: anInterval to: aNativeControl [	| startOffset endOffset |	anInterval isEmpty		ifTrue: [			startOffset := anInterval first - 1.			endOffset := startOffset ]		ifFalse: [			startOffset := anInterval first - 1.			endOffset := anInterval last ].	aNativeControl selectionStart: startOffset end: endOffset]{ #category : 'accessing' }SpWin32TextInputFieldAdapter >> takeKeyboardFocus [	self selectAll.	super takeKeyboardFocus]{ #category : 'accessing' }SpWin32TextInputFieldAdapter >> takeKeyboardFocusWithoutSelecting [	super takeKeyboardFocus]{ #category : 'accessing' }SpWin32TextInputFieldAdapter >> text: aString [	| value |	value := aString ifNil: [ '' ].	self presenter text = value ifFalse: [		self presenter text: value ].	self widget text = self presenter text ifFalse: [		self widget text: self presenter text.		self cursorPositionIndex: self presenter text size + 1 ]]{ #category : 'emulating' }SpWin32TextInputFieldAdapter >> type: aString [	self presenter isEditable ifFalse: [ ^ self ].	self text: aString]{ #category : 'emulating' }SpWin32TextInputFieldAdapter >> typeByChar: aString [	self presenter isEditable ifFalse: [ ^ self ].	aString do: [ :each |		self text: self getText, each asString ]]{ #category : 'native events' }SpWin32TextInputFieldAdapter >> win32TextChanged: aString [	self presenter text = aString ifFalse: [		self presenter text: aString ]]