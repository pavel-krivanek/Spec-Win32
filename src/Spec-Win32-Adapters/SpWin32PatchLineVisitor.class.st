Class {	#name : 'SpWin32PatchLineVisitor',	#superclass : 'DiffVisitor',	#instVars : [		'lineNumber',		'stream',		'lineMarks'	],	#category : 'Spec-Win32-Adapters-Code',	#package : 'Spec-Win32-Adapters',	#tag : 'Code'}{ #category : 'accessing' }SpWin32PatchLineVisitor >> contents [	^ stream contents]{ #category : 'initialization' }SpWin32PatchLineVisitor >> initialize [	super initialize.	lineNumber := 0.	lineMarks := OrderedCollection new.	stream := String new writeStream]{ #category : 'accessing' }SpWin32PatchLineVisitor >> lineMarks [	^ lineMarks]{ #category : 'visiting' }SpWin32PatchLineVisitor >> visitDelete: aPatchElement [	lineNumber := lineNumber + 1.	lineMarks add: lineNumber -> #delete.	stream << aPatchElement element << String lf]{ #category : 'visiting' }SpWin32PatchLineVisitor >> visitInsert: aPatchElement [	lineNumber := lineNumber + 1.	lineMarks add: lineNumber -> #insert.	stream << aPatchElement element << String lf]{ #category : 'visiting' }SpWin32PatchLineVisitor >> visitMatch: aPatchElement [	lineNumber := lineNumber + 1.	stream << aPatchElement element << String lf]