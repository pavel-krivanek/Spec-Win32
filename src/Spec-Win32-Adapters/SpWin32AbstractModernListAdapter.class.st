Class {	#name : 'SpWin32AbstractModernListAdapter',	#superclass : 'SpWin32AbstractAdapter',	#instVars : [		'rowPresenters',		'displayStrings',		'rowImages'	],	#category : 'Spec-Win32-Adapters-ListView',	#package : 'Spec-Win32-Adapters',	#tag : 'ListView'}{ #category : 'testing' }SpWin32AbstractModernListAdapter class >> isAbstract [	^ self == SpWin32AbstractModernListAdapter]{ #category : 'initialization' }SpWin32AbstractModernListAdapter >> initialize [	super initialize.	rowPresenters := #().	displayStrings := #().	rowImages := #()]{ #category : 'private - rows' }SpWin32AbstractModernListAdapter >> rebuildRowSnapshots [	| presenters strings images |	presenters := OrderedCollection new: self presenter items size.	strings := OrderedCollection new: self presenter items size.	images := OrderedCollection new: self presenter items size.	self presenter items do: [ :item |		| row |		row := self newRowPresenterFor: item.		presenters add: row.		strings add: (self displayStringForRowPresenter: row item: item).		images add: (self imageDataForRowPresenter: row) ].	rowPresenters := presenters asArray.	displayStrings := strings asArray.	rowImages := images asArray]{ #category : 'private - rows' }SpWin32AbstractModernListAdapter >> newRowPresenterFor: item [	| row |	row := self presenter setupAction cull: self presenter.	row ifNil: [		self error: 'Win32 modern ListView setup block returned nil.' ].	[ self presenter bindAction value: row value: item ]		on: Error		do: [ :error | error pass ].	^ row]{ #category : 'private - rows' }SpWin32AbstractModernListAdapter >> displayStringForRowPresenter: row item: item [	| strings unsupported |	strings := OrderedCollection new.	unsupported := OrderedCollection new.	self collectTextFromRowObject: row into: strings unsupported: unsupported.	unsupported ifNotEmpty: [		self error: 'Win32 modern ListView currently supports rows composed of Label/Image presenters only; unsupported row presenter: ', unsupported first name ].	^ strings		ifEmpty: [ item asString ]		ifNotEmpty: [ strings joinUsing: ' ' ]]{ #category : 'private - rows' }SpWin32AbstractModernListAdapter >> collectTextFromRowObject: anObject into: strings unsupported: unsupported [	| layout children |	anObject ifNil: [ ^ self ].	(anObject isKindOf: SpLabelPresenter) ifTrue: [		anObject label ifNotNil: [ :label | strings add: label asString ].		^ self ].	(anObject isKindOf: SpImagePresenter) ifTrue: [ ^ self ].	(anObject isSpLayout) ifTrue: [		anObject children do: [ :child |			self collectTextFromRowObject: child into: strings unsupported: unsupported ].		^ self ].	(anObject respondsTo: #layout) ifFalse: [		unsupported add: anObject class.		^ self ].	layout := anObject layout.	layout ifNil: [		unsupported add: anObject class.		^ self ].	children := layout children.	children ifEmpty: [		unsupported add: anObject class.		^ self ].	children do: [ :child |		self collectTextFromRowObject: child into: strings unsupported: unsupported ]]{ #category : 'private - rows' }SpWin32AbstractModernListAdapter >> imageDataForRowPresenter: row [	| images |	images := OrderedCollection new.	self collectImagesFromRowObject: row into: images.	images size > 1 ifTrue: [		self error: 'Win32 modern ListView currently supports at most one image per native row.' ].	^ images		ifEmpty: [ nil ]		ifNotEmpty: [ SpWin32ImageData fromForm: images first ]]{ #category : 'private - rows' }SpWin32AbstractModernListAdapter >> collectImagesFromRowObject: anObject into: images [	| layout |	anObject ifNil: [ ^ self ].	(anObject isKindOf: SpImagePresenter) ifTrue: [		anObject image ifNotNil: [ :image | images add: image ].		^ self ].	(anObject isKindOf: SpLabelPresenter) ifTrue: [ ^ self ].	(anObject isSpLayout) ifTrue: [		anObject children do: [ :child | self collectImagesFromRowObject: child into: images ].		^ self ].	(anObject respondsTo: #layout) ifFalse: [ ^ self ].	layout := anObject layout.	layout ifNil: [ ^ self ].	layout children do: [ :child | self collectImagesFromRowObject: child into: images ]]{ #category : 'accessing' }SpWin32AbstractModernListAdapter >> displayStrings [	^ displayStrings]{ #category : 'accessing' }SpWin32AbstractModernListAdapter >> rowImages [	^ rowImages]{ #category : 'accessing' }SpWin32AbstractModernListAdapter >> rowPresenters [	^ rowPresenters]{ #category : 'private - rows' }SpWin32AbstractModernListAdapter >> rowPresenterAt: anIndex [	^ (anIndex between: 1 and: rowPresenters size)		ifTrue: [ rowPresenters at: anIndex ]		ifFalse: [ nil ]]{ #category : 'enumerating' }SpWin32AbstractModernListAdapter >> traversePresentersDo: aBlock excluding: aSet [	rowPresenters do: [ :row |		row traversePresentersDo: aBlock excluding: aSet ]]