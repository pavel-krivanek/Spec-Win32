Class {	#name : 'SpWin32PopoverAdapter',	#superclass : 'SpWin32AbstractAdapter',	#instVars : [		'contentWidget',		'opened',		'lastPointingRectangle'	],	#category : 'Spec-Win32-Adapters-Popover',	#package : 'Spec-Win32-Adapters',	#tag : 'Popover'}{ #category : 'initialization' }SpWin32PopoverAdapter >> initialize [	super initialize.	opened := false]{ #category : 'factory' }SpWin32PopoverAdapter >> buildWidget [	| popup |	popup := SpWin32Runtime default		createPopupWindowOwnedBy: nil		width: 120		height: 48		autohide: true.	popup eventHandler: self.	self presenter whenPresenterChangedDo: [ self rebuildContent ].	^ popup]{ #category : 'api' }SpWin32PopoverAdapter >> dismiss [	opened ifFalse: [ ^ self ].	opened := false.	self widgetDo: [ :popup | [ popup hide ] on: Error do: [ :error | error return ] ].	self restoreFocus.	self presenter popoverClosed]{ #category : 'private - content' }SpWin32PopoverAdapter >> destroyContentWidget [	contentWidget ifNil: [ ^ self ].	(contentWidget respondsTo: #destroy) ifTrue: [ contentWidget destroy ].	contentWidget := nil]{ #category : 'private - content' }SpWin32PopoverAdapter >> ensureContentWidget [	contentWidget ifNotNil: [ ^ contentWidget ].	self presenter presenter ifNil: [ ^ nil ].	contentWidget := self presenter presenter build.	^ contentWidget]{ #category : 'private - geometry' }SpWin32PopoverAdapter >> nativeAnchorObject [	| relative adapter native windowPresenter |	relative := self presenter relativeTo.	relative ifNil: [ ^ nil ].	adapter := relative adapter.	adapter ifNil: [		[ relative build ] on: Error do: [ :error | error return ].		adapter := relative adapter ].	adapter ifNotNil: [		native := adapter widget.		(native notNil and: [ native respondsTo: #objectId ]) ifTrue: [ ^ native ] ].	[ windowPresenter := relative window ] on: Error do: [ :error | ^ nil ].	windowPresenter ifNil: [ ^ nil ].	windowPresenter adapter ifNil: [ ^ nil ].	^ windowPresenter adapter widget]{ #category : 'private - geometry' }SpWin32PopoverAdapter >> anchorRectangleFor: aPointingRectangle nativeAnchor: nativeAnchor [	| bounds |	bounds := SpWin32Runtime default screenBoundsOf: nativeAnchor.	aPointingRectangle ifNil: [ ^ bounds ].	^ (bounds origin + aPointingRectangle origin) extent: aPointingRectangle extent]{ #category : 'private - content' }SpWin32PopoverAdapter >> refreshContentPreferredExtentIn: popup [	contentWidget ifNil: [ ^ self ].	(contentWidget respondsTo: #refreshPreferredExtentIn:)		ifTrue: [ contentWidget refreshPreferredExtentIn: popup ]		ifFalse: [			(contentWidget respondsTo: #refreshPreferredExtentsIn:)				ifTrue: [ contentWidget refreshPreferredExtentsIn: popup ] ]]{ #category : 'private - content' }SpWin32PopoverAdapter >> preferredPopupExtent [	| preferred |	preferred := (contentWidget notNil and: [ contentWidget respondsTo: #preferredExtent ])		ifTrue: [ contentWidget preferredExtent ]		ifFalse: [ 180 @ 80 ].	^ ((preferred x + 12) max: 80) @ ((preferred y + 12) max: 36)]{ #category : 'private - content' }SpWin32PopoverAdapter >> realizeContentIn: popup [	| client bounds |	contentWidget ifNil: [ ^ self ].	client := popup clientExtent.	(contentWidget respondsTo: #realizeIn:extent:) ifTrue: [		contentWidget realizeIn: popup extent: client.		^ self ].	bounds := (6 @ 6) extent: ((client x - 12 max: 1) @ (client y - 12 max: 1)).	(contentWidget respondsTo: #realizeIn:bounds:) ifTrue: [		contentWidget realizeIn: popup bounds: bounds ]]{ #category : 'private - content' }SpWin32PopoverAdapter >> rebuildContent [	self destroyContentWidget.	self ensureContentWidget.	opened ifTrue: [ self repositionAndRealize ]]{ #category : 'private - geometry' }SpWin32PopoverAdapter >> repositionAndRealize [	| popup anchor anchorBounds extent origin |	popup := self widget.	popup ifNil: [ ^ self ].	anchor := self nativeAnchorObject.	anchor ifNil: [ ^ self ].	popup owner: anchor.	self ensureContentWidget.	self refreshContentPreferredExtentIn: popup.	extent := self preferredPopupExtent.	anchorBounds := self anchorRectangleFor: lastPointingRectangle nativeAnchor: anchor.	origin := SpWin32PopoverGeometry		originForPosition: self presenter position		anchor: anchorBounds		extent: extent.	origin := SpWin32PopoverGeometry		clampOrigin: origin		extent: extent		toWorkArea: (SpWin32Runtime default monitorWorkAreaOf: anchor).	popup moveTo: origin extent: extent.	self realizeContentIn: popup]{ #category : 'api' }SpWin32PopoverAdapter >> popupModal: isModal pointingTo: aRectangle [	lastPointingRectangle := aRectangle.	self ensureContentWidget.	self repositionAndRealize.	opened ifFalse: [		opened := true.		self presenter popoverOpened ].	self presenter isTransferFocus		ifTrue: [			self widget show.			self presenter takeKeyboardFocus ]		ifFalse: [ self widget showWithoutActivation ].	^ self]{ #category : 'private - focus' }SpWin32PopoverAdapter >> restoreFocus [	| relative |	relative := self presenter relativeTo.	relative ifNil: [ ^ self ].	[ relative takeKeyboardFocus ] on: Error do: [ :error | error return ]]{ #category : 'testing' }SpWin32PopoverAdapter >> isOpened [	^ opened]{ #category : 'native events' }SpWin32PopoverAdapter >> win32PopupDismissRequested [	self dismiss]{ #category : 'native events' }SpWin32PopoverAdapter >> win32CloseRequested [	self dismiss]{ #category : 'native events' }SpWin32PopoverAdapter >> win32Destroyed [	opened ifFalse: [ ^ self ].	opened := false.	self presenter popoverClosed]{ #category : 'native events' }SpWin32PopoverAdapter >> win32ResizedFrom: oldExtent to: newExtent [	"Popup extent is adapter-owned and non-resizable. The synchronous geometry path	 already realizes content; the normalized WM_SIZE notification is informational."	^ self]