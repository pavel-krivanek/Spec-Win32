Class {	#name : 'SpWin32DeferredDispatcher',	#superclass : 'Object',	#instVars : [		'queue',		'process',		'mutex'	],	#classVars : [		'Default'	],	#category : 'Spec-Win32-Adapters-Backend',	#package : 'Spec-Win32-Adapters',	#tag : 'Backend'}{ #category : 'instance creation' }SpWin32DeferredDispatcher class >> default [	^ Default ifNil: [ Default := self new ]]{ #category : 'instance creation' }SpWin32DeferredDispatcher class >> resetDefault [	Default ifNotNil: [ :dispatcher | dispatcher stop ].	Default := nil]{ #category : 'initialization' }SpWin32DeferredDispatcher >> initialize [	super initialize.	queue := SharedQueue new.	mutex := Semaphore forMutualExclusion]{ #category : 'dispatching' }SpWin32DeferredDispatcher >> defer: aBlock [	self ensureProcess.	queue nextPut: aBlock.	^ aBlock]{ #category : 'private' }SpWin32DeferredDispatcher >> ensureProcess [	mutex critical: [		(process isNil or: [ process isTerminated ]) ifTrue: [			process := [ self runLoop ]				forkAt: Processor userBackgroundPriority				named: 'Spec Win32 deferred dispatcher' ] ]]{ #category : 'private' }SpWin32DeferredDispatcher >> runLoop [	[ true ] whileTrue: [		| block |		block := queue next.		[ block value ]			on: Error			fork: [ :error | error pass ] ]]{ #category : 'lifecycle' }SpWin32DeferredDispatcher >> stop [	mutex critical: [		process ifNotNil: [ :aProcess |			aProcess isTerminated ifFalse: [ aProcess terminate ] ].		process := nil ]]