Class {	#name : 'SpWin32RadioButtonAdapter',	#superclass : 'SpWin32AbstractAdapter',	#category : 'Spec-Win32-Adapters-Controls',	#package : 'Spec-Win32-Adapters',	#tag : 'Controls'}{ #category : 'factory' }SpWin32RadioButtonAdapter >> buildWidget [	| text control |	self presenter isInitialStateSet ifFalse: [		self presenter property: #state rawValue: false.		self presenter associatedRadioButtons do: [ :each |			each property: #state rawValue: false ] ].	text := self getLabelText.	control := SpWin32NativeControl		runtime: SpWin32Runtime default		kind: SpWin32Runtime controlRadioButton		text: text		preferredExtent: (((text size * 7) + 28) max: 24) @ 22.	control		eventHandler: self;		checked: self presenter state.	self presenter whenLabelChangedDo: [ self updateLabel ].	self presenter whenChangedDo: [ self updateState ].	^ control]{ #category : 'emulating' }SpWin32RadioButtonAdapter >> clicked [	self presenter state: true]{ #category : 'private' }SpWin32RadioButtonAdapter >> getLabelText [	^ self presenter label		ifNil: [ '' ]		ifNotNil: [ :aString | aString localizedForPresenter: self presenter ]]{ #category : 'accessing' }SpWin32RadioButtonAdapter >> label [	^ self getLabelText]{ #category : 'accessing' }SpWin32RadioButtonAdapter >> labelClickable [	^ self presenter labelClickable]{ #category : 'accessing' }SpWin32RadioButtonAdapter >> state [	^ self presenter state]{ #category : 'accessing' }SpWin32RadioButtonAdapter >> state: aBoolean [	^ self presenter state: aBoolean]{ #category : 'private - updating' }SpWin32RadioButtonAdapter >> updateLabel [	| text |	text := self getLabelText.	self widget text: text.	self widget isValid ifFalse: [		self widget preferredExtent: (((text size * 7) + 28) max: 24) @ 22 ]]{ #category : 'private - updating' }SpWin32RadioButtonAdapter >> updateState [	self widget checked: self presenter state]{ #category : 'native events' }SpWin32RadioButtonAdapter >> win32Toggled: aBoolean [	aBoolean ifTrue: [ self presenter state: true ]]