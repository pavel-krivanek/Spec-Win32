Class {	#name : 'SpWin32GridAdapter',	#superclass : 'SpWin32LayoutAdapter',	#category : 'Spec-Win32-Adapters-Layout',	#package : 'Spec-Win32-Adapters',	#tag : 'Layout'}{ #category : 'accessing' }SpWin32GridAdapter >> add: aPresenter constraints: constraints [	| childWidget |	aPresenter owner: self model.	childWidget := aPresenter buildWithSelector: constraints spec.	widget addChild: childWidget constraints: constraints]{ #category : 'factory' }SpWin32GridAdapter >> adapterWasBuilt []{ #category : 'factory' }SpWin32GridAdapter >> layout: aLayout [	layout := aLayout.	widget ifNil: [		widget := SpWin32GridContainer			layout: aLayout			runtime: SpWin32Runtime default ].	aLayout whenChildrenAddedDo: [ :announcement |		self			add: announcement child			constraints: (aLayout constraintsFor: announcement child) ].	aLayout whenChildrenRemovedDo: [ :announcement |		announcement child adapter ifNotNil: [ :adapter |			widget removeChildWidget: adapter widget ] ]]{ #category : 'accessing' }SpWin32GridAdapter >> removeAll [	widget removeAll]{ #category : 'factory' }SpWin32GridAdapter >> removeSubWidgets [	widget removeAll]