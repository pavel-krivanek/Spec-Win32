Class {	#name : 'SpWin32ButtonAdapter',	#superclass : 'SpWin32AbstractAdapter',	#category : 'Spec-Win32-Adapters-Controls',	#package : 'Spec-Win32-Adapters',	#tag : 'Controls'}{ #category : 'factory' }SpWin32ButtonAdapter >> buildWidget [	| text iconData control |	text := self getLabelText.	iconData := self imageDataFor: self presenter icon.	control := SpWin32NativeControl		runtime: SpWin32Runtime default		kind: SpWin32Runtime controlButton		text: text		preferredExtent: (self preferredExtentForText: text iconData: iconData).	control		eventHandler: self;		imageData: iconData.	self presenter whenLabelChangedDo: [ self updateLabel ].	self presenter whenIconChangedDo: [ self updateIcon ].	^ control]{ #category : 'emulating' }SpWin32ButtonAdapter >> clicked [ self win32Clicked ]{ #category : 'private' }SpWin32ButtonAdapter >> getLabelText [	^ (self presenter label ifNil: [ '' ]) localizedForPresenter: self presenter]{ #category : 'private - images' }SpWin32ButtonAdapter >> imageDataFor: aFormOrNil [	^ SpWin32ImageData fromForm: aFormOrNil]{ #category : 'accessing' }SpWin32ButtonAdapter >> icon [ ^ self presenter icon ]{ #category : 'accessing' }SpWin32ButtonAdapter >> label [ ^ self getLabelText ]{ #category : 'private - layout' }SpWin32ButtonAdapter >> preferredExtentForText: text iconData: iconData [	| width height |	width := ((text size * 8) + 24) max: 75.	height := 28.	iconData ifNil: [ ^ width @ height ].	height := height max: iconData height + 10.	width := text isEmpty		ifTrue: [ iconData width + 16 ]		ifFalse: [ (text size * 8) + iconData width + 34 ].	^ (width max: iconData width + 16) @ height]{ #category : 'accessing' }SpWin32ButtonAdapter >> setAsDefault [ ]{ #category : 'private - updating' }SpWin32ButtonAdapter >> updateIcon [	| iconData |	iconData := self imageDataFor: self presenter icon.	self widget imageData: iconData.	self updatePreferredExtent]{ #category : 'private - updating' }SpWin32ButtonAdapter >> updateLabel [	self widget text: self getLabelText.	self updatePreferredExtent]{ #category : 'private - updating' }SpWin32ButtonAdapter >> updatePreferredExtent [	self widget preferredExtent: (self		preferredExtentForText: self getLabelText		iconData: self widget imageData).	self widget requestRelayout]{ #category : 'native events' }SpWin32ButtonAdapter >> win32Clicked [	self presenter performAction]