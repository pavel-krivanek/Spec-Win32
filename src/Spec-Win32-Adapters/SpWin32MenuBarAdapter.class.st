Class {	#name : 'SpWin32MenuBarAdapter',	#superclass : 'SpWin32MenuAdapter',	#instVars : [		'refreshAction'	],	#category : 'Spec-Win32-Adapters-Menu',	#package : 'Spec-Win32-Adapters',	#tag : 'Menu'}{ #category : 'accessing' }SpWin32MenuBarAdapter >> menuEntries [	^ self currentEntries]{ #category : 'updating' }SpWin32MenuBarAdapter >> refresh [	refreshAction ifNotNil: [ refreshAction value ]]{ #category : 'private - subscriptions' }SpWin32MenuBarAdapter >> subscribeToItem: anItem [	anItem whenNameChangedDo: [ self refresh ].	anItem whenIconChangedDo: [ self refresh ].	anItem whenEnabledChangedDo: [ self refresh ].	anItem subMenu ifNotNil: [ :subMenu | self subscribeToMenu: subMenu ]]{ #category : 'private - subscriptions' }SpWin32MenuBarAdapter >> subscribeToMenu: aMenuPresenter [	aMenuPresenter menuGroups do: [ :group |		group menuItems do: [ :item | self subscribeToItem: item ] ]]{ #category : 'updating' }SpWin32MenuBarAdapter >> whenMenuNeedsRefreshDo: aBlock [	refreshAction := aBlock.	self subscribeToMenu: self presenter]