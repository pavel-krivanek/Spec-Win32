Class {	#name : 'BaselineOfSpecWin32',	#superclass : 'BaselineOf',	#category : 'BaselineOfSpecWin32',	#package : 'BaselineOfSpecWin32'}{ #category : 'baseline' }BaselineOfSpecWin32 >> baseline: spec [	<baseline>	spec for: #common do: [		spec			package: 'Spec-Win32-Native';			package: 'Spec-Win32-Adapters' with: [ spec requires: #('Spec-Win32-Native') ];			package: 'Spec-Wind32-Examples' with: [ spec requires: #('Spec-Win32-Adapters') ];			package: 'Spec-Win32-Tests' with: [ spec requires: #('Spec-Win32-Adapters' 'Spec-Wind32-Examples') ].		spec group: 'Core' with: #('Spec-Win32-Native' 'Spec-Win32-Adapters').		spec group: 'Examples' with: #('Spec-Wind32-Examples').		spec group: 'Tests' with: #('Spec-Win32-Tests').		spec group: 'Full' with: #('Core' 'Examples').		spec group: 'default' with: #('Core') ]]