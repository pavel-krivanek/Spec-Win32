Button := SpButtonPresenter newApplication: application.	redrawButton		label: 'Change drawing + redraw';		action: [			phase := (phase + 24) \\ 160.			athens redraw.			status label: 'Explicit redraw at phase ', phase printString ].	layout := SpBoxLayout newTopToBottom		borderWidth: 12;		spacing: 8;		add: ((SpLabelPresenter newApplication: application)			label: 'AthensCairoSurface rendered in Pharo, transported as native BGRA';			yourself) expand: false;		add: athens;		add: redrawButton expand: false;		add: status expand: false;		yourself.	root layout: layout.	^ root]{ #category : 'examples' }SpWin32Examples class >> openAlexandrie [	<example>	| application root |	application := self application.	root := (Smalltalk globals includesKey: #AeCairoImageSurface)		ifTrue: [ self alexandrieOn: application ]		ifFalse: [			| label |			label := SpLabelPresenter newApplication: application.			label label: 'Alexandrie is optional and is not loaded in this image. Load Alexandrie, then reopen this example.'.			(SpPresenter newApplication: application)				layout: (SpBoxLayout newTopToBottom					borderWidth: 16;					add: label expand: false;					yourself);				yourself ].	^ self openRoot: root title: 'Spec Win32 - Alexandrie drawing' extent: 700 @ 480]{ #category : 'example builders' }SpWin32Examples class >> alexandrieOn: application [	| root alexandrie status redrawButton phase layout |	root := SpPresenter newApplication: application.	status := SpLabelPresenter newApplication: application.	status label: 'Resize the window: AeCairoImageSurface is rerendered at the actual native extent.'.	phase := 0.	alexandrie := SpAlexandriePresenter newApplication: application.	alexandrie		surfaceExtent: 520 @ 320;		drawBlock: [ :context :bounds |			context				clearColor: (Color r: 0.08 g: 0.10 b: 0.14);				sourceColorR: 0.10 g: 0.58 b: 0.92;				rectangle: (20 @ 20 extent: ((bounds width - 40) max: 1) @ ((bounds height - 40) max: 1));				fill;				sourceColorR: 1.0 g: 0.72 b: 0.12 a: 0.90;				rectangle: ((40 + phase) @ 55 extent: (((bounds width // 2) - 50) max: 20) @ 90);				fill;				sourceColorR: 0.96 g: 0.97 b: 1.0 a: 0.75;				rectangle: (55 @ ((bounds height - 95) max: 0) extent: ((bounds width - 110) max: 20) @ 24);				fill ].	redrawButton := SpButtonPresenter newApplication: application.	redrawButton		label: 'Change drawing + redraw';		action: [			phase := (phase + 24) \\ 160.			alexandrie redraw.			status label: 'Explicit redraw at phase ', phase printString ].	layout := SpBoxLayout newTopToBottom		borderWidth: 12;		spacing: 8;		add: ((SpLabelPresenter newApplication: application)			label: 'Alexandrie AeCairoImageSurface rendered in Pharo, transported as native BGRA';			yourself) expand: false;		add: alexandrie;		add: redrawButton expand: false;		add: status expand: false;		yourself.	root layout: layout.	^ root]{ #category : 'examples' }SpWin32Examples class >> openPaginator [	<example>	| application root |	application := self application.	root := self paginatorOn: application.	^ self openRoot: root title: 'Spec Win32 - Paginator' extent: 560 @ 190]{ #category : 'example builders' }SpWin32Examples class >> paginatorOn: application [	| root paginator status |	root := SpPresenter newApplication: application.	status := SpLabelPresenter newApplication: application.	status label: 'Drag the selection window or its edge grips.'.	paginator := SpPaginatorPresenter newApplication: application.	paginator		pages: (1 to: 12) asArray;		visiblePages: 3;		selectPage: 4.	paginator whenSelectedPageChangedDo: [ :page |		status label: 'Selected page ', page printString,			' / visible pages ', paginator visiblePages printString ].	paginator whenVisiblePagesChangedDo: [ :count |		status label: 'Visible pages ', count printString,			' / selected page ', paginator selectedPage printString ].	root layout: (SpBoxLayout newTopToBottom		borderWidth: 14;		spacing: 10;		add: ((SpLabelPresenter newApplication: application)			label: 'Paginator — click pages, drag selection, resize visible span';			yourself) expand: false;		add: paginator expand: false;		add: status expand: false;		yourself).	^ root]{ #category : 'examples' }SpWin32Examples class >> openMorph [	<example>	| application root |	application := self application.	root := self morphOn: application.	^ self openRoot: root title: 'Spec Win32 - live Morph surface' extent: 660 @ 460]{ #category : 'example builders' }SpWin32Examples class >> morphOn: application [	| root morphPresenter status morph panel accent label action |	root := SpPresenter newApplication: application.	status := SpLabelPresenter newApplication: application.	status label: 'The Morph tree is rendered off-screen but remains live: click the orange panel.'.	morph := Morph new		color: (Color r: 0.94 g: 0.96 b: 1.0);		extent: 560 @ 320;		hResizing: #spaceFill;		vResizing: #spaceFill;		yourself.	panel := Morph new		color: (Color r: 0.16 g: 0.35 b: 0.72);		position: 36 @ 42;		extent: 220 @ 118;		yourself.	accent := Morph new		color: Color orange;		position: 292 @ 82;		extent: 190 @ 92;		yourself.	label := StringMorph contents: 'Live Morphic tree'.	label color: Color white; position: 58 @ 84.	panel addMorph: label.	action := [		accent color: (accent color = Color orange			ifTrue: [ Color green ]			ifFalse: [ Color orange ]).		status label: 'Nested Morph received mouseDown through the private HandMorph.' ].	accent on: #mouseDown send: #value to: action.	morph addMorph: panel; addMorph: accent.	morphPresenter := SpMorphPresenter newApplication: application.	morphPresenter morph: morph.	root layout: (SpBoxLayout newTopToBottom		borderWidth: 12;		spacing: 8;		add: ((SpLabelPresenter newApplication: application)			label: 'MorphPresenter — private off-screen WorldMorph + native BGRA surface';			yourself) expand: false;		add: morphPresenter;		add: status expand: false;		yourself).	^ root]{ #category : 'examples' }SpWin32Examples class >> openDiffUnified [	<example>	| application root |	application := self application.	root := self diffUnifiedOn: application.	^ self openRoot: root title: 'Spec Win32 - Unified Diff' extent: 720 @ 430]{ #category : 'example builders' }SpWin32Examples class >> diffUnifiedOn: application [	| root diff status bothButton destinationButton |	root := SpPresenter newApplication: application.	status := SpLabelPresenter newApplication: application.	status label: 'Unified destination view (the SpDiffUnifiedPresenter default).'.	diff := SpDiffUnifiedPresenter newApplication: application.	diff		leftText: 'alpha', String lf, 'old line', String lf, 'shared', String lf, 'tail';		rightText: 'alpha', String lf, 'new line', String lf, 'shared', String lf, 'inserted', String lf, 'tail'.	bothButton := SpButtonPresenter newApplication: application.	bothButton		label: 'Show source + unified';		action: [ diff showBoth. status label: 'Inherited showBoth mode: source beside unified projection.' ].	destinationButton := SpButtonPresenter newApplication: application.	destinationButton		label: 'Unified only';		action: [ diff showOnlyDestination: true. status label: 'Unified destination-only view.' ].	root layout: (SpBoxLayout newTopToBottom		borderWidth: 12;		spacing: 8;		add: ((SpLabelPresenter newApplication: application)			label: 'DiffUnified — RichEdit unified projection with insert/delete decorations';			yourself) expand: false;		add: diff;		add: (SpBoxLayout newLeftToRight			spacing: 8;			add: destinationButton expand: false;			add: bothButton expand: false;			yourself) expand: false;		add: status expand: false;		yourself).	^ root]