og result |			dialog := SpFileDialog newApplication: application.			dialog				title: 'Choose a directory';				path: FileLocator temp;				beOpenDirectory.			root withWindowDo: [ :window | dialog parentWindow: window ].			result := dialog openModal.			status label: (result				ifNil: [ 'Directory selection cancelled' ]				ifNotNil: [ 'Directory: ', result fullName ]) ].	waitButton := SpButtonPresenter newApplication: application.	waitButton		label: 'Show wait cursor for 1.5 seconds';		action: [			application showWaitCursorWhile: [				status label: 'Wait cursor active...'.				(Delay forMilliseconds: 1500) wait ].			status label: 'Wait cursor restored' ].	layout := SpBoxLayout newTopToBottom		borderWidth: 14;		spacing: 9;		add: ((SpLabelPresenter newApplication: application)			label: 'Win32 backend services'; yourself) expand: false;		add: infoButton expand: false;		add: errorButton expand: false;		add: openButton expand: false;		add: saveButton expand: false;		add: directoryButton expand: false;		add: waitButton expand: false;		add: status expand: false;		yourself.	root layout: layout.	^ root]{ #category : 'examples' }SpWin32Examples class >> openBackendServices [	<example>	| application root |	application := self application.	root := self backendServicesOn: application.	^ self openRoot: root title: 'Spec Win32 - backend services' extent: 560@390]{ #category : 'example builders' }SpWin32Examples class >> modernListViewOn: application [	| root dropDown listView status layout rows colors |	root := SpPresenter newApplication: application.	status := SpLabelPresenter newApplication: application.	status label: 'Select or activate a row. ListView rows use native image-list icons.'.	dropDown := SpDropDownPresenter newApplication: application.	dropDown		items: #('Alpha' 'Beta' 'Gamma' 'Unicode 🙂');		setup: [ :builder | builder newLabel ];		bind: [ :label :item | label label: 'Choice: ', item ];		selectIndex: 2;		whenSele