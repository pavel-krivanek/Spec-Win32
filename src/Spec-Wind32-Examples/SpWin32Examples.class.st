ication: application.	description := SpLabelPresenter newApplication: application.	description label: 'ToolbarButton and ToolbarToggleButton use real native BUTTON HWNDs.'.	status := SpLabelPresenter newApplication: application.	status label: 'Use Run, toggle Pin, or the right-aligned Help button.'.	toolbar := self toolbarFor: application status: status.	layout := SpBoxLayout newTopToBottom		borderWidth: 14;		spacing: 12;		add: toolbar expand: false;		add: description expand: false;		add: status expand: false;		yourself.	root layout: layout.	^ root]{ #category : 'private' }SpWin32Examples class >> toolbarFor: application status: status [	| toolbar blue green run pin disabled help |	blue := self sampleButtonIconFormWithColor: (Color r: 0.15 g: 0.45 b: 0.95 alpha: 1.0).	green := self sampleButtonIconFormWithColor: (Color r: 0.15 g: 0.75 b: 0.35 alpha: 1.0).	toolbar := SpToolbarPresenter newApplication: application.	run := SpToolbarButtonPresenter newApplication: application.	run		label: 'Run';		icon: blue;		help: 'Run the toolbar action';		action: [ status label: 'Run clicked' ].	pin := SpToolbarToggleButtonPresenter newApplication: application.	pin		label: 'Pin';		icon: green;		help: 'Toggle pinned state';		action: [ :state | status label: 'Pin = ', state printString ].	disabled := SpToolbarButtonPresenter newApplication: application.	disabled label: 'Disabled'; icon: blue; enabled: false.	help := SpToolbarButtonPresenter newApplication: application.	help label: 'Help'; action: [ status label: 'Right-aligned Help clicked' ].	toolbar		addItem: run;		addItem: pin;		addItem: disabled;		addItem: help position: SpToolbarItemPosition right.	^ toolbar]{ #category : 'example builders' }SpWin32Examples class >> menuOn: application [	| root status popup openPopup layout icon submenu |	root := SpPresenter newApplication: application.	status := SpLabelPresenter newApplication: application.	status label: 'Use the button for a standalone native popup menu, or the window toolbar menu.' .	icon := Form extent: 16 @ 16 depth: 32.	icon fillColor: Color transparent.	3 to: 12 do: [ :y | 3 to: 12 do: [ :x | icon colorAt: x @ y put: Color blue ] ].	submenu := SpMenuPresenter newApplication: application.	submenu addItem: [ :item |		item name: 'Nested item'; action: [ status label: 'Nested standalone menu item selected' ] ].	popup := SpMenuPresenter newApplication: application.	popup owner: root.	popup		addItem: [ :item |			item name: 'Open'; icon: icon; action: [ status label: 'Standalone Open selected' ] ];		addItem: [ :item |			item name: 'Checked'; state: true; action: [ status label: 'Checked item selected' ] ];		addGroup: [ :group |			group addItem: [ :item | item name: 'More'; subMenu: submenu ] ].	openPopup := SpButtonPresenter newApplication: application.	openPopup		label: 'Open standalone popup';		action: [ popup openWithSpecAtPointer ].	layout := SpBoxLayout newTopToBottom		borderWidth: 16;		spacing: 12;		add: ((SpLabelPresenter newApplication: application)			label: 'Native Win32 popup menus: groups, checked/disabled state, submenus and Form icons';			yourself) expand: false;		add: openPopup expand: false;		add: status expand: false;		yourself.	root layout: layout.	^ root]{ #category : 'examples' }SpWin32Examples class >> openMenusAndToolbarMenu [	<example>	| application root toolbar menuButton actions nested window icon |	application := self application.	root := self menuOn: application.	icon := Form extent: 16 @ 16 depth: 32.	icon fillColor: Color green.	actions := SpActionGroup new.	actions addActionWith: [ :action |		action name: 'Run'; action: [ ] ].	nested := SpActionGroup newName: 'Tools'.	nested beDisplayedAsSubMenu.	nested addActionWith: [ :action | action name: 'Inspect'; action: [ ] ].	actions add: nested.	menuButton := SpToolbarMenuButtonPresenter newApplication: application.	menuButton label: 'Actions'; icon: icon; actions: actions.	toolbar := SpToolbarPresenter newApplication: application.	toolbar beBoth; addItem: menuButton.	window := SpWindowPresenter presenter: root.	window		title: 'Spec Win32 - menus';		initialExtent: 620 @ 260;		toolbar: toolbar;		open.	^ window]{ #category : 'private' }SpWin32Examples class >> popoverContentOn: application label: aString [	| content title input dismiss |	content := SpPresenter newApplication: application.	title := SpLabelPresenter newApplication: application.	title label: aString.	input := SpTextInputFieldPresenter newApplication: application.	input placeholder: 'Native EDIT inside owned popup'.	dismiss := SpButtonPresenter newApplication: application.	dismiss		label: 'Dismiss';		action: [ content owner dismiss ].	content layout: (SpBoxLayout newTopToBottom		borderWidth: 10;		spacing: 8;		add: title expand: false;		add: input expand: false;		add: dismiss expand: false;		yourself).	^ content]{ #category : 'examples' }SpWin32Examples class >> openPopoverAndToolbarPopover [	<example>	| application root status standalone toolbar toolbarButton generation window |	application := self application.	root := SpPresenter newApplication: application.	status := SpLabelPresenter newApplication: application.	status label: 'Use either button. Popovers are owned native popup windows hosting normal Spec content.'.	standalone := SpButtonPresenter newApplication: application.	standalone		label: 'Standalone popover';		action: [			| popover |			popover := root newPopover.			popover				relativeTo: standalone;				bePositionRight;				presenter: (self popoverContentOn: application label: 'Standalone popover');				popup ].	generation := 0.	toolbarButton := SpToolbarPopoverButtonPresenter newApplication: application.	toolbarButton		label: 'Details';		content: [			generation := generation + 1.			self popoverContentOn: application label: 'Toolbar popover #', generation printString ].	toolbar := SpToolbarPresenter newAp