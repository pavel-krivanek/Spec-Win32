Class {	#name : 'SpWin32Examples',	#superclass : 'Object',	#category : 'Spec-Wind32-Examples',	#package : 'Spec-Wind32-Examples'}{ #category : 'private' }SpWin32Examples class >> application [	^ SpApplication new		useBackend: #Win32;		yourself]{ #category : 'private' }SpWin32Examples class >> openRoot: aPresenter title: aString extent: anExtent [	| window |	window := SpWindowPresenter presenter: aPresenter.	window		title: aString;		initialExtent: anExtent;		open.	^ window]{ #category : 'examples' }SpWin32Examples class >> openCatalog [	<example>	| application root title description layout examples |	application := self application.	root := SpPresenter newApplication: application.	title := SpLabelPresenter newApplication: application.	title label: 'Spec Win32 examples'.	description := SpLabelPresenter newApplication: application.	description label: 'Each button opens an independent example using the native #Win32 backend.'.	examples := {		'All implemented features' -> [ self openAllFeatures ].		'Basic controls' -> [ self openBasicControls ].		'ToggleButton and Switch' -> [ self openToggleAndSwitch ].		'Spinner and Link' -> [ self openSpinnerAndLink ].		'NumberInput and SearchInput' -> [ self openNumberAndSearch ].		'Image / Form transport' -> [ self openImage ].		'Athens drawing surface' -> [ self openAthens ].		'Alexandrie drawing surface (optional)' -> [ self openAlexandrie ].		'Button and ToggleButton icons' -> [ self openButtonIcons ].		'Toolbar / ToolbarButton' -> [ self openToolbar ].		'Menus / ToolbarMenuButton' -> [ self openMenusAndToolbarMenu ].		'Window MenuBar' -> [ self openMenuBar ].		'Ordinary MenuButton' -> [ self openMenuButton ].		'StatusBar' -> [ self openStatusBar ].		'ButtonBar + ActionBar' -> [ self openButtonAndActionBars ].		'Popovers / ToolbarPopoverButton' -> [ self openPopoverAndToolbarPopover ].		'Box layout' -> [ self openBoxLayout ].		'Grid layout' -> [ self openGridLayout ].		'Text input' -> [ self openTextInput ].		'Multiline text' -> [ self openText ].		'Backend services' -> [ self openBackendServices ].		'Focus and text selection' -> [ self openFocusAndSelection ].		'List / ListView' -> [ self openList ].		'Table / multi-column ListView' -> [ self openTable ].		'Tree / TreeView' -> [ self openTree ].		'TreeTable / hierarchical columns' -> [ self openTreeTable ].		'DropList' -> [ self openDropList ].		'Slider and ProgressBar' -> [ self openSliderAndProgress ].		'Notebook / tabs' -> [ self openNotebook ].		'Tab layout' -> [ self openTabLayout ].		'Miller columns' -> [ self openMillerLayout ].		'Paginator selection window' -> [ self openPaginator ].		'Live Morph surface' -> [ self openMorph ].		'Modern DropDown + ListView' -> [ self openModernListView ].		'Modern ColumnView' -> [ self openModernColumnView ].		'Modern TreeListView' -> [ self openModernTreeListView ].		'Modern TreeColumnView' -> [ self openModernTreeColumnView ].		'ComponentList / embedded presenters' -> [ self openComponentList ].		'Dynamic updates' -> [ self openDynamicUpdates ].		'Window lifecycle' -> [ self openWindowLifecycle ] }.	layout := SpBoxLayout newTopToBottom		borderWidth: 14;		spacing: 8;		add: title expand: false;		add: description expand: false;		yourself.	examples do: [ :association |		| button |		button := SpButtonPresenter newApplication: application.		button			label: association key;			action: association value.		layout add: button expand: false ].	root layout: layout.	^ self openRoot: root title: 'Spec Win32 examples' extent: 440 @ 550]{ #category : 'examples' }SpWin32Examples class >> openAllFeatures [	<example>	| application root |	application := self application.	root := self allFeaturesOn: application.	^ self openRoot: root title: 'Spec Win32 - all implemented features' extent: 860 @ 860]{ #category : 'example builders' }SpWin32Examples class >> allFeaturesOn: application [	| root title status nameLabel nameInput passwordLabel passwordInput enabledCheck radioLabel radioOne radioTwo dropLabel dropList listLabel list tableLabel table sliderLabel slider progress progressLabel action notebook layout |	root := SpPresenter newApplication: application.	title := SpLabelPresenter newApplication: application.	title label: 'Native Win32 control gallery — Příliš žluťoučký kůň 🙂'.	status := SpLabelPresenter newApplication: application.	status label: 'Interact with the controls; resize the window to exercise Grid relayout.'.	nameLabel := SpLabelPresenter newApplication: application.	nameLabel label: 'Text:'.	nameInput := SpTextInputFieldPresenter newApplication: application.	nameInput		placeholder: 'UTF-8 text';		maxLength: 48.	nameInput whenTextChangedDo: [ :text | status label: 'Text changed: ', text ].	passwordLabel := SpLabelPresenter newApplication: application.	passwordLabel label: 'Password:'.	passwordInput := SpTextInputFieldPresenter newApplication: application.	passwordInput		placeholder: 'Masked EDIT';		bePassword.	enabledCheck := SpCheckBoxPresenter newApplication: application.	enabledCheck		label: 'Enable the action button';		state: true.	radioLabel := SpLabelPresenter newApplication: application.	radioLabel label: 'Mode:'.	radioOne := SpRadioButtonPresenter newApplication: application.	radioOne label: 'Alpha'.	radioTwo := SpRadioButtonPresenter newApplication: application.	radioTwo label: 'Beta'.	radioOne associatedRadioButtons: { radioTwo }.	radioOne state: true.	radioOne whenChangedDo: [ :state | state ifTrue: [ status label: 'Radio Alpha selected' ] ].	radioTwo whenChangedDo: [ :state | state ifTrue: [ status label: 'Radio Beta selected' ] ].	dropLabel := SpLabelPresenter newApplication: application.	dropLabel label: 'Choice:'.	dropList := SpDropListPresenter newApplication: application.	dropList		startWithoutSelection;		display: [ :each | each asString ];		items: #( 'Alpha' 'Beta' 'Příliš žluťoučký kůň' 'Emoji 🙂' ).	dropList whenSelectedItemChangedDo: [ :item |		status label: 'DropList: ', item printString ].	listLabel := SpLabelPresenter newApplication: application.	listLabel label: 'List:'.	list := SpListPresenter newApplication: application.	list		headerTitle: 'Native ListView';		items: #( 'Alpha' 'Beta' 'Unicode 🙂' 'Fourth' ).	list whenActivatedDo: [ :selection | status label: 'List activated: ', selection selectedItem printString ].	tableLabel := SpLabelPresenter newApplication: application.	tableLabel label: 'Table:'.	table := SpTablePresenter newApplication: application.	table		addColumn: ((SpIndexTableColumn title: '#') width: 36; beNotExpandable; yourself);		addColumn: (SpStringTableColumn title: 'Name' evaluated: #key);		addColumn: ((SpStringTableColumn title: 'Value' evaluated: #value)			width: 70;			displayAlignment: [ :item | SpColumnAlignment right ];			yourself);		items: { 'Alpha' -> 20. 'Beta' -> 10. 'Unicode 🙂' -> 30 }.	sliderLabel := SpLabelPresenter newApplication: application.	sliderLabel label: 'Value:'.	slider := SpSliderPresenter newApplication: application.	slider		min: -50;		max: 150;		quantum: 10;		value: 50.	progressLabel := SpLabelPresenter newApplication: application.	progressLabel label: 'Progress:'.	progress := SpProgressBarPresenter newApplication: application.	progress fixedAt: 0.5.	slider whenValueChangedDo: [ :value |		progress fixedAt: ((value + 50) / 200).		status label: 'Slider = ', value printString ].	action := SpButtonPresenter newApplication: application.	action		label: 'Native BUTTON';		action: [ status label: 'Button clicked at ', DateAndTime now printString ].	enabledCheck whenChangedDo: [ :state | action enabled: state ].	notebook := SpNotebookPresenter newApplication: application.	notebook		addPage: (SpNotebookPage title: 'General' provider: [			(SpLabelPresenter newApplication: application)				label: 'Native SysTabControl32, page 1';				yourself ]);		addPage: (SpNotebookPage title: 'UTF-8 🙂' provider: [			(SpButtonPresenter newApplication: application)				label: 'Button on page 2';				action: [ status label: 'Notebook page-2 button clicked' ];				yourself ]).	layout := SpGridLayout new		borderWidth: 14;		columnSpacing: 12;		rowSpacing: 9;		beColumnNotHomogeneous;		column: 2 expand: true;		add: title atPoint: 1@1 span: 2@1;		add: nameLabel atPoint: 1@2;		add: nameInput atPoint: 2@2;		add: passwordLabel atPoint: 1@3;		add: passwordInput atPoint: 2@3;		add: enabledCheck atPoint: 2@4;		add: radioLabel atPoint: 1@5;		add: (SpBoxLayout newLeftToRight			spacing: 12;			add: radioOne expand: false;			add: radioTwo expand: false;			yourself) atPoint: 2@5;		add: dropLabel atPoint: 1@6;		add: dropList atPoint: 2@6;		add: listLabel atPoint: 1@7;		add: list atPoint: 2@7;		row: 7 expand: true;		add: tableLabel atPoint: 1@8;		add: table atPoint: 2@8;		row: 8 expand: true;		add: sliderLabel atPoint: 1@9;		add: slider atPoint: 2@9;		add: progressLabel atPoint: 1@10;		add: progress atPoint: 2@10;		add: action atPoint: 2@11;		add: notebook atPoint: 1@12 span: 2@1;		row: 12 expand: true;		add: status atPoint: 1@13 span: 2@1;		yourself.	root layout: layout.	^ root]{ #category : 'examples' }SpWin32Examples class >> openBasicControls [	<example>	| application root |	application := self application.	root := self basicControlsOn: application.	^ self openRoot: root title: 'Spec Win32 - basic controls' extent: 560 @ 360]{ #category : 'example builders' }SpWin32Examples class >> basicControlsOn: application [	| root label status button check radioOne radioTwo layout |	root := SpPresenter newApplication: application.	label := SpLabelPresenter newApplication: application.	label label: 'STATIC label — Unicode: čeština 日本語 🙂'.	status := SpLabelPresenter newApplication: application.	status label: 'Try the native controls below.'.	button := SpButtonPresenter newApplication: application.	button		label: 'Click me';		action: [ status label: 'BUTTON clicked' ].	check := SpCheckBoxPresenter newApplication: application.	check label: 'Checkbox controls button enabled state'.	check state: true.	check whenChangedDo: [ :state |		button enabled: state.		status label: 'Checkbox = ', state printString ].	radioOne := SpRadioButtonPresenter newApplication: application.	radioOne label: 'Radio A'.	radioTwo := SpRadioButtonPresenter newApplication: application.	radioTwo label: 'Radio B'.	radioOne associatedRadioButtons: { radioTwo }.	radioOne state: true.	radioOne whenChangedDo: [ :state | state ifTrue: [ status label: 'Radio A selected' ] ].	radioTwo whenChangedDo: [ :state | state ifTrue: [ status label: 'Radio B selected' ] ].	layout := SpBoxLayout newTopToBottom		borderWidth: 14;		spacing: 10;		add: label expand: false;		add: button expand: false;		add: check expand: false;		add: (SpBoxLayout newLeftToRight			spacing: 12;			add: radioOne expand: false;			add: radioTwo expand: false;			yourself) expand: false;		add: status expand: false;		yourself.	root layout: layout.	^ root]{ #category : 'examples' }SpWin32Examples class >> openBoxLayout [	<example>	| application root |	application := self application.	root := self boxLayoutOn: application.	^ self openRoot: root title: 'Spec Win32 - Box layout' extent: 680 @ 360]{ #category : 'example builders' }SpWin32Examples class >> boxLayoutOn: application [	| root heading left middle right vertical layout |	root := SpPresenter newApplication: application.	heading := SpLabelPresenter newApplication: application.	heading label: 'Nested logical H/V Box layouts — resize the window.'.	left := SpButtonPresenter newApplication: application.	left label: 'Fixed left'.	middle := SpButtonPresenter newApplication: application.	middle label: 'Expands/fills'.	right := SpButtonPresenter newApplication: application.	right label: 'Placed at end'.	vertical := SpBoxLayout newTopToBottom		spacing: 6;		beHomogeneous;		add: ((SpLabelPresenter newApplication: application) label: 'Homogeneous row 1'; yourself);		add: ((SpLabelPresenter newApplication: application) label: 'Homogeneous row 2'; yourself);		yourself.	layout := SpBoxLayout newTopToBottom		borderWidth: 16;		spacing: 12;		add: heading expand: false;		add: (SpBoxLayout newLeftToRight			spacing: 10;			add: left expand: false fill: true padding: 4;			add: middle expand: true fill: true padding: 4;			addLast: right withConstraints: [ :constraints |				constraints					expand: false;					fill: true;					padding: 4;					bePlacedAtEnd ];			yourself) expand: false;		add: vertical expand: true;		yourself.	root layout: layout.	^ root]{ #category : 'examples' }SpWin32Examples class >> openGridLayout [	<example>	| application root |	application := self application.	root := self gridLayoutOn: application.	^ self openRoot: root title: 'Spec Win32 - Grid layout' extent: 720 @ 430]{ #category : 'example builders' }SpWin32Examples class >> gridLayoutOn: application [	| root title status first second spanning grow aligned homogeneous layout |	root := SpPresenter newApplication: application.	title := SpLabelPresenter newApplication: application.	title label: 'Grid: spacing, spanning and expandable tracks'.	first := SpButtonPresenter newApplication: application.	first label: '1,2'.	second := SpButtonPresenter newApplication: application.	second label: '2,2'.	spanning := SpLabelPresenter newApplication: application.	spanning label: 'This label spans two columns'.	grow := SpTextInputFieldPresenter newApplication: application.	grow placeholder: 'Column 2 expands'.	aligned := SpButtonPresenter newApplication: application.	aligned label: 'Aligned end/center'.	homogeneous := SpGridLayout new		beColumnHomogeneous;		beRowHomogeneous;		columnSpacing: 6;		rowSpacing: 4;		add: ((SpButtonPresenter newApplication: application) label: 'same'; yourself) atPoint: 1@1;		add: ((SpButtonPresenter newApplication: application) label: 'wider caption'; yourself) atPoint: 2@1;		add: ((SpLabelPresenter newApplication: application) label: 'row 2'; yourself) atPoint: 1@2;		add: ((SpLabelPresenter newApplication: application) label: 'row 2b'; yourself) atPoint: 2@2;		yourself.	status := SpLabelPresenter newApplication: application.	status label: 'Resize the window to inspect track growth.'.	layout := SpGridLayout new		borderWidth: 16;		columnSpacing: 14;		rowSpacing: 10;		beColumnNotHomogeneous;		beRowNotHomogeneous;		column: 2 expand: true;		row: 4 expand: true;		add: title atPoint: 1@1 span: 2@1;		add: first atPoint: 1@2;		add: second atPoint: 2@2;		add: spanning atPoint: 1@3 span: 2@1;		add: ((SpLabelPresenter newApplication: application) label: 'Expandable:'; yourself) atPoint: 1@4;		add: grow atPoint: 2@4;		add: aligned withConstraints: [ :constraints |			constraints				position: 2@5;				hAlignEnd;				vAlignCenter ];		add: homogeneous atPoint: 1@6 span: 2@1;		row: 6 expand: true;		add: status atPoint: 1@7 span: 2@1;		yourself.	root layout: layout.	^ root]{ #category : 'examples' }SpWin32Examples class >> openTextInput [	<example>	| application root |	application := self application.	root := self textInputOn: application.	^ self openRoot: root title: 'Spec Win32 - EDIT controls' extent: 650 @ 410]{ #category : 'example builders' }SpWin32Examples class >> textInputOn: application [	| root status normal password limited readOnly layout |	root := SpPresenter newApplication: application.	status := SpLabelPresenter newApplication: application.	status label: 'Native single-line EDIT controls'.	normal := SpTextInputFieldPresenter newApplication: application.	normal placeholder: 'Type Unicode text'.	normal whenTextChangedDo: [ :text | status label: 'Normal text = ', text ].	password := SpTextInputFieldPresenter newApplication: application.	password placeholder: 'Password'; bePassword.	limited := SpTextInputFieldPresenter newApplication: application.	limited placeholder: 'Maximum 8 characters'; maxLength: 8.	readOnly := SpTextInputFieldPresenter newApplication: application.	readOnly text: 'Read-only native EDIT'; beNotEditable.	layout := SpGridLayout new		borderWidth: 14;		columnSpacing: 12;		rowSpacing: 10;		column: 2 expand: true;		add: ((SpLabelPresenter newApplication: application) label: 'Normal:'; yourself) atPoint: 1@1;		add: normal atPoint: 2@1;		add: ((SpLabelPresenter newApplication: application) label: 'Password:'; yourself) atPoint: 1@2;		add: password atPoint: 2@2;		add: ((SpLabelPresenter newApplication: application) label: 'Max length:'; yourself) atPoint: 1@3;		add: limited atPoint: 2@3;		add: ((SpLabelPresenter newApplication: application) label: 'Read only:'; yourself) atPoint: 1@4;		add: readOnly atPoint: 2@4;		add: status atPoint: 1@5 span: 2@1;		yourself.	root layout: layout.	^ root]{ #category : 'examples' }SpWin32Examples class >> openList [	<example>	| application root |	application := self application.	root := self listOn: application.	^ self openRoot: root title: 'Spec Win32 - List / ListView' extent: 650 @ 430]{ #category : 'example builders' }SpWin32Examples class >> listOn: application [	| root status list single multiple replace header layout |	root := SpPresenter newApplication: application.	status := SpLabelPresenter newApplication: application.	status label: 'Native SysListView32: select, Ctrl-select, double-click or press Enter.'.	list := SpListPresenter newApplication: application.	list		headerTitle: 'Native ListView items';		display: [ :each | each asString ];		items: #( 'Alpha' 'Beta' 'Příliš žluťoučký kůň' '日本語' 'Emoji 🙂' 'Last item' ).	list whenSelectionChangedDo: [ :selection |		status label: 'Selected indexes: ', selection selectedIndexes printString ].	list whenActivatedDo: [ :selection |		status label: 'Activated: ', selection selectedItem printString ].	single := SpButtonPresenter newApplication: application.	single label: 'Single selection'; action: [ list beSingleSelection. status label: 'Single-selection mode' ].	multiple := SpButtonPresenter newApplication: application.	multiple label: 'Multiple selection'; action: [ list beMultipleSelection. status label: 'Multiple-selection mode; use Ctrl-click' ].	replace := SpButtonPresenter newApplication: application.	replace label: 'Replace items'; action: [		list items: #( red green blue cyan magenta yellow ).		status label: 'Model replaced' ].	header := SpCheckBoxPresenter newApplication: application.	header label: 'Show header'; state: true.	header whenChangedDo: [ :state |		state ifTrue: [ list headerTitle: 'Native ListView items' ] ifFalse: [ list hideHeaderTitle ] ].	layout := SpBoxLayout newTopToBottom		borderWidth: 14;		spacing: 8;		add: list expand: true;		add: (SpBoxLayout newLeftToRight			spacing: 8;			add: single expand: false;			add: multiple expand: false;			add: replace expand: false;			yourself) expand: false;		add: header expand: false;		add: status expand: false;		yourself.	root layout: layout.	^ root]{ #category : 'examples' }SpWin32Examples class >> openTable [	<example>	| application root |	application := self application.	root := self tableOn: application.	^ self openRoot: root title: 'Spec Win32 - Table / ListView report mode' extent: 760 @ 480]{ #category : 'example builders' }SpWin32Examples class >> tableOn: application [	| root status table sortScore replace headers resizable layout |	root := SpPresenter newApplication: application.	status := SpLabelPresenter newApplication: application.	status label: 'Click the sortable Score header; use Ctrl-click after enabling multiple selection.' .	table := SpTablePresenter newApplication: application.	table		addColumn: ((SpIndexTableColumn title: '#') width: 38; beNotExpandable; yourself);		addColumn: (SpStringTableColumn title: 'Name' evaluated: #key);		addColumn: ((SpStringTableColumn title: 'Score' evaluated: #value)			width: 90;			displayAlignment: [ :item | SpColumnAlignment right ];			yourself);		items: {			'Alpha' -> 20.			'Beta' -> 10.			'Příliš žluťoučký kůň' -> 40.			'日本語' -> 30.			'Emoji 🙂' -> 50 }.	table whenSelectionChangedDo: [ :selection |		status label: 'Selected table rows: ', selection selectedIndexes printString ].	table whenActivatedDo: [ :selection |		status label: 'Activated row: ', selection selectedItem printString ].	sortScore := SpButtonPresenter newApplication: application.	sortScore label: 'Sort Score'; action: [ table clickOnColumnHeaderAt: 3 ].	replace := SpButtonPresenter newApplication: application.	replace label: 'Replace rows'; action: [		table items: { 'Delta' -> 7. 'Echo' -> 99. 'Foxtrot' -> 42 }.		status label: 'Table rows replaced' ].	headers := SpCheckBoxPresenter newApplication: application.	headers label: 'Show headers'; state: true.	headers whenChangedDo: [ :state | state ifTrue: [ table showColumnHeaders ] ifFalse: [ table hideColumnHeaders ] ].	resizable := SpCheckBoxPresenter newApplication: application.	resizable label: 'Resizable columns'; state: false.	resizable whenChangedDo: [ :state | state ifTrue: [ table beResizable ] ifFalse: [ table beNotResizable ] ].	layout := SpBoxLayout newTopToBottom		borderWidth: 14;		spacing: 8;		add: table expand: true;		add: (SpBoxLayout newLeftToRight			spacing: 8;			add: sortScore expand: false;			add: replace expand: false;			yourself) expand: false;		add: headers expand: false;		add: resizable expand: false;		add: status expand: false;		yourself.	root layout: layout.	^ root]{ #category : 'examples' }SpWin32Examples class >> openDropList [	<example>	| application root |	application := self application.	root := self dropListOn: application.	^ self openRoot: root title: 'Spec Win32 - DropList / COMBOBOX' extent: 600 @ 300]{ #category : 'example builders' }SpWin32Examples class >> dropListOn: application [	| root status drop selectThird replace layout |	root := SpPresenter newApplication: application.	status := SpLabelPresenter newApplication: application.	status label: 'No selection yet'.	drop := SpDropListPresenter newApplication: application.	drop		startWithoutSelection;		display: [ :each | each asString asUppercase ];		items: #( alpha beta 'Příliš žluťoučký kůň' '🙂 emoji' ).	drop whenSelectedItemChangedDo: [ :item | status label: 'Selected: ', item printString ].	selectThird := SpButtonPresenter newApplication: application.	selectThird label: 'Select index 3'; action: [ drop selectIndex: 3 ].	replace := SpButtonPresenter newApplication: application.	replace label: 'Replace items'; action: [		drop items: #( one two three four five ).		status label: 'Items replaced' ].	layout := SpBoxLayout newTopToBottom		borderWidth: 14;		spacing: 10;		add: drop expand: false;		add: (SpBoxLayout newLeftToRight			spacing: 10;			add: selectThird expand: false;			add: replace expand: false;			yourself) expand: false;		add: status expand: false;		yourself.	root layout: layout.	^ root]{ #category : 'examples' }SpWin32Examples class >> openSliderAndProgress [	<example>	| application root |	application := self application.	root := self sliderAndProgressOn: application.	^ self openRoot: root title: 'Spec Win32 - Slider and ProgressBar' extent: 680 @ 430]{ #category : 'example builders' }SpWin32Examples class >> sliderAndProgressOn: application [	| root status horizontal vertical progress indeterminate progressing progressValue layout |	root := SpPresenter newApplication: application.	status := SpLabelPresenter newApplication: application.	status label: 'Trackbar values are mapped through Spec min/max/quantum.'.	horizontal := SpSliderPresenter newApplication: application.	horizontal min: -100; max: 100; quantum: 5; value: 25.	vertical := SpSliderPresenter newApplication: application.	vertical beVertical; min: 0; max: 10; quantum: 1; value: 4.	progress := SpProgressBarPresenter newApplication: application.	progress fixedAt: 0.625.	indeterminate := SpCheckBoxPresenter newApplication: application.	indeterminate label: 'Indeterminate / marquee progress'.	progressValue := 0.	progressing := SpButtonPresenter newApplication: application.	progressing label: 'Run timed progress'; action: [		progressValue := 0.		progress progress: [			progressValue := (progressValue + 0.05) min: 1.0.			progressValue ] every: 0.1 second ].	horizontal whenValueChangedDo: [ :value |		progress fixedAt: ((value + 100) / 200).		status label: 'Horizontal slider = ', value printString ].	vertical whenValueChangedDo: [ :value | status label: 'Vertical slider = ', value printString ].	indeterminate whenChangedDo: [ :state |		state			ifTrue: [ progress indeterminate ]			ifFalse: [ progress fixedAt: ((horizontal value + 100) / 200) ] ].	layout := SpGridLayout new		borderWidth: 14;		columnSpacing: 12;		rowSpacing: 10;		column: 2 expand: true;		row: 2 expand: true;		add: ((SpLabelPresenter newApplication: application) label: 'Horizontal:'; yourself) atPoint: 1@1;		add: horizontal atPoint: 2@1;		add: ((SpLabelPresenter newApplication: application) label: 'Vertical:'; yourself) atPoint: 1@2;		add: vertical atPoint: 2@2;		add: ((SpLabelPresenter newApplication: application) label: 'Progress:'; yourself) atPoint: 1@3;		add: progress atPoint: 2@3;		add: indeterminate atPoint: 2@4;		add: progressing atPoint: 2@5;		add: status atPoint: 1@6 span: 2@1;		yourself.	root layout: layout.	^ root]{ #category : 'examples' }SpWin32Examples class >> openNotebook [	<example>	| application root |	application := self application.	root := self notebookOn: application.	^ self openRoot: root title: 'Spec Win32 - Notebook / Tab control' extent: 720 @ 500]{ #category : 'example builders' }SpWin32Examples class >> notebookOn: application [	| root status notebook add remove rename reset layout counter |	root := SpPresenter newApplication: application.	status := SpLabelPresenter newApplication: application.	status label: 'Native SysTabControl32 with lazy Spec page contents.'.	notebook := SpNotebookPresenter newApplication: application.	notebook		addPage: (SpNotebookPage title: 'First' provider: [			(SpLabelPresenter newApplication: application) label: 'First page content'; yourself ]);		addPage: (SpNotebookPage title: 'UTF-8 Příliš 🙂' provider: [			(SpButtonPresenter newApplication: application)				label: 'Button in second page';				action: [ status label: 'Second-page button clicked' ];				yourself ]).	notebook whenSelectedPageChangedDo: [ :page |		status label: 'Selected page: ', (page ifNil: [ '<none>' ] ifNotNil: [ page title ]) ].	counter := 2.	add := SpButtonPresenter newApplication: application.	add label: 'Add page'; action: [		counter := counter + 1.		notebook addPage: (SpNotebookPage			title: 'Dynamic ', counter printString			provider: [ (SpLabelPresenter newApplication: application) label: 'Dynamic page'; yourself ]) ].	remove := SpButtonPresenter newApplication: application.	remove label: 'Remove selected'; action: [		notebook selectedPage ifNotNil: [ :page | notebook removePage: page ] ].	rename := SpButtonPresenter newApplication: application.	rename label: 'Rename selected'; action: [		notebook selectedPage ifNotNil: [ :page | page title: page title, ' *' ] ].	reset := SpButtonPresenter newApplication: application.	reset label: 'Reset page contents'; action: [ notebook resetAllPageContents ].	layout := SpBoxLayout newTopToBottom		borderWidth: 14;		spacing: 10;		add: notebook expand: true;		add: (SpBoxLayout newLeftToRight			spacing: 8;			add: add expand: false;			add: remove expand: false;			add: rename expand: false;			add: reset expand: false;			yourself) expand: false;		add: status expand: false;		yourself.	root layout: layout.	^ root]{ #category : 'examples' }SpWin32Examples class >> openDynamicUpdates [	<example>	| application root |	application := self application.	root := self dynamicUpdatesOn: application.	^ self openRoot: root title: 'Spec Win32 - dynamic updates' extent: 700 @ 430]{ #category : 'example builders' }SpWin32Examples class >> dynamicUpdatesOn: application [	| root status changing target replacement box changeLabel toggleVisible toggleEnabled replace layout |	root := SpPresenter newApplication: application.	status := SpLabelPresenter newApplication: application.	status label: 'Changes below exercise presenter-to-native synchronization and Box replacement.'.	changing := SpLabelPresenter newApplication: application.	changing label: 'This label changes dynamically'.	target := SpButtonPresenter newApplication: application.	target label: 'Target button'.	replacement := SpButtonPresenter newApplication: application.	replacement label: 'Replacement button'.	box := SpBoxLayout newLeftToRight		spacing: 10;		add: changing expand: true;		add: target expand: false;		yourself.	changeLabel := SpButtonPresenter newApplication: application.	changeLabel label: 'Change UTF-8 label'; action: [ changing label: 'Changed: Žluťoučký 🙂 ', DateAndTime now asTime printString ].	toggleVisible := SpButtonPresenter newApplication: application.	toggleVisible label: 'Toggle target visibility'; action: [ target visible: target isVisible not ].	toggleEnabled := SpButtonPresenter newApplication: application.	toggleEnabled label: 'Toggle target enabled'; action: [ target enabled: target isEnabled not ].	replace := SpButtonPresenter newApplication: application.	replace label: 'Replace target'; action: [		box replace: target with: replacement.		status label: 'Box child replaced dynamically' ].	layout := SpBoxLayout newTopToBottom		borderWidth: 14;		spacing: 10;		add: box expand: false;		add: changeLabel expand: false;		add: toggleVisible expand: false;		add: toggleEnabled expand: false;		add: replace expand: false;		add: status expand: false;		yourself.	root layout: layout.	^ root]{ #category : 'examples' }SpWin32Examples class >> openWindowLifecycle [	<example>	| application root status window buttons move resize minimize maximize restore activate beep rename close |	application := self application.	root := SpPresenter newApplication: application.	status := SpLabelPresenter newApplication: application.	status label: 'Use the buttons to exercise native top-level-window operations.'.	move := SpButtonPresenter newApplication: application.	resize := SpButtonPresenter newApplication: application.	minimize := SpButtonPresenter newApplication: application.	maximize := SpButtonPresenter newApplication: application.	restore := SpButtonPresenter newApplication: application.	activate := SpButtonPresenter newApplication: application.	beep := SpButtonPresenter newApplication: application.	rename := SpButtonPresenter newApplication: application.	close := SpButtonPresenter newApplication: application.	buttons := { move. resize. minimize. maximize. restore. activate. beep. rename. close }.	root layout: (SpBoxLayout newTopToBottom		borderWidth: 14;		spacing: 8;		add: status expand: false;		yourself).	buttons do: [ :button | root layout add: button expand: false ].	window := SpWindowPresenter presenter: root.	window		title: 'Spec Win32 - window lifecycle';		initialExtent: 520 @ 520.	move label: 'Move to 80@80'; action: [ window moveTo: 80@80 ].	resize label: 'Resize to 700@460'; action: [ window resize: 700@460 ].	minimize label: 'Minimize'; action: [ window minimize ].	maximize label: 'Maximize'; action: [ window maximize ].	restore label: 'Restore'; action: [ window restore ].	activate label: 'Activate'; action: [ window activate ].	beep label: 'Beep'; action: [ window beep ].	rename label: 'Change title'; action: [ window title: 'Spec Win32 - title changed at ', DateAndTime now asTime printString ].	close label: 'Close'; action: [ window close ].	window whenResizingDo: [ :announcement |		status label: 'Resized: ', announcement newSize printString ].	window whenWillCloseDo: [ Transcript show: 'Spec Win32 example: window will close'; cr ].	window whenClosedDo: [ Transcript show: 'Spec Win32 example: window closed'; cr ].	window open.	^ window]{ #category : 'examples' }SpWin32Examples class >> openFocusAndSelection [	<example>	| application root |	application := self application.	root := self focusAndSelectionOn: application.	^ self openRoot: root title: 'Spec Win32 - focus and EDIT selection' extent: 700 @ 390]{ #category : 'example builders' }SpWin32Examples class >> focusAndSelectionOn: application [	| root status first second focusSelect focusPreserve selectEmoji report layout |	root := SpPresenter newApplication: application.	status := SpLabelPresenter newApplication: application.	status label: 'Use Tab / Shift+Tab to exercise native Win32 focus traversal.'.	first := SpTextInputFieldPresenter newApplication: application.	first text: 'A🙂BC — first EDIT'.	second := SpTextInputFieldPresenter newApplication: application.	second text: 'Second EDIT'.	first eventHandler		whenFocusReceivedDo: [ status label: 'First EDIT received focus' ];		whenFocusLostDo: [ status label: 'First EDIT lost focus' ].	second eventHandler		whenFocusReceivedDo: [ status label: 'Second EDIT received focus' ];		whenFocusLostDo: [ status label: 'Second EDIT lost focus' ].	focusSelect := SpButtonPresenter newApplication: application.	focusSelect		label: 'Focus first + select all';		action: [ first takeKeyboardFocus ].	focusPreserve := SpButtonPresenter newApplication: application.	focusPreserve		label: 'Focus first, preserve selection';		action: [ first takeKeyboardFocusWithoutSelecting ].	selectEmoji := SpButtonPresenter newApplication: application.	selectEmoji		label: 'Select emoji (character 2)';		action: [ first selectionInterval: (2 to: 2) ].	report := SpButtonPresenter newApplication: application.	report		label: 'Report selection/caret';		action: [			status label: 'selection=', first selectionInterval printString,				' caret=', first cursorPositionIndex printString ].	layout := SpGridLayout new		borderWidth: 14;		columnSpacing: 10;		rowSpacing: 10;		column: 2 expand: true;		add: ((SpLabelPresenter newApplication: application) label: 'First:'; yourself) atPoint: 1@1;		add: first atPoint: 2@1;		add: ((SpLabelPresenter newApplication: application) label: 'Second:'; yourself) atPoint: 1@2;		add: second atPoint: 2@2;		add: focusSelect atPoint: 1@3;		add: focusPreserve atPoint: 2@3;		add: selectEmoji atPoint: 1@4;		add: report atPoint: 2@4;		add: status atPoint: 1@5 span: 2@1;		yourself.	root layout: layout.	^ root]{ #category : 'examples' }SpWin32Examples class >> openTree [	<example>	| application root |	application := self application.	root := self treeOn: application.	^ self openRoot: root title: 'Spec Win32 - Tree / TreeView' extent: 650 @ 460]{ #category : 'example builders' }SpWin32Examples class >> treeOn: application [	| root status tree expand collapse replace layout |	root := SpPresenter newApplication: application.	status := SpLabelPresenter newApplication: application.	status label: 'Native SysTreeView32: expand/collapse nodes, double-click or Enter to activate.'.	tree := SpTreePresenter newApplication: application.	tree		roots: #( 'Europe' 'Asia' 'Emoji 🙂' );		children: [ :each |			each = 'Europe' ifTrue: [ #( 'Czechia' 'Germany' ) ] ifFalse: [			each = 'Czechia' ifTrue: [ #( 'Prague' 'Ostrava' ) ] ifFalse: [			each = 'Asia' ifTrue: [ #( '日本' '한국' ) ] ifFalse: [ #() ] ] ] ];		display: [ :each | each asString ].	tree whenSelectionChangedDo: [ :selection | status label: 'Selected path: ', selection selectedPath printString ].	tree whenActivatedDo: [ :selection | status label: 'Activated: ', selection selectedItem printString ].	expand := SpButtonPresenter newApplication: application.	expand label: 'Expand all'; action: [ tree expandAll ].	collapse := SpButtonPresenter newApplication: application.	collapse label: 'Collapse all'; action: [ tree collapseAll ].	replace := SpButtonPresenter newApplication: application.	replace label: 'Replace roots'; action: [ tree roots: #( 'One' 'Two' 'Three' ). status label: 'Roots replaced' ].	layout := SpBoxLayout newTopToBottom		borderWidth: 14;		spacing: 8;		add: tree expand: true;		add: (SpBoxLayout newLeftToRight spacing: 8; add: expand expand: false; add: collapse expand: false; add: replace expand: false; yourself) expand: false;		add: status expand: false;		yourself.	root layout: layout.	^ root]{ #category : 'examples' }SpWin32Examples class >> openTreeTable [	<example>	| application root |	application := self application.	root := self treeTableOn: application.	^ self openRoot: root title: 'Spec Win32 - TreeTable' extent: 620 @ 430]{ #category : 'example builders' }SpWin32Examples class >> treeTableOn: application [	| root status treeTable expand collapse multiple headers resizable layout |	root := SpPresenter newApplication: application.	status := SpLabelPresenter newApplication: application.	status label: 'TreeTable uses native report ListView rows with hierarchical path mapping.'.	treeTable := SpTreeTablePresenter newApplication: application.	treeTable		addColumn: ((SpStringTableColumn title: 'Name' evaluated: #key) width: 260; yourself);		addColumn: ((SpStringTableColumn title: 'Value' evaluated: #value) width: 110; yourself);		roots: { 'Europe' -> 'continent'. 'Asia' -> 'continent'. 'Emoji 🙂' -> 'sample' };		children: [ :each |			each key = 'Europe' ifTrue: [ { 'Czechia' -> 'country'. 'Germany' -> 'country' } ] ifFalse: [			each key = 'Czechia' ifTrue: [ { 'Prague' -> 'city'. 'Ostrava' -> 'city' } ] ifFalse: [			each key = 'Asia' ifTrue: [ { '日本' -> 'country'. '한국' -> 'country' } ] ifFalse: [ #() ] ] ] ].	treeTable whenSelectionChangedDo: [ :selection |		status label: 'Selected paths: ', selection selectedPaths printString ].	treeTable whenActivatedDo: [ :selection |		status label: 'Activated: ', selection selectedItem printString ].	expand := SpButtonPresenter newApplication: application.	expand label: 'Expand all'; action: [ treeTable expandAll ].	collapse := SpButtonPresenter newApplication: application.	collapse label: 'Collapse all'; action: [ treeTable collapseAll ].	multiple := SpCheckBoxPresenter newApplication: application.	multiple label: 'Multiple selection'; state: false.	multiple whenChangedDo: [ :state | state ifTrue: [ treeTable beMultipleSelection ] ifFalse: [ treeTable beSingleSelection ] ].	headers := SpCheckBoxPresenter newApplication: application.	headers label: 'Show headers'; state: true.	headers whenChangedDo: [ :state | state ifTrue: [ treeTable showColumnHeaders ] ifFalse: [ treeTable hideColumnHeaders ] ].	resizable := SpCheckBoxPresenter newApplication: application.	resizable label: 'Resizable columns'; state: false.	resizable whenChangedDo: [ :state | state ifTrue: [ treeTable beResizable ] ifFalse: [ treeTable beNotResizable ] ].	layout := SpBoxLayout newTopToBottom		borderWidth: 14;		spacing: 8;		add: treeTable expand: true;		add: (SpBoxLayout newLeftToRight spacing: 8; add: expand expand: false; add: collapse expand: false; yourself) expand: false;		add: multiple expand: false;		add: headers expand: false;		add: resizable expand: false;		add: status expand: false;		yourself.	root layout: layout.	^ root]{ #category : 'examples' }SpWin32Examples class >> openToggleAndSwitch [	<example>	| application root |	application := self application.	root := self toggleAndSwitchOn: application.	^ self openRoot: root title: 'Spec Win32 - ToggleButton and Switch' extent: 560 @ 330]{ #category : 'example builders' }SpWin32Examples class >> toggleAndSwitchOn: application [	| root status first second switch layout |	root := SpPresenter newApplication: application.	status := SpLabelPresenter newApplication: application.	status label: 'ToggleButton uses native push-like state; Switch uses native custom rendering.'.	first := SpToggleButtonPresenter newApplication: application.	first label: 'Mode A'.	second := SpToggleButtonPresenter newApplication: application.	second label: 'Mode B'.	first associatedToggleButtons: { second }.	first state: true.	first whenChangedDo: [ :state | status label: 'Mode A = ', state printString ].	second whenChangedDo: [ :state | status label: 'Mode B = ', state printString ].	switch := SpSwitchPresenter newApplication: application.	switch state: false.	switch whenChangedDo: [ :state | status label: 'Switch = ', state printString ].	layout := SpBoxLayout newTopToBottom		borderWidth: 14;		spacing: 12;		add: ((SpLabelPresenter newApplication: application) label: 'Associated toggle buttons:'; yourself) expand: false;		add: (SpBoxLayout newLeftToRight			spacing: 10;			add: first expand: false;			add: second expand: false;			yourself) expand: false;		add: ((SpLabelPresenter newApplication: application) label: 'Switch:'; yourself) expand: false;		add: switch expand: false;		add: status expand: false;		yourself.	root layout: layout.	^ root]{ #category : 'examples' }SpWin32Examples class >> openSpinnerAndLink [	<example>	| application root |	application := self application.	root := self spinnerAndLinkOn: application.	^ self openRoot: root title: 'Spec Win32 - Spinner and Link' extent: 560 @ 280]{ #category : 'example builders' }SpWin32Examples class >> spinnerAndLinkOn: application [	| root status spinner link changeLabel layout |	root := SpPresenter newApplication: application.	status := SpLabelPresenter newApplication: application.	status label: 'Spinner is a native animated control; Link is a native SysLink.'.	spinner := SpSpinnerPresenter newApplication: application.	link := SpLinkPresenter newApplication: application.	link		label: 'Click native hyperlink';		action: [ status label: 'Link activated at ', DateAndTime now asTime printString ].	changeLabel := SpButtonPresenter newApplication: application.	changeLabel		label: 'Change link label';		action: [			link label: 'Updated link — čeština 日本語'.			status label: 'Link label changed dynamically' ].	layout := SpBoxLayout newTopToBottom		borderWidth: 14;		spacing: 12;		add: ((SpLabelPresenter newApplication: application)			label: 'Indefinite spinner:';			yourself) expand: false;		add: spinner expand: false;		add: ((SpLabelPresenter newApplication: application)			label: 'Native hyperlink:';			yourself) expand: false;		add: link expand: false;		add: changeLabel expand: false;		add: status expand: false;		yourself.	root layout: layout.	^ root]{ #category : 'examples' }SpWin32Examples class >> openNumberAndSearch [	<example>	| application root |	application := self application.	root := self numberAndSearchOn: application.	^ self openRoot: root title: 'Spec Win32 - NumberInput and SearchInput' extent: 560 @ 330]{ #category : 'example builders' }SpWin32Examples class >> numberAndSearchOn: application [	| root status number search layout |	root := SpPresenter newApplication: application.	status := SpLabelPresenter newApplication: application.	status label: 'Number has native step affordances; Search has a native clear affordance.'.	number := SpNumberInputFieldPresenter newApplication: application.	number		beFloat;		rangeMinimum: -10 maximum: 10;		digits: 2;		climbRate: 0.25;		number: 1.5.	number whenTextChangedDo: [ :text | status label: 'Number text = ', text ].	search := SpSearchInputFieldPresenter newApplication: application.	search		placeholder: 'Search native controls';		text: 'needle'.	search whenTextChangedDo: [ :text | status label: 'Search text = ', text printString ].	layout := SpBoxLayout newTopToBottom		borderWidth: 14;		spacing: 12;		add: ((SpLabelPresenter newApplication: application)			label: 'NumberInputField (-10..10, step 0.25, 2 digits):';			yourself) expand: false;		add: number expand: false;		add: ((SpLabelPresenter newApplication: application)			label: 'SearchInputField:';			yourself) expand: false;		add: search expand: false;		add: status expand: false;		yourself.	root layout: layout.	^ root]{ #category : 'private' }SpWin32Examples class >> sampleImageForm [	| form |	form := Form extent: 96 @ 64 depth: 32.	0 to: 63 do: [ :y |		0 to: 95 do: [ :x |			| color |			color := ((x // 16 + (y // 16)) even)				ifTrue: [ Color r: 0.12 g: 0.45 b: 0.90 alpha: 1.0 ]				ifFalse: [ Color r: 0.95 g: 0.55 b: 0.10 alpha: 0.72 ].			form colorAt: x @ y put: color ] ].	^ form]{ #category : 'examples' }SpWin32Examples class >> openImage [	<example>	| application root |	application := self application.	root := self imageOn: application.	^ self openRoot: root title: 'Spec Win32 - Image / Form transport' extent: 620 @ 360]{ #category : 'example builders' }SpWin32Examples class >> imageOn: application [	| root image scaled status clear restore layout form |	root := SpPresenter newApplication: application.	form := self sampleImageForm.	status := SpLabelPresenter newApplication: application.	status label: 'Left: native size and centered. Right: aspect-preserving autoscale.'.	image := SpImagePresenter newApplication: application.	image image: form; action: [ status label: 'Native-size image clicked' ].	scaled := SpImagePresenter newApplication: application.	scaled image: form; autoScale: true; action: [ status label: 'Autoscaled image clicked' ].	clear := SpButtonPresenter newApplication: application.	clear label: 'Clear left'; action: [ image image: nil. status label: 'Left image cleared' ].	restore := SpButtonPresenter newApplication: application.	restore label: 'Restore left'; action: [ image image: form. status label: 'Left image restored' ].	layout := SpBoxLayout newTopToBottom		borderWidth: 14;		spacing: 8;		add: (SpBoxLayout newLeftToRight			spacing: 10;			add: image expand: true;			add: scaled